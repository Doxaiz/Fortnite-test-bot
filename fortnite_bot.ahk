ApplyToggles() {
    global CFG, UI
    try {
        m := UI.ddMode.Value
        CFG.botMode := (m = 2) ? "queue" : ((m = 3) ? "antiafk" : ((m = 4) ? "xp" : "auto"))
    }
    try CFG.dryRun := UI.cbDry.Value ? true : false
    try CFG.smartRestore := UI.cbSmart.Value ? true : false
    try CFG.squadAutoLeave := UI.cbSquad.Value ? true : false
    try CFG.bgMode := UI.cbBg.Value ? true : false
    try CFG.teamSafe := UI.cbTeam.Value ? true : false
}

OnBotModeChange(*) {
    global CFG, ST
    oldMode := CFG.botMode
    ApplyToggles()
    if (oldMode != CFG.botMode) {
        AntiAfkReset()
        XpModeReset()
        MacroPlayReset()
        if (ST.running && !ST.paused)
            ReleaseKeys()
        Log("[i] Режим работы: " ModeRu(CFG.botMode))
        Flash("Режим: " ModeRu(CFG.botMode), 2400)
    }
    UpdateTrayChecks()
    SaveSettings()
    UpdateStatus()
}

SetBotMode(mode) {
    global CFG
    CFG.botMode := (mode = "queue" || mode = "antiafk" || mode = "xp") ? mode : "auto"
    SyncTogglesFromCfg()
    OnBotModeChange()
}

SetPerfPreset(prof) {
    global CFG
    ApplyPerfProfile(prof)
    SyncAfkFields()
    UpdateTrayChecks()
    SaveSettings()
    msg := "Профиль ЦП: " PerfRu(CFG.perfProfile)
    Log("[i] " msg)
    Flash(msg, 2200)
    UpdateStatus()
}

SetStopTimerPreset(mins) {
    global CFG
    CFG.stopAfterMin := Max(0, mins)
    SyncAfkFields()
    UpdateTrayChecks()
    SaveSettings()
    msg := (CFG.stopAfterMin > 0) ? ("Таймер авто-стопа: " CFG.stopAfterMin " мин") : "Таймер авто-стопа выключен"
    Log("[i] " msg)
    Flash(msg, 2400)
    UpdateStatus()
}

OnModeOptionsChange(*) {
    global CFG, ST, UI
    oldBg := CFG.bgMode, oldDry := CFG.dryRun
    oldSmart := CFG.smartRestore
    oldSquad := CFG.squadAutoLeave
    newBg := UI.cbBg.Value ? true : false
    if ((oldBg != newBg || oldDry != UI.cbDry.Value) && ST.running && !ST.paused && !ST.mouseCalActive)
        OnPause()
    ApplyToggles()
    if (oldBg != CFG.bgMode) {
        ST.bgWarned := false
        Log(CFG.bgMode
            ? "[i] Фон-клавиатура: клавиши через PostMessage, мышь только при фокусе."
            : "[i] Фон-клавиатура выключена.")
        if (ST.running && ST.paused)
            Flash("Режим ввода изменён; снимите паузу для продолжения", 3200)
    }
    if (oldDry != CFG.dryRun) {
        Log(CFG.dryRun ? "DryRun ВКЛ (только журнал)" : "DryRun ВЫКЛ")
        if ST.running && ST.paused
            Flash("Режим ввода изменён; снимите паузу вручную", 3200)
    }
    if (oldSmart != CFG.smartRestore) {
        ST.bgWarned := false
        SmartAlertClear()
        Log(CFG.smartRestore
            ? "[i] Умный фон ВКЛ: для кликов меню подниму Fortnite на ~0.5 с и верну ваше окно и курсор."
            : "[i] Умный фон ВЫКЛ: окно игры автоматически не активируется.")
    }
    if (oldSquad != CFG.squadAutoLeave) {
        ST.squadEmptyCount := 0
        ST.squadStatus := CFG.squadAutoLeave ? "активен" : "выкл"
        Log(CFG.squadAutoLeave
            ? "[i] Выход при пустом отряде ВКЛ (пауза " CFG.squadGraceSec " с, интервал 5 с, не для Соло)."
            : "[i] Выход при пустом отряде ВЫКЛ.")
    }
    SaveSettings()
    UpdateStatus()
}

