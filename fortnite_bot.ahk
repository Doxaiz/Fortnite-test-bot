        . " · жетонов " ST.tokensFound " (всего " CFG.totalTokens ")"
        . " · попыток E " ST.promptN " · прежний счётчик (не проверка открытий) " CFG.totalChests
        . " · маршрут: " ST.macroEvents.Length " ш."
        . " · webhook: " (CFG.webhookUrl != "" ? ST.webhookStatus : "выкл"))
    Log("  включено: ходить " Flag(CFG.featMove) " · сундуки " Flag(CFG.featChest)
        . " · лут " Flag(CFG.featLoot) " · бой " Flag(CFG.featCombat)
        . " · предупреждение о лечении " Flag(CFG.featHeal) " (лечиться вручную) · автобус " Flag(CFG.featBusJump)
        . " · оружие " Flag(CFG.featWeaponPick) " · стиль про " Flag(CFG.featProStyle))
    if (CFG.bgMode || ST.mouseBlocked > 0)
        Log("  мышь в фоне: отбито попыток " ST.mouseBlocked
            . (MouseAllowed() ? " · сейчас мышь разрешена (игра в фокусе)" : " · сейчас мышь ЗАКРЫТА"))
    Log("────────────────────────────────────────────")

    ; ВАЖНО (жалоба пользователя, AHK: «local variable appears to never be assigned»):
    ; здесь осталась переменная от старого кода. Теперь фокус спрашиваем заново.
    inFocus := WinActive("ahk_id " hwnd) ? true : false
    if (pct < 3)
        Flash("Почти весь кадр чёрный (" pct "%).`nПереключите игру в «Оконный без рамки».", 5000)
    else if !inFocus
        Flash("Захват ок, но игра НЕ в фокусе —`nбот не нажимает клавиши. Кликните в игру.", 5000)
    else
        Flash("Всё в порядке: захват " pct "% · окно активно · сцена " StateRu(ST.state), 4000)
}

Flag(v) {
    return v ? "да" : "НЕТ"
}


CaptureCalibrationFrame() {
    hwnd := GetGameWindow()
    if (!hwnd || IsSelfWindow(hwnd)) {
        Flash("Окно игры не найдено", 2500)
        return 0
    }
    shot := CaptureClient(hwnd)
    if (!shot || IsSelfWindow(hwnd)) {
        Flash("Кадр недоступен. Разверните игру и проверьте захват с F7.", 3500)
        return 0
    }
    return shot
}

OnCalibrate(*) {
    shot := CaptureCalibrationFrame()
    if shot
        Flash(DescribeCalibrationFrame(shot), 7000)
}

OnSaveCalibration(*) {
    global CFG, ST
    static busy := false
    if busy
        return
    if (ST.mouseCalActive || ST.startWorkers || ST.stopWorkers || (ST.running && !ST.paused && !CFG.dryRun)) {
        Flash("Для снимка поставьте FORMA на паузу, остановите её или включите DryRun.", 4000)
        return
    }
    ; Сначала захват, затем подсказка: не рисуем её поверх плашки игры.
    busy := true, previous := ST.tickCheckMuted
    ST.tickCheckMuted := true
    try {
        shot := CaptureCalibrationFrame()
        if !shot
            return
        saved := SaveCalibrationPair(shot, A_Temp "\FORMA-diagnostics")
        Log("[diag] Кадр #" shot.captureId " и отчёт сохранены локально: " saved.name " (.bmp + .txt)")
        Flash("Сохранены кадр и отчёт:`n" saved.bmp "`nФайлы не отправлены.", 7000)
    } catch as e {
        Log("[diag] Не удалось сохранить кадр и отчёт: " e.Message)
        Flash("Ошибка сохранения. Подробности в run.log.", 4000)
    } finally {
        ST.tickCheckMuted := previous, busy := false
    }
}

SaveCalibrationPair(shot, folder) {
    ; Один снимок BGRX, без масштабирования и без отрисовки рамок на пикселях.
    if (shot.w < 1 || shot.h < 1 || shot.w > 8192 || shot.h > 8192 || shot.stride != shot.w * 4
        || shot.buf.Size != shot.stride * shot.h || shot.buf.Size > 128 * 1024 * 1024)
        throw ValueError("Не поддерживается размер буфера кадра для BMP")
    stamp := A_Now
    name := "forma-" FormatTime(stamp, "yyyyMMdd-HHmmss") "-" ProcessExist() "-" shot.captureId
    bmp := folder "\" name ".bmp", txt := folder "\" name ".txt"
    report := BuildCalibrationReport(shot)
    text := FormaTitle() " · AutoHotkey " A_AhkVersion " (" (A_PtrSize * 8) " бит)`r`n"
        . "Локальное время: " FormatTime(stamp, "yyyy-MM-dd HH:mm:ss") "`r`n"
        . "Файл кадра: " name ".bmp`r`n"
    for line in report.lines
        text .= line "`r`n"
    DirCreate(folder)
    if (FileExist(bmp) || FileExist(txt))
        throw Error("Снимок с таким именем уже существует; нажмите Ctrl+F5 ещё раз")
    try {
        WriteCalibrationBmp(shot, bmp)
        FileAppend(text, txt, "UTF-8")
    } catch as e {
        ; Не оставляем пару, из которой записалась только половина.
        try FileDelete(bmp)
        try FileDelete(txt)
        throw e
    }
    return {name:name, bmp:bmp, txt:txt}
}

WriteCalibrationBmp(shot, path) {
    ; BITMAPFILEHEADER (14 байт) + BITMAPINFOHEADER (40 байт), BI_RGB 32 bpp.
    header := Buffer(54, 0), bytes := shot.buf.Size
    NumPut("UShort", 0x4D42, "UInt", header.Size + bytes, "UInt", 0, "UInt", header.Size
        , "UInt", 40, "Int", shot.w, "Int", -shot.h, "UShort", 1, "UShort", 32
        , "UInt", 0, "UInt", bytes, header)
    f := FileOpen(path, "w", "UTF-8-RAW")
    try {
        if (f.RawWrite(header) != header.Size || f.RawWrite(shot.buf) != bytes)
            throw Error("Неполная запись пикселей кадра")
    } finally {
        f.Close()
    }
}

DescribeCalibrationFrame(shot) {
    report := BuildCalibrationReport(shot)
    for line in report.lines
        Log(line)
    return report.summary
}

BuildCalibrationReport(shot) {
    global CFG
    dens := Round(EdgeDensity(shot), 3)
    dark := Round(FrameDarkRatio(shot), 2)
    yellow := FindYellowButtons(shot, CFG.regEnd)
    plates := ScanLobbyPlates(shot)
    hud := FrameHudEvidence(shot)
    hb := FrameHealth(shot)
    masks := ScanLootMasks(shot)
    chest := FindChest(shot, masks)
    loot := FindLoot(shot, masks)
    diagnostic := {skinPct:0}
    enemy := ReadStaticFigure(shot, CFG.enemyFastFrac, 0, diagnostic)
    prompt := ReadInteractPrompt(shot)
    ring := SoundMarks(shot)
    flashPct := SoundFlash(shot)

    lines := []
    lines.Push("── калибровка ──────────────────────────────")
    lines.Push("  кадр #" shot.captureId " · " shot.w "x" shot.h " · края " dens " (для справки)")
    if shot.HasOwnProp("source")
        lines.Push("  источник: " shot.source)
    lines.Push("  слоты внизу справа " Round(hud.slots, 3))
    lines.Push("  HUD на диагностическом кадре: " (hud.confirmed ? "есть признаки матча" : "не подтверждён")
        . " · " hud.score " (" (hud.why != "" ? hud.why : "нет") ") · память HUD цикла не меняю")
    lines.Push("  панель «ВАС УСТРАНЯЕТ» " Round(BrightRatio(shot, CFG.regDeath, 200), 3)
        . "   [порог экрана смерти " CFG.deathBrightMin "]")
    lines.Push("  затемнение " dark "   [порог итогов " CFG.endDarkRatio "]")
    lines.Push("  жёлтых кнопок (весь экран): " yellow.Length)
    for c in yellow
        lines.Push("     · x=" c.x " y=" c.y " " c.w "x" c.h "  заливка " Round(c.fill, 2)
            . (c.x > shot.w * 0.45 ? "  -> правая колонка (Играть снова)" : "  -> левая панель (Играть)"))
    lines.Push("  в панели лобби жёлтых: " plates.yellow.Length "   кремовая «Отменить»: " (plates.cream ? "да" : "нет"))
    lines.Push("  HP " hb.hp.pct "% (" hb.hp.run " px)  щит " hb.sh.pct "% (" hb.sh.run " px)"
        . "   [порог лечения " CFG.hpLowPercent "%]")
    lines.Push("  сундук: " (chest ? ("кандидат, " chest.area " px в (" chest.x "," chest.y ")") : "нет")
        . "   лут: " (loot ? (loot.kind ", " loot.area " px") : "нет"))
    cand := EnemyCandidates(shot, enemy, diagnostic.skinPct)
    lines.Push("  фигура: " (enemy ? ("кандидат в (" enemy.cx "," enemy.cy "), рамка "
        . enemy.w "x" enemy.h " @ (" enemy.x "," enemy.y ")") : "нет: " diagnostic.figureReject)
        . " · цвет прицела не участвует")
    lines.Push("  плашка E: " (prompt ? ("кандидат в (" prompt.cx "," prompt.cy "), рамка "
        . prompt.w "x" prompt.h " @ (" prompt.x "," prompt.y ")") : "нет")
        . " · один кадр, без ввода и подтверждения текста")
    lines.Push("  бой: одиночный диагностический кадр; движение не измерялось"
        . "   [кожи в боксе нужно " CFG.enemySkinMinPct ".." CFG.enemySkinMaxPct
        . " %, ширина " CFG.enemyMinBoxW ".." CFG.enemyMaxBoxW
        . " px, ближе " Round(CFG.enemyCenterFrac * 100) "% к центру]")
    i := 0
    for c in cand {
        i += 1
        if (i > 6)
            break
        lines.Push("     · " c.src (c.pass ? (": " c.w "x" c.h " @ (" c.cx "," c.cy ")") : "")
            . " · только диагностика")
    }
    lines.Push("  звук: метка " (ring ? ("(" ring.x "," ring.y ") " ring.w "x" ring.h) : "нет")
        . "   вспышка " Round(flashPct) "%")
    sq := SquadScanHud(shot)
    slp := FindSleepScreen(shot)
    redL := FindLeaveButton(shot)
    confirm := FindLeaveConfirmation(shot)
    mdl := FindModalDismissButton(shot)
    pa := PickResultPlayAgain(shot, FindYellowButtons(shot, CFG.regResults))
    lines.Push("  UI: отряд в HUD " sq.count " союзн."
        . " · «Играть снова» " (pa ? ("ДА (" pa.cx "," pa.cy ")") : "нет")
        . " · спящий режим " (slp ? ("ДА (" slp.cx "," slp.cy ")") : "нет")
        . " · красная кнопка выхода " (redL ? ("ДА (" redL.cx "," redL.cy ")") : "нет")
        . " · подтверждение выхода " (confirm ? ("ДА (" confirm.cx "," confirm.cy ")") : "нет")
        . " · модальное окно/опрос " (mdl ? ("ДА (" mdl.cx "," mdl.cy ")") : "нет"))
    lines.Push("────────────────────────────────────────────")

    msg := "кадр " shot.w "×" shot.h " · HUD матча: " (hud.confirmed ? "ДА" : "не подтверждён") "`n"
    msg .= "жёлтых кнопок: " yellow.Length " · «Отменить»: " (plates.cream ? "да" : "нет")
        . " · сон: " (slp ? "ДА" : "нет") "`n"
    msg .= "HP " hb.hp.pct "% · щит " hb.sh.pct "% · отряд: " sq.count " союзн.`n"
    msg .= "сундук: " (chest ? "да" : "нет") " · лут: " (loot ? loot.kind : "нет")
        . " · плашка E: " (prompt ? "кандидат" : "нет")
        . " · фигура: " (enemy ? "кандидат" : "нет")
    return {summary:msg, lines:lines}
}


; ============================================================================
;                            ГОРЯЧИЕ КЛАВИШИ
; ============================================================================
; Горячие клавиши регистрируются динамически (см. ApplyHotkeys) — их можно
; переназначить в меню. Аварийные выходы остаются всегда:
;   Esc — стоп · Ctrl+Alt+Q — полный выход.

ApplyHotkeys() {
    global CFG, UI
    ; снять все ранее назначенные
    try {
        for k in UI.hkKeys
            Hotkey(k, "Off")
    } catch {
    }
    UI.hkKeys := []
    okList := ""
    badList := ""
    UI.hkReport := Map()
    for item in [[CFG.hkStart, OnStart, "старт/стоп"]
               , [CFG.hkDry, ToggleDry, "DryRun"]
               , [CFG.hkBypass, RequestBypassMatch, "пропуск матча"]
               , [CFG.hkHud, ToggleMiniHud, "мини-HUD"]
               , [CFG.hkVision, ToggleVision, "зрение"]
               , [CFG.hkCal, OnCalibrate, "HUD"]
               , [CFG.hkMouseCal, OnMouseCalPrepare, "мышь"]
               , [CFG.hkCheck, OnCheckCapture, "захват"]
               , [CFG.hkMenu, ToggleGui, "меню"]
               , ["^F5", OnSaveCalibration, "сохранить кадр и отчёт"]] {
        key := Trim(item[1])
        if !key {
            Log("[!] клавиша для «" item[3] "» пустая — пропущена")
            badList .= (badList != "" ? " · " : "") item[3]
            continue
        }
        ; Частая причина «бинды не работают»: одна клавиша указана дважды,
        ; тогда второе назначение молча затирает первое.
        if UI.hkReport.Has(StrUpper(key)) {
            Log("[!] клавиша «" key "» назначена дважды («" item[3] "») — оставляю первое")
            badList .= (badList != "" ? " · " : "") item[3]
            continue
        }
        try {
            ; F8/переназначенный старт-стоп: остановка раньше журнала.
            callback := (item[3] = "старт/стоп") ? StartStopHotkey
                : (item[2] = OnSaveCalibration ? OnSaveCalibration : Hk(item[3] "  (" key ")", item[2]))
            ; Старт/стоп можно нажать повторно во время медленного запуска.
            ; Остальные клавиши остаются однопоточными; буфер отключён,
            ; чтобы запоздалое повторное нажатие не запустило бота вновь.
            Hotkey(key, callback, item[3] = "старт/стоп" ? "T2 B0" : "T1 B0")
            UI.hkKeys.Push(key)
            UI.hkReport[StrUpper(key)] := item[3] ":" key
            okList .= (okList != "" ? " · " : "") item[3] " " key
        } catch as e {
            Log("[!] не смог назначить клавишу «" key "» (" item[3] "): " e.Message)
            badList .= (badList != "" ? " · " : "") item[3] " " key
        }
    }
    ; аварийные — всегда
    try {
        ; SendEvent бота работает на уровне 0. Не отключаем Esc даже
        ; на время LeaveStep: физическая клавиша всегда вызывает Stop.
        Hotkey("~$Esc", (*) => OnStop("Esc"), "I0 T1 B0")
        UI.hkReport["~ESC"] := "стоп:Esc"
    } catch as e {
        Log("[!] Esc не назначен: " e.Message)
    }
    try
        Hotkey("^!q", Hk("Ctrl+Alt+Q — выход", (*) => ExitApp()))
    Log("[i] горячие клавиши: " (okList != "" ? okList : "нет"))
    if (badList != "")
        Log("[!] НЕ назначены: " badList " — выберите другую клавишу в меню")
    if (badList = "")
        Flash("Клавиши активны:`n" okList, 2800)
    else
        Flash("Клавиши:`n" okList "`nНЕ назначены: " badList, 5000)
}


