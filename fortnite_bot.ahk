OnCalibrate(*) {
    hwnd := GetGameWindow()
    if !hwnd {
        Flash("Окно не найдено", 2000)
        return
    }
    shot := CaptureClient(hwnd)
    if !shot {
        Flash("Захват не удался", 2000)
        return
    }
    Flash(DescribeCalibrationFrame(shot), 7000)
}

DescribeCalibrationFrame(shot) {
    global CFG
    dens := Round(EdgeDensity(shot), 3)
    dark := Round(FrameDarkRatio(shot), 2)
    yellow := FindYellowButtons(shot, CFG.regEnd)
    lobbyY := FindYellowButtons(shot, CFG.regLobbyBtn)
    cream := FindCreamButton(shot, CFG.regLobbyBtn)
    hud := FrameHudEvidence(shot)
    hb := FrameHealth(shot)
    masks := ScanLootMasks(shot)
    chest := FindChest(shot, masks)
    loot := FindLoot(shot, masks)
    diagnostic := {skinPct:0}
    enemy := FindEnemySkin(shot, CFG.enemyFastFrac, 0, diagnostic)
    cross := CrosshairRed(shot)
    ring := SoundMarks(shot)
    flashPct := SoundFlash(shot)

    Log("── калибровка ──────────────────────────────")
    Log("  кадр #" shot.captureId " · " shot.w "x" shot.h " · края " dens " (для справки)")
    Log("  слоты внизу справа " Round(hud.slots, 3))
    Log("  HUD на диагностическом кадре: " (hud.confirmed ? "есть признаки матча" : "не подтверждён")
        . " · " hud.score " (" (hud.why != "" ? hud.why : "нет") ") · память HUD цикла не меняю")
    Log("  панель «ВАС УСТРАНЯЕТ» " Round(BrightRatio(shot, CFG.regDeath, 200), 3)
        . "   [порог экрана смерти " CFG.deathBrightMin "]")
    Log("  затемнение " dark "   [порог итогов " CFG.endDarkRatio "]")
    Log("  жёлтых кнопок (весь экран): " yellow.Length)
    for c in yellow
        Log("     · x=" c.x " y=" c.y " " c.w "x" c.h "  заливка " Round(c.fill, 2)
            . (c.x > shot.w * 0.45 ? "  -> правая колонка (Играть снова)" : "  -> левая панель (Играть)"))
    Log("  в панели лобби жёлтых: " lobbyY.Length "   кремовая «Отменить»: " (cream ? "да" : "нет"))
    Log("  HP " hb.hp.pct "% (" hb.hp.run " px)  щит " hb.sh.pct "% (" hb.sh.run " px)"
        . "   [порог лечения " CFG.hpLowPercent "%]")
    Log("  сундук: " (chest ? ("да, " chest.area " px в (" chest.cx "," chest.cy ")") : "нет")
        . "   лут: " (loot ? (loot.kind ", " loot.area " px") : "нет"))
    cand := EnemyCandidates(shot, enemy, diagnostic.skinPct)
    Log("  враг: " (enemy ? ("да (" enemy.src ") в (" enemy.cx "," enemy.cy ")") : "нет")
        . "   прицел красный: " (cross ? "да" : "нет"))
    ; Полосы здоровья над врагом в игре НЕТ (v7.7), поэтому смотрим каналы:
    ; фигура (кожа), цифры урона, метка выстрела.
    Log("  каналы врага (v7.7): фигура · цифры урона · метка звука"
        . "   [кожи в боксе нужно " CFG.enemySkinMinPct ".." CFG.enemySkinMaxPct
        . " %, ширина " CFG.enemyMinBoxW ".." CFG.enemyMaxBoxW
        . " px, ближе " Round(CFG.enemyCenterFrac * 100) "% к центру]")
    i := 0
    for c in cand {
        i += 1
        if (i > 6)
            break
        Log("     · " c.w "x" c.h " @ (" c.cx "," c.cy ")  отступ от центра " c.dist " px"
            . (c.pass ? "  -> ПОДХОДИТ" : "  -> отсеяна"))
    }
    Log("  звук: метка " (ring ? ("(" ring.x "," ring.y ") " ring.w "x" ring.h) : "нет")
        . "   вспышка " Round(flashPct) "%")
    Log("────────────────────────────────────────────")

    msg := "края " dens " · затемнение " dark "`n"
    msg .= "жёлтых кнопок: " yellow.Length " · «Отменить»: " (cream ? "да" : "нет") "`n"
    msg .= "HP " hb.hp.pct "% · щит " hb.sh.pct "%`n"
    msg .= "сундук: " (chest ? "да" : "нет") " · лут: " (loot ? loot.kind : "нет") "`n"
    msg .= "враг: " (enemy ? "да" : "нет") " · звук: " (ring ? "метка" : (flashPct ? "вспышка" : "нет"))
    return msg
}

; ============================================================================
;        ПРОВЕРКА СКАЧАННЫХ КАДРОВ (кнопка «🖼 Проверить кадры»)
; ============================================================================
; Зачем: любой набор скриншотов (свой или скачанный) прогоняется через те же
; правила, что и в игре, — сразу видно, где бот врёт.
; Запускается python с photo_check.py — один файл рядом со скриптом,
; зависимость только OpenCV.
;
; ВАЖНО про кавычки: в AHK v2 двойная кавычка внутри строки экранируется
; ОБРАТНОЙ ГАЛОЧКОЙ (`"), а не удвоением ("" — это синтаксис v1).
; Поэтому кавычки для командной строки собираются переменной q.
OnPhotoCheck(*) {
    global CFG, PHOTO
    q := Chr(34)

    ; --- какую папку брать ------------------------------------------------
    ; По умолчанию — НИКАКОГО диалога: ищем кадры рядом с ботом.
    ; Ctrl+клик — выбрать другую папку вручную (диалог с навигацией).
    folder := ""
    if GetKeyState("Ctrl", "P")
        folder := DirSelect(A_ScriptDir, 0, "Выберите папку с кадрами (Ctrl+клик)")
    else
        folder := AutoPhotoFolder()
    if (folder = "") {
        folder := DirSelect(A_ScriptDir, 0, "Кадров рядом не нашёл — выберите папку")
        if (folder = "")
            return
    }
    if !InStr(FileExist(folder), "D") {
        Log("[!] это не папка: " folder)
        Toast("Это не папка", folder, 4000)
        return
    }
    n := CountImages(folder)
    Log("[i] кадры: «" folder "» — найдено картинок: " n)
    if (n = 0) {
        Log("[!] в этой папке нет картинок (нужны .jpg .png .bmp .webp)")
        Log("    положите кадры в snapshots рядом с ботом либо укажите путь в")
        Log("    файле photos_folder.txt (одна строка — путь к папке)")
        Toast("Кадров не нашлось", "см. журнал", 5000)
        return
    }

    ; --- есть ли чем считать ---------------------------------------------
    ; скрипт проверки встроен в .ahk: если файла нет — создаём его сами
    script := A_ScriptDir "\photo_check_v810.py"
    if !FileExist(script) {
        try
            EnsurePhotoScript(script)
        catch as e {
            Log("[!] не смог создать photo_check.py: " e.Message)
            Toast("Не смог создать файл", e.Message, 6000)
            return
        }
        Log("[i] photo_check_v810.py создан рядом с ботом (встроенная копия)")
    }
    pyInfo := FindPython()
    if (pyInfo.exe = "") {
        Log("[!] Python не найден: ни python.exe, ни python3.exe, ни py.exe не видны.")
        Log("    Установите с python.org (галочка «Add python.exe to PATH»), затем")
        Log("    выполните в командной строке: python -m pip install opencv-python")
        Log("    Проверить, что видно: нажмите Win+R и введите  where python")
        Toast("Python не найден", "python.org + pip install opencv-python", 6000)
        return
    }
    if (pyInfo.cv = "") {
        Log("[!] Python есть («" pyInfo.exe "»), но OpenCV в нём нет. Выполните:")
        Log("    " pyInfo.cmd " -m pip install opencv-python")
        Toast("Нет OpenCV", "pip install opencv-python", 6000)
        return
    }
    Log("[i] проверяю кадры · «" pyInfo.exe "» · opencv " pyInfo.cv)

    csvOut := A_ScriptDir "\report.csv"
    txtOut := A_ScriptDir "\photo_check_out.txt"
    SafeDelete(txtOut)
    ; 5469 кадров — это больше часа. По умолчанию считаем 300 равномерно по
    ; папке; свой предел можно записать в photo_folder_limit.txt (0 = все).
    lim := 300
    limPath := A_ScriptDir "\photo_folder_limit.txt"
    if FileExist(limPath) {
        try {
            v := Trim(FileRead(limPath, "UTF-8"))
            if (v != "" && IsInteger(v) && Integer(v) > 0)
                lim := Integer(v)
        }
    }
    if (n > lim)
        Log("[i] кадров " n " — для сверки порогов считаю " lim
            . " (менять: photo_folder_limit.txt, 0 = все)")
    else
        lim := 0
    cmd := pyInfo.cmd " " q script q " " q folder q
        . " --csv " q csvOut q " --out " q txtOut q
        . (lim ? " --limit " lim : "")
    ; --- запуск В ФОНЕ: меню не должно замирать на минуты ---
    if PHOTO.active {
        Toast("Проверка уже идёт", "дождитесь итогов в журнале", 4000)
        Log("[i] проверка уже выполняется — жду")
        return
    }
    Log("[i] считаю " (lim ? Min(n, lim) : n) " кадров в фоне"
        . " (0.3–1 с на кадр; меню работает)…")
    Toast("Проверяю кадры", (lim ? Min(n, lim) : n)
        . " шт. — меню работает, итоги будут в журнале", 4000)
    pid := LaunchHidden(cmd, A_ScriptDir)
    if !pid {
        Log("[!] Python не запустился ни одним способом. Запустите вручную —")
        Log("    скопируйте строку ниже в Win+R (или в командную строку):")
        Log("    " cmd)
        Toast("Не смог запустить Python", "см. журнал: готовая строка запуска", 6000)
        ; сбросим кэш: возможно, путь к python устарел
        PHOTO.pyCmd := "", PHOTO.pyLabel := "", PHOTO.pyVer := ""
        return
    }
    PHOTO.pid := pid
    PHOTO.active := true
    PHOTO.out := txtOut
    PHOTO.csv := csvOut
    PHOTO.started := A_TickCount
    PHOTO.detached := false
    PHOTO.n := lim ? Min(n, lim) : n      ; сколько реально считаем, а не всего в папке
    PHOTO.folder := folder
    SetTimer(WatchPhotoDone, 700)
    UpdateStatus()
}

; Отчёт готов? Признак — слово ГОТОВО, оно пишется последним. Надёжнее, чем
; «процесс жив»: при запуске через «start» PID принадлежит оболочке, которая
; выходит сразу, и по ProcessExist(pid) итог можно потерять.
PhotoReady() {
    global PHOTO
    if (PHOTO.out = "" || !FileExist(PHOTO.out))
        return false
    try {
        if (FileGetSize(PHOTO.out) < 8)
            return false
        return InStr(FileRead(PHOTO.out, "UTF-8"), "ГОТОВО") ? true : false
    } catch {
        return false
    }
}

; Таймер фоновой проверки: раз в 0.7 с смотрит, жива ли проверка.
; ВАЖНО (run-14.log): AHK v2 не всегда возвращает PID запущенного процесса
; (при запуске через оболочку он равен 0). Поэтому «жива ли» определяется не
; только по PID, а по трём признакам: отчёт дописан, есть процесс python,
; либо ещё не истекло время ожидания.
WatchPhotoDone() {
    global PHOTO
    if !PHOTO.active
        return
    elapsed := A_TickCount - PHOTO.started

    ; 1) отчёт готов (последняя строка — ГОТОВО)
    if PhotoReady() {
        FinishPhoto(elapsed)
        return
    }

    ; 2) кто-нибудь из python жив? (в том числе если PID нам не сообщили)
    pyPid := PhotoPythonPid()
    if pyPid {
        if (PHOTO.pid <= 0) {
            PHOTO.pid := pyPid
            LogThrottledKey("[photoPid]", "[i] python найден по имени (PID " pyPid
                . ") — проверка идёт")
        }
        if (elapsed > 15000)
            LogThrottledKey("[photo]", "[i] проверка кадров идёт… " Round(elapsed / 1000)
                . " с · меню работает")
        if (elapsed > 45 * 60000) {
            try
                ProcessClose(pyPid)
            Log("[!] проверка идёт дольше 45 минут — остановил. Уменьшите папку"
                . " (photo_folder_limit.txt) или запустите photo_check.py вручную.")
            Toast("Проверка остановлена", "слишком долго — см. журнал", 6000)
            FinishPhoto(0)
        }
        return
    }

    ; 3) процесса нет и отчёта нет — ждём до 2 минут (файл мог ещё не появиться)
    if (elapsed > 20000)
        LogThrottledKey("[photoWait]", "[i] отчёта пока нет, python уже не виден —"
            . " жду до 2 минут: возможно, он ещё пишет файл")
    if (elapsed < 120000)
        return
    FinishPhoto(elapsed)
}

; PID любого живого python (или 0). Нужен, когда запуск не сообщил PID.
PhotoPythonPid() {
    global PHOTO
    if (PHOTO.pid > 0 && ProcessExist(PHOTO.pid))
        return PHOTO.pid
    for exeName in ["python.exe", "python3.exe", "py.exe"] {
        p := ProcessExist(exeName)
        if p
            return p
    }
    return 0
}

; Разбор результата фоновой проверки.
FinishPhoto(elapsed) {
    global PHOTO
    SetTimer(WatchPhotoDone, 0)
    txt := ""
    try txt := FileRead(PHOTO.out, "UTF-8")
    if (Trim(txt) = "") {
        q := Chr(34)
        Log("[!] проверка закончилась, но отчёта нет. Запустите вручную: python"
            . " photo_check.py " q PHOTO.folder q)
        Toast("Пустой отчёт", "см. журнал", 6000)
    } else {
        Log("[i] проверка готова за " Round(elapsed / 1000) " с · кадров " PHOTO.n)
        LogLines(txt, 14)
        ; ВЕРДИКТ — самое важное: что это за папка и что делать. Без него отчёт
        ; из 228 «НЕ РАСПОЗНАНО» выглядит как поломка бота (run-12.log).
        lines := StrSplit(txt, "`n")
        i := 1, inV := false, vLines := 0
        while (i <= lines.Length) {
            l := Trim(RTrim(lines[i], "`r"))
            if (l = "ВЕРДИКТ") {
                inV := true
                Log("  ВЕРДИКТ")
                i += 1
                continue
            }
            if inV {
                if (l = "" || l = "ГОТОВО" || vLines > 12)
                    inV := false
                else {
                    Log("  " l)
                    vLines += 1
                }
            }
            i += 1
        }
        Log("[i] полный список: " PHOTO.csv)
        Log("    и текстом: " PHOTO.out)
        Toast("Кадры проверены", "отчёт открыт, итоги — в журнале", 5000)
        ; открываем отчёт: иначе пользователь не узнает, что проверка «работает»
        try
            Run(PHOTO.out)
        catch {
            Log("[i] отчёт лежит здесь: " PHOTO.out)
        }
    }
    PHOTO.pid := 0
    PHOTO.active := false
    UpdateStatus()
}

; Удаление файла, если он есть. ВАЖНО: FileDelete() в AHK v2 бросает ошибку,
; когда удалять нечего (run-10.log: «(2) Не удается найти указанный файл»).
SafeDelete(path) {
    if (path = "")
        return false
    try {
        if FileExist(path)
            FileDelete(path)
        return true
    } catch {
        return false
    }
}

; Создаёт photo_check.py рядом с ботом из встроенной копии (PHOTO_PY).
; Нужен, чтобы «один файл» было правдой: раньше кнопка требовала этот файл
; отдельно (run-9.log: «нет файла photo_check.py рядом со скриптом»).
EnsurePhotoScript(path) {
    global PHOTO_PY
    SafeDelete(path)
    buf := ""
    for line in PHOTO_PY {
        buf .= line "`n"
        if (StrLen(buf) > 32000) {          ; пишем порциями
            FileAppend(buf, path, "UTF-8")
            buf := ""
        }
    }
    if (buf != "")
        FileAppend(buf, path, "UTF-8")
    if !FileExist(path)
        throw Error("файл не создался: " path)
    return true
}

; Где искать кадры без диалога. Порядок:
;   1) путь из photos_folder.txt рядом со скриптом (если файл есть);
;   2) snapshots рядом с ботом (вместе с вложенными train/valid/test);
;   3) папка самого бота;
;   4) папка «snapshots» на уровень выше.
AutoPhotoFolder() {
    listPath := A_ScriptDir "\photos_folder.txt"
    if FileExist(listPath) {
        try {
            p := Trim(FileRead(listPath, "UTF-8"))
            p := RTrim(p, "\/")
            if (p != "" && InStr(FileExist(p), "D")) {
                Log("[i] путь взят из photos_folder.txt: " p)
                return p
            }
            Log("[!] в photos_folder.txt путь не найден: " p)
        }
    }
    for cand in [A_ScriptDir "\snapshots", A_ScriptDir
               , A_ScriptDir "\..\snapshots"] {
        if (InStr(FileExist(cand), "D") && CountImages(cand) > 0) {
            Log("[i] кадры нашлись без вопросов: " cand)
            return cand
        }
    }
    return ""
}

; Сколько картинок в папке (рекурсивно). Быстро: только имена файлов.
CountImages(dir) {
    cnt := 0
    for ext in ["jpg", "jpeg", "png", "bmp", "webp"] {
        Loop Files, dir "\*." ext, "R" {
            cnt += 1
            if (cnt >= 20000)
                return cnt
        }
    }
    return cnt
}


; Полный путь к программе через `where`. Голое имя («python») AHK сам не находит
; и отдаёт оболочке как документ — Run возвращает 0 и ничего не запускается
; (run-12.log: «[!] Python не запустился»).
WhereExe(name) {
    q := Chr(34)
    out := A_Temp "\forma_where.txt"
    SafeDelete(out)
    try
        RunWait(A_ComSpec " /c where " name " > " q out q " 2>nul", , "Hide")
    catch {
        return ""
    }
    txt := ""
    try txt := FileRead(out, "UTF-8")
    for line in StrSplit(txt, "`n") {
        line := Trim(RTrim(line, "`r"))
        if (line != "" && FileExist(line))
            return line
    }
    return ""
}

; Ищет рабочий Python и возвращает {exe, cmd, cv}:
;   exe — короткое имя для журнала («python 3.12»),
;   cmd — ГОТОВАЯ строка запуска с ПОЛНЫМ путём в кавычках.
; Никаких .bat и перенаправлений вывода: python сам пишет файл, поэтому
; кириллица в путях и кодировка консоли нас не касаются.
FindPython() {
    global PHOTO
    q := Chr(34)
    ; второй клик не должен снова искать: путь и версия уже известны
    if (PHOTO.pyCmd != "" && PHOTO.pyVer != "")
        return {exe: PHOTO.pyLabel, cmd: PHOTO.pyCmd, cv: PHOTO.pyVer}

    res := {exe: "", cmd: "", cv: ""}
    pyCode := "import cv2,sys;open(sys.argv[1],'w',encoding='utf-8').write(cv2.__version__)"
    verCode := "import sys;open(sys.argv[1],'w').write(sys.version.split()[0])"

    ; кандидаты: сначала полные пути, которые нашёл `where`, затем py.exe
    cands := []
    for name in ["python.exe", "python3.exe"] {
        p := WhereExe(name)
        if (p != "")
            cands.Push({label: name " · " SubStr(p, Max(1, StrLen(p) - 24))
                , cmd: q p q})
    }
    pyp := WhereExe("py.exe")
    if (pyp != "")
        cands.Push({label: "py -3 · " SubStr(pyp, Max(1, StrLen(pyp) - 24))
            , cmd: q pyp q " -3"})

    out := A_Temp "\forma_py.txt"
    for c in cands {
        SafeDelete(out)
        try
            RunWait(c.cmd " -c " q pyCode q " " q out q, , "Hide")
        ver := ""
        try ver := Trim(FileRead(out, "UTF-8"))
        if RegExMatch(ver, "^[0-9]+\.[0-9]+") {
            res.exe := c.label, res.cmd := c.cmd, res.cv := ver
            PHOTO.pyCmd := res.cmd, PHOTO.pyLabel := res.exe, PHOTO.pyVer := ver
            return res
        }
        ; python запустился, но cv2 нет — запомним и продолжим поиск
        SafeDelete(out)
        try
            RunWait(c.cmd " -c " q verCode q " " q out q, , "Hide")
        v2 := ""
        try v2 := Trim(FileRead(out, "UTF-8"))
        if (v2 != "" && res.exe = "")
            res := {exe: c.label, cmd: c.cmd, cv: ""}
    }
    return res
}

; Запуск программы в фоне так, чтобы это РАБОТАЛО и был PID для наблюдения.
; run-12.log: обычный Run со строкой, начинающейся с «"python"», вернул 0 и
; ничего не запустил. Поэтому несколько способов подряд, и каждый пишется
; в журнал — видно, какой сработал.
LaunchHidden(cmd, workDir := "") {
    q := Chr(34)
    if (workDir = "")
        workDir := A_ScriptDir
    ways := []
    ways.Push({name: "Run", cmd: cmd})
    ways.Push({name: "cmd /c", cmd: A_ComSpec " /c " cmd})
    ways.Push({name: "cmd /c start /B /MIN",
        cmd: A_ComSpec " /c start " q q " /B /MIN " cmd})
    for w in ways {
        pid := 0
        try
            pid := Run(w.cmd, workDir, "Hide")
        catch as e {
            Log("[!] запуск через " w.name " не удался: " e.Message)
            pid := 0
            continue
        }
        ; ВАЖНО (run-14.log): AHK v2 НЕ ВСЕГДА возвращает PID — при запуске через
        ; оболочку/ShellExecute он равен 0, хотя программа прекрасно стартует.
        ; Раньше «pid = 0» считалось отказом, бот пробовал следующий способ и в
        ; итоге писал «Python не запустился», хотя команда была рабочей.
        ; Теперь отказ — это только исключение; при PID = 0 запуск считаем
        ; принятым и следим за отчётом и за процессом python.
        if pid
            Log("[i] запуск принят (" w.name ", PID " pid ")")
        else
            Log("[i] запуск принят (" w.name ", PID не сообщён — слежу за отчётом)")
        return pid ? pid : -1
    }
    return 0
}

; Печатает в журнал последние N непустых строк текста (отчёт целиком — в файле).
LogLines(txt, n) {
    lines := []
    for line in StrSplit(txt, "`n") {
        line := RTrim(line, "`r")
        if (Trim(line) = "")
            continue
        lines.Push(line)
        if (lines.Length > 400)
            lines.RemoveAt(1)
    }
    start := Max(1, lines.Length - n + 1)
    if (start > 1)
        Log("    … (список кадров с начала — в report.csv)")
    i := start
    while (i <= lines.Length) {
        Log("    " lines[i])
        i += 1
    }
}

; ============================================================================
;     ПОРОГИ ПО ВАШИМ СКРИНШОТАМ — БЕЗ PYTHON И БЕЗ УСТАНОВКИ ЧЕГО-ЛИБО (v7.2)
; ============================================================================
; Вопрос был: «как применить скриншоты, которые я скачивал, если без установки
; чего-либо — только обычный AutoHotkey».
; Ответ: AutoHotkey умеет читать картинки через WIA (Windows Image Acquisition,
; он уже есть в системе, ставить нечего). Мы открываем ваши кадры, переводим их
; во временный BMP, считаем по пикселям статистику и подбираем пороги — те самые
; числа, которые раньше приходилось угадывать.
;
; Если рядом с картинками лежит разметка Roboflow (YOLO: .txt с числами
; «класс cx cy w h»), мы её тоже читаем: тогда пороги берутся ИЗ БОКСОВ
; разметки, то есть точно, а не «в среднем по кадру».
; ----------------------------------------------------------------------------
OnLearnThresholds(*) {
    ; Кнопка «🎓 Пороги».
    ;   обычный клик  — сам находит скачанный датасет и учится по нему;
    ;   Ctrl+клик     — дать выбрать папку вручную.
    global CFG, ST
    if ST.learnBusy {
        Flash("Подбор порогов уже идёт — подождите", 2500)
        return
    }
    if GetKeyState("Ctrl", "P") {
        startDir := CFG.learnFolder != "" ? CFG.learnFolder : A_ScriptDir
        ; Options = 0 — как в остальных местах бота: выбирается папка
    dir := DirSelect(startDir, 0, "Выберите папку со скриншотами или корень датасета")
        if (dir = "") {
            Log("[learn] отменено: папка не выбрана")
            return
        }
        CFG.learnFolder := dir
        SaveSettings()
        LearnStart(dir, 0, false)
        return
    }
    root := FindDatasetRoot()
    if (root = "") {
        Log("[learn] папку с кадрами не нашёл автоматически. Где искал:")
        for c in DatasetCandidates()
            Log("   · " c (DirExist(c) ? "  (есть)" : "  (нет)"))
        Log("  Нажмите Ctrl+клик по «🎓 Пороги» и укажите папку вручную,")
        Log("  либо положите датасет рядом: snapshots\train\images и snapshots\train\labels")
        Flash("Кадров не нашёл — Ctrl+клик по кнопке, выберите папку", 6000)
        return
    }
    CFG.learnFolder := root
    SaveSettings()
    LearnStart(root, 0, false)
}

; Где ищем датасет (ваш случай: ...\fort afk\snapshots\train\images)
DatasetCandidates() {
    global CFG
    out := []
    if (CFG.learnFolder != "")
        out.Push(CFG.learnFolder)
    out.Push(A_ScriptDir "\snapshots")
    out.Push(A_ScriptDir)
    SplitPath(A_ScriptDir, , &parent)
    if (parent != "")
        out.Push(parent "\snapshots")
    return out
}

IsDatasetDir(dir) {
    ; Roboflow-раскладка: train\images + train\labels (или valid/test),
    ; либо просто папка с картинками рядом с папкой labels.
    if !DirExist(dir)
        return false
    for part in ["train", "valid", "test"] {
        if (DirExist(dir "\" part "\images") || DirExist(dir "\" part "\labels"))
            return true
    }
    if (DirExist(dir "\images") && DirExist(dir "\labels"))
        return true
    ; своя папка со снимками бота: в ней ЛЕЖАТ картинки
    Loop Files, dir "\*.bmp"
        return true
    Loop Files, dir "\*.jpg"
        return true
    return false
}

FindDatasetRoot() {
    for c in DatasetCandidates() {
        if IsDatasetDir(c)
            return c
    }
    return ""
}

; Отпечаток набора: сколько картинок и разметок + самый свежий файл.
; Нужен, чтобы «сам обучился» не повторялся при каждом запуске зря.
DatasetSignature(dir) {
    nImg := 0, nLab := 0
    for ext in ["jpg", "jpeg", "png", "bmp"] {
        Loop Files, dir "\*." ext, "R"
            nImg += 1
    }
    Loop Files, dir "\*.txt", "R"
        nLab += 1
    return dir "|" nImg "|" nLab
}

; ---- запуск лёгкого (не блокирующего меню) подбора -------------------------
LearnStart(dir, limit, auto) {
    global CFG, ST
    if ST.learnBusy
        return false
    lim := (limit > 0) ? limit : CFG.learnLimit
    files := CollectImages(dir, lim)
    if (files.Length = 0) {
        Log("[learn] в «" dir "» нет картинок (jpg/png/bmp) — учиться не на чем")
        if !auto
            Flash("В этой папке нет картинок", 4000)
        return false
    }
    ST.learn := {dir: dir, files: files, i: 0, skin: [], widths: [], heights: []
               , boxes: 0, labeled: 0, read: 0, auto: auto
               , started: A_TickCount, wholeFrame: 0}
    ST.learnBusy := true
    Log("── подбор порогов по вашим кадрам ─────────────")
    Log("  папка: " dir (auto ? "  (нашёл сам)" : ""))
    Log("  картинок взято: " files.Length " · разметка YOLO читается, если есть")
    Log("  читаю системой (WIA) — Python, opencv и модели не нужны")
    SetTimer(LearnChunk, 40)
    if !auto
        Flash("Считаю пороги по кадрам…`nМеню работает, это не зависание.", 5000)
    return true
}

; Обрабатываем по несколько картинок за тик: меню остаётся живым.
LearnChunk() {
    global ST
    job := ST.learn
    if !IsObject(job) {
        SetTimer(LearnChunk, 0)
        ST.learnBusy := false
        return
    }
    ; run-21.log: во время обучения тик стоял 15 с и скрипт перезапускался.
    ; Причина — один кусок обучения забирал поток надолго (WIA + чтение
    ; картинки). Теперь кусок ограничен и по числу картинок, и ПО ВРЕМЕНИ.
    t0 := A_TickCount
    done := 0
    while (job.i < job.files.Length && done < 5 && (A_TickCount - t0) < 80) {
        job.i += 1
        done += 1
        path := job.files[job.i]
        img := LoadImagePixels(path)
        if !img
            continue
        job.read += 1
        lab := FindLabelFile(path)
        if (lab != "") {
            job.labeled += 1
            ; v7.7: полосок HP над врагом в игре НЕТ. Поэтому по размеченным
            ; боксам (классы 0 — голова, 1 — тело) меряем РАЗМЕР ФИГУРЫ и долю
            ; «кожи» внутри бокса — это и есть пороги детектора врага.
            for b in ReadYoloBoxes(lab) {
                job.boxes += 1
                bwPx := Round(b.w * img.w), bhPx := Round(b.h * img.h)
                if (bwPx < 4 || bhPx < 4)
                    continue
                pct := SkinPctInBox(img, b)
                if (pct < 0)
                    continue
                job.skin.Push(pct)
                k := 1280 / Max(1, img.w)
                job.widths.Push(Round(bwPx * k))
                job.heights.Push(Round(bhPx * k))
            }
        } else {
            ; без разметки: ищем фигуру сами по всему кадру
            job.wholeFrame += 1
            f := SkinFigureInImage(img)
            if f {
                job.skin.Push(f.skin)
                job.widths.Push(Round(f.w * 1280 / Max(1, img.w)))
                job.heights.Push(Round(f.h * 1280 / Max(1, img.w)))
            }
        }
        if (Mod(job.i, 50) = 0)
            Log("[learn] … " job.i " из " job.files.Length " · фигур " job.skin.Length)
    }
    if (job.i >= job.files.Length)
        LearnFinish()
}

LearnFinish() {
    global CFG, ST
    job := ST.learn
    SetTimer(LearnChunk, 0)
    ST.learnBusy := false
    if !IsObject(job)
        return
    Log("[learn] прочитано картинок: " job.read " · с разметкой YOLO: " job.labeled
        . " · без разметки: " job.wholeFrame)
    if (job.labeled)
        Log("[learn] боксов в разметке: " job.boxes)
    ; ВАЖНО (v7.7): полосок здоровья над противником в Fortnite НЕТ, поэтому
    ; обучение больше не ищет «красную полоску». Оно меряет то, что в игре
    ; действительно есть: РАЗМЕР ФИГУРЫ игрока и долю кожи в ней.
    if (job.skin.Length < 10) {
        Log("[learn] фигур врага в кадрах почти нет (найдено " job.skin.Length
            . "). Пороги не меняю — они и не нужны: детектор уже настроен на")
        Log("  то, как игра выглядит сейчас (полосы HP над врагом в Fortnite нет).")
        Log("  Зато бот теперь САМ собирает свои кадры с разметкой — папка")
        Log("  snapshots\auto. Через несколько матчей тут будет по чему учиться.")
        if !job.auto
            Flash("Фигур врага в кадрах мало — пороги не меняю", 6000)
        return
    }
    SortNums(job.skin)
    SortNums(job.widths)
    SortNums(job.heights)
    ps := Percentiles(job.skin), pw := Percentiles(job.widths), ph := Percentiles(job.heights)
    oldSkin := CFG.enemySkinMinPct, oldW := CFG.enemyMinBoxW, oldH := CFG.enemyMinBoxH

    CFG.enemySkinMinPct := Clamp(Round(ps.p15 * 0.7), 3, 25)
    CFG.enemyMinBoxW := Clamp(Round(pw.p15 * 0.8), 10, 40)
    CFG.enemyMaxBoxW := Clamp(Round(pw.p90 * 1.5), 120, 400)
    CFG.enemyMinBoxH := Clamp(Round(ph.p15 * 0.8), 20, 60)
    CFG.enemyMaxBoxH := Clamp(Round(ph.p90 * 1.5), 200, 600)

    Log("[learn] фигур в статистике: " job.skin.Length)
    Log("  кожа в боксе: 15% = " ps.p15 "% · 50% = " ps.p50 "% · 90% = " ps.p90 "%")
    Log("  ширина: 15% = " pw.p15 " · 50% = " pw.p50 " · 90% = " pw.p90 " px (на 1280)")
    Log("  высота: 15% = " ph.p15 " · 50% = " ph.p50 " · 90% = " ph.p90 " px")
    Log("  было:  кожа от " oldSkin "% · ширина от " oldW " px · высота от " oldH " px")
    Log("  стало: кожа от " CFG.enemySkinMinPct "% · ширина "
        . CFG.enemyMinBoxW ".." CFG.enemyMaxBoxW " px · высота "
        . CFG.enemyMinBoxH ".." CFG.enemyMaxBoxH " px")
    CFG.learnSig := DatasetSignature(job.dir)
    SaveSettings()
    Log("[learn] готово за " Round((A_TickCount - job.started) / 1000) " с · сохранено в forma.ini")
    Flash("Пороги подобраны по " job.skin.Length " фигурам."
        . "`nКожа от " CFG.enemySkinMinPct "%, ширина "
        . CFG.enemyMinBoxW ".." CFG.enemyMaxBoxW " px.`nСохранено в forma.ini", 6000)
}

; --- сколько «кожи» внутри бокса разметки (в процентах, -1 = мерить нечего) ---
SkinPctInBox(img, b) {
    x1 := Round((b.cx - b.w / 2) * img.w), y1 := Round((b.cy - b.h / 2) * img.h)
    x2 := Round((b.cx + b.w / 2) * img.w), y2 := Round((b.cy + b.h / 2) * img.h)
    return SkinPctRect(img, x1, y1, x2, y2)
}

SkinPctRect(img, x1, y1, x2, y2) {
    x1 := Max(0, x1), y1 := Max(0, y1)
    x2 := Min(img.w - 1, x2), y2 := Min(img.h - 1, y2)
    if (x2 - x1 < 4 || y2 - y1 < 4)
        return -1
    skin := 0, all := 0
    y := y1
    while (y <= y2) {
        TickCheck("обучение: кожа в боксе")
        x := x1
        while (x <= x2) {
            px := NumGet(img.buf, y * img.stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 120 && rr > g + 16 && g >= b + 6 && (rr - b) >= 26
                && !(rr >= 232 && g >= 232 && b >= 225))
                skin += 1
            all += 1
            x += 3
        }
        y += 3
    }
    return all ? Round(skin / all * 100) : -1
}

; --- самая крупная фигура на картинке (для кадров без разметки) ------------
SkinFigureInImage(img) {
    ; Работаем по той же логике, что и в игре, только по всей картинке и
    ; крупным шагом: нам нужен просто типичный размер фигуры и доля кожи.
    global CFG
    step := 4
    cw := img.w // 24 + 2, ch := img.h // 24 + 2
    n := cw * ch
    cnt := [], tot := []
    i := 1
    while (i <= n) {
        cnt.Push(0), tot.Push(0)
        i += 1
    }
    y := 0
    while (y < img.h) {
        TickCheck("обучение: поиск фигуры")
        x := 0
        while (x < img.w) {
            px := NumGet(img.buf, y * img.stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            k := (y // 24) * cw + (x // 24) + 1
            tot[k] += 1
            if (rr >= 120 && rr > g + 16 && g >= b + 6 && (rr - b) >= 26
                && !(rr >= 232 && g >= 232 && b >= 225))
                cnt[k] += 1
            x += step
        }
        y += step
    }
    best := 0, bk := 0
    k := 1
    while (k <= n) {
        if (cnt[k] > best)
            best := cnt[k], bk := k
        k += 1
    }
    if (best < 4)
        return 0
    ; бокс — столбец и строка лучшей ячейки, растянутые по порогу
    thr := Max(2, best // 3)
    col := Mod(bk - 1, cw) + 1, row := (bk - 1) // cw + 1
    c0 := col, c1 := col, r0 := row, r1 := row
    while (c0 > 1 && cnt[(row - 1) * cw + c0 - 1] >= thr)
        c0 -= 1
    while (c1 < cw && cnt[(row - 1) * cw + c1 + 1] >= thr)
        c1 += 1
    while (r0 > 1 && cnt[(r0 - 2) * cw + col] >= thr)
        r0 -= 1
    while (r1 < ch && cnt[r1 * cw + col] >= thr)
        r1 += 1
    x1 := (c0 - 1) * 24, x2 := c1 * 24, y1 := (r0 - 1) * 24, y2 := r1 * 24
    pct := SkinPctRect(img, x1, y1, x2, y2)
    if (pct <= 0)
        return 0
    return {x: x1, y: y1, w: x2 - x1, h: y2 - y1, skin: pct}
}

; Автозапуск: «чтобы он сам обучился на уже скачанных скринах».
; Один раз на набор: при следующем запуске с тем же числом файлов не повторяем.
; Идёт по частям (по 5 картинок за тик) — меню не подвисает.
; ============================================================================
;   СВОЙ ДАТАСЕТ: БОТ САМ СНИМАЕТ КАДРЫ И САМ РАЗМЕЧАЕТ ИХ (v7.6)
; ============================================================================
; Просьба из run-21: «пусть сам делает скриншоты игры в папку и сам выставляет
; хитбоксы — голова/тело противника, сундуки». Работает так:
;   * раз в CFG.autoSnapMs игрового тика бот кладёт кадр в snapshots\auto;
;   * рядом пишет .txt с разметкой в формате YOLO (класс + центр + размер
;     рамки в долях кадра). Формат читают YOLO-инструменты, но автометки не
;     проверены, могут быть неполными и не гарантируют пригодность к обучению;
;   * классы: 0 — оценка головы, 1 — рамка кандидата, 2 — кандидат сундука;
;     прежний класс 3 зарезервирован и больше не создаётся: HP над врагом нет.
;     Авторазметка — гипотезы, не проверенная разметка для обучения.
;   * кадр уменьшается до 960 px по ширине — иначе 300 кадров 1280x720 заняли
;     бы гигабайты; на разметку это не влияет (она в долях кадра);
;   * папка snapshots уже в списке DatasetCandidates, поэтому подбор порогов
;     подхватит эти кадры сам, ничего настраивать не нужно.
AutoSnapDir() {
    ; Отдельная папка на запуск: старые 300 кадров не блокируют новые и не
    ; удаляются. Каждая папка ограничена CFG.autoSnapMax; общий объём растёт.
    static session := FormatTime(A_Now, "yyyyMMdd_HHmmss") "_" DllCall("GetCurrentProcessId", "UInt")
    return A_ScriptDir "\snapshots\auto\session_" session
}

; Сколько кадров уже лежит в папке (при первом обращении считаем по диску,
; потом держим счётчик — перебирать 300 файлов каждый тик ни к чему).
AutoSnapCount(dir) {
    global ST
    if ST.autoSnapN >= 0
        return ST.autoSnapN
    n := 0
    Loop Files, dir "\*.bmp"
        n += 1
    ST.autoSnapN := n
    return n
}

; Сохраняем только пока исходный игровой тик и его сессия актуальны.
AutoSnapAllowed(epoch, gen, tickGen) {
    global ST
    return ST.running && !ST.paused && !ST.mouseCalActive && !ST.cancelHold
        && !ST.tickAbort && !ST.tickAborted && ST.inputEpoch = epoch
        && ST.startGeneration = gen && ST.tickGen = tickGen
}

; Главный вызов из тика. Возвращает true, если кадр сохранён.
AutoSnap(shot) {
    global CFG, ST
    if (!CFG.autoSnap || !IsObject(shot) || CFG.dryRun)
        return false
    prev := Critical("On")
    epoch := ST.inputEpoch, gen := ST.startGeneration, tickGen := ST.tickGen
    allowed := AutoSnapAllowed(epoch, gen, tickGen) && shot.HasOwnProp("capturedAt")
        && shot.capturedAt >= ST.startedAt && shot.capturedAt <= A_TickCount
    Critical(prev)
    if !allowed
        return false
    now := A_TickCount
    ; Снимки не отменяем: в активном бою делаем их реже, чтобы меньше
    ; времени тратить на запись BMP и разметку в игровом цикле.
    snapInterval := CFG.autoSnapMs
    if (ST.enemy && ST.combatAt && (now - ST.combatAt < 1500))
        snapInterval := Max(snapInterval, 6000)
    if (ST.autoSnapAt && (now - ST.autoSnapAt) < snapInterval)
        return false
    dir := AutoSnapDir()
    have := AutoSnapCount(dir)
    if (have >= CFG.autoSnapMax) {
        LogThrottledKey("[autosnapfull]", "[i] свой датасет: " have
            . " кадров уже есть — больше не снимаю (это предел "
            . CFG.autoSnapMax "). Кадры лежат в " dir, 60000)
        return false
    }
    try DirCreate(dir)
    ; Не трогаем файл при неожиданном совпадении имени.
    name := FormatTime(A_Now, "yyyyMMdd_HHmmss") "_" Format("{:05}", have + 1)
    bmp := dir "\" name ".bmp", txt := dir "\" name ".txt", txtPart := txt ".part"
    firstSave := (have = 0)
    if (FileExist(bmp) || FileExist(txt) || FileExist(txtPart)) {
        LogThrottledKey("[autosnaperr]", "[!] свой датасет: имя уже занято, не перезаписываю: " name)
        return false
    }
    ; Зафиксировать гипотезы перед записью этого буфера, а не из будущего тика.
    lines := CFG.autoLabel ? AutoLabelLines(shot) : []
    prev := Critical("On")
    allowed := AutoSnapAllowed(epoch, gen, tickGen)
    if allowed
        ST.autoSnapAt := now
    Critical(prev)
    if !allowed
        return false
    ; При отмене или ошибке удаляем только файл, который начали создавать сами.
    ; Повтор ограничен обычным интервалом, а не сразу на каждом игровом тике.
    okBmp := false
    try
        okBmp := SaveShotBmp(shot, bmp)
    catch as err {
        try FileDelete(bmp)
        if (ST.tickAbort || ST.tickAborted)
            throw err
        LogThrottledKey("[autosnaperr]", "[!] свой датасет: ошибка записи: " err.Message)
        return false
    }
    if !okBmp {
        try FileDelete(bmp)
        LogThrottledKey("[autosnaperr]", "[!] свой датасет: не смог записать кадр в " bmp)
        return false
    }
    if !AutoSnapAllowed(epoch, gen, tickGen) {
        try FileDelete(bmp)
        return false
    }
    labelWritten := false
    if lines.Length {
        text := ""
        for ln in lines
            text .= ln "`n"
        try {
            ; Публикуем текст одним переименованием; существующий txt не трогаем.
            FileAppend(text, txtPart, "UTF-8-RAW")
            if !AutoSnapAllowed(epoch, gen, tickGen) {
                try FileDelete(txtPart)
                try FileDelete(bmp)
                return false
            }
            FileMove(txtPart, txt, 0)
            labelWritten := true
        } catch as err {
            try FileDelete(txtPart)
            ; Сторонний txt под этим именем нельзя связывать с нашим BMP.
            if FileExist(txt) {
                try FileDelete(bmp)
                LogThrottledKey("[autosnaperr]", "[!] свой датасет: имя разметки занято, кадр не сохраняю.")
                return false
            }
            LogThrottledKey("[autosnaperr]", "[!] свой датасет: кадр без разметки: " err.Message)
        }
    }
    ; Решение о фиксации счётчиков атомарно с проверкой Stop/Pause.
    prev := Critical("On")
    allowed := AutoSnapAllowed(epoch, gen, tickGen)
    if allowed {
        ST.autoSnapN := have + 1
        if labelWritten
            ST.autoLabelN += 1
    }
    Critical(prev)
    if !allowed {
        if labelWritten
            try FileDelete(txt)
        try FileDelete(bmp)
        return false
    }
    ; classes.txt — чтобы любой тренер знал, что означают номера
    cls := dir "\classes.txt"
    if !FileExist(cls)
        FileAppend("enemy_head`nenemy_body`nchest`nenemy_hp_bar`n", cls, "UTF-8-RAW")
    if firstSave
        Log("[i] свой датасет: сам снимаю кадры в " dir " и сам пишу разметку"
            . " (голова/тело врага, сундук). До " CFG.autoSnapMax " кадров.")
    else if Mod(ST.autoSnapN, 25) = 0
        Log("[i] свой датасет: " ST.autoSnapN " кадров · с разметкой "
            . ST.autoLabelN)
    return true
}

; --- разметка кадра: рамки в формате YOLO ---------------------------------
AutoLabelLines(shot) {
    global ST
    out := []
    ; Захватываем связанные объекты и ID одним коротким атомарным чтением.
    ; ST.enemy/ST.chest — рабочие поля, они могут отставать от кэша. Нельзя
    ; присваивать старой рамке новый ID другого объекта из свежего кэша.
    prev := Critical("On")
    try {
        e := 0, c := 0
        if (IsObject(ST.enemy) && ST.enemySeenSeq = shot.captureId && ST.enemy = ST.enemyCache)
            e := {x:ST.enemy.x, y:ST.enemy.y, w:ST.enemy.w, h:ST.enemy.h, cx:ST.enemy.cx}
        if (IsObject(ST.chest) && ST.chestCacheSeq = shot.captureId && ST.chest = ST.chestCache) {
            currentChest := ST.chest
            cx1 := currentChest.HasProp("x") ? currentChest.x : (currentChest.cx - currentChest.w / 2)
            cy1 := currentChest.HasProp("y") ? currentChest.y : (currentChest.cy - currentChest.h / 2)
            c := {x:cx1, y:cy1, w:currentChest.w, h:currentChest.h}
        }
    } finally
        Critical(prev)
    ; Это непроверенные гипотезы, голова — лишь оценка части рамки.
    if IsObject(e) {
        ln := YoloLine(1, shot, e.x, e.y, e.w, e.h)
        if (ln != "")
            out.Push(ln)
        headW := Max(4, Round(e.w * 0.45))
        headH := Max(4, Round(e.h * 0.25))
        headX := e.cx - headW / 2
        headY := e.y
        ln := YoloLine(0, shot, headX, headY, headW, headH)
        if (ln != "")
            out.Push(ln)
    }
    ; Сундук — только тот же объект, что и проверенный кэш этого кадра.
    if IsObject(c) {
        ln := YoloLine(2, shot, c.x, c.y, c.w, c.h)
        if (ln != "")
            out.Push(ln)
    }
    return out
}

; одна строка YOLO: класс, центр и размеры — в долях кадра
YoloLine(cls, shot, x, y, w, h) {
    x1 := Clamp(x, 0, shot.w), y1 := Clamp(y, 0, shot.h)
    x2 := Clamp(x + w, 0, shot.w), y2 := Clamp(y + h, 0, shot.h)
    if ((x2 - x1) < 4 || (y2 - y1) < 4)
        return ""
    return cls " " Format("{:.6f} {:.6f} {:.6f} {:.6f}"
        , (x1 + x2) / 2 / shot.w, (y1 + y2) / 2 / shot.h
        , (x2 - x1) / shot.w, (y2 - y1) / shot.h)
}

; --- кадр -> BMP. GDI уменьшает кадр в памяти, без цикла AHK по пикселям.
; Отрицательная высота BMP хранит строки сверху вниз, как и буфер захвата.
SaveShotBmp(shot, path) {
    if (!IsObject(shot) || shot.w < 1 || shot.h < 1 || shot.stride != shot.w * 4
        || shot.buf.Size < shot.stride * shot.h)
        return false
    step := Max(1, Ceil(shot.w / 960))
    ow := shot.w // step, oh := shot.h // step
    if (ow < 32 || oh < 32)
        return false
    TickCheck("подготовка кадра датасета")
    src := Buffer(40, 0)
    NumPut("UInt", 40, src, 0), NumPut("Int", shot.w, src, 4), NumPut("Int", -shot.h, src, 8)
    NumPut("UShort", 1, src, 12), NumPut("UShort", 32, src, 14)
    dst := Buffer(40, 0)
    NumPut("UInt", 40, dst, 0), NumPut("Int", ow, dst, 4), NumPut("Int", -oh, dst, 8)
    NumPut("UShort", 1, dst, 12), NumPut("UShort", 32, dst, 14)
    dc := 0, bitmap := 0, oldBitmap := 0, bits := 0, fh := 0
    try {
        dc := DllCall("gdi32\CreateCompatibleDC", "Ptr", 0, "Ptr")
        if !dc
            return false
        bitmap := DllCall("gdi32\CreateDIBSection", "Ptr", dc, "Ptr", dst
            , "UInt", 0, "Ptr*", &bits, "Ptr", 0, "UInt", 0, "Ptr")
        if (!bitmap || !bits)
            return false
        oldBitmap := DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", bitmap, "Ptr")
        if (!oldBitmap || oldBitmap = -1)
            return false
        DllCall("gdi32\SetStretchBltMode", "Ptr", dc, "Int", 3)
        copied := DllCall("gdi32\StretchDIBits", "Ptr", dc
            , "Int", 0, "Int", 0, "Int", ow, "Int", oh
            , "Int", 0, "Int", 0, "Int", shot.w, "Int", shot.h
            , "Ptr", shot.buf, "Ptr", src, "UInt", 0, "UInt", 0x00CC0020, "Int")
        if (copied = 0 || copied = -1)
            return false
        ; Синхронизируем GDI перед доступом к пикселям DIB.
        DllCall("gdi32\GdiFlush")
        TickCheck("сохранение кадра датасета")
        hdr := Buffer(54, 0), dataBytes := ow * oh * 4
        NumPut("UShort", 0x4D42, hdr, 0), NumPut("UInt", 54 + dataBytes, hdr, 2)
        NumPut("UInt", 54, hdr, 10), NumPut("UInt", 40, hdr, 14)
        NumPut("Int", ow, hdr, 18), NumPut("Int", -oh, hdr, 22)
        NumPut("UShort", 1, hdr, 26), NumPut("UShort", 32, hdr, 28)
        NumPut("UInt", dataBytes, hdr, 34)
        fh := FileOpen(path, "w", "CP0")
        if !fh
            return false
        if (fh.RawWrite(hdr, 54) != 54 || fh.RawWrite(bits, dataBytes) != dataBytes)
            return false
        fh.Close(), fh := 0
        TickCheck("записан кадр датасета")
        return true
    } finally {
        if fh
            try fh.Close()
        if (dc && oldBitmap && oldBitmap != -1)
            DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", oldBitmap, "Ptr")
        if bitmap
            DllCall("gdi32\DeleteObject", "Ptr", bitmap)
        if dc
            DllCall("gdi32\DeleteDC", "Ptr", dc)
    }
}

AutoLearnOnStart() {
    global CFG, ST
    if (!CFG.learnAuto || ST.learnBusy)
        return
    root := FindDatasetRoot()
    if (root = "") {
        LogThrottledKey("[learnnone]", "[i] пороги: папку с кадрами не нашёл — учусь на том, что есть")
        return
    }
    sig := DatasetSignature(root)
    if (sig = CFG.learnSig) {
        Log("[i] пороги: набор кадров не изменился — обучение не нужно")
        return
    }
    Log("[i] пороги: нашёл набор кадров, считаю по нему сам: " root)
    LearnStart(root, 0, true)
}
; --- список картинок в папке (рекурсивно, с датасетной раскладкой) ----------
CollectImages(dir, limit) {
    out := []
    for ext in ["jpg", "jpeg", "png", "bmp"] {
        Loop Files, dir "\*." ext, "R" {
            out.Push(A_LoopFileFullPath)
            if (out.Length >= limit)
                return out
        }
    }
    return out
}

; --- файл разметки: рядом или в соседней папке labels ----------------------
FindLabelFile(imgPath) {
    SplitPath(imgPath, , &dir, , &nameNoExt)
    cand := [dir "\" nameNoExt ".txt"]
    ; Roboflow: ...\train\images\x.jpg  ->  ...\train\labels\x.txt
    split := StrSplit(dir, "\")
    if (split.Length >= 2 && split[split.Length] = "images") {
        parent := ""
        i := 1
        while (i < split.Length) {
            parent .= (i > 1 ? "\" : "") split[i]
            i += 1
        }
        cand.Push(parent "\labels\" nameNoExt ".txt")
    }
    for c in cand {
        if FileExist(c)
            return c
    }
    return ""
}

; --- картинка -> пиксели: WIA конвертирует во временный BMP, читаем сами -----
LoadImagePixels(path) {
    static BmpFmt := "{B96B3CAB-0728-11D3-9D7B-0000F81EF32E}"
    tmp := A_Temp "\forma_learn_" A_TickCount ".bmp"
    try {
        img := ComObject("WIA.ImageFile")
        img.LoadFile(path)
        ip := ComObject("WIA.ImageProcess")
        ip.Filters.Add(ip.FilterInfos("Convert").FilterID)
        ip.Filters[1].Properties["FormatID"].Value := BmpFmt
        res := ip.Apply(img)
        SafeDelete(tmp)
        res.SaveFile(tmp)
    } catch as e {
        LogThrottledKey("[wiaerr]", "[!] не смог прочитать картинку (" e.Message ")."
            . " Проверьте, что она не битая.")
        return 0
    }
    px := ReadBmpFile(tmp)
    try FileDelete(tmp)
    return px
}

ReadBmpFile(path) {
    ; Читаем BMP целиком в память. Поддерживаем 24 и 32 бита (так WIA и сохраняет).
    try
        f := FileOpen(path, "r")
    catch
        return 0
    size := f.Length
    if (size < 60) {
        f.Close()
        return 0
    }
    buf := Buffer(size, 0)
    f.RawRead(buf, size)
    f.Close()
    if (NumGet(buf, 0, "UChar") != 0x42 || NumGet(buf, 1, "UChar") != 0x4D)
        return 0
    off := NumGet(buf, 10, "UInt")
    w := NumGet(buf, 18, "Int")
    hRaw := NumGet(buf, 22, "Int")
    bpp := NumGet(buf, 28, "UShort")
    if (w <= 0 || bpp < 24)
        return 0
    bottomUp := (hRaw > 0)
    h := Abs(hRaw)
    stride := ((w * bpp + 31) // 32) * 4
    return {w: w, h: h, bpp: bpp, stride: stride, buf: buf, off: off, bottomUp: bottomUp}
}




SortNums(arr) {
    ; v7.6: КРИТИЧЕСКОЕ. В AHK v2 у Array НЕТ метода Sort. В run-21.log подбор
    ; порогов падал в самом конце:
    ;   [!!] ОШИБКА (Return): This value of type "Array" has no method named "Sort"
    ; — то есть 500 кадров читались 13 секунд и всё выбрасывалось.
    ; Простая вставка: массивов тут сотни элементов, этого более чем достаточно.
    n := arr.Length
    if (n < 2)
        return arr
    i := 2
    while (i <= n) {
        v := arr[i], j := i - 1
        while (j >= 1 && arr[j] > v) {
            arr[j + 1] := arr[j]
            j -= 1
        }
        arr[j + 1] := v
        i += 1
    }
    return arr
}

Percentiles(sorted) {
    ; Перцентили по отсортированному массиву. Без вложенной функции: в AHK v2
    ; вложенные функции не видят локальных переменных внешней.
    n := sorted.Length
    if (n = 0)
        return {p15: 0, p50: 0, p90: 0}
    return {p15: PercentileAt(sorted, 0.15), p50: PercentileAt(sorted, 0.50)
          , p90: PercentileAt(sorted, 0.90)}
}

PercentileAt(sorted, k) {
    n := sorted.Length
    if (n = 0)
        return 0
    return sorted[Clamp(Round(k * n), 1, n)]
}

; YOLO-разметка: «класс cx cy w h» в долях кадра
ReadYoloBoxes(labPath) {
    out := []
    try
        txt := FileRead(labPath, "UTF-8")
    catch
        return out
    for line in StrSplit(txt, "`n", "`r") {
        parts := StrSplit(Trim(line), " ")
        if (parts.Length < 5)
            continue
        try {
            cx := parts[2] + 0, cy := parts[3] + 0
            bw := parts[4] + 0, bh := parts[5] + 0
        } catch
            continue
        out.Push({cx: cx, cy: cy, w: bw, h: bh})
    }
    return out
}

; Ищем полоску HP в верхней части бокса врага (полоска висит над головой).

; Полоски по всему кадру (когда разметки нет). Один быстрый проход: шаг 2 по X
; и 3 по Y — для статистики этого достаточно, а время падает в 6 раз.

; Самая длинная красная полоска в прямоугольнике

; Склеиваем строки в полоску: у полоски HP соседние строки почти одинаковой ширины.

; ============================================================================
;                            ГОРЯЧИЕ КЛАВИШИ
; ============================================================================
; Горячие клавиши регистрируются динамически (см. ApplyHotkeys) — их можно
; переназначить в меню. Аварийные выходы остаются всегда:
;   Esc — стоп · Ctrl+Alt+Q — полный выход.

ApplyHotkeys() {
    global CFG, UI
    ; снять все ранее назначенные
    try {
        for k in UI.hkKeys
            Hotkey(k, "Off")
    } catch {
    }
    UI.hkKeys := []
    okList := ""
    badList := ""
    UI.hkReport := Map()
    for item in [[CFG.hkStart, OnStart, "старт/стоп"]
               , [CFG.hkDry, ToggleDry, "DryRun"]
               , [CFG.hkCal, OnCalibrate, "калибровка HUD"]
               , [CFG.hkMouseCal, OnMouseCalPrepare, "мышь: подготовка"]
               , [CFG.hkCheck, OnCheckCapture, "захват"]
               , [CFG.hkMenu, ToggleGui, "меню"]
               , [CFG.hkVision, ToggleVision, "зрение"]] {
        key := Trim(item[1])
        if !key {
            Log("[!] клавиша для «" item[3] "» пустая — пропущена")
            badList .= (badList != "" ? " · " : "") item[3]
            continue
        }
        ; Частая причина «бинды не работают»: одна клавиша указана дважды,
        ; тогда второе назначение молча затирает первое.
        if UI.hkReport.Has(StrUpper(key)) {
            Log("[!] клавиша «" key "» назначена дважды («" item[3] "») — оставляю первое")
            badList .= (badList != "" ? " · " : "") item[3]
            continue
        }
        try {
            ; F8/переназначенный старт-стоп: остановка раньше журнала.
            callback := (item[3] = "старт/стоп") ? StartStopHotkey : Hk(item[3] "  (" key ")", item[2])
            ; Старт/стоп можно нажать повторно во время медленного запуска.
            ; Остальные клавиши остаются однопоточными; буфер отключён,
            ; чтобы запоздалое повторное нажатие не запустило бота вновь.
            Hotkey(key, callback, item[3] = "старт/стоп" ? "T2 B0" : "T1 B0")
            UI.hkKeys.Push(key)
            UI.hkReport[StrUpper(key)] := item[3] ":" key
            okList .= (okList != "" ? " · " : "") item[3] " " key
        } catch as e {
            Log("[!] не смог назначить клавишу «" key "» (" item[3] "): " e.Message)
            badList .= (badList != "" ? " · " : "") item[3] " " key
        }
    }
    ; аварийные — всегда
    try {
        Hotkey("~$Esc", OnStop)
        UI.hkReport["~ESC"] := "стоп:Esc"
    } catch as e {
        Log("[!] Esc не назначен: " e.Message)
    }
    try
        Hotkey("^!q", Hk("Ctrl+Alt+Q — выход", (*) => ExitApp()))
    Log("[i] горячие клавиши: " (okList != "" ? okList : "нет"))
    if (badList != "")
        Log("[!] НЕ назначены: " badList " — попробуйте другую клавишу в меню")
    ; итог виден глазами, а не только в журнале
    if (badList = "")
        Flash("Клавиши работают:`n" okList, 3000)
    else
        Flash("Клавиши:`n" okList "`nНЕ назначены: " badList, 5000)
}


ReadHotkeysFromGui() {
    global CFG, UI
    try {
        CFG.hkStart := Trim(UI.edStart.Value)
        CFG.hkDry   := Trim(UI.edDry.Value)
        CFG.hkCal   := Trim(UI.edCal.Value)
        CFG.hkMouseCal := Trim(UI.edMouseCal.Value)
        CFG.hkCheck := Trim(UI.edCheck.Value)
        CFG.hkMenu  := Trim(UI.edMenu.Value)
        CFG.hkVision := Trim(UI.edVision.Value)
    } catch {
    }
}

; ---------- настройки в файл ----------
IniPath() {
    global CFG
    return A_ScriptDir "\forma.ini"
}

SaveSettings() {
    global CFG
    try {
        p := IniPath()
        ini := IniPath()
        IniWrite(CFG.hkStart, ini, "keys", "start")
        IniWrite(CFG.hkDry, ini, "keys", "dry")
        IniWrite(CFG.hkCal, ini, "keys", "cal")
        IniWrite(CFG.hkMouseCal, ini, "keys", "mouseCal")
        IniWrite(CFG.hkCheck, ini, "keys", "check")
        IniWrite(CFG.hkMenu, ini, "keys", "menu")
        IniWrite(CFG.hkVision, ini, "keys", "vision")
        IniWrite(CFG.buildWall, ini, "keys", "cover")
        IniWrite(CFG.zeroBuild ? 1 : 0, ini, "mode", "zeroBuild")
        IniWrite(CFG.teamSafe ? 1 : 0, ini, "mode", "teamSafe")
        IniWrite(CFG.dryRun ? 1 : 0, ini, "mode", "dryRun")
        IniWrite(CFG.featPlayAgain ? 1 : 0, ini, "feat", "playAgain")
        IniWrite(CFG.featAutoQueue ? 1 : 0, ini, "feat", "autoQueue")
        IniWrite(CFG.featMove ? 1 : 0, ini, "feat", "move")
        IniWrite(CFG.featParkour ? 1 : 0, ini, "feat", "parkour")
        IniWrite(CFG.sprint ? 1 : 0, ini, "feat", "sprint")
        IniWrite(CFG.featCrouchFight ? 1 : 0, ini, "feat", "crouchFight")
        IniWrite(CFG.featAds ? 1 : 0, ini, "feat", "ads")
        IniWrite(CFG.featChest ? 1 : 0, ini, "feat", "chest")
        IniWrite(CFG.featLoot ? 1 : 0, ini, "feat", "loot")
        IniWrite(CFG.featHeal ? 1 : 0, ini, "feat", "heal")
        IniWrite(CFG.featCombat ? 1 : 0, ini, "feat", "combat")
        IniWrite(CFG.featSound ? 1 : 0, ini, "feat", "sound")
        IniWrite(CFG.featReward ? 1 : 0, ini, "feat", "reward")
        IniWrite(CFG.featToken ? 1 : 0, ini, "feat", "token")
        IniWrite(CFG.featHarvest ? 1 : 0, ini, "feat", "harvest")
        IniWrite(CFG.featFirstSlot ? 1 : 0, ini, "feat", "firstSlot")
        IniWrite(CFG.featReload ? 1 : 0, ini, "feat", "reload")
        IniWrite(CFG.bgMode ? 1 : 0, ini, "mode", "bg")
        IniWrite(CFG.featBusJump ? 1 : 0, ini, "feat", "busJump")
        IniWrite(CFG.featWeaponPick ? 1 : 0, ini, "feat", "weaponPick")
        IniWrite(CFG.featFightBack ? 1 : 0, ini, "feat", "fightBack")
        ; v7.2: то, что подобрано по вашим кадрам, переживает перезапуск
        ; v7.7: сохраняем пороги ФИГУРЫ (полосок HP над врагом в игре нет)
        IniWrite(CFG.enemySkinMinPct, ini, "learn", "skinMin")
        IniWrite(CFG.enemyMinBoxW, ini, "learn", "boxMinW")
        IniWrite(CFG.enemyMaxBoxW, ini, "learn", "boxMaxW")
        IniWrite(CFG.enemyMinBoxH, ini, "learn", "boxMinH")
        IniWrite(CFG.enemyMaxBoxH, ini, "learn", "boxMaxH")
        IniWrite(CFG.learnFolder, ini, "learn", "folder")
        IniWrite(CFG.learnSig, ini, "learn", "sig")
        IniWrite(CFG.learnAuto ? 1 : 0, ini, "learn", "auto")
        return true
    } catch as e {
        Log("[!] не смог сохранить настройки: " e.Message)
        return false
    }
}

LoadSettings() {
    global CFG
    ini := IniPath()
    if !FileExist(ini)
        return
    try {
        CFG.hkStart := IniRead(ini, "keys", "start", CFG.hkStart)
        CFG.hkDry   := IniRead(ini, "keys", "dry", CFG.hkDry)
        CFG.hkCal   := IniRead(ini, "keys", "cal", CFG.hkCal)
        CFG.hkMouseCal := IniRead(ini, "keys", "mouseCal", CFG.hkMouseCal)
        CFG.hkCheck := IniRead(ini, "keys", "check", CFG.hkCheck)
        CFG.hkVision := IniRead(ini, "keys", "vision", CFG.hkVision)
        CFG.hkMenu  := IniRead(ini, "keys", "menu", CFG.hkMenu)
        CFG.buildWall := IniRead(ini, "keys", "cover", CFG.buildWall)
        CFG.zeroBuild := IniRead(ini, "mode", "zeroBuild", CFG.zeroBuild ? 1 : 0) = 1
        CFG.teamSafe := IniRead(ini, "mode", "teamSafe", CFG.teamSafe ? 1 : 0) = 1
        CFG.dryRun  := IniRead(ini, "mode", "dryRun", CFG.dryRun ? 1 : 0) = 1
        CFG.featPlayAgain := IniRead(ini, "feat", "playAgain", CFG.featPlayAgain ? 1 : 0) = 1
        CFG.featAutoQueue := IniRead(ini, "feat", "autoQueue", CFG.featAutoQueue ? 1 : 0) = 1
        CFG.featMove := IniRead(ini, "feat", "move", CFG.featMove ? 1 : 0) = 1
        CFG.featParkour := IniRead(ini, "feat", "parkour", CFG.featParkour ? 1 : 0) = 1
        CFG.sprint := IniRead(ini, "feat", "sprint", CFG.sprint ? 1 : 0) = 1
        CFG.featCrouchFight := IniRead(ini, "feat", "crouchFight", CFG.featCrouchFight ? 1 : 0) = 1
        CFG.featAds := IniRead(ini, "feat", "ads", CFG.featAds ? 1 : 0) = 1
        CFG.featChest := IniRead(ini, "feat", "chest", CFG.featChest ? 1 : 0) = 1
        CFG.featLoot := IniRead(ini, "feat", "loot", CFG.featLoot ? 1 : 0) = 1
        CFG.featHeal := IniRead(ini, "feat", "heal", CFG.featHeal ? 1 : 0) = 1
        CFG.featCombat := IniRead(ini, "feat", "combat", CFG.featCombat ? 1 : 0) = 1
        CFG.featSound := IniRead(ini, "feat", "sound", CFG.featSound ? 1 : 0) = 1
        CFG.featReward := IniRead(ini, "feat", "reward", CFG.featReward ? 1 : 0) = 1
        CFG.featToken := IniRead(ini, "feat", "token", CFG.featToken ? 1 : 0) = 1
        CFG.featHarvest := IniRead(ini, "feat", "harvest", CFG.featHarvest ? 1 : 0) = 1
        CFG.featFirstSlot := IniRead(ini, "feat", "firstSlot", CFG.featFirstSlot ? 1 : 0) = 1
        CFG.featReload := IniRead(ini, "feat", "reload", CFG.featReload ? 1 : 0) = 1
        CFG.bgMode := IniRead(ini, "mode", "bg", CFG.bgMode ? 1 : 0) = 1
        CFG.featBusJump := IniRead(ini, "feat", "busJump", CFG.featBusJump ? 1 : 0) = 1
        CFG.featWeaponPick := IniRead(ini, "feat", "weaponPick", CFG.featWeaponPick ? 1 : 0) = 1
        CFG.featFightBack := IniRead(ini, "feat", "fightBack", CFG.featFightBack ? 1 : 0) = 1
        ; v7.2: пороги, подобранные по скриншотам, и папка с кадрами
        CFG.enemySkinMinPct := IniRead(ini, "learn", "skinMin", CFG.enemySkinMinPct)
        CFG.enemyMinBoxW := IniRead(ini, "learn", "boxMinW", CFG.enemyMinBoxW)
        CFG.enemyMaxBoxW := IniRead(ini, "learn", "boxMaxW", CFG.enemyMaxBoxW)
        CFG.enemyMinBoxH := IniRead(ini, "learn", "boxMinH", CFG.enemyMinBoxH)
        CFG.enemyMaxBoxH := IniRead(ini, "learn", "boxMaxH", CFG.enemyMaxBoxH)
        CFG.learnFolder   := IniRead(ini, "learn", "folder", CFG.learnFolder)
        CFG.learnSig      := IniRead(ini, "learn", "sig", CFG.learnSig)
        CFG.learnAuto     := IniRead(ini, "learn", "auto", CFG.learnAuto ? 1 : 0) = 1

    } catch {
    }
}

OnApplyKeys(*) {
    global CFG, UI
    ReadHotkeysFromGui()
    ApplyHotkeys()
    n := UI.hkKeys.Length
    saved := SaveSettings()
    if !saved {
        result := "Настройки не удалось полностью сохранить. См. журнал."
    } else if (n != 7) {
        result := "Назначено " n " из 7. Ошибки и повторы — в журнале."
    } else {
        result := "Готово: все 7 клавиш назначены и сохранены."
    }
    Log("[i] клавиши: " n " из 7 · " (saved ? "настройки сохранены" : "ошибка сохранения"))
    try UI.keyResult.Value := result
    Flash(result, 4000)
}

ToggleDry(*) {
    global CFG, ST
    if (ST.running && !ST.paused && !ST.mouseCalActive)
        OnPause()
    CFG.dryRun := !CFG.dryRun
    SyncTogglesFromCfg()
    Log(CFG.dryRun ? "DryRun ВКЛ (только журнал)" : "DryRun ВЫКЛ")
    SaveSettings()
    mode := CFG.dryRun ? "DryRun: ВКЛ" : "DryRun: ВЫКЛ"
    Flash(mode (ST.running && ST.paused ? " · снимите паузу вручную" : ""), 2500)
    UpdateStatus()
}

ToggleGui(*) {
    global UI
    if UI.visible
        HideGui()
    else
        ShowGui()
}

; ============================================================================
;                             ИНИЦИАЛИЗАЦИЯ
; ============================================================================
Init() {
    global CFG, UI, ST
    LoadSettings()
    ; Скрытые старые галочки не должны отключать обычные действия.
    SetAutomaticFeatures()
    SetDpiAware()
    SetTitleMatchMode(2)
    SetKeyDelay(-1, 30)
    CoordMode("Mouse", "Screen")
    CoordMode("Pixel", "Screen")

    try {
        BuildGui()
    } catch as e {
        BuildGuiFallback(e.Message)
        Log("[!] Тема GUI не создалась: " e.Message)
    }
    ShowGui()

    ; ошибки — в журнал (иначе диалог прячется за игрой и бот «молча стоит»)
    OnError(LogFatal)

    ApplyHotkeys()
    SetTimer(Watchdog, 1000)          ; сторож: заметит, что цикл встал
    SetTimer(UpdateStatus, 400)
    SetTimer(ModelLiveTimer, 30)  ; диагностика: опрос ответа, не частота захвата или FPS модели

    ; --- если прошлый запуск закончился самовосстановлением — продолжаем сами
    if ResumeFlagTake() {
        ST.autoResumeTimer := AutoResume.Bind(ST.startGeneration)
        SetTimer(ST.autoResumeTimer, -6000)
    }

    ; --- «сделай, чтобы он сам обучился на уже скачанных скринах» (v7.3):
    ;     один раз на набор, кусками по 5 картинок, меню при этом живое
    SetTimer(AutoLearnOnStart, -2500)

    A_IconTip := FormaTitle() " — Fortnite AFK"
    TrayTip("F1 меню · F8 старт/стоп · F9 DryRun · F5 калибровка · F7 диагностика · F3 зрение", "FORMA", 1)
    Log("=== Запуск: " FormaBuildInfo()
        . " · окно: " CFG.winTitle " / " CFG.winTitleAlt
        . " · режим: " (CFG.dryRun ? "DryRun (только журнал)" : "БОЕВОЙ")
        . " · права администратора: " (A_IsAdmin ? "есть" : "НЕТ (игра может не принять нажатия)") " ===")
    Log("[i] режим игры: " (CFG.zeroBuild ? "ZERO BUILD — постройки не ставлю,"
        . " укрытие ищу в рельефе" : "обычный BR — стены/укрытия разрешены"))
    Log("[i] разрешение кадра подстраивается само: все размеры (фигура, цифры"
        . " урона, подсказка E) считаются в пересчёте на 1280 px по ширине")
    hwGo := GetGameWindow()
    if hwGo {
        tGo := ""
        try
            tGo := WinGetTitle("ahk_id " hwGo)
        Log("[i] окно игры: ahk_id " hwGo " «" tGo "» · найдено окон игры: " GameWindowCount())
    } else {
        Log("[!] окно игры пока не найдено — запустите Fortnite и нажмите F7."
            . " Меню бота (FORMA — Fortnite AFK) за игру НЕ считается.")
    }
    Log("Порядок: запустите игру (оконный без рамки) → F7 (захват) → F5 (калибровка) → Старт.")
}
