; Кумулятивная вероятность выпадения жетона пиратского магазина:
; базовый шанс 1 из 137 500 за сундук, в «Час сокровищ» — 1.5x (1.5 из 137 500).
CalcTokenOdds(chests, treasureHour := false) {
    n := Max(0, Floor(chests))
    if (n <= 0)
        return 0.0
    p := (treasureHour ? 1.5 : 1.0) / 137500.0
    odds := 100.0 * (1.0 - ((1.0 - p) ** n))
    return Clamp(odds, 0.0, 99.9999)
}

FmtOdds(chests, treasureHour := false) {
    pct := CalcTokenOdds(chests, treasureHour)
    if (pct <= 0.0)
        return "0%"
    if (pct < 0.1)
        return Format("{:.3f}%", pct)
    if (pct < 10.0)
        return Format("{:.2f}%", pct)
    return Format("{:.1f}%", pct)
}

; Темп в час (раундов/ч или сундуков/ч); ждём минимум 60 с, чтобы не шуметь на старте.
CalcRatePerHour(count, elapsedSec) {
    if (count <= 0 || elapsedSec < 60)
        return 0.0
    return Round((count * 3600.0) / elapsedSec, 1)
}

FmtCountdown(ms) {
    sec := Ceil(Max(0, ms) / 1000)
    h := sec // 3600
    m := Mod(sec, 3600) // 60
    s := Mod(sec, 60)
    if (h > 0)
        return Format("{:02}:{:02}:{:02}", h, m, s)
    return Format("{:02}:{:02}", m, s)
}

FmtClock(sec) {
    sec := Max(0, Floor(sec))
    return Format("{:02}:{:02}:{:02}", sec // 3600, Mod(sec, 3600) // 60, Mod(sec, 60))
}

FmtLifetime(sec) {
    sec := Max(0, Floor(sec))
    d := sec // 86400
    h := Mod(sec, 86400) // 3600
    m := Mod(sec, 3600) // 60
    s := Mod(sec, 60)
    if (d > 0)
        return d " д " h " ч " m " м"
    if (h > 0)
        return h " ч " Format("{:02} м", m)
    return Format("{:02} м {:02} с", m, s)
}

