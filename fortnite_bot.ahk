    ST.altWasDown := false, ST.altSettleUntil := 0
    SmartAlertClear()
    MacroStopRec()
    ST.afkAct := "", ST.afkUntil := 0, ST.afkKeys := [], ST.afkCrouched := false, ST.afkPitch := 0
    ST.xpNextActAt := 0, ST.xpNextNudgeAt := 0, ST.xpNudges := 0, ST.xpActions := 0
    ST.xpLmbHeld := false, ST.xpStepPhase := 0, ST.xpStepKey1 := "", ST.xpStepKey2 := ""
    ST.xpLastCurX := -99999, ST.xpManualResets := 0, ST.xpPausedAt := 0, ST.coinNextAt := 0, ST.coinAlerts := 0
    ST.macroPlayIdx := 0, ST.macroPlayNextAt := 0, ST.macroPlayHeld := [], ST.macroLoops := 0
    ST.sessionActiveSec := 0, ST.activeRunTick := 0, ST.groundAt := 0
    ST.bgWarned := false
    ST.queuePending := false, ST.queueSeen := false, ST.leftQueueT := 0
    ST.state := "", ST.pendingState := "", ST.pendingCount := 0, ST.pendingSince := 0
    ST.mmEnterAt := 0, ST.mmSince := 0
    ST.matchStarted := false, ST.matchFromQueue := false
    ST.roundActive := false, ST.lobbyRequeue := false
    ST.promptConfirm := NewCandidateTracker()
    ST.enemyConfirm := NewCandidateTracker()
    ST.enemyWideConfirm := NewCandidateTracker()
    ResetMoveWatch(true)
    ST.tickReentry := 0
    ST.lastTickAt := A_TickCount
    ST.combatBrakeUntil := 0, ST.combatMoveUntil := 0
