OnModeOptionsChange(*) {
    global CFG, ST, UI
    oldBg := CFG.bgMode
    oldSmart := CFG.smartRestore
    oldSquad := CFG.squadAutoLeave
    newBg := UI.cbBg.Value ? true : false
    if (oldBg != newBg && ST.running && !ST.paused && !ST.mouseCalActive)
        OnPause()
    ApplyToggles()
    if (oldBg != CFG.bgMode) {
        ST.bgWarned := false
        Log(CFG.bgMode
            ? "[i] Фон-клавиатура: клавиши через PostMessage, мышь только при фокусе."
            : "[i] Фон-клавиатура выключена.")
        if (ST.running && ST.paused)
            Flash("Режим ввода изменён; снимите паузу для продолжения", 3200)
    }
    if (oldSmart != CFG.smartRestore) {
        ST.bgWarned := false
        SmartAlertClear()
        Log(CFG.smartRestore
            ? "[i] Умный фон ВКЛ: для кликов меню подниму Fortnite на ~0.5 с и верну ваше окно и курсор."
            : "[i] Умный фон ВЫКЛ: окно игры автоматически не активируется.")
    }
    if (oldSquad != CFG.squadAutoLeave) {
        ST.squadEmptyCount := 0
        ST.squadStatus := CFG.squadAutoLeave ? "активен" : "выкл"
        Log(CFG.squadAutoLeave
            ? "[i] Выход при пустом отряде ВКЛ (пауза " CFG.squadGraceSec " с, интервал 5 с, не для Соло)."
            : "[i] Выход при пустом отряде ВЫКЛ.")
    }
    SaveSettings()
    UpdateStatus()
}

