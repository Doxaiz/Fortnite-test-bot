        . " · поток цикла " ST.tickSlot
        . (ST.stallRecover ? " · восстановлений потока " ST.stallRecover : ""))
    Log("  шаг тика: " (ST.tickStep != "" ? ST.tickStep : "—")
        . " · игра отвечает: " (ST.respOk ? "да" : "НЕТ")
        . (ST.gameHungAt ? " (молчит " Round((A_TickCount - ST.gameHungAt) / 1000) " с)" : "")
