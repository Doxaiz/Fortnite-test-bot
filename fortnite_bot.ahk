ApplyToggles() {
    global CFG, UI
    try {
        m := UI.ddMode.Value
        CFG.botMode := (m = 2) ? "queue" : ((m = 3) ? "antiafk" : ((m = 4) ? "xp" : "auto"))
    }
    try CFG.dryRun := UI.cbDry.Value ? true : false
    try CFG.smartRestore := UI.cbSmart.Value ? true : false
    try CFG.squadAutoLeave := UI.cbSquad.Value ? true : false
    try CFG.bgMode := UI.cbBg.Value ? true : false
    try CFG.teamSafe := UI.cbTeam.Value ? true : false
}

OnBotModeChange(*) {
    global CFG, ST
    oldMode := CFG.botMode
    ApplyToggles()
    if (oldMode != CFG.botMode) {
        AntiAfkReset()
        XpModeReset()
        MacroPlayReset()
        if (ST.running && !ST.paused)
            ReleaseKeys()
        Log("[i] Режим работы: " ModeRu(CFG.botMode))
        Flash("Режим: " ModeRu(CFG.botMode), 2400)
    }
    UpdateTrayChecks()
    SaveSettings()
    UpdateStatus()
}

SetBotMode(mode) {
    global CFG
    CFG.botMode := (mode = "queue" || mode = "antiafk" || mode = "xp") ? mode : "auto"
    SyncTogglesFromCfg()
    OnBotModeChange()
}

