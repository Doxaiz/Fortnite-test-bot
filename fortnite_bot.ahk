ModelWritePayload(path, encoded) {
    ; CRYPT_STRING_BASE64 accepts the line breaks used by ModelPayload.
    n := 0
    if !DllCall("Crypt32\CryptStringToBinaryW", "Str", encoded, "UInt", 0, "UInt", 1
        , "Ptr", 0, "UInt*", &n, "Ptr", 0, "Ptr", 0, "Int") || !n
        throw Error("Не удалось подготовить встроенные файлы модели")
    buf := Buffer(n, 0)
    if !DllCall("Crypt32\CryptStringToBinaryW", "Str", encoded, "UInt", 0, "UInt", 1
        , "Ptr", buf, "UInt*", &n, "Ptr", 0, "Ptr", 0, "Int")
        throw Error("Не удалось декодировать встроенные файлы модели")
    if FileExist(path)
        throw Error("Временный файл уже существует; не перезаписываю")
    f := FileOpen(path, "w")
    if !f
        throw Error("Не удалось создать временный файл модели")
    try {
        if (f.RawWrite(buf, n) != n)
            throw Error("Временный файл записан не полностью")
    } finally {
        f.Close()
    }
}

OnInstallModel(*) {
    global MODEL_SETUP
    if MODEL_SETUP.active {
        Flash("Установка модели уже выполняется", 3500)
        return
    }
    root := A_ScriptDir "\forma_model"
    final := root "\runtime-v1"
    if DirExist(final) {
        Log("[i] Модель: папка установки уже существует: " final
            . ". Повторно не перезаписываю. Модель используется лишь для диагностики.")
        Flash("Папка модели уже существует; см. журнал", 4000)
        return
    }
    answer := MsgBox("Загрузить Python, NumPy, OpenCV и стороннюю модель фигур?"
        . "`nОколо 110 МБ загрузки и 230 МБ после установки; во время установки нужно до 400 МБ."
        . "`nИсточник модели — коллекция файлов сторонних авторов; происхождение весов не проверено."
        . "`nХэши проверяются, но они не гарантируют безопасность или качество модели."
        . "`nПри ошибке или скорости ниже 100 КиБ/с за 15 секунд пробую резервный источник:"
        . "`nmirrors.huaweicloud.com, mirrors.aliyun.com или ghproxy.net (сторонний прокси)."
        . "`nПосле установки модель запускается для диагностики при работе бота; цели управлению не передаются."
        . "`nПрава установщика совпадают с правами FORMA; доступ в интернет нужен для загрузки."
        , "FORMA — подготовка модели", "YesNo Icon? Default2")
    if (answer != "Yes")
        return
    ; Резервируем установку до записи и запуска дочернего процесса.
    prev := Critical("On")
    if MODEL_SETUP.active {
        Critical(prev)
        return
    }
    MODEL_SETUP.active := true, MODEL_SETUP.started := A_TickCount, MODEL_SETUP.warned := false
    MODEL_SETUP.lastStatus := "", MODEL_SETUP.pid := 0
    MODEL_SETUP.progressText := "УСТАНОВКА   начинаю загрузку", MODEL_SETUP.progressRaw := ""
    MODEL_SETUP.progressSeenAt := A_TickCount
    Critical(prev)
    try {
        DirCreate(root)
        task := root "\task-" DllCall("GetCurrentProcessId", "UInt") "-" A_TickCount "-" Random(100000,999999)
        if DirExist(task)
            throw Error("Временная папка уже существует")
        DirCreate(task)
        MODEL_SETUP.task := task
        ModelWritePayload(task "\install.ps1", ModelPayload("install"))
        ModelWritePayload(task "\vision_worker.py", ModelPayload("worker"))
        powershell := A_WinDir "\System32\WindowsPowerShell\v1.0\powershell.exe"
        if !FileExist(powershell)
            throw Error("Не найден Windows PowerShell")
        cmd := '"' powershell '" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "'
            . task '\install.ps1" -Root "' root '" -Task "' task '"'
        Run(cmd, A_ScriptDir, "Hide", &pid)
        MODEL_SETUP.pid := pid
        SetTimer(ModelSetupPoll, 1000)
        Log("[i] Модель: установка запущена с правами FORMA; папка " root
            . ". Загрузка только по явному запросу; модель не управляет игрой.")
    } catch as e {
        MODEL_SETUP.active := false
        Log("[!] Модель: не удалось запустить установку: " e.Message)
        Flash("Не удалось запустить установку модели", 4500)
    }
}

; Снимок прогресса — только отображение, никогда не подтверждает установку.
ModelSetupReadProgress() {
    global MODEL_SETUP
    file := MODEL_SETUP.task "\progress.txt"
    raw := ""
    try {
        if (FileExist(file) && FileGetSize(file) <= 500)
            raw := Trim(FileRead(file, "UTF-8"), " `t`r`n" Chr(0xFEFF))
    }
    if !RegExMatch(raw, "^P\|(Python|NumPy|OpenCV|ONNX)\|(\d+)\|(\d+)\|(\d+)\|(\d+)\|(\d+)\|(\d+)\|(\d+)$", &m)
        return
    try {
        n := Integer(m[2]), size := Integer(m[3]), before := Integer(m[4]), total := Integer(m[5])
        bps := Integer(m[6]), source := Integer(m[7]), sources := Integer(m[8])
        if (size <= 0 || total <= 0 || total > 1000000000 || n > size || before + size > total
            || bps > 1073741824 || source < 1 || source > sources || sources > 8)
            return
        if (raw != MODEL_SETUP.progressRaw)
            MODEL_SETUP.progressSeenAt := A_TickCount, MODEL_SETUP.progressRaw := raw
        silent := A_TickCount - MODEL_SETUP.progressSeenAt
        if (silent > 10000)
            bps := 0
        done := before + n, left := total - done
        pct := Round(done * 100 / total, 1)
        speed := bps ? (Round(bps / 1024, 1) " КиБ/с") : "ожидание данных"
        eta := "—"
        if (bps > 0) {
            seconds := Ceil(left / bps)
            eta := (seconds >= 3600) ? (Round(seconds / 3600, 1) " ч")
                : (seconds >= 60 ? (Ceil(seconds / 60) " мин") : (seconds " с"))
        }
        src := source > 1 ? "зеркало" : "основной"
        MODEL_SETUP.progressText := "УСТАНОВКА   " m[1] " · " pct "% · " src " " source "/" sources "`n"
            . "  " Round(done/1048576, 1) "/" Round(total/1048576, 1) " МиБ · осталось "
            . Round(left/1048576, 1) " МиБ · " speed " · ~" eta
    }
}

ModelSetupPoll() {
    global MODEL_SETUP
    if !MODEL_SETUP.active {
        SetTimer(ModelSetupPoll, 0)
        return
    }
    status := ""
    try status := Trim(FileRead(MODEL_SETUP.task "\status.txt", "UTF-8"), " `t`r`n" Chr(0xFEFF))
    if (status != "" && status != MODEL_SETUP.lastStatus) {
        MODEL_SETUP.lastStatus := status
        if (SubStr(status, 1, 5) = "WORK:")
            Log("[i] Модель: " status)
    }
    if (InStr(status, "WORK: extracting"))
        MODEL_SETUP.progressText := "УСТАНОВКА   загрузка завершена · распаковка"
    else if (InStr(status, "WORK: checking runtime"))
        MODEL_SETUP.progressText := "УСТАНОВКА   проверка среды и модели"
    else if (InStr(status, "WORK: checking SHA256"))
        MODEL_SETUP.progressText := "УСТАНОВКА   проверка SHA-256 загруженного файла"
    else if (SubStr(status, 1, 5) = "WORK:")
        ModelSetupReadProgress()
    if (status = "OK") {
        MODEL_SETUP.active := false
        SetTimer(ModelSetupPoll, 0)
        Log("[+] Модель и локальная среда установлены, проверка загрузки прошла."
            . " Модель даёт только диагностику, а не цели для управления или распознавание команды.")
        Flash("Модель установлена; только диагностика", 4500)
        return
    }
    if (SubStr(status, 1, 6) = "ERROR:") {
        MODEL_SETUP.active := false
        SetTimer(ModelSetupPoll, 0)
        Log("[!] Установка модели не выполнена: " status " · " MODEL_SETUP.task)
        Flash("Ошибка установки модели; см. журнал", 4500)
        return
    }
    if (MODEL_SETUP.pid && !ProcessExist(MODEL_SETUP.pid)) {
        MODEL_SETUP.active := false
        SetTimer(ModelSetupPoll, 0)
        Log("[!] Установщик модели завершился без подтверждения успеха; проверьте " MODEL_SETUP.task)
        Flash("Установка модели не подтверждена", 4500)
        return
    }
    if (!MODEL_SETUP.warned && A_TickCount - MODEL_SETUP.started > 600000) {
        MODEL_SETUP.warned := true
        Log("[!] Установка модели длится более 10 минут; загрузка или проверка ещё выполняется.")
    }
}


; F7 выполняет отдельную одноразовую диагностику. Задержанные рамки
; никогда не передаются игровым действиям, даже если обнаружена фигура.
ModelDebugRequest(shot) {
    global ST, MODEL_CHECK
    base := A_ScriptDir "\forma_model\runtime-v1"
    if (!FileExist(base "\installed.txt") || !FileExist(base "\python\pythonw.exe")
        || !FileExist(base "\vision_worker.py") || !FileExist(base "\fortnite.onnx"))
        return false
    if MODEL_CHECK.active {
        LogThrottledKey("[modelbusy]", "[i] Модель: предыдущая проверка ещё завершается.", 5000)
        return false
    }
    if (ST.running || ST.tickLiveCount > 0 || ST.mouseCalActive || ST.startWorkers > 0 || ST.stopWorkers > 0) {
        LogThrottledKey("[modelrun]", "[i] Модель: остановите бота для диагностической проверки F7.", 5000)
        return false
    }
    prev := Critical("On")
    if (MODEL_CHECK.active || ST.running || ST.tickLiveCount > 0 || ST.mouseCalActive || ST.startWorkers > 0) {
        Critical(prev)
        return false
    }
    MODEL_CHECK.active := true, MODEL_CHECK.stopping := false, MODEL_CHECK.pid := 0
    MODEL_CHECK.started := A_TickCount, MODEL_CHECK.shot := shot
    Critical(prev)
    try {
        session := A_ScriptDir "\forma_model\check-" DllCall("GetCurrentProcessId", "UInt") "-" A_TickCount "-" Random(100000,999999)
        if DirExist(session)
            throw Error("Временная папка уже существует")
        DirCreate(session)
        MODEL_CHECK.dir := session
        step := Max(1, Ceil(shot.w / 960))
        MODEL_CHECK.step := step
        if !SaveShotBmp(shot, session "\frame.bmp")
            throw Error("Не удалось подготовить кадр")
        FileAppend("1", session "\lease.txt", "UTF-8-RAW")
        FileAppend("1," shot.captureId "," shot.cameraSeqAtCapture "," shot.capturedAt "`n"
            , session "\request.txt", "UTF-8-RAW")
        cmd := '"' base '\python\pythonw.exe" "' base '\vision_worker.py" "'
            . base '\fortnite.onnx" "' session '"'
        Run(cmd, A_ScriptDir, "Hide", &pid)
        MODEL_CHECK.pid := pid
        SetTimer(ModelDebugPoll, 250)
        Log("[i] Модель: запускаю диагностическую проверку кадра F7; управление не меняется.")
        return true
    } catch as e {
        MODEL_CHECK.active := false
        Log("[!] Модель: тест не запущен: " e.Message)
        return false
    }
}

ModelDebugPoll() {
    global MODEL_CHECK
    if !MODEL_CHECK.active {
        SetTimer(ModelDebugPoll, 0)
        return
    }
    dir := MODEL_CHECK.dir
    if MODEL_CHECK.stopping {
        if (MODEL_CHECK.pid && ProcessExist(MODEL_CHECK.pid))
            return
        ; Удаляем только известные временные файлы собственного теста.
        for name in ["frame.bmp", "lease.txt", "request.txt", "result.txt", "result.tmp"
            , "ready.txt", "ready.tmp", "error.txt", "error.tmp", "stop.txt"]
            try FileDelete(dir "\" name)
        try DirDelete(dir)
        MODEL_CHECK.active := false, MODEL_CHECK.shot := 0
        SetTimer(ModelDebugPoll, 0)
        return
    }
    ; Периодическое продление аренды; она закончится, если FORMA завершится.
    try FileAppend(".", dir "\lease.txt", "UTF-8-RAW")
    result := ""
    try {
        if FileExist(dir "\result.txt") {
            if (FileGetSize(dir "\result.txt") > 8192)
                throw Error("слишком большой ответ")
            result := FileRead(dir "\result.txt", "UTF-8")
        }
    } catch as e {
        Log("[!] Модель F7: ответ не прочитан: " e.Message)
        MODEL_CHECK.stopping := true
        try FileAppend("stop", dir "\stop.txt", "UTF-8-RAW")
        return
    }
    if (result != "") {
        try {
            lines := StrSplit(Trim(result, "`r`n"), "`n", "`r")
            header := StrSplit(lines[1], ",")
            if (header.Length != 8 || Integer(header[1]) != 1
                || Integer(header[2]) != MODEL_CHECK.shot.captureId
                || Integer(header[3]) != MODEL_CHECK.shot.cameraSeqAtCapture
                || Integer(header[4]) != MODEL_CHECK.shot.capturedAt)
                throw Error("не совпадают ID кадра")
            n := Integer(header[8]), w := Integer(header[5]), h := Integer(header[6])
            if (n < 0 || n > 32 || lines.Length != n + 1
                || w != MODEL_CHECK.shot.w // MODEL_CHECK.step || h != MODEL_CHECK.shot.h // MODEL_CHECK.step)
                throw Error("неверный формат результата")
            best := 0
            Loop n {
                box := StrSplit(lines[A_Index + 1], ",")
                if (box.Length != 5)
                    throw Error("неверная рамка")
                x := Integer(box[1]), y := Integer(box[2]), bw := Integer(box[3]), bh := Integer(box[4])
                conf := Float(box[5])
                if (x < 0 || y < 0 || bw <= 0 || bh <= 0 || x+bw > w || y+bh > h || conf < 0 || conf > 1)
                    throw Error("неверные координаты рамки")
                best := Max(best, conf)
            }
            Log("[i] Модель F7: фигур-кандидатов " n " · уверенность до " Round(best, 2)
                . " · обработка " Integer(header[7]) " мс · возраст кадра "
                . (A_TickCount - MODEL_CHECK.shot.capturedAt) " мс. Свой персонаж/союзник возможен; это не цель.")
        } catch as e {
            Log("[!] Модель F7: результат отброшен: " e.Message)
        }
        MODEL_CHECK.stopping := true
        try FileAppend("stop", dir "\stop.txt", "UTF-8-RAW")
        return
    }
    if FileExist(dir "\error.txt") {
        Log("[!] Модель F7: ошибка обработки; управление не изменено.")
        MODEL_CHECK.stopping := true
        try FileAppend("stop", dir "\stop.txt", "UTF-8-RAW")
        return
    }
    if (MODEL_CHECK.pid && !ProcessExist(MODEL_CHECK.pid)) {
        Log("[!] Модель F7: процесс завершился без результата; проверьте установку.")
        MODEL_CHECK.stopping := true
        return
    }
    if (A_TickCount - MODEL_CHECK.started > 30000) {
        Log("[!] Модель F7: превышено 30 с; не использую результат и жду завершения процесса.")
        MODEL_CHECK.stopping := true
        try FileAppend("stop", dir "\stop.txt", "UTF-8-RAW")
    }
}

; Нейромодель: диагностический поток. Нет доступа к действиям или игре.
; Последний кадр тика копируется в pagefile-backed mapping без BMP на диске.
ModelLiveStartAllowed(epoch, startedAt, gen) {
    global ST, MODEL_CHECK
    return ST.running && !ST.paused && !ST.mouseCalActive && !ST.cancelHold
        && !MODEL_CHECK.active && !ST.startWorkers && !ST.stopWorkers
        && ST.inputEpoch = epoch && ST.startedAt = startedAt && ST.startGeneration = gen
}

ModelLiveStart(shot, epoch, startedAt, gen) {
    global ST, MODEL_LIVE
    if !ModelLiveStartAllowed(epoch, startedAt, gen)
        return false
    base := A_ScriptDir "\forma_model\runtime-v1"
    ; Обученной модели не нужна стандартная fortnite.onnx: проверяем выбранную
    ; модель отдельно, сохраняя прежний приоритет и проверку SHA в worker.
    trainedBase := A_ScriptDir "\forma_model\photo-training\job-20261115-163623-3370eee7\train\weights\best"
    trained := FileExist(trainedBase ".onnx") ? trainedBase ".onnx" : trainedBase ".txt"
    modelPath := FileExist(trained) ? trained : base "\fortnite.onnx"
    modelLabel := FileExist(trained) ? "ваша обученная фотомодель" : "стандартная модель"
    for path in [base "\installed.txt", base "\python\pythonw.exe", modelPath]
        if !FileExist(path) {
            MODEL_LIVE.status := "модель не установлена или неполная"
            return false
        }
    w := shot.w, h := shot.h, size := w * h * 4
    if (w < 32 || h < 32 || w*h > 16000000 || shot.stride != w*4 || shot.buf.Size < size)
        throw Error("неподдерживаемый буфер кадра")
    rnd := Buffer(16, 0)
    if DllCall("bcrypt\BCryptGenRandom", "Ptr", 0, "Ptr", rnd, "UInt", 16, "UInt", 2, "UInt")
        throw Error("не удалось создать случайное имя сеанса")
    token := ""
    Loop 16
        token .= Format("{:02x}", NumGet(rnd, A_Index-1, "UChar"))
    mapname := "Local\FORMA_" token
    root := A_ScriptDir "\forma_model"
    dir := root "\live-" token
    if DirExist(dir)
        throw Error("папка сеанса уже существует")
    DirCreate(dir)
    MODEL_LIVE.dir := dir
    handle := DllCall("CreateFileMappingW", "Ptr", -1, "Ptr", 0, "UInt", 4
        , "UInt", 0, "UInt", size, "Str", mapname, "Ptr")
    if !handle
        throw Error("CreateFileMapping: " A_LastError)
    already := A_LastError = 183
    MODEL_LIVE.handle := handle
    if already
        throw Error("имя памяти уже занято")
    ptr := DllCall("MapViewOfFile", "Ptr", handle, "UInt", 2, "UInt", 0, "UInt", 0, "UPtr", size, "Ptr")
    if !ptr
        throw Error("MapViewOfFile: " A_LastError)
    MODEL_LIVE.ptr := ptr, MODEL_LIVE.size := size, MODEL_LIVE.w := w, MODEL_LIVE.h := h
    MODEL_LIVE.epoch := epoch, MODEL_LIVE.startedAt := startedAt
    MODEL_LIVE.request := 0, MODEL_LIVE.issued := 0, MODEL_LIVE.lastCapture := 0, MODEL_LIVE.preview := 0
    MODEL_LIVE.startTick := A_TickCount, MODEL_LIVE.lastBeat := 0, MODEL_LIVE.pid := 0
    MODEL_LIVE.status := "загрузка модели (диагностика)"
    ModelWritePayload(dir "\live.py", ModelPayload("live"))
    FileAppend("1", dir "\lease.txt", "UTF-8-RAW")
    ; Stop/Pause могли прервать подготовку; не запускать процесс старого сеанса.
    if !ModelLiveStartAllowed(epoch, startedAt, gen) {
        ModelLiveCleanup()
        return false
    }
    ; Только диагностика: ни одна рамка не передаётся в игровое управление.
    ; SHA выбранного файла проверяется отдельно в worker до загрузки ONNX.
    ; Отправка кадров начинается только после готовности дочернего процесса.
    cmd := '"' base '\python\pythonw.exe" "' dir '\live.py" "'
        . modelPath '" "' dir '" "' mapname '" ' size
    Run(cmd, A_ScriptDir, "Hide", &pid)
    MODEL_LIVE.pid := pid
    MODEL_LIVE.active := true, MODEL_LIVE.stopping := false
    Log("[i] Нейрозрение: " modelLabel ", только диагностика. Текущие кадры окна игры, не папка snapshots; кадры берутся из игрового цикла. Фигуры могут быть своим персонажем или союзником; управление не меняется. F7 проверяет стандартную модель.")
    return true
}

ModelLiveStop() {
    global MODEL_LIVE
    if !MODEL_LIVE.active || MODEL_LIVE.stopping
        return
    MODEL_LIVE.stopping := true, MODEL_LIVE.preview := 0
    MODEL_LIVE.stopTick := A_TickCount, MODEL_LIVE.stopWarned := false
    MODEL_LIVE.status := "останавливаю диагностику"
    try FileAppend("stop", MODEL_LIVE.dir "\stop.txt", "UTF-8-RAW")
}

ModelLiveCleanup() {
    global MODEL_LIVE
    if MODEL_LIVE.ptr
        DllCall("UnmapViewOfFile", "Ptr", MODEL_LIVE.ptr)
    if MODEL_LIVE.handle
        DllCall("CloseHandle", "Ptr", MODEL_LIVE.handle)
    MODEL_LIVE.ptr := 0, MODEL_LIVE.handle := 0
    dir := MODEL_LIVE.dir
    if (dir != "") {
        for name in ["live.py", "lease.txt", "request.txt", "request.tmp", "result.txt", "result.tmp"
            , "ready.txt", "ready.tmp", "error.txt", "error.tmp", "exit.txt", "exit.tmp", "stop.txt"]
            try FileDelete(dir "\" name)
        try DirDelete(dir)
    }
    MODEL_LIVE.dir := "", MODEL_LIVE.pid := 0, MODEL_LIVE.active := false
    MODEL_LIVE.stopping := false, MODEL_LIVE.issued := 0, MODEL_LIVE.preview := 0
}

ModelLiveTimer() {
    global ST, MODEL_LIVE, MODEL_CHECK
    prev := Critical("On")
    if MODEL_LIVE.busy {
        Critical(prev)
        return
    }
    MODEL_LIVE.busy := true
    timerGen := ST.startGeneration, timerEpoch := ST.inputEpoch, timerStartedAt := ST.startedAt
    Critical(prev)
    try {
        ModelLiveTick()
    } catch as e {
        LogThrottledKey("[model-live-error]", "[!] Нейрозрение: " e.Message " · управление не изменено.", 5000)
        ; Ошибка старого запуска или до паузы не выключает новую сессию.
        if (ST.startGeneration = timerGen && ST.inputEpoch = timerEpoch && ST.startedAt = timerStartedAt)
            MODEL_LIVE.disabledGen := timerGen
        if MODEL_LIVE.active
            ModelLiveStop()
        else
            ModelLiveCleanup()
        MODEL_LIVE.status := "ошибка диагностики; см. журнал"
    } finally {
        prev := Critical("On")
        MODEL_LIVE.busy := false
        Critical(prev)
    }
}

ModelLiveTick() {
    global ST, MODEL_LIVE, MODEL_CHECK
    ; Счётчики относятся к поколению запуска; Stop/Pause не возобновляются.
    static retryGen := -1, retryN := 0, statsGen := -1, statsAt := 0, statsN := 0
    static statsValid := 0, statsAge := 0, statsAgeMax := 0, statsBeforeSend := 0, statsAfterSend := 0, statsCompute := 0
    static statsYoung := 0, statsMoved := 0, statsYoungUnmoved := 0
    if MODEL_LIVE.active && !MODEL_LIVE.stopping {
        if (!ST.running || ST.paused || ST.mouseCalActive || ST.cancelHold
            || ST.inputEpoch != MODEL_LIVE.epoch || ST.startedAt != MODEL_LIVE.startedAt)
            ModelLiveStop()
    }
    if MODEL_LIVE.stopping {
        if (MODEL_LIVE.pid && ProcessExist(MODEL_LIVE.pid)) {
            if (!MODEL_LIVE.stopWarned && A_TickCount - MODEL_LIVE.stopTick > 7000) {
                MODEL_LIVE.stopWarned := true
                Log("[!] Нейрозрение: ожидаю завершения модели; управление не затронуто.")
            }
            return
        }
        ModelLiveCleanup()
        MODEL_LIVE.status := "остановлено"
        return
    }
    if !MODEL_LIVE.active {
        ; Снимок сессии и кадра одной операцией: запуск может быть прерван
        ; горячей клавишей до создания дочернего процесса или во время Run.
        prev := Critical("On")
        epoch := ST.inputEpoch, startedAt := ST.startedAt, gen := ST.startGeneration, shot := ST.lastShot
        allowed := ModelLiveStartAllowed(epoch, startedAt, gen) && MODEL_LIVE.disabledGen != gen
            && IsObject(shot) && shot.capturedAt >= startedAt && A_TickCount >= shot.capturedAt
            && A_TickCount - shot.capturedAt <= 1200 && A_TickCount >= MODEL_LIVE.nextAttempt
        Critical(prev)
        if !allowed
            return
        if ModelLiveStart(shot, epoch, startedAt, gen) {
            if !ModelLiveStartAllowed(epoch, startedAt, gen)
                ModelLiveStop()
        } else if ModelLiveStartAllowed(epoch, startedAt, gen)
            MODEL_LIVE.nextAttempt := A_TickCount + 2000
        return
    }
    dir := MODEL_LIVE.dir
    if (!MODEL_LIVE.pid || !ProcessExist(MODEL_LIVE.pid)) {
        reason := "unknown"
        try {
            p := dir "\exit.txt"
            if FileExist(p) && FileGetSize(p) <= 128 {
                candidate := Trim(FileRead(p, "UTF-8"), "`r`n `t")
                if RegExMatch(candidate, "^(lease_timeout|startup_[A-Za-z0-9_]+|runtime_[A-Za-z0-9_]+)$")
                    reason := candidate
            }
        }
        if (retryGen != ST.startGeneration)
            retryGen := ST.startGeneration, retryN := 0
        ModelLiveCleanup()
        ; Повреждённая модель/неверная установка требуют исправления, а не цикла
        ; перезапусков. Неизвестный выход и истечение heartbeat пробуем дважды.
        if (InStr(reason, "startup_") = 1 || retryN >= 2) {
            MODEL_LIVE.disabledGen := ST.startGeneration
            MODEL_LIVE.status := "модель остановлена; см. журнал"
            Log("[!] Нейрозрение: процесс завершился (" reason "); повторы исчерпаны или ошибка запуска. До нового старта не перезапускаю.")
        } else {
            retryN += 1
            delay := retryN * 3000
            MODEL_LIVE.nextAttempt := A_TickCount + delay
            MODEL_LIVE.status := "модель остановилась; ожидаю повтор " retryN "/2"
            seconds := delay // 1000
            Log("[!] Нейрозрение: процесс завершился (" reason "); повтор " retryN "/2 через " seconds " с, только диагностика.")
        }
        return
    }
    ; При новом размере не ждём старый результат до тайм-аута: буфер старой
    ; сессии больше не подходит. После завершения процесс запустится с новым.
    latest := ST.lastShot
    if (IsObject(latest) && latest.HasOwnProp("w") && latest.HasOwnProp("h")
        && latest.HasOwnProp("stride") && latest.HasOwnProp("capturedAt")
        && latest.capturedAt >= MODEL_LIVE.startedAt && A_TickCount >= latest.capturedAt
        && A_TickCount - latest.capturedAt <= 1200
        && (latest.w != MODEL_LIVE.w || latest.h != MODEL_LIVE.h || latest.stride != MODEL_LIVE.w*4)) {
        Log("[i] Нейрозрение: размер кадра изменился; останавливаю старый процесс и подготовлю новый.")
        ModelLiveStop()
        return
    }
    if (A_TickCount - MODEL_LIVE.lastBeat >= 1000) {
        FileAppend(".", dir "\lease.txt", "UTF-8-RAW")
        MODEL_LIVE.lastBeat := A_TickCount
    }
    if FileExist(dir "\error.txt")
        throw Error("ошибка обработки кадра")
    if !FileExist(dir "\ready.txt") {
        if (A_TickCount - MODEL_LIVE.startTick > 30000)
            throw Error("модель не подготовилась за 30 с")
        return
    }
    if MODEL_LIVE.issued {
        p := dir "\result.txt"
        if FileExist(p) {
            ; В Windows процесс может на мгновение заменять файл ответа.
            ; Не выключаем модель из-за временной ошибки чтения, но сохраняем
            ; общий тайм-аут и строгие проверки формата после успешного чтения.
            try
                resultSize := FileGetSize(p)
            catch {
                if (A_TickCount - MODEL_LIVE.issued.sent > 30000)
                    throw Error("модель не ответила за 30 с")
                return
            }
            if (resultSize > 8192)
                throw Error("слишком большой ответ модели")
            try
                data := FileRead(p, "UTF-8")
            catch {
                if (A_TickCount - MODEL_LIVE.issued.sent > 30000)
                    throw Error("модель не ответила за 30 с")
                return
            }
            lines := StrSplit(Trim(data, "`r`n"), "`n", "`r")
            hd := StrSplit(lines[1], ",")
            if (hd.Length != 10)
                throw Error("неверный заголовок модели")
            rid := Integer(hd[1])
            if (rid = MODEL_LIVE.issued.id) {
                if (Integer(hd[2]) != MODEL_LIVE.issued.capture || Integer(hd[3]) != MODEL_LIVE.issued.camera
                    || Integer(hd[4]) != MODEL_LIVE.issued.at || Integer(hd[5]) != MODEL_LIVE.w
                    || Integer(hd[6]) != MODEL_LIVE.h || Integer(hd[7]) != MODEL_LIVE.w*4
                    || Integer(hd[8]) != MODEL_LIVE.issued.epoch)
                    throw Error("неверное происхождение кадра")
                n := Integer(hd[10]), elapsed := Integer(hd[9])
                if (n < 0 || n > 32 || lines.Length != n+1 || elapsed < 0 || elapsed > 60000)
                    throw Error("неверный результат модели")
                best := 0, boxes := []
                Loop n {
                    box := StrSplit(lines[A_Index+1], ",")
                    if (box.Length != 5)
                        throw Error("неверная рамка")
                    x := Integer(box[1]), y := Integer(box[2]), bw := Integer(box[3]), bh := Integer(box[4]), conf := Float(box[5])
                    if (x < 0 || y < 0 || bw <= 0 || bh <= 0 || x+bw > MODEL_LIVE.w || y+bh > MODEL_LIVE.h || conf < 0 || conf > 1)
                        throw Error("рамка вне кадра")
                    best := Max(best, conf)
                    boxes.Push({x:x, y:y, w:bw, h:bh, conf:conf})
                }
                age := A_TickCount - MODEL_LIVE.issued.at
                moved := ST.cameraSeq != MODEL_LIVE.issued.camera
                ; Только визуализация: кадр и рамки из ОДНОГО запроса, никогда
                ; не переносим координаты на более новый кадр. Не управляет игрой.
                if (MODEL_LIVE.issued.HasOwnProp("snapshot") && age >= 0 && age <= 1200)
                    MODEL_LIVE.preview := {shot:MODEL_LIVE.issued.snapshot, boxes:boxes, at:MODEL_LIVE.issued.at}
                MODEL_LIVE.status := n " фигур · " elapsed " мс · кадр " age " мс"
                if moved
                    MODEL_LIVE.status .= " · камера изменена"
                ; Только валидированные ответы. Возраст отсчитывается от начала
                ; захвата; до отправки входят захват/ожидание тика/копирование,
                ; после отправки — IPC, обработка и ожидание приёма таймером.
                if (statsGen != ST.startGeneration) {
                    statsGen := ST.startGeneration, statsAt := A_TickCount, statsN := 0
                    statsValid := 0, statsAge := 0, statsAgeMax := 0
                    statsBeforeSend := 0, statsAfterSend := 0, statsCompute := 0
                    statsYoung := 0, statsMoved := 0, statsYoungUnmoved := 0
                }
                statsN += 1
                afterSend := A_TickCount - MODEL_LIVE.issued.sent
                beforeSend := MODEL_LIVE.issued.sent - MODEL_LIVE.issued.at
                if (age >= 0 && beforeSend >= 0 && afterSend >= 0) {
                    statsValid += 1, statsAge += age, statsAgeMax := Max(statsAgeMax, age)
                    statsBeforeSend += beforeSend, statsAfterSend += afterSend, statsCompute += elapsed
                    if (age <= 250)
                        statsYoung += 1
                    if moved
                        statsMoved += 1
                    else if (age <= 250)
                        statsYoungUnmoved += 1
                }
                spanMs := A_TickCount - statsAt
                if (spanMs >= 10000 && statsN > 1) {
                    modelHz := Round((statsN - 1) * 1000 / spanMs, 1)
                    summary := "[i] Нейрозрение: " (statsN - 1) " интервалов ответов за " Round(spanMs / 1000, 1)
                        . " с · около " modelHz " кадров/с модели"
                    if statsValid
                        summary .= " · средний возраст " Round(statsAge / statsValid) " мс, максимум " statsAgeMax
                            . " мс · до отправки " Round(statsBeforeSend / statsValid)
                            . " мс · ответ после отправки " Round(statsAfterSend / statsValid)
                            . " мс · вычисление " Round(statsCompute / statsValid) " мс"
                            . " · возраст ≤250 мс " statsYoung "/" statsValid
                            . " · поворот бота после кадра " statsMoved "/" statsValid
                            . " · ≤250 мс без поворота бота " statsYoungUnmoved "/" statsValid
                    Log(summary ". Только диагностика: ручной поворот не отслеживается; свежесть не доказывает врага. Вычисление входит в ответ после отправки.")
                    statsAt := A_TickCount, statsN := 1
                    statsValid := 0, statsAge := 0, statsAgeMax := 0
                    statsBeforeSend := 0, statsAfterSend := 0, statsCompute := 0
                    statsYoung := 0, statsMoved := 0, statsYoungUnmoved := 0
                }
                ; Только после проверки происхождения и рамок: одна запись сразу,
                ; затем не чаще раза в 15 с. Это не подтверждение врага или FPS.
                LogThrottledKey("[model-live-result-" MODEL_LIVE.startedAt "]"
                    , "[i] Нейрозрение: кадр обработан · фигур " n " · вычисление " elapsed
                    . " мс · возраст кадра " age " мс" . (moved ? " · камера изменилась" : "")
                    . " · только диагностика, управлению не передаю.", 15000)
                MODEL_LIVE.issued := 0
            } else if (rid > MODEL_LIVE.issued.id)
                throw Error("неизвестный номер ответа")
        }
        if MODEL_LIVE.issued {
            if (A_TickCount - MODEL_LIVE.issued.sent > 30000)
                throw Error("модель не ответила за 30 с")
            return
        }
    }
    shot := ST.lastShot
    if (!IsObject(shot) || shot.captureId = MODEL_LIVE.lastCapture || shot.capturedAt < ST.startedAt
        || A_TickCount - shot.capturedAt > 1200)
        return
    if (shot.w != MODEL_LIVE.w || shot.h != MODEL_LIVE.h || shot.stride != shot.w*4 || shot.buf.Size < MODEL_LIVE.size) {
        ModelLiveStop()
        return
    }
    if (!ST.running || ST.paused || ST.mouseCalActive || ST.inputEpoch != MODEL_LIVE.epoch)
        return
    DllCall("RtlMoveMemory", "Ptr", MODEL_LIVE.ptr, "Ptr", shot.buf.Ptr, "UPtr", MODEL_LIVE.size)
    if (!ST.running || ST.paused || ST.mouseCalActive || ST.inputEpoch != MODEL_LIVE.epoch)
        return
    id := MODEL_LIVE.request + 1
    payload := id "," shot.captureId "," shot.cameraSeqAtCapture "," shot.capturedAt "," shot.w "," shot.h "," shot.stride "," MODEL_LIVE.epoch "`n"
    tmp := dir "\request.tmp", final := dir "\request.txt"
    try {
        if FileExist(tmp)
            FileDelete(tmp)
        FileAppend(payload, tmp, "UTF-8-RAW")
        try FileMove(tmp, final, 1)
        catch as e
            throw e
    } catch {
        try FileDelete(tmp)
        return
    }
    MODEL_LIVE.request := id, MODEL_LIVE.lastCapture := shot.captureId
    ; Буфер кадра остаётся жить до ответа; метаданные копируем, не ссылаемся
    ; на перезаписываемый объект. Он НЕ используется для игрового управления.
    snapshot := {buf:shot.buf, w:shot.w, h:shot.h, stride:shot.stride
        , captureId:shot.captureId, capturedAt:shot.capturedAt}
    MODEL_LIVE.issued := {id:id, capture:shot.captureId, camera:shot.cameraSeqAtCapture
        , at:shot.capturedAt, epoch:MODEL_LIVE.epoch, sent:A_TickCount, snapshot:snapshot}
}

