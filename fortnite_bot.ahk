    promptScanMs:    250,       ; как часто искать подсказку «E ОБЫСКАТЬ»
    promptEcooldownMs: 1500,    ; чаще этого E по подсказке не жмём
    promptWindowMs: 15000,      ; ограничение повторов в скользящем окне
