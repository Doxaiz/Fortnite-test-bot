ResetRunDiagnostics() {
    global ST, LogThrMap
    ; Фокус измеряем внутри конкретного запуска, а не с момента старого
    ; Alt+Tab до Stop. Первый новый переход не подавляем старым троттлом.
    ST.focusLostAt := 0, ST.focusBackAt := 0, ST.focusNoteAt := 0, ST.bgWarned := false
    ST.playInputSuspended := false, ST.playFocused := -1
    ST.tickProfile := 0, ST.tickMs := 0, ST.lastTickMs := 0
    ST.slowTicks := 0, ST.fastTicks := 0
    for key in ["[focusgrace]", "[focus]", "[tickperf]", "[tickcancel:бюджет]", "[tickcancel:запрос сторожа]"] {
        if LogThrMap.Has(key)
            LogThrMap.Delete(key)
    }
}

ResetSceneEvidence() {
    global ST
    ST.sceneRaw := "", ST.sceneRawAt := 0
    ST.menuCache := 0, ST.scanMenuAt := 0
    ST.lastLobbyAt := 0, ST.playSeenAt := 0, ST.menuSeenAt := 0
    ST.inMatchT := 0, ST.hudLastT := 0, ST.hudWindow := 0
    ST.hudFound := 0, ST.hudFoundSeq := 0, ST.hudScore := 0, ST.hudWhy := ""
    ST.hudSlots := 0.0, ST.hudHp := 0
    ST.hpPercent := -1, ST.shPercent := -1
    ST.lastShot := 0, ST.lastShotAt := 0, ST.prevShot := 0
    ST.deadSince := 0, ST.hpPrev := -1
    ST.uiBoxCache := 0, ST.uiBoxSeq := 0
}

StartPermit(gen) {
    global ST
    return ST.startWorkers > 0 && ST.startGeneration = gen && !ST.stopWorkers && !ST.mouseCalActive
}

OnStart(expectedGen := 0, *) {
    global CFG, ST, UI, HUD
    ; Зарезервировать запуск атомарно: Stop должен видеть даже ещё не
    ; включивший running поток, а новый запуск не пересекаться со старым.
    prev := Critical("On")
    ; Автовозобновление не может отменить ручной стоп или чужой активный запуск.
    if (expectedGen && (expectedGen != ST.startGeneration || ST.running || ST.startWorkers > 0 || ST.mouseCalActive)) {
        Critical(prev)
        return
    }
    if ST.mouseCalActive {
        Critical(prev)
        OnStop()
        Flash("Тест мыши отменён; бот остановлен", 2500)
        return
    }
    if ST.running {
        Critical(prev)
        OnStop()
        Flash("СТОП — бот остановлен (F8 — снова запустить)", 2500)
        return
    }
    if ST.startWorkers > 0 {
        Critical(prev)
        OnStop()
        Flash("Незавершённый запуск отменён", 2500)
        return
    }
    if (ST.mouseCalWorkers > 0 || ST.stopWorkers > 0 || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0) {
        Critical(prev)
        Flash("Жду завершения старых действий; затем нажмите Старт", 3500)
        return
    }
    ST.startWorkers += 1, startGen := ST.startGeneration
    Critical(prev)
    try {
    Flash("Подготовка запуска · " CFG.hkStart " — стоп", 2000)
    if !StartPermit(startGen)
        return
    ApplyToggles()
    if !StartPermit(startGen)
