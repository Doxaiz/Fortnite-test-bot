; Эксперимент Raw Input: диагностический сигнал, не гарантия регистрации всей
; физической мыши в Fortnite. Никаких координат или ID устройств не сохраняем.
MouseCalRawParse(buf, ptrSize) {
    out := {ok:false, activity:false, reason:""}
    if (ptrSize != 4 && ptrSize != 8) {
        out.reason := "pointer size"
        return out
    }
    header := 8 + ptrSize * 2
    if (!IsObject(buf) || buf.Size < header + 24) {
        out.reason := "short"
        return out
    }
    kind := NumGet(buf, 0, "UInt"), size := NumGet(buf, 4, "UInt")
    if (kind != 0 || size < header + 24 || size > buf.Size) {
        out.reason := "type or length"
        return out
    }
    flags := NumGet(buf, header, "UShort")
    buttons := NumGet(buf, header + 4, "UShort")
    x := NumGet(buf, header + 12, "Int"), y := NumGet(buf, header + 16, "Int")
    out.ok := true
    out.activity := (flags & 1) || buttons || x || y ? true : false
    return out
}

; Only the last RAWINPUTDEVICE registration for mouse within this process wins.
; Read it before registering/removing, so unrelated registrations are not
; knowingly overwritten or unregistered.
MouseCalRawRegistration() {
    out := {ok:false, present:false, hwnd:0, reason:""}
    count := 0, recSize := 8 + A_PtrSize
    try {
        n := DllCall("user32\GetRegisteredRawInputDevices", "Ptr", 0, "UInt*", &count, "UInt", recSize, "Int")
        if (n = -1 || count > 128) {
            out.reason := "список Raw Input недоступен"
            return out
        }
        if !count {
            out.ok := true
            return out
        }
        records := Buffer(count * recSize, 0)
        n := DllCall("user32\GetRegisteredRawInputDevices", "Ptr", records, "UInt*", &count, "UInt", recSize, "Int")
        if (n = -1 || n > count || n * recSize > records.Size) {
            out.reason := "список Raw Input изменился"
            return out
        }
        loop n {
            off := (A_Index - 1) * recSize
            if (NumGet(records, off, "UShort") = 1 && NumGet(records, off + 2, "UShort") = 2) {
                out.present := true
                out.hwnd := NumGet(records, off + 8, "UPtr")
                break
            }
        }
        out.ok := true
    } catch as e {
        out.reason := e.Message
    }
    return out
}

MouseCalRawStart(expectedGen := 0) {
    global MC_RAW, ST
    if (MC_RAW.active || MC_RAW.registered)
        return {ok:false, reason:"уже включён"}
    sink := 0, subscribed := false, registered := false, owns := false, errorText := ""
    try sink := Gui("+ToolWindow -Caption", "FORMA raw test")
    catch as e
        return {ok:false, reason:e.Message}
    prev := Critical("On")
    try {
        ; Другой поток мог занять слушатель, пока создавалось скрытое окно.
        if (MC_RAW.active || MC_RAW.registered)
            throw Error("уже включён")
        ; F8 мог прервать поток ещё до установки обработчика.
        if (expectedGen && (!ST.mouseCalActive || expectedGen != ST.mouseCalGeneration || ST.mouseCalCancel))
            throw Error("тест отменён")
        status := MouseCalRawRegistration()
        if (!status.ok || status.present)
            throw Error(status.ok ? "мышь уже зарегистрирована этим процессом" : status.reason)
        hwnd := sink.Hwnd
        OnMessage(0xFF, MouseCalRawInput)
        subscribed := true
        rid := Buffer(8 + A_PtrSize, 0)
        NumPut("UShort", 1, "UShort", 2, "UInt", 0x100, "UPtr", hwnd, rid, 0)
        MC_RAW.active := true, MC_RAW.sink := sink, MC_RAW.hwnd := hwnd, owns := true
        MC_RAW.packets := 0, MC_RAW.activity := 0, MC_RAW.faults := 0, MC_RAW.lastAt := 0
        registered := DllCall("user32\RegisterRawInputDevices", "Ptr", rid, "UInt", 1, "UInt", rid.Size, "Int")
        if !registered
            throw Error("RegisterRawInputDevices: " A_LastError)
        MC_RAW.registered := true
    } catch as e {
        errorText := e.Message
        if owns
            MC_RAW.active := false, MC_RAW.registered := false, MC_RAW.sink := 0, MC_RAW.hwnd := 0
        if subscribed
            OnMessage(0xFF, MouseCalRawInput, 0)
    } finally {
        Critical(prev)
    }
    if (errorText != "") {
        try sink.Destroy()
        return {ok:false, reason:errorText}
    }
    return {ok:true, reason:"Raw Input зарегистрирован; доставка не подтверждена"}
}

MouseCalRawStop() {
    global MC_RAW
    prev := Critical("On")
    try {
        if !MC_RAW.registered
            return {ok:true, reason:"не включён"}
        MC_RAW.active := false
        status := MouseCalRawRegistration()
        removed := false
        if (status.ok && status.present && status.hwnd = MC_RAW.hwnd) {
            rid := Buffer(8 + A_PtrSize, 0)
            NumPut("UShort", 1, "UShort", 2, "UInt", 1, "UPtr", 0, rid, 0)
            removed := DllCall("user32\RegisterRawInputDevices", "Ptr", rid, "UInt", 1, "UInt", rid.Size, "Int")
        }
        OnMessage(0xFF, MouseCalRawInput, 0)
        oldSink := MC_RAW.sink
        MC_RAW.sink := 0, MC_RAW.hwnd := 0, MC_RAW.registered := false
    } finally {
        Critical(prev)
    }
    try oldSink.Destroy()
    return {ok:status.ok && (!status.present || removed), reason:"диагностика остановлена"}
}

MouseCalRawInput(wParam, lParam, msg, hwnd) {
    global MC_RAW
    if (!MC_RAW.active || hwnd != MC_RAW.hwnd)
        return
    previous := Critical("On")
    try {
        if (!MC_RAW.active || hwnd != MC_RAW.hwnd)
            return
        len := 0, header := 8 + A_PtrSize * 2
        ret := DllCall("user32\GetRawInputData", "Ptr", lParam, "UInt", 0x10000003
            , "Ptr", 0, "UInt*", &len, "UInt", header, "Int")
        if (ret != 0 || len < header + 24 || len > 1024) {
            MC_RAW.faults += 1
            return
        }
        data := Buffer(len, 0), readLen := len
        ret := DllCall("user32\GetRawInputData", "Ptr", lParam, "UInt", 0x10000003
            , "Ptr", data, "UInt*", &readLen, "UInt", header, "Int")
        if (ret != len || readLen != len) {
            MC_RAW.faults += 1
            return
        }
        event := MouseCalRawParse(data, A_PtrSize)
        if !event.ok {
            MC_RAW.faults += 1
            return
        }
        MC_RAW.packets += 1
        if event.activity
            MC_RAW.activity += 1, MC_RAW.lastAt := A_TickCount
    } catch {
        MC_RAW.faults += 1
    } finally {
        Critical(previous)
    }
    ; Empty return leaves WM_INPUT to the default window procedure.
}

; Начальный этап калибровки: проверка пригодности одного кадра, БЕЗ замера
; коэффициентов и управления игрой. Ожидает выхода тиков, при необходимости
; ставит работающего бота на паузу и бережно продолжает после теста.
OnMouseCalPrepare(*) {
    global ST
    hwnd := GetGameWindow()
    if !hwnd {
        Flash("Мышь: окно Fortnite не найдено", 3500)
        Log("[!] Мышь: окно Fortnite не найдено; тест не выполнялся.")
        return false
    }
    prev := Critical("On")
    if (ST.mouseCalActive || ST.mouseCalWorkers > 0 || ST.stopWorkers > 0 || ST.startWorkers > 0) {
        Critical(prev)
        Flash("Запуск, остановка или тест мыши ещё завершаются", 3000)
        return false
    }
    failed := ""
    try {
        ST.mouseCalGeneration += 1
        gen := ST.mouseCalGeneration
        ST.mouseCalActive := true, ST.mouseCalPhase := "drain"
        ST.mouseCalOriginalRunning := ST.running
        ST.mouseCalResumePaused := ST.paused
        ST.mouseCalCancel := false, ST.mouseCalReleased := false
        ST.mouseCalFocusNote := false, ST.mouseCalWaitNote := false, ST.mouseCalStart := A_TickCount
        ST.mouseCalHwnd := hwnd
        ST.inputEpoch += 1
        if ST.running
            ST.paused := true
        ST.tickAbort := true
        StopTickSlots()
        SetTimer(MouseCalPreparePoll.Bind(gen), -20)
    } catch as e {
        ; Не возобновлять автоматически, если не удалось создать задачу.
        failed := e.Message
        ST.mouseCalActive := false, ST.mouseCalGeneration += 1
        ST.running := false, ST.paused := false, ST.tickAbort := true
        ST.inputEpoch += 1
    } finally {
        Critical(prev)
    }
    if (failed != "") {
        try ReleaseKeysSafe()
        Log("[!] Мышь: не удалось начать тест; бот остановлен: " failed)
        return false
    }
    Log("[i] Мышь: приостанавливаю цикл для проверки кадра; настройки не изменятся.")
    return true
}

MouseCalPreparePoll(gen) {
    global CFG, ST, MC_RAW
    prev := Critical("On")
    if (!ST.mouseCalActive || gen != ST.mouseCalGeneration) {
        Critical(prev)
        return
    }
    ST.mouseCalWorkers += 1
    Critical(prev)
    try {
        if (ST.mouseCalPhase = "drain") {
            if !ST.mouseCalReleased {
                ReleaseKeysSafe()
                if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                    return
                ST.mouseCalReleased := true
            }
            busy := false
            prev := Critical("On")
            try {
                if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                    return
                if (ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0)
                    busy := true
                else {
                    ; Ticks cannot enter while active. Invalidate callbacks
                    ; scheduled by old ticks after the initial epoch change.
                    ST.inputEpoch += 1
                    ST.tickBusy := false
                    ST.mouseCalPhase := "final_release"
                }
            } finally {
                Critical(prev)
            }
            if busy {
                if (!ST.mouseCalWaitNote && A_TickCount - ST.mouseCalStart > 3000) {
                    ST.mouseCalWaitNote := true
                    Log("[!] Мышь: жду завершения тика или старого ввода. F8 — стоп.")
                }
                SetTimer(MouseCalPreparePoll.Bind(gen), -100)
                return
            }
        }
        if (ST.mouseCalPhase = "final_release") {
            ; Old tick could have completed an input after the first release.
            ReleaseKeysSafe()
            prev := Critical("On")
            try {
                if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                    return
                if (ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0) {
                    ST.mouseCalPhase := "drain"
                    SetTimer(MouseCalPreparePoll.Bind(gen), -100)
                    return
                }
                ST.mouseCalPhase := ST.mouseCalCancel ? "resume" : "capture"
            } finally {
                Critical(prev)
            }
        }
        if (ST.mouseCalPhase = "capture") {
            ; Короткий диагностический слушатель не вводит мышь/клавиатуру и
            ; НЕ гарантирует получение каждого движения в Fortnite. Если он
            ; недоступен, пассивная проверка кадра всё равно может продолжиться.
            try rawStart := MouseCalRawStart(gen)
            catch as e
                rawStart := {ok:false, reason:e.Message}
            rawDone := 0
            try {
                if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                    return
                ; Отмена кнопкой «Пауза» не должна выводить из worker до фазы resume:
                ; иначе активный тест остаётся без запланированного таймера.
                if !ST.mouseCalCancel {
                    shot := CaptureClient(ST.mouseCalHwnd)
                    if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                        return
                    if (!ST.mouseCalCancel && shot) {
                        features := MouseCalSceneFeatures(shot)
                        if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                            return
                        if !ST.mouseCalCancel {
                            coverage := MouseCalFeatureReadiness(features)
                            Log("[i] Мышь: кандидатов " features.points.Length " · " features.elapsedMs
                                . " мс; " features.reason " · " coverage.reason
                                . ". Это только тест, не калибровка.")
                        }
                    } else if !ST.mouseCalCancel
                        Log("[!] Мышь: кадр недоступен; настройки не менялись.")
                }
            } catch as e {
                Log("[!] Мышь: тест кадра не удался: " e.Message)
            } finally {
                if rawStart.ok
                    rawDone := MouseCalRawStop()
            }
            if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                return
            if rawStart.ok {
                Log("[i] Raw Input: событий " MC_RAW.packets " · активность " MC_RAW.activity
                    . " · ошибок " MC_RAW.faults " · " (rawDone.ok ? "снят" : "ошибка снятия")
                    . ". Ноль не доказывает отсутствие ручной мыши; Fortnite не проверен.")
            } else
                Log("[i] Raw Input: диагностика недоступна (" rawStart.reason "); параметры не менялись.")
            ST.mouseCalPhase := "resume"
        }
        if (ST.mouseCalPhase = "resume") {
            if (ST.mouseCalOriginalRunning && !ST.mouseCalResumePaused
                && !WinActive("ahk_id " ST.mouseCalHwnd)) {
                if !ST.mouseCalFocusNote {
                    ST.mouseCalFocusNote := true
                    Log("[i] Мышь: жду возврата фокуса в Fortnite для продолжения. F8 — стоп.")
                }
                SetTimer(MouseCalPreparePoll.Bind(gen), -250)
                return
            }
            prev := Critical("On")
            try {
                if (!ST.mouseCalActive || gen != ST.mouseCalGeneration)
                    return
                if ST.mouseCalOriginalRunning {
                    ST.lastTickAt := A_TickCount
                    ST.tickSlot := 1
                    SetTimer(TickSlot1, CFG.loopMs)
                    ST.paused := ST.mouseCalResumePaused
                    ST.tickAbort := false
                }
                ST.mouseCalActive := false, ST.mouseCalPhase := "idle"
            } finally {
                Critical(prev)
            }
            Log("[i] Мышь: тест завершён; чувствительность не измерена и не сохранена.")
        }
    } catch as e {
        ; Ошибка контроллера не должна молча возобновлять бота.
        prev := Critical("On")
        stillOurs := ST.mouseCalActive && gen = ST.mouseCalGeneration
        if stillOurs {
            ST.mouseCalActive := false, ST.mouseCalGeneration += 1
            ST.running := false, ST.paused := false, ST.tickAbort := true
            ST.inputEpoch += 1
        }
        Critical(prev)
        if stillOurs {
            try ReleaseKeysSafe()
            Log("[!] Мышь: тест прерван ошибкой; бот остановлен: " e.Message)
        }
    } finally {
        prev := Critical("On")
        ST.mouseCalWorkers -= 1
        Critical(prev)
    }
}

; ------------------------------ диагностика -------------------------------
; F7: пара кадров только из одной непрерывной остановленной сессии.
; Ни эта проверка, ни совпадение HWND/ID не подтверждают ручную неподвижность
; или отсутствие повторно выданного источником старого изображения.
MouseCalF7Pair(hwnd, shot, guard) {
    out := {ok:false, x:0, y:0, votes:0, elapsedMs:0, reason:"состояние изменилось или бот занят"}
    if (!guard || MouseCalProbeStop(A_TickCount + 1000, guard))
        return out
    Sleep(120)
    if (MouseCalProbeStop(A_TickCount + 1000, guard) || GetGameWindow() != hwnd)
        return out
    nextShot := CaptureClient(hwnd)
    if (MouseCalProbeStop(A_TickCount + 1000, guard) || GetGameWindow() != hwnd)
        return out
    if (!shot || !nextShot || shot.captureId = nextShot.captureId
        || shot.capturedAt >= nextShot.capturedAt
        || shot.cameraSeqAtCapture != guard.camera || nextShot.cameraSeqAtCapture != guard.camera) {
        out.reason := "нет двух последовательных кадров той же камеры"
        return out
    }
    out := MouseCalCompareFrames(shot, nextShot, 2500, guard)
    if (MouseCalProbeStop(A_TickCount + 1000, guard) || GetGameWindow() != hwnd)
        return {ok:false, x:0, y:0, votes:0, elapsedMs:out.elapsedMs
            , reason:"результат отброшен: состояние или окно изменилось"}
    return out
}

OnCheckCapture(*) {
    ; ВАЖНО (v7.1): здесь БОЛЬШЕ НЕТ ActivateGame. Именно из-за него проверка
    ; захвата разворачивала свёрнутую игру и поднимала её поверх всех окон —
    ; в run-18.log видно: «свёрнуто → активация: удалась → после: у игры».
    ; Диагностике фокус не нужен: кадр берётся у самого окна (PrintWindow).

    ; F7 — «почему бот стоит». Раньше проверял только захват. Теперь печатает
    ; всё, что нужно, чтобы понять причину: какие окна нашлись, какое активно,
    ; удаётся ли вернуть фокус, что видит бот и какие галочки включены.
    global CFG, ST
    Log("── диагностика окна и ввода (FORMA v10.0) ──")
    ; Пассивная проверка кандидата для будущей калибровки. Само значение не
    ; доказывает, что Fortnite и все устройства доступны hook; на управление
    ; и сохранение коэффициентов оно пока не влияет.
    try {
        InstallMouseHook()
        Log("  диагностика A_TimeIdleMouse: " A_TimeIdleMouse " мс"
            . " · запрос установки mouse hook; физический ввод в игре не проверен")
    } catch as e {
        Log("  [!] диагностика mouse hook недоступна: " e.Message)
    }
    list := ""
    try
        list := WinGetList(CFG.winTitle)
    catch {
    }
    nAll := IsObject(list) ? list.Length : 0
    Log("  окон класса «" CFG.winTitle "»: " nAll
        . " (из них игра: " GameWindowCount() ", остальное — своё меню)")
    if IsObject(list) {
        i := 0
        for h in list {
            i += 1
            if (i > 6)
                break
            t := ""
            try
                t := WinGetTitle("ahk_id " h)
            act := WinActive("ahk_id " h) ? "  ← АКТИВНО" : ""
            mini := ""
            try {
                mm := WinGetMinMax("ahk_id " h)
                mini := (mm = -1) ? "  свёрнуто" : ((mm = 1) ? "  развёрнуто" : "")
            }
            Log("     · ahk_id " h " «" t "»" mini act
                . (IsSelfWindow(h) ? "  [это своё меню — не игра]" : ""))
        }
    }
    actNow := 0
    try
        actNow := WinActive("A")
    actTitle := ""
    try
        actTitle := WinGetTitle("ahk_id " actNow)
    Log("  активное окно сейчас: «" actTitle "» (ahk_id " actNow ")")

    hwnd := GetGameWindow()
    if !hwnd {
        Log("  [!] окно игры не найдено — запустите Fortnite (и «Оконный без рамки»)")
        Flash("Окно игры не найдено", 4000)
        return
    }
    ; --- ФОКУС НЕ ЗАБИРАЕМ (это и был баг: игра поднималась поверх всех) ---
    wasActive := WinActive("ahk_id " hwnd) ? true : false
    iconic := false
    try
        iconic := (WinGetMinMax("ahk_id " hwnd) = -1)
    Log("  фокус у игры: " (wasActive ? "да" : "нет")
        . " · окно игры: " (iconic ? "СВЁРНУТО (в панели задач)" : "развёрнуто/обычное")
        . " · окно игры не трогаю: кадр беру у окна, фокус остаётся у вас")
    if iconic
        Log("  [!] игры не видно, потому что она свёрнута. Кадр со свёрнутого окна"
            . " снять нельзя — ни ботом, ни скриншотом. Разверните Fortnite"
            . " (необязательно делать активным: достаточно, чтобы окно было на экране).")

    ; Зафиксировать состояние ДО первого кадра: старт/стоп между кадрами
    ; не должен казаться непрерывным покоем только потому, что running снова false.
    calGuard := MouseCalF7Guard()
    shot := CaptureClient(hwnd)
    if !shot {
        if iconic
            Log("  [!] захват не удался — причина выше: окно свёрнуто")
        else
            Log("  [!] захват не удался — окно не отдало кадр (PrintWindow и экран пусты)."
                . " Попробуйте нажать «Проверить захват» ещё раз или сменить"
                . " «Оконный без рамки».")
        Flash(iconic ? "Игра свёрнута — разверните окно" : "Захват не удался", 4000)
        return
    }
    step := 24, total := 0, nonBlack := 0
    y := 0
    while (y < shot.h) {
        x := 0
        while (x < shot.w) {
            o := y * shot.stride + x * 4
            if (NumGet(shot.buf, o, "UChar") + NumGet(shot.buf, o + 1, "UChar") + NumGet(shot.buf, o + 2, "UChar") > 8)
                nonBlack += 1
            total += 1
            x += step
        }
        y += step
    }
    pct := total ? Round(nonBlack / total * 100, 1) : 0
    dens := Round(EdgeDensity(shot), 3)
    slots := Round(BrightRatio(shot, CFG.regSlots, 170), 3)
    Log("  кадр " shot.w "x" shot.h " @ экран (" shot.x ", " shot.y ") · непустых " pct "% · края " dens " · слоты " slots)
    Log("  масштабированные точки (" shot.w "x" shot.h "): Играть("
        . Round(CFG.playNormX * shot.w) "," Round(CFG.playNormY * shot.h) ") · Параметры("
        . Round(CFG.optNormX * shot.w) "," Round(CFG.optNormY * shot.h) ") · В лобби("
        . Round(CFG.leaveNormX * shot.w) "," Round(CFG.leaveNormY * shot.h) ")")
    ; Только F7: поиск ещё НЕ запускает поворот и не сохраняет настройки.
    try {
        calScene := MouseCalSceneFeatures(shot)
        coverage := MouseCalFeatureReadiness(calScene)
        Log("  подготовка калибровки мыши: кандидатов " calScene.points.Length
            . " · " calScene.elapsedMs " мс · " calScene.reason
            . " · " coverage.reason . (calScene.complete ? "" : " (результат неполный)"))
    } catch as e {
        Log("  [!] подготовка калибровки мыши: анализ не удался: " e.Message)
    }
    ; Сравнение двух кадров пассивное. Guard привязывает его к непрерывной
    ; остановленной сессии, включая время первого захвата и анализа.
    try {
        calPair := MouseCalF7Pair(hwnd, shot, calGuard)
        if calPair.ok
