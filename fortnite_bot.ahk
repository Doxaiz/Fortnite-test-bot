    aimStepPx:       34,        ; максимум сдвига ЗА МИКРОШАГ (рывков по-прежнему нет)
    aimFlickPx:      120,       ; ошибка больше этого = «доводка» одной серией
    aimReactMs:      170,       ; человеческая задержка: увидел -> начал вести
    aimLeadMs:       90,        ; на сколько мс вперёд предсказываем движение цели
    reloadEvery:     6,         ; жать R не после каждой очереди, а раз в N очередей
    aimIntervalMs:   28,        ; v7.2: 55 мс -> 28 мс (ведём цель, а не «дёргаем»)
    enemyFastMs:     55,        ; быстрый скан центральной полосы (реакция на врага)
    enemyFastFrac:   0.68,      ; v7.5: 0.55 -> 0.68 — враг у края кадра тоже виден
    enemyHoldMs:     700,       ; v7.5: 450 -> 700. Цель не «мигает» между кадрами
    aimLogMs:        2500,      ; как часто писать «вижу врага / стреляю»
    combatOverLoot:  true,      ; v7.5: при подтверждённом враге НЕ отвлекаемся на
                                ; сундук/лут — раньше сбор перебивал наведение

    ; ---- эпизоды матча: автобус -> глайдер -> посадка -> лут ----
    featBusJump:   true,        ; прыгать из автобуса самому (Пробел)
