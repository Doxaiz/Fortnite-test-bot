    ResetRunDiagnostics()
    ResetSceneEvidence()
    ResetNavigation()
    ResetCaches()
    ST.frames := 0
    ST.rounds := 0, ST.roundCounted := false
    ST.tokensFound := 0, ST.tokenFoundMatch := false, ST.tokenStopArmed := false
    ST.finishMatchArmed := false, ST.finishMatchReason := ""
