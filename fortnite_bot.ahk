}

; Активное время текущей сессии (паузы не накручивают счётчик).
SessionElapsedSec() {
    global ST
    add := (ST.running && !ST.paused && ST.activeRunTick > 0)
        ? Max(0, (A_TickCount - ST.activeRunTick) // 1000) : 0
    return ST.sessionActiveSec + add
}

CommitRunElapsed() {
    global CFG, ST
    if (ST.activeRunTick > 0) {
        delta := Max(0, (A_TickCount - ST.activeRunTick) // 1000)
        ST.sessionActiveSec += delta
        CFG.totalRuntimeSec += delta
        ST.activeRunTick := (ST.running && !ST.paused) ? A_TickCount : 0
    }
}

PersistStats(force := false) {
    global CFG, ST
    now := A_TickCount
    if (!force && ST.lastStatsSaveAt && now - ST.lastStatsSaveAt < 15000)
        return
    ST.lastStatsSaveAt := now
    CommitRunElapsed()
    ini := IniPath()
    try {
        IniWrite(CFG.totalRounds, ini, "stats", "totalRounds")
        IniWrite(CFG.totalRuntimeSec, ini, "stats", "totalRuntimeSec")
        IniWrite(CFG.totalTokens, ini, "stats", "totalTokens")
        IniWrite(CFG.totalChests, ini, "stats", "totalChests")
    }
}

