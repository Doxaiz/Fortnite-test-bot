SyncExtraFields() {
    global CFG, ST, UI
    if !UI.extGui
        return
    try {
        xa := CFG.xpAction
        UI.ddXpAct.Value := (xa = "click") ? 2 : ((xa = "hold_lmb") ? 3
            : ((xa = "interact") ? 4 : ((xa = "nudge_only") ? 5 : 1)))
        UI.edXpActSec.Value := CFG.xpActionSec
        UI.edXpNudgeSec.Value := CFG.xpNudgeSec
        UI.edXpNudgePx.Value := CFG.xpNudgePx
        UI.edCoinMin.Value := CFG.coinRemindMin
        cnt := ST.macroEvents.Length
        UI.txtMacroInfo.Value := (cnt > 0)
            ? ("Файл macro.txt: загружено " cnt " шагов (WASD/Space/Shift/Ctrl/E/Q/R/1..5 + мышь)")
            : "Файл macro.txt: не записан (Esc/Alt/F-клавиши никогда не пишутся)"
        UI.cbMacroQueue.Value := CFG.macroInQueue ? 1 : 0
        UI.edWebhook.Value := CFG.webhookUrl
        UI.cbWhTok.Value := CFG.webhookToken ? 1 : 0
        UI.cbWhStop.Value := CFG.webhookStop ? 1 : 0
        UI.cbWhRound.Value := CFG.webhookRound ? 1 : 0
        UI.cbWhSave.Value := CFG.webhookSave ? 1 : 0
    }
