; ============================================================================
;     v10.0: DISCORD / HTTPS WEBHOOK (ЧИСТЫЙ WinHTTP COM, БЕЗ ЗАВИСИМОСТЕЙ)
; ============================================================================
; Экранирование строки для JSON (RFC 8259) с лимитом длины Discord (2000 симв.).
JsonEscape(text, maxLen := 1850) {
    s := String(text)
    if (maxLen > 0 && StrLen(s) > maxLen)
        s := SubStr(s, 1, maxLen - 1) "…"
    out := ""
    Loop Parse, s {
        ch := A_LoopField
        code := Ord(ch)
        if (ch = "\")
            out .= "\\"
        else if (ch = '"')
            out .= '\"'
        else if (code = 10)
            out .= "\n"
        else if (code = 13)
            out .= "\r"
        else if (code = 9)
            out .= "\t"
        else if (code = 8)
            out .= "\b"
        else if (code = 12)
            out .= "\f"
        else if (code < 32)
            out .= Format("\u{:04x}", code)
        else
            out .= ch
    }
    return out
}

; Строгая проверка URL вебхука: только публичный HTTPS, без локальных адресов и пробелов.
; Сам URL никогда не пишется в run.log, чтобы токен канала не утёк при отправке лога.
ValidateWebhookUrl(rawUrl) {
    u := Trim(String(rawUrl))
    if (u = "" || StrLen(u) > 512)
        return false
    if RegExMatch(u, "[\s`"<>\\]")
        return false
    m := 0
    if !RegExMatch(u, "i)^https://([a-z0-9.-]+)(?::\d+)?/.+$", &m)
        return false
    host := StrLower(m[1])
    if (host = "localhost" || SubStr(host, -6) = ".local" || SubStr(host, 1, 1) = "." || SubStr(host, -1) = ".")
        return false
    if RegExMatch(host, "^(0\.|10\.|127\.|169\.254\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.)")
        return false
    if !RegExMatch(host, "\.[a-z]{2,}$")
        return false
    return true
}

SendWebhookAsync(content, tag := "событие", urgent := false) {
    global CFG, ST
    url := Trim(CFG.webhookUrl)
    if (url = "")
        return false
    if !ValidateWebhookUrl(url) {
        ST.webhookStatus := "некорректный HTTPS URL"
        LogThrottledKey("[whbad]", "[!] Webhook: укажите корректный публичный адрес https://...", 15000)
        return false
    }
    now := A_TickCount
    if (!urgent && ST.webhookLastAt && now - ST.webhookLastAt < 2500)
        return false
    ST.webhookLastAt := now
    body := '{"username":"' FormaTitle() '","content":"' JsonEscape(content) '"}'
    SetTimer(WebhookWorker.Bind(url, body, tag), -25)
    return true
}

WebhookWorker(url, body, tag) {
    global ST, UI
    ok := false, code := 0, errTxt := ""
    try {
        whr := ComObject("WinHttp.WinHttpRequest.5.1")
        whr.SetTimeouts(2500, 3000, 3000, 3500)
        whr.Open("POST", url, true)
        whr.SetRequestHeader("Content-Type", "application/json; charset=utf-8")
        whr.SetRequestHeader("User-Agent", "FORMA-AHK/10.0")
        whr.Send(body)
        if whr.WaitForResponse(4) {
            code := whr.Status
            ok := (code >= 200 && code < 300)
        } else {
            try whr.Abort()
            errTxt := "таймаут"
        }
    } catch as e {
        errTxt := SubStr(e.Message, 1, 60)
    }
    if ok {
        ST.webhookSent += 1
        ST.webhookStatus := "ОК (" tag ", HTTP " code ")"
        Log("[+] Webhook отправлен: " tag " (HTTP " code ")")
    } else {
        why := (errTxt != "") ? errTxt : ("HTTP " code)
        ST.webhookStatus := "ошибка (" why ")"
        Log("[!] Webhook не доставлен (" tag "): " why)
    }
    try {
        if UI.extGui
            UI.extResult.Value := "Webhook: " ST.webhookStatus
    } catch {
    }
}

SendTokenWebhook(detail) {
    global CFG, ST
    if !CFG.webhookToken
        return
    msg := "@here 🏆 **" FormaTitle() " — ЖЕТОН / РЕДКАЯ НАХОДКА!**`n"
        . "• Детали: " detail "`n"
        . "• Время: " FormatTime(, "yyyy-MM-dd HH:mm:ss") "`n"
        . "• Сессия: раунд #" ST.rounds " · время " FmtClock(SessionElapsedSec())
        . " · жетонов " ST.tokensFound " (всего " CFG.totalTokens ")"
    SendWebhookAsync(msg, "жетон", true)
}

SendRoundWebhook(reason := "") {
    global CFG, ST
    runSec := SessionElapsedSec()
    rph := CalcRatePerHour(ST.rounds, runSec)
    msg := "✅ **" FormaTitle() " — раунд #" ST.rounds " завершён**"
        . (reason != "" ? " (" reason ")" : "")
        . " · время " FmtClock(runSec)
        . (rph > 0 ? " · темп " rph "/ч" : "")
        . " · всего раундов " CFG.totalRounds
        . " · [E] " CFG.totalChests " (шанс " FmtOdds(CFG.totalChests, CFG.treasureHour) ")"
    SendWebhookAsync(msg, "раунд #" ST.rounds, false)
}

SendSessionWebhook(whyStr := "") {
    global CFG, ST
    if !CFG.webhookStop
        return
    runSec := ST.sessionActiveSec
    rph := CalcRatePerHour(ST.rounds, runSec)
    msg := "📊 **" FormaTitle() " — сессия завершена**" whyStr "`n"
        . "• Режим: " ModeShortRu(CFG.botMode)
        . " · Время: " FmtClock(runSec)
        . " · Раундов: " ST.rounds (rph > 0 ? " (" rph "/ч)" : "")
        . " · Всего: " CFG.totalRounds "`n"
        . "• Жетонов: " ST.tokensFound " (всего " CFG.totalTokens ")"
        . " · [E]: " ST.promptN " (всего " CFG.totalChests
        . ", кумул. шанс " FmtOdds(CFG.totalChests, CFG.treasureHour) ")"
        . (ST.squadLeaves ? "`n• Выходов без отряда: " ST.squadLeaves : "")
        . (ST.rebootCount ? " · Возрождений: " ST.rebootCount : "")
    SendWebhookAsync(msg, "итог сессии", true)
}

