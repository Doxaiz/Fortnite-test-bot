    ST.squadStatus := CFG.squadAutoLeave ? "активен" : "выкл"
    ST.spectateSquadAt := 0, ST.spectateAlive := 0, ST.wasDeadScene := false, ST.rebootCount := 0
    ST.surveySkips := 0, ST.lastSurveyAt := 0, ST.mmRecoveries := 0, ST.lastMmRecoverAt := 0
