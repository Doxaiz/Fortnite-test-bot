        IniWrite(CFG.webhookSave ? 1 : 0, ini, "webhook", "saveUrl")
        IniWrite(CFG.webhookSave ? CFG.webhookUrl : "", ini, "webhook", "url")
        IniWrite(CFG.webhookToken ? 1 : 0, ini, "webhook", "onToken")
        IniWrite(CFG.webhookStop ? 1 : 0, ini, "webhook", "onStop")
        IniWrite(CFG.webhookRound ? 1 : 0, ini, "webhook", "onRound")
        ; Нормированные координаты кнопок (масштабируются под любое разрешение)
        IniWrite(CFG.playNormX, ini, "coords", "playNormX")
        IniWrite(CFG.playNormY, ini, "coords", "playNormY")
        IniWrite(CFG.optNormX, ini, "coords", "optNormX")
        IniWrite(CFG.optNormY, ini, "coords", "optNormY")
        IniWrite(CFG.leaveNormX, ini, "coords", "leaveNormX")
        IniWrite(CFG.leaveNormY, ini, "coords", "leaveNormY")
        IniWrite(CFG.coordRefW, ini, "coords", "coordRefW")
        IniWrite(CFG.coordRefH, ini, "coords", "coordRefH")
        ; Функции авто-игры
        IniWrite(CFG.featPlayAgain ? 1 : 0, ini, "feat", "playAgain")
        IniWrite(CFG.featAutoQueue ? 1 : 0, ini, "feat", "autoQueue")
        IniWrite(CFG.featMove ? 1 : 0, ini, "feat", "move")
        IniWrite(CFG.featParkour ? 1 : 0, ini, "feat", "parkour")
        IniWrite(CFG.sprint ? 1 : 0, ini, "feat", "sprint")
        IniWrite(CFG.featCrouchFight ? 1 : 0, ini, "feat", "crouchFight")
        IniWrite(CFG.featAds ? 1 : 0, ini, "feat", "ads")
        IniWrite(CFG.featChest ? 1 : 0, ini, "feat", "chest")
        IniWrite(CFG.featLoot ? 1 : 0, ini, "feat", "loot")
        IniWrite(CFG.featHeal ? 1 : 0, ini, "feat", "heal")
        IniWrite(CFG.featCombat ? 1 : 0, ini, "feat", "combat")
        IniWrite(CFG.featSound ? 1 : 0, ini, "feat", "sound")
        IniWrite(CFG.featReward ? 1 : 0, ini, "feat", "reward")
        IniWrite(CFG.featToken ? 1 : 0, ini, "feat", "token")
        IniWrite(CFG.featHarvest ? 1 : 0, ini, "feat", "harvest")
        IniWrite(CFG.featFirstSlot ? 1 : 0, ini, "feat", "firstSlot")
        IniWrite(CFG.featReload ? 1 : 0, ini, "feat", "reload")
        IniWrite(CFG.featBusJump ? 1 : 0, ini, "feat", "busJump")
        IniWrite(CFG.featWeaponPick ? 1 : 0, ini, "feat", "weaponPick")
        IniWrite(CFG.featFightBack ? 1 : 0, ini, "feat", "fightBack")
        ; Накопительная статистика
        IniWrite(CFG.totalRounds, ini, "stats", "totalRounds")
        IniWrite(CFG.totalRuntimeSec, ini, "stats", "totalRuntimeSec")
        IniWrite(CFG.totalTokens, ini, "stats", "totalTokens")
        IniWrite(CFG.totalChests, ini, "stats", "totalChests")
        return true
    } catch as e {
        Log("[!] не смог сохранить настройки: " e.Message)
        return false
    }
}

LoadSettings() {
    global CFG
    ini := IniPath()
    if !FileExist(ini)
        return
    try {
        CFG.hkStart    := IniRead(ini, "keys", "start", CFG.hkStart)
        CFG.hkDry      := IniRead(ini, "keys", "dry", CFG.hkDry)
        CFG.hkBypass   := IniRead(ini, "keys", "bypass", CFG.hkBypass)
        CFG.hkHud      := IniRead(ini, "keys", "hud", CFG.hkHud)
        CFG.hkVision   := IniRead(ini, "keys", "vision", CFG.hkVision)
        CFG.hkCal      := IniRead(ini, "keys", "cal", CFG.hkCal)
        CFG.hkMouseCal := IniRead(ini, "keys", "mouseCal", CFG.hkMouseCal)
        CFG.hkCheck    := IniRead(ini, "keys", "check", CFG.hkCheck)
        CFG.hkMenu     := IniRead(ini, "keys", "menu", CFG.hkMenu)
        CFG.buildWall  := IniRead(ini, "keys", "cover", CFG.buildWall)

        bm := IniRead(ini, "mode", "botMode", CFG.botMode)
        CFG.botMode := (bm = "queue" || bm = "antiafk" || bm = "xp") ? bm : "auto"
        pf := IniRead(ini, "mode", "perfProfile", CFG.perfProfile)
        CFG.perfProfile := (pf = "balanced" || pf = "low_cpu") ? pf : "fast"
        CFG.cloudGaming := IniRead(ini, "mode", "cloudGaming", CFG.cloudGaming ? 1 : 0) = 1
        CFG.zeroBuild := IniRead(ini, "mode", "zeroBuild", CFG.zeroBuild ? 1 : 0) = 1
        CFG.teamSafe := IniRead(ini, "mode", "teamSafe", CFG.teamSafe ? 1 : 0) = 1
        CFG.dryRun := IniRead(ini, "mode", "dryRun", CFG.dryRun ? 1 : 0) = 1
        CFG.bgMode := IniRead(ini, "mode", "bg", CFG.bgMode ? 1 : 0) = 1
        CFG.smartRestore := IniRead(ini, "mode", "smartRestore", CFG.smartRestore ? 1 : 0) = 1
        CFG.squadAutoLeave := IniRead(ini, "mode", "squadAutoLeave", CFG.squadAutoLeave ? 1 : 0) = 1

        CFG.matchMaxMin := ParseNumSafe(IniRead(ini, "afk", "matchMaxMin", CFG.matchMaxMin), 0, 0, 180, false)
        CFG.lobbyDelaySec := ParseNumSafe(IniRead(ini, "afk", "lobbyDelaySec", CFG.lobbyDelaySec), 0, 0, 600, true)
        CFG.queueAntiAfk := IniRead(ini, "afk", "queueAntiAfk", CFG.queueAntiAfk ? 1 : 0) = 1
        ea := IniRead(ini, "afk", "endAction", CFG.endAction)
        CFG.endAction := (ea = "lobby_only") ? "lobby_only" : "play_again"
        CFG.finishMatch := IniRead(ini, "afk", "finishMatch", CFG.finishMatch ? 1 : 0) = 1
        CFG.waitSquadOnDeath := IniRead(ini, "afk", "waitSquadOnDeath", CFG.waitSquadOnDeath ? 1 : 0) = 1
        mmr := ParseNumSafe(IniRead(ini, "afk", "mmRecoverSec", CFG.mmRecoverSec), 0, 0, 900, true)
        CFG.mmRecoverSec := (mmr > 0 && mmr < 90) ? 90 : mmr
        CFG.audioAlert := IniRead(ini, "afk", "audioAlert", CFG.audioAlert ? 1 : 0) = 1
        CFG.stopOnToken := IniRead(ini, "afk", "stopOnToken", CFG.stopOnToken ? 1 : 0) = 1
        CFG.treasureHour := IniRead(ini, "afk", "treasureHour", CFG.treasureHour ? 1 : 0) = 1
        CFG.miniHudStart := IniRead(ini, "afk", "miniHudStart", CFG.miniHudStart ? 1 : 0) = 1
        CFG.macroInQueue := IniRead(ini, "afk", "macroInQueue", CFG.macroInQueue ? 1 : 0) = 1
        CFG.stopAfterMin := ParseNumSafe(IniRead(ini, "afk", "stopAfterMin", CFG.stopAfterMin), 0, 0, 1440, false)
        CFG.maxRounds := ParseNumSafe(IniRead(ini, "afk", "maxRounds", CFG.maxRounds), 0, 0, 500, true)
        sa := IniRead(ini, "afk", "stopAction", CFG.stopAction)
        CFG.stopAction := (sa = "close_game" || sa = "sleep_pc") ? sa : "none"
        sl := IniRead(ini, "afk", "sleepAction", CFG.sleepAction)
        CFG.sleepAction := (sl = "stop" || sl = "wait") ? sl : "wake"
        CFG.squadGraceSec := ParseNumSafe(IniRead(ini, "afk", "squadGraceSec", CFG.squadGraceSec), 45, 10, 300, true)
        CFG.keepAwake := IniRead(ini, "afk", "keepAwake", CFG.keepAwake ? 1 : 0) = 1
        CFG.hideFromCapture := IniRead(ini, "afk", "hideFromCapture", CFG.hideFromCapture ? 1 : 0) = 1

        xa := IniRead(ini, "xp", "xpAction", CFG.xpAction)
        CFG.xpAction := (xa = "click" || xa = "hold_lmb" || xa = "interact" || xa = "nudge_only") ? xa : "move"
        CFG.xpActionSec := ParseNumSafe(IniRead(ini, "xp", "xpActionSec", CFG.xpActionSec), 18, 2, 300, true)
        CFG.xpNudgeSec := ParseNumSafe(IniRead(ini, "xp", "xpNudgeSec", CFG.xpNudgeSec), 285, 30, 380, true)
        CFG.xpNudgePx := ParseNumSafe(IniRead(ini, "xp", "xpNudgePx", CFG.xpNudgePx), 95, 20, 260, true)
        CFG.coinRemindMin := ParseNumSafe(IniRead(ini, "xp", "coinRemindMin", CFG.coinRemindMin), 0, 0, 180, false)

        CFG.webhookSave := IniRead(ini, "webhook", "saveUrl", CFG.webhookSave ? 1 : 0) = 1
        rawWh := Trim(IniRead(ini, "webhook", "url", ""))
        CFG.webhookUrl := (CFG.webhookSave && ValidateWebhookUrl(rawWh)) ? rawWh : ""
        CFG.webhookToken := IniRead(ini, "webhook", "onToken", CFG.webhookToken ? 1 : 0) = 1
        CFG.webhookStop := IniRead(ini, "webhook", "onStop", CFG.webhookStop ? 1 : 0) = 1
        CFG.webhookRound := IniRead(ini, "webhook", "onRound", CFG.webhookRound ? 1 : 0) = 1

        CFG.playNormX := Clamp(Number(IniRead(ini, "coords", "playNormX", CFG.playNormX)), 0.005, 0.995)
        CFG.playNormY := Clamp(Number(IniRead(ini, "coords", "playNormY", CFG.playNormY)), 0.005, 0.995)
        CFG.optNormX := Clamp(Number(IniRead(ini, "coords", "optNormX", CFG.optNormX)), 0.005, 0.995)
        CFG.optNormY := Clamp(Number(IniRead(ini, "coords", "optNormY", CFG.optNormY)), 0.005, 0.995)
        CFG.leaveNormX := Clamp(Number(IniRead(ini, "coords", "leaveNormX", CFG.leaveNormX)), 0.005, 0.995)
        CFG.leaveNormY := Clamp(Number(IniRead(ini, "coords", "leaveNormY", CFG.leaveNormY)), 0.005, 0.995)
        CFG.coordRefW := ParseNumSafe(IniRead(ini, "coords", "coordRefW", CFG.coordRefW), 1920, 640, 7680, true)
        CFG.coordRefH := ParseNumSafe(IniRead(ini, "coords", "coordRefH", CFG.coordRefH), 1080, 480, 4320, true)

        CFG.featPlayAgain := IniRead(ini, "feat", "playAgain", CFG.featPlayAgain ? 1 : 0) = 1
        CFG.featAutoQueue := IniRead(ini, "feat", "autoQueue", CFG.featAutoQueue ? 1 : 0) = 1
        CFG.featMove := IniRead(ini, "feat", "move", CFG.featMove ? 1 : 0) = 1
        CFG.featParkour := IniRead(ini, "feat", "parkour", CFG.featParkour ? 1 : 0) = 1
        CFG.sprint := IniRead(ini, "feat", "sprint", CFG.sprint ? 1 : 0) = 1
        CFG.featCrouchFight := IniRead(ini, "feat", "crouchFight", CFG.featCrouchFight ? 1 : 0) = 1
        CFG.featAds := IniRead(ini, "feat", "ads", CFG.featAds ? 1 : 0) = 1
        CFG.featChest := IniRead(ini, "feat", "chest", CFG.featChest ? 1 : 0) = 1
        CFG.featLoot := IniRead(ini, "feat", "loot", CFG.featLoot ? 1 : 0) = 1
        CFG.featHeal := IniRead(ini, "feat", "heal", CFG.featHeal ? 1 : 0) = 1
        CFG.featCombat := IniRead(ini, "feat", "combat", CFG.featCombat ? 1 : 0) = 1
        CFG.featSound := IniRead(ini, "feat", "sound", CFG.featSound ? 1 : 0) = 1
        CFG.featReward := IniRead(ini, "feat", "reward", CFG.featReward ? 1 : 0) = 1
        CFG.featToken := IniRead(ini, "feat", "token", CFG.featToken ? 1 : 0) = 1
        CFG.featHarvest := IniRead(ini, "feat", "harvest", CFG.featHarvest ? 1 : 0) = 1
        CFG.featFirstSlot := IniRead(ini, "feat", "firstSlot", CFG.featFirstSlot ? 1 : 0) = 1
        CFG.featReload := IniRead(ini, "feat", "reload", CFG.featReload ? 1 : 0) = 1
        CFG.featBusJump := IniRead(ini, "feat", "busJump", CFG.featBusJump ? 1 : 0) = 1
        CFG.featWeaponPick := IniRead(ini, "feat", "weaponPick", CFG.featWeaponPick ? 1 : 0) = 1
        CFG.featFightBack := IniRead(ini, "feat", "fightBack", CFG.featFightBack ? 1 : 0) = 1

        CFG.totalRounds := ParseNumSafe(IniRead(ini, "stats", "totalRounds", 0), 0, 0, 9999999, true)
        CFG.totalRuntimeSec := ParseNumSafe(IniRead(ini, "stats", "totalRuntimeSec", 0), 0, 0, 999999999, true)
        CFG.totalTokens := ParseNumSafe(IniRead(ini, "stats", "totalTokens", 0), 0, 0, 9999999, true)
        CFG.totalChests := ParseNumSafe(IniRead(ini, "stats", "totalChests", 0), 0, 0, 99999999, true)
    } catch {
    }
}

OnApplyKeys(*) {
    global CFG, UI
    ReadHotkeysFromGui()
    ApplyHotkeys()
    n := UI.hkKeys.Length
    saved := SaveSettings()
    if !saved {
        result := "Настройки не удалось полностью сохранить. См. журнал."
    } else if (n != 9) {
        result := "Назначено " n " из 9. Ошибки и повторы — в журнале."
    } else {
        result := "Готово: все 9 клавиш назначены и сохранены."
    }
    Log("[i] клавиши: " n " из 9 · " (saved ? "настройки сохранены" : "ошибка сохранения"))
    try UI.keyResult.Value := result
    Flash(result, 4000)
}

ToggleDry(*) {
    global CFG
    CFG.dryRun := !CFG.dryRun
    SyncTogglesFromCfg()
    Log(CFG.dryRun ? "DryRun ВКЛ (только журнал, без нажатий)" : "DryRun ВЫКЛ (боевой режим)")
    SaveSettings()
    Flash(CFG.dryRun ? "DryRun: ВКЛ" : "DryRun: ВЫКЛ", 1500)
    UpdateStatus()
}

ToggleGui(*) {
    global UI
    if UI.visible
        HideGui()
    else
        ShowGui()
}

OnAppExit(exitReason, exitCode) {
    ; Полная и безопасная очистка при закрытии / Reload: отпускаем все клавиши
    ; и кнопки мыши, возвращаем окно пользователя, освобождаем GDI, сохраняем статистику.
    global ST
    try SetTimer(StopActionTick, 0)
    try SetTimer(CoordPickTick, 0)
    try SetTimer(MacroRecCountdownTick, 0)
    try SetTimer(MacroRecSampleTick, 0)
    try StopTickSlots()
    try SetTimer(Watchdog, 0)
    try SetTimer(UpdateStatus, 0)
    try LeaveCancel(false)
    try XpReleaseLmb()
    try CommitRunElapsed()
    try PersistStats(true)
    ST.running := false, ST.paused := false, ST.tickAbort := true, ST.macroRec := false
    try ReleaseKeysSafe()
    try UpdateKeepAwake(false)
    try HideMiniHud()
    try VisionHide()
    try MouseCalRawStop()
}

; ============================================================================
;                             ИНИЦИАЛИЗАЦИЯ
; ============================================================================
Init() {
    global CFG, UI, ST
    RotateLogIfLarge()
    LoadSettings()
    ApplyPerfProfile()
    MacroLoad()
    SetAutomaticFeatures()
    SetDpiAware()
    SetTitleMatchMode(2)
    SetKeyDelay(-1, 30)
    CoordMode("Mouse", "Screen")
    CoordMode("Pixel", "Screen")
    OnExit(OnAppExit)

    BuildTrayMenu()
    try {
        BuildGui()
    } catch as e {
        BuildGuiFallback(e.Message)
        Log("[!] Тема GUI не создалась: " e.Message)
    }
    ShowGui()

    OnError(LogFatal)

    ApplyHotkeys()
    SetTimer(Watchdog, 1000)
    SetTimer(UpdateStatus, 400)

    ; --- если прошлый запуск закончился самовосстановлением — продолжаем сами
    if ResumeFlagTake() {
        ST.autoResumeTimer := AutoResume.Bind(ST.startGeneration)
        SetTimer(ST.autoResumeTimer, -6000)
    }

    A_IconTip := "FORMA v10.0 — Fortnite AFK, Queue & XP (AHK v2)"
    TrayTip("F8 старт/стоп · F4 пропуск · F2 мини-HUD · F9 DryRun · F3 зрение · F7 окно · F1 в трей", "FORMA v10.0", 1)
    Log("=== FORMA v10.0 запущена" (A_IsCompiled ? " (EXE)" : " (AutoHotkey v2)")
        . " · чистый AHK v2 (0 моделей/Python)"
        . " · режим: " ModeRu(CFG.botMode)
        . " · ЦП: " PerfRu(CFG.perfProfile)
        . " · " (CFG.dryRun ? "DryRun (без нажатий)" : "БОЕВОЙ")
        . " · админ: " (A_IsAdmin ? "да" : "НЕТ (рекомендуется запуск от администратора)") " ===")
    if (CFG.totalRounds > 0 || CFG.totalRuntimeSec > 0 || CFG.totalChests > 0)
        Log("[i] Накопительная статистика: раундов " CFG.totalRounds
            . " · наработка " FmtLifetime(CFG.totalRuntimeSec)
            . " · жетонов " CFG.totalTokens " · [E] " CFG.totalChests
            . " (кумул. шанс " FmtOdds(CFG.totalChests, CFG.treasureHour) ")")
    if (ST.macroEvents.Length > 0)
        Log("[i] Загружен пользовательский маршрут macro.txt: " ST.macroEvents.Length " шагов"
            . (CFG.macroInQueue ? " (повтор в AFK-очереди ВКЛ)." : "."))
    hwGo := GetGameWindow()
    if hwGo {
        tGo := ""
        try
            tGo := WinGetTitle("ahk_id " hwGo)
        area := GetClientArea(hwGo)
        szTxt := area ? (" · клиент " area.w "×" area.h " @ (" area.x "," area.y ")") : ""
        clTxt := (ST.cloudTarget != "") ? (" · облако: " ST.cloudTarget) : ""
        Log("[i] Окно игры: ahk_id " hwGo " «" tGo "»" szTxt . clTxt " · окон игры: " GameWindowCount())
    } else {
        Log("[!] Окно Fortnite пока не найдено — запустите игру («Оконный без рамки»"
            . (CFG.cloudGaming ? " или облачный клиент" : "") ") и нажмите F7.")
    }
    Log("Готов к работе: F7 (окно) → F5 (HUD) → F8 (Старт) · F2 (мини-HUD) · «Настройки AFK…» и «XP / Discord…».")
}
