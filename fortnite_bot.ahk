    recoilPx:        3,
    combatStrafe:    true,


    ; ---- звук (визуализация) ----
    soundRingMin:   22,     ; размер метки звука, px
    soundRingMax:   120,

    soundFlashDelta: 14,    ; прирост яркости кадра = вспышка выстрела
    soundReactMs:   600,    ; не реагировать чаще, чем раз в N мс
    soundDodgeJumpChance: 55,

    ; ---- движение ----
    sprint:       true,
    jumpChance:   0.12,
    strafeChance: 0.35,
    fwdMinMs:     700,
    fwdMaxMs:     2600,
    idleMinMs:    60,
