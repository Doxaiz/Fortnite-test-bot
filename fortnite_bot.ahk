Rep(ch, n) {
    ; n копий символа — без Format, чтобы не зависеть от версии .NET-формата
    ; ПРЕДОХРАНИТЕЛЬ: пустой символ раньше означал вечный цикл (StrLen("") = 0)
    if (ch = "" || n <= 0)
        return ""
    n := Round(n)
    out := ""
    while (StrLen(out) < n)
        out .= ch
    return out
}

Bar(pct, width := 14) {
    ; текстовая полоса для панели состояния: [██████████░░░░] 87%
    if (pct < 0)
        return "[" Rep("·", width) "]   —"
    n := Clamp(Round(width * pct / 100), 0, width)
    return "[" Rep("█", n) Rep("░", width - n) "] " pct "%"
}

Fps() {
    ; Средняя частота успешных захватов основного цикла за текущий запуск.
    ; Это НЕ частота завершённых анализов и не FPS самой игры; паузы включены.
    global ST
    elapsed := A_TickCount - ST.startedAt
    if (!ST.running || elapsed < 500)
        return 0
    return Round(ST.frames / (elapsed / 1000), 1)
}

UpdateStatus() {
    global CFG, ST, UI
    runSec := SessionElapsedSec()
    upS := FmtClock(runSec)
    lifeSec := CFG.totalRuntimeSec + ((ST.running && !ST.paused && ST.activeRunTick > 0)
        ? Max(0, (A_TickCount - ST.activeRunTick) // 1000) : 0)

    ; Обновляем подсказку иконки в трее и сквозной мини-HUD даже при скрытом окне
    tipState := ST.running ? (ST.paused ? "ПАУЗА" : StateRu(ST.leaveActive ? "LEAVING" : ST.state)) : "СТОП"
    oddsS := FmtOdds(CFG.totalChests, CFG.treasureHour)
    try A_IconTip := "FORMA v10.0 · " tipState " · Р:" ST.rounds " (" CFG.totalRounds ") · шанс " oddsS
    UpdateMiniHud()

    if (!UI.status || !UI.visible)
        return

    badge := "СТОП"
    if ST.macroRec
        badge := "● ЗАПИСЬ МАРШРУТА"
    else if (ST.stopActionKind != "")
        badge := "АВТО-СТОП · " ST.stopActionLeft " с"
    else if ST.mouseCalActive
        badge := "МЫШЬ: ТЕСТ"
    else if ST.running {
        if ST.paused
            badge := "ПАУЗА"
        else if ST.cancelHold
            badge := "ЖДУ ИГРОКА"
        else if ST.finishMatchArmed
            badge := "ДОИГРЫВАЮ МАТЧ"
        else if ST.leaveActive
            badge := "ВЫХОД В ЛОББИ"
        else if (ST.state = "MATCHMAKING")
            badge := "ИЩУ МАТЧ"
        else
            badge := CFG.dryRun ? "DRY-RUN · без нажатий" : "РАБОТА · активен"
    }
    SetBadge("  " badge)

    extra := ""
    now := A_TickCount
    if (ST.running && !ST.paused) {
        if (ST.state = "MATCHMAKING" && ST.mmSince > 0)
            extra := " · поиск " Round((now - ST.mmSince) / 1000) " с"
        else if (ST.state = "GAME" && CFG.matchMaxMin > 0 && ST.matchStartT > 0 && CFG.botMode != "xp") {
            rem := Max(0, Round(CFG.matchMaxMin * 60000) - (now - ST.matchStartT))
            extra := " · выход через " FmtCountdown(rem)
        } else if (ST.state = "MENU" && ST.lobbyCooldownUntil > now) {
            extra := " · пауза " FmtCountdown(ST.lobbyCooldownUntil - now)
        }
    }
    if (ST.cloudTarget != "")
        extra .= " · [" ST.cloudTarget "]"
    limTxt := ""
    if (CFG.stopAfterMin > 0 && ST.running) {
        limTxt := ST.finishMatchArmed ? " (доигрываю)"
            : (" (стоп " FmtCountdown(Max(0, CFG.stopAfterMin * 60000 - runSec * 1000)) ")")
    }
    rph := CalcRatePerHour(ST.rounds, runSec)
    rndTxt := ST.rounds . (CFG.maxRounds > 0 ? ("/" CFG.maxRounds) : "")
        . (rph > 0 ? (" (" rph "/ч)") : "")
    focusMode := CFG.smartRestore ? "Умный фон" : (CFG.bgMode ? "Фон-клавиши" : "Обычный")
    whInfo := (CFG.webhookUrl != "") ? " · Discord ВКЛ" : ""

    txt := ""
    txt .= "СЦЕНА    " StateRu(ST.leaveActive ? "LEAVING" : ST.state) extra "`n"
    if (ST.stopActionKind != "")
        txt .= "ОТМЕНА   Действие через " ST.stopActionLeft " с — нажмите " CFG.hkStart " или Esc для отмены!`n"
    else if ST.cancelHold
        txt .= "ВНИМАНИЕ Подбор остановлен — нажмите «Очередь» или " CFG.hkStart ".`n"
    txt .= "РЕЖИМ    " ModeRu(CFG.botMode) " · " focusMode . whInfo "`n"
    txt .= "ДЕЙСТВИЕ " (ST.lastAction != "" ? ST.lastAction : "—") "`n"
    txt .= "СЕССИЯ   " (ST.running || runSec > 0 ? upS : "00:00:00") limTxt
        . "  ·  раундов " rndTxt "  ·  жетонов " ST.tokensFound "`n"
    txt .= "ВСЕГО    " FmtLifetime(lifeSec) " · раундов " CFG.totalRounds
        . " · жетон " CFG.totalTokens " · [E] " CFG.totalChests
        . " (шанс " oddsS (CFG.treasureHour ? " 1.5×" : "") ")`n`n"
    if (CFG.botMode = "auto") {
        txt .= "ЗДОРОВЬЕ " Bar(ST.hpPercent, 12) "   ЩИТ " Bar(ST.shPercent, 10) "`n"
        txt .= "ОБЪЕКТЫ  враг: " (ST.enemy ? "кандидат" : "нет")
            . " · сундук: " (ST.chest ? "кандидат" : "нет")
            . " · бой: " (CFG.teamSafe ? "вручную" : "авто")
            . (ST.rebootCount ? " · Reboot: " ST.rebootCount : "") "`n"
    } else if (CFG.botMode = "xp") {
        nRem := (ST.running && ST.xpNextNudgeAt > now) ? FmtCountdown(ST.xpNextNudgeAt - now) : ("~" CFG.xpNudgeSec " с")
        cTxt := (CFG.coinRemindMin > 0) ? (CFG.coinRemindMin " мин (#" ST.coinAlerts ")") : "выкл"
        txt .= "AFK XP   «" XpActRu(CFG.xpAction) "» каждые " CFG.xpActionSec " с · камера 0 px: " nRem "`n"
        txt .= "СЧЁТ XP  сдвигов: " ST.xpNudges " · действий: " ST.xpActions
            . " · сбросов мышью: " ST.xpManualResets " · монеты: " cTxt "`n"
    } else {
        endLbl := (CFG.endAction = "lobby_only") ? "в лобби" : "играть снова"
        macLbl := (CFG.macroInQueue && ST.macroEvents.Length > 0) ? (" · маршрут " ST.macroEvents.Length " ш.") : ""
        txt .= "ТАЙМЕРЫ  матч: " (CFG.matchMaxMin > 0 ? CFG.matchMaxMin " мин" : "до конца")
            . " · лобби: " CFG.lobbyDelaySec " с · итоги: " endLbl . macLbl "`n"
        txt .= "ОТРЯД    " (CFG.squadAutoLeave ? (ST.squadStatus " (выходов: " ST.squadLeaves ")") : "авто-выход выкл")
            . (ST.rebootCount ? " · Reboot: " ST.rebootCount : "")
            . " · побудок: " ST.sleepWakes " · [E]: " ST.promptN "`n"
    }
    try {
        UI.status.Value := txt
    } catch {
    }
    try {
        admTxt := A_IsAdmin ? "Админ" : "Без админа"
        UI.foot.Value := "  " StateRu(ST.state) " · " ST.capW "×" ST.capH
            . " · " Fps() " к/с · ЦП:" CFG.loopMs "мс · " admTxt " · "
            . (CFG.dryRun ? "DryRun" : "Боевой")
            . " · " CFG.hkStart " Старт · " CFG.hkBypass " Пропуск · " CFG.hkHud " HUD · " CFG.hkVision " Зрение"
    } catch {
    }
}

; ------------------------------ обработчики меню ---------------------------
StartPermit(gen) {
    global ST
    return ST.startWorkers > 0 && ST.startGeneration = gen && !ST.stopWorkers && !ST.mouseCalActive
}

OnStart(expectedGen := 0, *) {
    global CFG, ST, UI, HUD
    ; Зарезервировать запуск атомарно: Stop должен видеть даже ещё не
    ; включивший running поток, а новый запуск не пересекаться со старым.
    prev := Critical("On")
    ; Автовозобновление не может отменить ручной стоп или чужой активный запуск.
    if (expectedGen && (expectedGen != ST.startGeneration || ST.running || ST.startWorkers > 0 || ST.mouseCalActive)) {
        Critical(prev)
        return
    }
    if ST.mouseCalActive {
        Critical(prev)
        OnStop()
        Flash("Тест мыши отменён; бот остановлен", 2500)
        return
    }
    if ST.running {
        Critical(prev)
        OnStop()
        Flash("СТОП — бот остановлен (F8 — снова запустить)", 2500)
        return
    }
    if ST.startWorkers > 0 {
        Critical(prev)
        OnStop()
        Flash("Незавершённый запуск отменён", 2500)
        return
    }
    if (ST.mouseCalWorkers > 0 || ST.stopWorkers > 0 || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0) {
        Critical(prev)
        Flash("Жду завершения старых действий; затем нажмите Старт", 3500)
        return
    }
    ST.startWorkers += 1, startGen := ST.startGeneration
    Critical(prev)
    try {
    Flash("Подготовка запуска · " CFG.hkStart " — стоп", 2000)
    if !StartPermit(startGen)
        return
    ApplyToggles()
    if !StartPermit(startGen)
        return
    hwnd := GetGameWindow()
    if !StartPermit(startGen)
        return
    if !hwnd {
        Flash("Окно игры не найдено:`n" CFG.winTitle, 2500)
        Log("[!] старт отменён: окно не найдено")
        return
    }
    if !A_IsAdmin
        Log("[!] Скрипт запущен БЕЗ прав администратора. Fortnite часто не принимает"
            . " нажатия от обычного процесса — если бот стоит на месте, перезапустите"
            . " AutoHotkey «от имени администратора».")
    if CFG.dryRun {
        Log("[i] подготовка запуска (DryRun: только логи)")
        Log("[!] Внимание: DryRun включён — клавиши НЕ нажимаются, бот только пишет сюда."
            . " Чтобы он реально играл: снимите галочку «Тест: без нажатий» и нажмите Старт снова.")
        Flash("DryRun: только журнал, клавиши не нажимаются", 2500)
    } else {
        Log("[i] подготовка запуска (боевой режим)")
    }
    Log("[i] Режим: " ModeRu(CFG.botMode)
        . (CFG.botMode = "auto" ? (" · " (CFG.teamSafe ? "КОМАНДА (бой вручную)" : "СОЛО (автобой)")) : "")
        . (CFG.smartRestore ? " · Умный фон ВКЛ" : "")
        . (CFG.squadAutoLeave ? " · Выход без отряда ВКЛ" : "")
        . (CFG.matchMaxMin > 0 ? " · матч до " CFG.matchMaxMin " мин" : "")
        . (CFG.stopAfterMin > 0 ? " · стоп через " CFG.stopAfterMin " мин" : ""))
    if (CFG.botMode = "auto") {
        Log("[i] Авто-игра: лечение и перезарядка выполняются игроком вручную; Zero Build без построек.")
    }
    if !StartPermit(startGen)
        return
    CancelStopAction()
    ; Старые отложенные отпускания не относятся к новому запуску.
    InputCancelDeferred()
    if ST.cancelHold {
        ST.cancelHold := false
        ST.queueTries := 0, ST.lastQueueT := 0
        Log("[игрок] запуск после остановки: снимаю ожидание после отмены")
    }
    ST.frames := 0
    ST.rounds := 0, ST.roundCounted := false
    ST.tokensFound := 0, ST.tokenFoundMatch := false, ST.tokenStopArmed := false
    ST.finishMatchArmed := false, ST.finishMatchReason := ""
    ST.squadLeaves := 0, ST.squadCheckAt := 0, ST.squadEmptyCount := 0, ST.squadEverSeen := false
    ST.squadStatus := CFG.squadAutoLeave ? "активен" : "выкл"
    ST.spectateSquadAt := 0, ST.spectateAlive := 0, ST.wasDeadScene := false, ST.rebootCount := 0
    ST.surveySkips := 0, ST.lastSurveyAt := 0, ST.mmRecoveries := 0, ST.lastMmRecoverAt := 0
    ST.sleepWakes := 0, ST.lastSleepAct := 0
    ST.lobbyCooldownUntil := 0, ST.bypassRequested := false
    ST.leaveActive := false, ST.leaveStep := 0, ST.leaveSavedHwnd := 0
    ST.altWasDown := false, ST.altSettleUntil := 0
    SmartAlertClear()
    MacroStopRec()
    ST.afkAct := "", ST.afkUntil := 0, ST.afkKeys := [], ST.afkCrouched := false, ST.afkPitch := 0
    ST.xpNextActAt := 0, ST.xpNextNudgeAt := 0, ST.xpNudges := 0, ST.xpActions := 0
    ST.xpLmbHeld := false, ST.xpStepPhase := 0, ST.xpStepKey1 := "", ST.xpStepKey2 := ""
    ST.xpLastCurX := -99999, ST.xpManualResets := 0, ST.xpPausedAt := 0, ST.coinNextAt := 0, ST.coinAlerts := 0
    ST.macroPlayIdx := 0, ST.macroPlayNextAt := 0, ST.macroPlayHeld := [], ST.macroLoops := 0
    ST.sessionActiveSec := 0, ST.activeRunTick := 0, ST.groundAt := 0
    ST.bgWarned := false
    ST.queuePending := false, ST.queueSeen := false, ST.leftQueueT := 0
    ST.state := "", ST.pendingState := "", ST.pendingCount := 0, ST.pendingSince := 0
    ST.mmEnterAt := 0, ST.mmSince := 0
    ST.hudLastT := 0, ST.hudEvAt := 0, ST.lastHpSeenT := 0
    ST.matchStarted := false, ST.matchFromQueue := false
    ST.lastLobbyBtn := 0, ST.lastLobbyAt := 0, ST.playSeenAt := 0, ST.menuSeenAt := 0
    ST.roundActive := false, ST.lobbyRequeue := false
    ST.promptConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.enemyConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.enemyWideConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ResetMoveWatch(true)
    ST.tickReentry := 0
    ST.lastTickAt := A_TickCount
    ST.sprintUntil := 0
    ST.combatBrakeUntil := 0, ST.combatMoveUntil := 0
    ST.moveMode := ""
    ST.lastAction := "старт..."
    ST.phase := "", ST.phaseAt := 0, ST.busJumped := false, ST.glideDeploys := 0
    ST.weaponTries := 0
    SaveSettings()
    prev := Critical("On")
    try {
        if (!StartPermit(startGen) || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0)
            return
        ST.tickAbort := true, ST.running := true, ST.paused := false
        ST.startedAt := A_TickCount
        ST.activeRunTick := A_TickCount
        ST.lastStatsSaveAt := A_TickCount
        try {
            StopTickSlots()
            ST.tickSlot := 1
            SetTimer(TickSlot1, CFG.loopMs)
        } catch as e {
            ST.running := false, ST.activeRunTick := 0, ST.tickAbort := true, ST.tickSlot := 0
            throw e
        }
    } finally {
        Critical(prev)
    }
    if (!StartPermit(startGen) || !ST.running)
        return
    UpdateKeepAwake(true)
    Log(CFG.dryRun ? "=== СТАРТ (DryRun: только журнал) ===" : "=== СТАРТ (БОЕВОЙ · " ModeRu(CFG.botMode) ") ===")
    if (!StartPermit(startGen) || !ST.running)
        return
    Flash(CFG.dryRun ? "СТАРТ · DryRun (без нажатий)" : ("СТАРТ · " ModeRu(CFG.botMode)), 2500)
    if (!StartPermit(startGen) || !ST.running)
        return
    try {
        if (WinGetExStyle("ahk_id " hwnd) & 0x8)
            DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", -2
                , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                , "UInt", 0x0001 | 0x0002 | 0x0010)
    }
    if CFG.smartRestore
        Log("[i] Умный фон: можете работать в других окнах (не сворачивайте Fortnite).")
    else if CFG.bgMode
        Log("[i] Фон-клавиатура: клавиши через PostMessage, мышь только при фокусе.")
    else if !WinActive("ahk_id " hwnd)
        Log("[i] Переключитесь в окно Fortnite (или включите «Умный фон»).")
    if (!StartPermit(startGen) || !ST.running)
        return
    if (CFG.miniHudStart && !HUD.on)
        ShowMiniHud()
    if (CFG.hideOnStart && UI.gui)
        HideGui()
    UpdateStatus()
    } finally {
        prev := Critical("On")
        ST.startWorkers -= 1
        Critical(prev)
    }
}

; Снять паузу после ручной отмены подбора и снова искать матч.
OnResumeQueue(*) {
    global ST
    if !ST.cancelHold {
        Flash("Бот и так ищет матч", 1800)
        Log("[i] «Продолжить»: паузы после отмены нет")
        return
    }
    ST.cancelHold := false
    ST.queuePending := false, ST.queueSeen := false, ST.leftQueueT := 0
    ST.queueTries := 0
    ST.lastQueueT := 0
    Log("[игрок] «Продолжить» — возвращаюсь к поиску матча")
    Flash("Продолжаю: жму «Играть»", 2500)
    UpdateStatus()
}

OnPause(*) {
    global ST
    ; Пауза, её очистка и повторный запуск не должны пересекаться.
    prev := Critical("On")
    if ST.mouseCalActive {
        ST.mouseCalCancel := true, ST.mouseCalResumePaused := true
        Critical(prev)
        Log("[i] Тест мыши отменён: бот останется на паузе после завершения тика.")
        return
    }
    if !ST.running {
        Critical(prev)
        return
    }
    if ST.paused {
        if (ST.stopWorkers > 0 || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0) {
            Critical(prev)
            Flash("Жду завершения старого действия; повторите продолжение", 2500)
            return
        }
        InputCancelDeferred()
        ST.paused := false
        nowR := A_TickCount
        ST.activeRunTick := nowR
        if (ST.xpPausedAt > 0) {
            pDelta := Max(0, nowR - ST.xpPausedAt)
            if (ST.xpNextNudgeAt > 0)
                ST.xpNextNudgeAt += pDelta
            if (ST.xpNextActAt > 0)
                ST.xpNextActAt += pDelta
            if (ST.coinNextAt > 0)
                ST.coinNextAt += pDelta
            ST.xpPausedAt := 0
        }
        Critical(prev)
        UpdateKeepAwake(true)
    } else {
        InputCancelDeferred()
        ST.paused := true
        ST.xpPausedAt := A_TickCount
        ST.inputReleasesLive += 1
        Critical(prev)
        try {
            CommitRunElapsed()
            LeaveCancel(false)
            SmartAlertClear()
            XpReleaseLmb()
            ST.xpStepPhase := 0, ST.xpStepKey1 := "", ST.xpStepKey2 := ""
            ST.macroPlayIdx := 0, ST.macroPlayNextAt := 0, ST.macroPlayHeld := []
            ST.afkAct := "", ST.afkUntil := 0, ST.afkKeys := [], ST.afkCrouched := false
            ReleaseKeysSafe()
            ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
            ResetMoveWatch(true)
            UpdateKeepAwake(false)
            PersistStats(true)
        } finally {
            prev := Critical("On")
            ST.inputReleasesLive -= 1
            Critical(prev)
        }
    }
    Log(ST.paused ? "пауза" : "продолжаем")
    UpdateStatus()
}

OnStop(reason := "", *) {
    global CFG, ST, MC_RAW
    ; Если шла запись маршрута или захват координат — Esc завершает их
    if (ST.macroRec || ST.macroCountdown > 0) {
        MacroStopRec("Esc")
        return
    }
    if (!ST.running && ST.pickActive) {
        CancelCoordPick(true)
        return
    }
    ; Если шёл отсчёт закрытия игры/сна и пользователь нажал Esc — отменяем его
    if (!ST.running && !ST.mouseCalActive && ST.startWorkers = 0 && ST.stopActionKind != "") {
        CancelStopAction()
        return
    }
    wasRunning := ST.running
    prev := Critical("On")
    ST.stopWorkers += 1, ST.startGeneration += 1
    resumeTimer := ST.autoResumeTimer, ST.autoResumeTimer := 0
    ST.mouseCalActive := false, ST.mouseCalGeneration += 1
    ST.running := false, ST.paused := false, ST.tickAbort := true
    MC_RAW.active := false
    ST.inputEpoch += 1
    Critical(prev)
    try {
        if resumeTimer
            SetTimer(resumeTimer, 0)
        InputCancelDeferred()
        CommitRunElapsed()
        LeaveCancel(false)
        SmartAlertClear()
        XpReleaseLmb()
        ST.bypassRequested := false
        ST.tokenStopArmed := false
        ST.finishMatchArmed := false, ST.finishMatchReason := ""
        ST.xpStepPhase := 0, ST.xpStepKey1 := "", ST.xpStepKey2 := "", ST.xpNextNudgeAt := 0, ST.xpPausedAt := 0
        ST.macroPlayIdx := 0, ST.macroPlayNextAt := 0, ST.macroPlayHeld := []
        ST.afkAct := "", ST.afkUntil := 0, ST.afkKeys := [], ST.afkCrouched := false, ST.afkPitch := 0
        ST.tgt := 0
        ST.promptAt := 0
        ST.promptCache := 0
        ST.promptAvailable := false
        ST.enemyConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
        ST.enemyWideConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
        ST.promptConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
        ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
        ResetMoveWatch(true)
        StopTickSlots()
        busySecs := (ST.tickBusy && (A_TickCount - ST.tickStart > 1000))
            ? Round((A_TickCount - ST.tickStart) / 1000) : 0
        if !ST.tickBusy
            ST.tickStart := 0
        ST.tickReentry := 0
        ReleaseKeysSafe()
        UpdateKeepAwake(false)
        try MouseCalRawStop()
        if wasRunning
            PersistStats(true)
        if busySecs
            Log("[i] стоп: тик работает " busySecs " с — прошу завершиться")
        whyStr := (Type(reason) = "String" && reason != "" && !InStr(reason, "$")) ? (" (" reason ")") : ""
        if wasRunning {
            ST.lastAction := "остановлен" whyStr
            rph := CalcRatePerHour(ST.rounds, ST.sessionActiveSec)
            Log("=== СТОП" whyStr " === сессия " FmtClock(ST.sessionActiveSec)
                . " · раундов " ST.rounds (rph > 0 ? " (" rph "/ч)" : "")
                . " (всего " CFG.totalRounds ")"
                . " · жетонов " ST.tokensFound " (всего " CFG.totalTokens
                . ", шанс " FmtOdds(CFG.totalChests, CFG.treasureHour) ")"
                . " · [E] " ST.promptN
                . (ST.squadLeaves ? " · выходов без отряда " ST.squadLeaves : "")
                . (ST.rebootCount ? " · возрождений " ST.rebootCount : "")
                . (ST.sleepWakes ? " · побудок " ST.sleepWakes : ""))
            SendSessionWebhook(whyStr)
        }
        UpdateStatus()
    } finally {
        prev := Critical("On")
        ST.stopWorkers -= 1
        Critical(prev)
    }
}

OnGuiClose(*) {
    global CFG, ST, UI
    if (ST.running || ST.mouseCalActive || ST.startWorkers > 0)
        OnStop("закрыто окно")
    try MacroStopRec()
    try HideKeySettings()
    try HideAfkSettings()
    try HideExtraSettings()
    try {
        UI.gui.Hide()
    } catch {
    }
    UI.visible := false
    TrayTip("Бот остановлен, окно скрыто в трей. " CFG.hkMenu " — открыть снова.", "FORMA v10", 1)
}

HideGui() {
    global UI
    try HideKeySettings()
    try HideAfkSettings()
    try HideExtraSettings()
    try {
        UI.gui.Hide()
    } catch {
    }
    UI.visible := false
}

ShowGui() {
    global UI
    try {
        if (!UI.visible) {
            UI.gui.Show("w980 h650")
            UI.visible := true
            UpdateStatus()
            RefreshLog()
        } else {
            UI.gui.Show()
        }
    } catch {
    }
}

OnOpenFolder(*) {
