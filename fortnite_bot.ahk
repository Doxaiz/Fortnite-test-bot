    "        if not (1.6 <= asp <= 4.5): continue",
    "        if c['fill'] < 0.35: continue",
    "        if not (h*0.76 <= c['cy'] <= h*0.97): continue",
    "        if best is None or c['area'] > best['area']: best = c",
    "    return best",
    "",
    "def bright_ratio(img, region, thr=170):",
    "    x1, y1, x2, y2 = region_to_pixels(img, region)",
    "    sub = img[y1:y2:4, x1:x2:4].astype(np.int32)",
    "    lum = (sub[:, :, 2]*299 + sub[:, :, 1]*587 + sub[:, :, 0]*114)//1000",
    "    return float((lum >= thr).mean()) if lum.size else 0.0",
    "",
    "def longest_run(mask_row):",
    "    d = np.diff(np.concatenate(([0], mask_row.astype(np.int8), [0])))",
    "    st = np.flatnonzero(d == 1); en = np.flatnonzero(d == -1)",
    "    return int((en-st).max()) if len(st) else 0",
    "",
    "def bar_profile(img, region, kind):",
    "    `"`"`"Длина самой длинной ровной серии + толщина (сколько строк с серией >= barMinRun).`"`"`"",
    "    x1, y1, x2, y2 = region_to_pixels(img, region)",
    "    sub = img[y1:y2, x1:x2].astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    m = (g >= 110) & ((g-b) >= 30) & ((g-r) >= 20) if kind == `"hp`" \",
    "        else (b >= 140) & ((b-r) >= 40) & ((b-g) >= 15)",
    "    best = 0; rows = 0; last_y = -9",
    "    for y in range(0, m.shape[0], 2):",
    "        run = longest_run(m[y])",
    "        best = max(best, run)",
    "        if run >= CFG['barMinRun']:",
    "            rows = rows + 1 if y - last_y <= 2 else 1",
    "            last_y = y",
    "    return best, rows",
    "",
    "def measure_bar(img, region, kind):",
    "    x1, y1, x2, y2 = region_to_pixels(img, region)",
    "    sub = img[y1:y2, x1:x2].astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    m = (g >= 110) & ((g-b) >= 30) & ((g-r) >= 20) if kind == `"hp`" \",
    "        else (b >= 140) & ((b-r) >= 40) & ((b-g) >= 15)",
    "    best = max((longest_run(row) for row in m), default=0)",
    "    full = img.shape[1]*(CFG['hpBarFrac'] if kind == `"hp`" else CFG['shBarFrac'])",
    "    pct = int(round(min(100, best/full*100))) if full else -1",
    "    return pct, int(best)",
    "",
    "",
    "def ahk_round(value):",
    "    return int(np.floor(value + 0.5))",
    "",
    "",
    "def estimate_bars(img):",
    "    `"`"`"Приближённая модель AHK. -1: полоска не определена, а не ноль.`"`"`"",
    "    h, w = img.shape[:2]",
    "    k = w / 1280.0",
    "    x1, x2 = ahk_round(.02*w), ahk_round(.24*w)",
    "    y1, y2 = ahk_round(.885*h), ahk_round(.990*h)",
    "    x1, y1 = max(0, min(w-2, x1)), max(0, min(h-2, y1))",
    "    x2, y2 = min(w, max(x1+2, x2)), min(h, max(y1+2, y2))",
    "    sub = img[y1:y2, x1:x2].astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    mask = (g >= 110) & (g-b >= 30) & (g-r >= 20)",
    "    minrun = max(12, ahk_round(CFG['barMinRun']*k))",
    "    minthick = max(4, ahk_round(CFG['hpBarMinThick']*k))",
    "    rows = bx = bw = by = 0",
    "    last_y = -9",
    "    for yi in range(0, mask.shape[0], 2):",
    "        d = np.diff(np.r_[0, mask[yi].astype(np.int8), 0])",
    "        starts, ends = np.flatnonzero(d == 1), np.flatnonzero(d == -1)",
    "        if len(starts):",
    "            j = int(np.argmax(ends-starts))",
    "            rowrun, rowx = int(ends[j]-starts[j]), int(starts[j])+x1",
    "        else:",
    "            rowrun, rowx = 0, -1",
    "        y = yi+y1",
    "        if rowrun >= minrun:",
    "            if y-last_y <= 2:",
    "                rows += 1",
    "            elif not rows or rowrun > bw:",
    "                rows = 1",
    "            last_y = y",
    "            if rowrun > bw:",
    "                bw, bx = rowrun, rowx",
    "            if not by:",
    "                by = y",
    "    valid = bw >= minrun and rows >= minthick and .025*w <= bx <= .07*w",
    "    if not valid:",
    "        return -1, -1",
    "    hp = min(100, ahk_round(bw/(w*CFG['hpBarFrac'])*100))",
    "    sx1, sx2 = max(0, bx-ahk_round(5*k)), min(w, bx+ahk_round(220*k))",
    "    sy1, sy2 = max(0, by-ahk_round(23*k)), min(h, by-ahk_round(2*k))",
    "    if sy1 >= sy2 or sx1 >= sx2:",
    "        return hp, -1",
    "    sub = img[sy1:sy2, sx1:sx2].astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    mask = (b >= 205) & (g >= 125) & (r <= 65) & (b-r >= 130) & (g-r >= 65)",
    "    positions = []",
    "    minimum, tol = max(12, ahk_round(35*k)), max(2, ahk_round(3*k))",
    "    for yi in range(0, mask.shape[0], 2):",
    "        d = np.diff(np.r_[0, mask[yi].astype(np.int8), 0])",
    "        starts, ends = np.flatnonzero(d == 1), np.flatnonzero(d == -1)",
    "        choices = [(int(e-a), int(a)+sx1) for a, e in zip(starts, ends)",
    "                   if abs(int(a)+sx1-bx) <= tol and int(e-a) >= minimum]",
    "        if choices:",
    "            length, xx = max(choices)",
    "            positions.append((sy1+yi, length))",
    "    if not positions:",
    "        return hp, -1",
    "    best = max(length for _, length in positions)",
    "    seq = maximum = 0",
    "    prev = -100",
    "    for y, length in positions:",
    "        if abs(length-best) <= max(4, ahk_round(best*.12)):",
    "            seq = seq+1 if y-prev == 2 else 1",
    "            prev = y",
    "            maximum = max(maximum, seq)",
    "    shield = (min(100, ahk_round(best/(w*CFG['shBarFrac'])*100))",
    "              if maximum >= max(3, ahk_round(4*k)) else -1)",
    "    return hp, shield",
    "",
    "def find_chest(img):",
    "    best = None",
    "    for c in mask_clusters(img, CFG['regLoot'], `"gold`", 18, 5, 3):",
    "        if c['area'] < CFG['chestGoldArea'] or c['w'] < 18 or c['h'] < 14: continue",
    "        if best is None or c['area'] > best['area']: best = c",
    "    return best",
    "",
    "def find_loot(img):",
    "    best = None",
    "    for mode in (`"green`", `"blue`", `"purple`"):",
    "        for c in mask_clusters(img, CFG['regLoot'], mode, 18, 6, 2):",
    "            if c['area'] < CFG['lootMinArea']: continue",
    "            if best is None or c['area'] > best['area']: best = dict(c, kind=mode)",
    "    return best",
    "",
    "def sound_marks(img, region=(0.10, 0.14, 0.90, 0.80)):",
    "    `"`"`"Метки «Визуализации звуковых эффектов». Цвета в текущем Fortnite:",
    "    красные/оранжевые — выстрелы и взрывы, золотые — сундук и лут, белые —",
    "    шаги, звери, машины. v7.7: раньше искались только белые кольца, из-за чего",
    "    выстрелы рядом не «слышались».`"`"`"",
    "    out = []",
    "    for mode, rank in ((`"red`", 3), (`"gold`", 2), (`"white`", 1)):",
    "        for c in mask_clusters(img, region, mode, 14, 4, 2):",
    "            s = max(c['w'], c['h'])",
    "            if not (22 <= s <= 120):",
    "                continue",
    "            if c['fill'] > 0.72:               # метка — дуга, а не пятно",
    "                continue",
    "            if c['w'] / max(1, c['h']) < 0.45 or c['w'] / max(1, c['h']) > 2.2:",
    "                continue",
    "            out.append(dict(c, kind=mode, rank=rank))",
    "    return sorted(out, key=lambda c: (-c['rank'], -c['area']))",
    "",
    "def skin_mask(img):",
    "    `"`"`"Маска «кожи»: тёплые пиксели (красного больше синего, зелёного больше",
    "    синего), без пересвета. По ней в v7.7 ищется ФИГУРА игрока: полосы HP над",
    "    противником в Fortnite нет.`"`"`"",
    "    b = img[:, :, 0].astype(np.int16)",
    "    g = img[:, :, 1].astype(np.int16)",
    "    r = img[:, :, 2].astype(np.int16)",
    "    m = (r >= 120) & (r > g + 16) & (g >= b + 6) & ((r - b) >= 26)",
    "    white = (r >= 232) & (g >= 232) & (b >= 225)",
    "    return m & ~white",
    "",
    "",
    "def find_interact_prompt(img):",
    "    `"`"`"Эвристика подсказки: полосы, тёмная подложка и маленький значок.",
    "",
    "    Текст не читаем. Это самостоятельная Python-модель, а не выполнение AHK.",
    "    `"`"`"",
    "    h, w = img.shape[:2]",
    "    k = w / 1280.0",
    "    sx, sy = max(1, round(2*k)), max(1, round(3*k))",
    "    hop, band = max(2, round(7*k)), max(6, round(15*k))",
    "    pad = max(2, round(5*k))",
    "    sub = img.astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    white = (r >= 185) & (g >= 185) & (b >= 178)",
    "    lum = (r + g + b) / 3.0",
    "    xmin = max(0, (round(w*.38) // sx) * sx)",
    "    xmax = min(w, round(w*.82))",
    "    ylo = max(0, round(h*.38))",
    "    yhi = min(h-band-1, round(h*.63))",
    "    xs = np.arange(xmin, xmax, sx)",
    "    best = None",
    "    for y in range(ylo, yhi, hop):",
    "        ys = np.arange(y, y+band, sy)",
    "        cols = white[np.ix_(ys, xs)].sum(axis=0)",
    "        i = 0",
    "        while i < len(cols):",
    "            if not cols[i]:",
    "                i += 1",
    "                continue",
    "            j, last, gap = i, i, 0",
    "            while j < len(cols):",
    "                if cols[j]:",
    "                    last, gap = j, 0",
    "                else:",
    "                    gap += 1",
    "                    if gap > 3:",
    "                        break",
    "                j += 1",
    "            x0, x1 = int(xs[i]), int(xs[last])",
    "            span = x1-x0+sx",
    "            if CFG['promptSpanMin']*k <= span <= CFG['promptSpanMax']*k:",
    "                pts = white[np.ix_(ys, xs[i:last+1])]",
    "                rows = ys[np.where(pts.any(axis=1))[0]]",
    "                if int(pts.sum()) >= max(8, round(16*k)) and len(rows) >= 2:",
    "                    hi, lo = int(rows[0]), int(rows[-1])",
    "                    hgt = lo-hi+1",
    "                    cx, cy = (x0+x1)//2, (hi+lo)//2",
    "                    dx, dy = cx-w//2, cy-h//2",
    "                    if (CFG['promptHMin']*k <= hgt <= CFG['promptHMax']*k",
    "                        and abs(dx) <= w*CFG['promptDxFrac']",
    "                        and abs(dy) <= h*CFG['promptDyFrac']):",
    "                        st = max(1, round(3*k))",
    "                        back = float(lum[max(0, hi-pad):min(h, lo+pad+1):st,",
    "                                         max(0, x0-pad):min(w, x1+pad+1):st].mean())",
    "                        above = float(lum[max(0, hi-round(10*k)):max(0, hi-round(5*k)):2,",
    "                                          x0:x1+1:2].mean())",
    "                        below = float(lum[min(h, lo+round(5*k)):min(h, lo+round(10*k)):2,",
    "                                          x0:x1+1:2].mean())",
    "                        q = white[max(0, hi-round(5*k)):min(h, lo+round(6*k)),",
    "                                  max(0, x0-round(38*k)):max(0, x0-round(21*k))]",
    "                        bx, by = np.where(q.any(axis=0))[0], np.where(q.any(axis=1))[0]",
    "                        mw = int(bx[-1]-bx[0]+1) if bx.size else 0",
    "                        mh = int(by[-1]-by[0]+1) if by.size else 0",
    "                        compact = (int(q.sum()) >= max(3, round(8*k*k))",
    "                                   and 2*k <= mw <= 10*k and 4*k <= mh <= 14*k)",
    "                        clearance, outer = max(2, round(3*k)), max(5, round(17*k))",
    "                        up = white[max(0, hi-outer):max(0, hi-clearance), x0:x1+1].sum()",
    "                        down = white[min(h, lo+clearance):min(h, lo+outer), x0:x1+1].sum()",
    "                        middle = white[hi:lo+1, x0:x1+1].sum()",
    "                        isolated = up+down <= max(10, round(.08*int(middle)))",
    "                        if (back <= CFG['promptDarkMax'] and above <= 110 and below <= 110",
    "                            and compact and isolated):",
    "                            cand = dict(x=x0, y=hi, w=span, h=hgt, cx=cx, cy=cy,",
    "                                        span=span, back=round(back), dx=dx, dy=dy,",
    "                                        src='prompt')",
    "                            if best is None or abs(dx)+abs(dy) < abs(best['dx'])+abs(best['dy']):",
    "                                best = cand",
    "            i = last+1",
    "    return best",
    "",
    "",
    "def find_damage_number(img):",
    "    `"`"`"Цифра урона над противником — единственное честное подтверждение",
    "    попадания. Цвет: белый — по здоровью, синий — по щиту, золотой — в голову.",
    "    Прицел сам белый и стоит ровно в центре — его за цифру не берём.`"`"`"",
    "    h, w = img.shape[:2]",
    "    frac = CFG['damageNearFrac']",
    "    x1, y1, x2, y2 = region_to_pixels(img, (0.5 - frac / 2, 0.12, 0.5 + frac / 2, 0.92))",
    "    sub = img[y1:y2, x1:x2].astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    boxes = []",
    "    kinds = [(`"health`", (r >= 205) & (g >= 205) & (b >= 195) & (np.abs(r - b) <= 45)),",
    "             (`"shield`", (b >= 190) & ((b - r) >= 25) & ((b - g) >= 15)),",
    "             (`"head`", (r >= 200) & (g >= 150) & (b <= 120) & ((r - b) >= 80))]",
    "    for kind, mask in kinds:",
    "        n, _lab, stats, _cent = cv2.connectedComponentsWithStats(mask.astype(np.uint8), 8)",
    "        for i in range(1, n):",
    "            bw = int(stats[i, cv2.CC_STAT_WIDTH]); bh = int(stats[i, cv2.CC_STAT_HEIGHT])",
    "            area = int(stats[i, cv2.CC_STAT_AREA])",
    "            side = max(bw, bh)",
    "            if side < CFG['damageMinPx'] or side > CFG['damageMaxPx']:",
    "                continue",
    "            if bw > bh * 3 or bh > bw * 3:",
    "                continue",
    "            if not (CFG['damageAspectMin'] <= bw / float(max(1, bh))",
    "                    <= CFG['damageAspectMax']):",
    "                continue",
    "            cx = int(stats[i, cv2.CC_STAT_LEFT]) + x1 + bw // 2",
    "            cy = int(stats[i, cv2.CC_STAT_TOP]) + y1 + bh // 2",
    "            if abs(cx - w // 2) <= CFG['damageCrossPx'] and abs(cy - h // 2) <= CFG['damageCrossPx']:",
    "                continue",
    "            boxes.append(dict(x=cx - bw // 2, y=cy - bh // 2, w=bw, h=bh, cx=cx, cy=cy,",
    "                              kind=kind, area=area, src=`"damage`"))",
    "    if not boxes:",
    "        return None",
    "    boxes.sort(key=lambda c: abs(c['cx'] - w // 2) + abs(c['cy'] - h // 2))",
    "    return boxes[0]",
    "",
    "",
    "def find_alert_mark(img):",
    "    `"`"`"Красная/оранжевая метка выстрела (настройка игры «Визуализация звуковых",
    "    эффектов»): дуга/кольцо небольшого размера около центра кадра.`"`"`"",
    "    h, w = img.shape[:2]",
    "    frac = CFG['alertCenterFrac']",
    "    x1, y1, x2, y2 = region_to_pixels(img, (0.5 - frac / 2, 0.10, 0.5 + frac / 2, 0.92))",
    "    sub = img[y1:y2, x1:x2].astype(np.int16)",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    m = (r >= 110) & ((r - g) >= 45) & ((r - b) >= 45)",
    "    best = None",
    "    n, _lab, stats, _cent = cv2.connectedComponentsWithStats(m.astype(np.uint8), 8)",
    "    for i in range(1, n):",
    "        bw = int(stats[i, cv2.CC_STAT_WIDTH]); bh = int(stats[i, cv2.CC_STAT_HEIGHT])",
    "        area = int(stats[i, cv2.CC_STAT_AREA])",
    "        side = max(bw, bh)",
    "        if side < CFG['alertMinPx'] or side > CFG['alertMaxPx']:",
    "            continue",
    "        if area / float(max(1, bw * bh)) > CFG['alertFillMax']:",
    "            continue",
    "        if bw > bh * 3 or bh > bw * 3:",
    "            continue",
    "        cx = int(stats[i, cv2.CC_STAT_LEFT]) + x1 + bw // 2",
    "        cy = int(stats[i, cv2.CC_STAT_TOP]) + y1 + bh // 2",
    "        cand = dict(x=cx - bw // 2, y=cy - bh // 2, w=bw, h=bh, cx=cx, cy=cy,",
    "                    area=area, src=`"alert`")",
    "        if best is None or area > best['area']:",
    "            best = cand",
    "    return best",
    "",
    "",
    "def find_enemy(img):",
    "    `"`"`"Враг в ТЕКУЩЕМ Fortnite (v7.7): полосы здоровья над противником НЕТ.",
    "",
    "    В игре своя полоса HP только внизу слева; над врагом появляются лишь",
    "    всплывающие цифры урона (белые — по здоровью, синие — по щиту, золотые — в",
    "    голову), а при включённой «Визуализации звуковых эффектов» — красные метки",
    "    выстрелов. Поэтому «враг» — это:",
    "      1) ФИГУРА: компактное пятно кожи нужного размера около центра;",
    "      2) ЦИФРА УРОНА: подтверждение, что мы попали (и где цель);",
    "      3) КРАСНАЯ МЕТКА выстрела: враг рядом, даже если его не видно.",
    "    `"`"`"",
    "    h, w = img.shape[:2]",
    "    k = w / 1280.0",
    "    x1, y1, x2, y2 = region_to_pixels(img, CFG['regEnemy'])",
    "    m = skin_mask(img)[y1:y2, x1:x2]",
    "    best = None",
    "    n, lab, stats, cent = cv2.connectedComponentsWithStats(m.astype(np.uint8), 8)",
    "    for i in range(1, n):",
    "        bw = int(stats[i, cv2.CC_STAT_WIDTH])",
    "        bh = int(stats[i, cv2.CC_STAT_HEIGHT])",
    "        area = int(stats[i, cv2.CC_STAT_AREA])",
    "        if area < 40:",
    "            continue",
    "        if bw < CFG['enemyMinBoxW'] * k or bw > CFG['enemyMaxBoxW'] * k:",
    "            continue",
    "        if bh < CFG['enemyMinBoxH'] * k or bh > CFG['enemyMaxBoxH'] * k:",
    "            continue",
    "        pct = area * 100.0 / max(1, bw * bh)",
    "        if not (CFG['enemySkinMinPct'] <= pct <= CFG['enemySkinMaxPct']):",
    "            continue",
    "        asp = bw / float(max(1, bh))",
    "        if not (CFG['enemyAspectMin'] <= asp <= CFG['enemyAspectMax']):",
    "            continue",
    "        # «голова уже плеч»: у человека верх бокса узкий, у камня и стены — нет",
    "        bx0 = int(stats[i, cv2.CC_STAT_LEFT])",
    "        by0 = int(stats[i, cv2.CC_STAT_TOP])",
    "        comp = (lab[by0:by0 + bh, bx0:bx0 + bw] == i)",
    "",
    "        def span(a, b):",
    "            band = comp[a:b]",
    "            cols = np.flatnonzero(band.any(axis=0))",
    "            return (int(cols[-1]) - int(cols[0]) + 1) if cols.size else 0",
    "",
    "        head_span = span(0, max(2, int(bh * 0.22)))",
    "        mid_span = span(int(bh * 0.35), max(3, int(bh * 0.75)))",
    "        if head_span < 1 or mid_span < 2:",
    "            continue",
    "        if head_span > mid_span * CFG['enemyHeadNarrow']:",
    "            continue",
    "        cx = int(cent[i][0]) + x1",
    "        if abs(cx - w // 2) > w * CFG['enemyCenterFrac']:",
    "            continue",
    "        # свой персонаж всегда виден в центре-снизу кадра — это не противник",
    "        if (w * 0.34 < cx < w * 0.66 and (y1 + by0 + bh) > h * 0.55",
    "                and bw > w * 0.08):",
    "            continue",
    "        bx = bx0 + x1",
    "        by = by0 + y1",
    "        cand = dict(x=bx, y=by, w=bw, h=bh, cx=cx, cy=by + int(bh * 0.55),",
    "                    hy=by + int(bh * CFG['enemyHeadFrac']), src=`"skin`", skin=int(pct))",
    "        if best is None or cand['w'] * cand['h'] > best['w'] * best['h']:",
    "            best = cand",
    "    if best is not None:",
    "        return best",
    "    d = find_damage_number(img)",
    "    if d is not None:",
    "        return d",
    "    a = find_alert_mark(img)",
    "    if a is not None:",
    "        return a",
    "    return None",
    "",
    "def label_path(img_path):",
    "    `"`"`"Путь к разметке YOLO для картинки набора Roboflow: images/x.jpg -> labels/x.txt.`"`"`"",
    "    p = img_path.replace(os.sep + `"images`" + os.sep, os.sep + `"labels`" + os.sep)",
    "    if p == img_path:",
    "        return `"`"",
    "    root, _ext = os.path.splitext(p)",
    "    cand = root + `".txt`"",
    "    return cand if os.path.isfile(cand) else `"`"",
    "",
    "",
    "def find_enemy_label(img_path, img):",
    "    `"`"`"Враг по РАЗМЕТКЕ набора (класс 0 = enemy). В скачанных кропах враг",
    "    занимает почти весь кадр, и «фигуру» там искать бессмысленно — зато бокс",
    "    размечен руками. Возвращаем середину бокса как точку цели.`"`"`"",
    "    lab = label_path(img_path)",
    "    if not lab:",
    "        return None",
    "    h, w = img.shape[:2]",
    "    for ln in io.open(lab, encoding=`"utf-8`", errors=`"ignore`"):",
    "        parts = ln.split()",
    "        if len(parts) < 5:",
    "            continue",
    "        try:",
    "            cls, cx, cy = int(float(parts[0])), float(parts[1]), float(parts[2])",
    "            bw, bh = float(parts[3]), float(parts[4])",
    "        except ValueError:",
    "            continue",
    "        if cls != 0:",
    "            continue",
    "        return dict(x=int((cx - bw / 2) * w), y=int((cy - bh / 2) * h),",
    "                    w=int(bw * w), h=int(bh * h), cx=int(cx * w), cy=int(cy * h),",
    "                    hy=int((cy - bh / 2) * h) + int(bh * h * 0.3), src=`"label`")",
    "    return None",
    "",
    "",
    "def find_figure(img):",
    "    `"`"`"Запасной канал «фигура» для проверки кадров: самое крупное пятно кожи,",
    "    прошедшее проверки размера и пропорций. Без привязки к центру кадра — на то",
    "    он и запасной (в самом боте фигуру всегда ищут около прицела).`"`"`"",
    "    h, w = img.shape[:2]",
    "    k = w / 1280.0",
    "    m = skin_mask(img)",
    "    n, lab, stats, cent = cv2.connectedComponentsWithStats(m.astype(np.uint8), 8)",
    "    best = None",
    "    for i in range(1, n):",
    "        bw = int(stats[i, cv2.CC_STAT_WIDTH])",
    "        bh = int(stats[i, cv2.CC_STAT_HEIGHT])",
    "        area = int(stats[i, cv2.CC_STAT_AREA])",
    "        if area < 120:",
    "            continue",
    "        if not (CFG['enemyMinBoxW'] * k <= bw <= CFG['enemyMaxBoxW'] * k):",
    "            continue",
    "        if not (CFG['enemyMinBoxH'] * k <= bh <= CFG['enemyMaxBoxH'] * k):",
    "            continue",
    "        pct = area * 100.0 / max(1, bw * bh)",
    "        if not (CFG['enemySkinMinPct'] <= pct <= CFG['enemySkinMaxPct']):",
    "            continue",
    "        asp = bw / float(max(1, bh))",
    "        if not (CFG['enemyAspectMin'] <= asp <= CFG['enemyAspectMax']):",
    "            continue",
    "        bx = int(stats[i, cv2.CC_STAT_LEFT])",
    "        by = int(stats[i, cv2.CC_STAT_TOP])",
    "        cand = dict(x=bx, y=by, w=bw, h=bh, cx=bx + bw // 2, cy=by + int(bh * 0.55),",
    "                    hy=by + int(bh * CFG['enemyHeadFrac']), src=`"figure`",",
    "                    skin=int(pct))",
    "        if best is None or cand['w'] * cand['h'] > best['w'] * best['h']:",
    "            best = cand",
    "    return best",
    "",
    "",
    "def dark_ratio(img, region=(0.15, 0.10, 0.85, 0.90)):",
    "    x1, y1, x2, y2 = region_to_pixels(img, region)",
    "    sub = img[y1:y2:4, x1:x2:4].astype(np.int16)",
    "    return float((sub.sum(axis=2) < 120).mean())",
    "",
    "def in_match_hud(img):",
    "    `"`"`"Матч = ровная толстая зелёная полоса здоровья (не яркость!).`"`"`"",
    "    run, thick = bar_profile(img, CFG['regHp'], 'hp')",
    "    slots = bright_ratio(img, CFG['regSlots'], 170)",
    "    return (run >= CFG['hpBarMinRun'] and thick >= CFG['hpBarMinThick']), slots, run",
    "",
    "def lobby_button(img, region=(0.00, 0.30, 0.40, 1.00)):",
    "    `"`"`"«ИГРАТЬ» в лобби: самый массивный сплошной жёлтый блок левой панели.",
    "    По строкам берём самую длинную серию и склеиваем строки с зазором ≤ 64 px,",
    "    чтобы чёрная надпись внутри кнопки не разрывала её.`"`"`"",
    "    h, w = img.shape[:2]",
    "    x1, y1, x2, y2 = int(region[0]*w), int(region[1]*h), int(region[2]*w), int(region[3]*h)",
    "    s = img[y1:y2:2, x1:x2].astype(np.int16)",
    "    b, g, r = s[:, :, 0], s[:, :, 1], s[:, :, 2]",
    "    m = (r >= CFG['yRMin']) & (g >= CFG['yGMin']) & (b <= CFG['yBMax']) & (np.abs(r - g) <= CFG['yRGDelta'])",
    "    rows = []",
    "    best_run = 0",
    "    for row in m:",
    "        d = np.diff(np.concatenate(([0], row.astype(np.int8), [0])))",
    "        st = np.flatnonzero(d == 1); en = np.flatnonzero(d == -1)",
    "        if not len(st):",
    "            rows.append((0, 0)); continue",
    "        k = int(np.argmax(en - st)); run = int(en[k] - st[k])",
    "        rows.append((run, int(st[k]) + run // 2))",
    "        best_run = max(best_run, run)",
    "    if best_run < w * 0.08:",
    "        return None",
    "    thresh = max(int(best_run * 0.6), int(w * 0.08))",
    "    blocks = []; cur = None; last = -999",
    "    for i, (run, cx) in enumerate(rows):",
    "        if run >= thresh:",
    "            if cur is not None and i - last <= 32:",
    "                cur['bot'] = i; cur['runs'].append((run, cx))",
    "            else:",
    "                if cur: blocks.append(cur)",
    "                cur = {'top': i, 'bot': i, 'runs': [(run, cx)]}",
    "            last = i",
    "    if cur: blocks.append(cur)",
    "    if not blocks: return None",
    "    bl = max(blocks, key=lambda b: sum(x[0] for x in b['runs']))",
    "    bh = (bl['bot'] - bl['top'] + 1) * 2",
    "    bw = max(x[0] for x in bl['runs'])",
    "    cx = int(np.mean([x[1] for x in bl['runs']])) + x1",
    "    asp = bw / max(1, bh)",
    "    if not (w*0.10 <= bw <= w*0.32): return None",
    "    if not (h*0.025 <= bh <= h*0.20): return None",
    "    if not (1.6 <= asp <= 6.5): return None",
    "    return dict(x=cx-bw//2, y=y1+bl['top']*2, w=bw, h=bh, cx=cx,",
    "                cy=y1+bl['top']*2+bh//2, fill=1.0, area=bw*bh)",
    "",
    "def find_reward_button(img):",
    "    `"`"`"Кнопка внизу по центру: белая «ЗАБРАТЬ ВСЁ» или кремовая «ПОЛУЧИТЬ ВСЁ».`"`"`"",
    "    best = None",
    "    for mode, fill_min in ((`"cream`", CFG['rewardFillMin']), (`"white`", 0.50)):",
    "        for c in mask_clusters(img, CFG['regRewardBtn'], mode, 16, 4, 3):",
    "            asp = c['w']/max(1, c['h'])",
    "            if c['w'] < img.shape[1]*CFG['rewardBtnMinW']: continue",
    "            if not (img.shape[1]*0.30 <= c['cx'] <= img.shape[1]*0.70): continue",
    "            if not (CFG['rewardBtnAspect'][0] <= asp <= CFG['rewardBtnAspect'][1]): continue",
    "            if c['fill'] < fill_min: continue",
    "            if best is None or c['area'] > best['area']:",
    "                best = dict(c, kind=mode)",
    "    return best",
    "",
    "def gold_ratio(img, x1, y1, x2, y2):",
    "    sub = img[max(0, y1):y2:3, max(0, x1):x2:3].astype(np.int16)",
    "    if sub.size == 0: return 0.0",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    return float(((r >= 200) & (g >= 120) & (g <= 215) & (b <= 110)).mean())",
    "",
    "def light_ratio(img, x1, y1, x2, y2):",
    "    sub = img[max(0, y1):y2:3, max(0, x1):x2:3].astype(np.int16)",
    "    if sub.size == 0: return 0.0",
    "    b, g, r = sub[:, :, 0], sub[:, :, 1], sub[:, :, 2]",
    "    return float(((r >= 225) & (g >= 215) & (b >= 170)).mean())",
    "",
    "def rare_banner(img):",
    "    `"`"`"Баннер «ВАША НАХОДКА» (скин/машина/жетон) сверху по центру кадра.`"`"`"",
    "    h, w = img.shape[:2]",
    "    x1, y1, x2, y2 = int(CFG['regBanner'][0]*w), int(CFG['regBanner'][1]*h), \",
    "                     int(CFG['regBanner'][2]*w), int(CFG['regBanner'][3]*h)",
    "    g = gold_ratio(img, x1, y1, x2, y2)",
    "    light = light_ratio(img, x1, y1, x2, y2)",
    "    # буквы занимают мало места: много света = картинка/видео, а не баннер",
    "    if light > CFG['bannerLightMax']:",
    "        return False",
    "    if g < CFG['bannerGoldMin'] or light < CFG['bannerLightMin']:",
    "        return False",
    "    return gold_band_rows(img, x1, y1, x2, y2) >= CFG['bannerBandRows']",
    "",
    "",
    "def gold_band_rows(img, x1, y1, x2, y2):",
    "    `"`"`"Сколько строк почти целиком золотые: у баннера — десятки, у фото — 0.`"`"`"",
    "    roi = img[y1:y2, x1:x2].astype(int)",
    "    b, g, r = roi[:, :, 0], roi[:, :, 1], roi[:, :, 2]",
    "    gold = (r >= 140) & (g >= 80) & (g <= 200) & (b <= 90) & ((r - b) >= 80)",
    "    return int((gold.sum(axis=1) > gold.shape[1] * 0.5).sum())",
    "",
    "def rare_hit(img):",
    "    `"`"`"Должен ли бот нажать «\\»: жетон или баннер находки.`"`"`"",
    "    tok = find_token(img)",
    "    if tok: return `"жетон`", tok",
    "    if rare_banner(img): return `"баннер`", None",
    "    return None, None",
    "",
    "def find_token(img):",
    "    `"`"`"Жетон пиратского магазина: белая вытянутая «F» в золотом круге.`"`"`"",
    "    h, w = img.shape[:2]",
    "    for c in mask_clusters(img, CFG['regToken'], `"pure`", 14, 4, 6):",
    "        asp = c['w']/max(1, c['h'])",
    "        if not (CFG['tokenAspect'][0] <= asp <= CFG['tokenAspect'][1]): continue",
    "        if not (CFG['tokenFill'][0] <= c['fill'] <= CFG['tokenFill'][1]): continue",
    "        if not (w*CFG['tokenW'][0] <= c['w'] <= w*CFG['tokenW'][1]): continue",
    "        if not (h*CFG['tokenH'][0] <= c['h'] <= h*CFG['tokenH'][1]): continue",
    "        g = gold_ratio(img, c['x']-c['w'], c['y']-c['h'], c['x']+2*c['w'], c['y']+2*c['h'])",
    "        if g < CFG['tokenGoldMin']: continue",
    "        return dict(c, gold=round(g, 2))",
    "    return None",
    "",
    "def detect_state(img):",
    "    res = yellow_buttons(img, CFG['regResults'])",
    "    if res: return `"END_SCREEN`", dict(btn=res[0])",
    "",
    "    death = bright_ratio(img, CFG['regDeath'], 200)",
    "    if death >= CFG['deathBrightMin'] and in_match_hud(img)[0]:",
    "        return `"DEATH`", dict(death=death)",
    "",
    "    hud, slots, hp_run = in_match_hud(img)",
    "    if hud: return `"GAME`", dict(slots=slots, hp=hp_run)",
    "",
    "    lob = lobby_button(img)",
    "    if not lob:",
    "        ys = yellow_buttons(img, CFG['regLobbyBtn'])",
    "        lob = ys[-1] if ys else None",
    "    if lob: return `"MENU`", dict(btn=lob)",
    "",
    "    cr = cream_button(img, CFG['regLobbyBtn'])",
    "    if cr: return `"MATCHMAKING`", dict(btn=cr)",
    "",
    "    if CFG.get('featReward', True):",
    "        rb = find_reward_button(img)",
    "        if rb: return `"REWARD`", dict(btn=rb)",
    "",
    "    if dark_ratio(img) >= CFG['endDarkRatio']: return `"END_SCREEN`", dict(dark=True)",
    "    return `"UNKNOWN`", dict()",
    "",
    "",
    "# ======================= проход по папке и отчёт =========================",
    "EXTS = (`".png`", `".jpg`", `".jpeg`", `".bmp`", `".webp`")",
    "",
    "# Ширина и 16:9 — граница «настоящий кадр игры» / «картинка из набора данных».",
    "FRAME_MIN_W = 800",
    "",
    "",
    "def img_size(path):",
    "    `"`"`"Размер картинки по заголовку файла, без распаковки пикселей.",
    "",
    "    Нужно, чтобы за секунды понять, сколько в папке НАСТОЯЩИХ кадров игры:",
    "    у пользователя в snapshots лежат 5470 картинок 416x416 из набора данных,",
    "    и честно считать их «кадрами» — значит час работы ради нуля пользы.",
    "    `"`"`"",
    "    try:",
    "        with open(path, `"rb`") as f:",
    "            head = f.read(32)",
    "            if head[:2] == b`"\xff\xd8`":                  # JPEG",
    "                f.seek(2)",
    "                while True:",
    "                    b = f.read(1)",
    "                    while b and b != b`"\xff`":",
    "                        b = f.read(1)",
    "                    while b == b`"\xff`":",
    "                        b = f.read(1)",
    "                    if not b:",
    "                        return 0, 0",
    "                    m = b[0]",
    "                    if m == 0x01 or 0xD0 <= m <= 0xD9:",
    "                        continue",
    "                    ln = f.read(2)",
    "                    if len(ln) < 2:",
    "                        return 0, 0",
    "                    n = (ln[0] << 8) | ln[1]",
    "                    if 0xC0 <= m <= 0xCF and m not in (0xC4, 0xC8, 0xCC):",
    "                        d = f.read(5)",
    "                        if len(d) < 5:",
    "                            return 0, 0",
    "                        h = (d[1] << 8) | d[2]",
    "                        w = (d[3] << 8) | d[4]",
    "                        return w, h",
    "                    f.seek(n - 2, 1)",
    "            if head[:8] == b`"\x89PNG\r\n\x1a\n`":",
    "                d = head[16:24]",
    "                return (int.from_bytes(d[:4], `"big`"),",
    "                        int.from_bytes(d[4:8], `"big`"))",
    "            if head[:2] == b`"BM`":                          # BMP",
    "                d = head[18:26]",
    "                if len(d) < 8:",
    "                    return 0, 0",
    "                return (int.from_bytes(d[:4], `"little`"),",
    "                        abs(int.from_bytes(d[4:8], `"little`")))",
    "    except OSError:",
    "        return 0, 0",
    "    return 0, 0",
    "",
    "",
    "def frame_kind(w, h):",
    "    `"`"`"frame — настоящий кадр игры (можно сверять пороги), thumb — картинка из",
    "    набора данных/миниатюра (сверять по ней нечего).`"`"`"",
    "    if not w or not h:",
    "        return `"frame`"          # размер не прочитали — лучше проверить",
    "    if w < FRAME_MIN_W:",
    "        return `"thumb`"",
    "    if w / float(h) < 1.35:     # квадратные и вертикальные — не экран игры",
    "        return `"thumb`"",
    "    return `"frame`"",
    "",
    "",
    "def mini_candidate_tile(tile):",
    "    `"`"`"Только эксперимент для отчёта, не распознавание предметов в AHK.",
    "",
    "    Порог подогнан на нескольких связанных кадрах. Пейзаж под прозрачным HUD",
    "    может подходить под правило; наличие/отсутствие предмета не подтверждается.",
    "    `"`"`"",
    "    if tile.size == 0:",
    "        return False",
    "    a = cv2.resize(tile, (50, 50), interpolation=cv2.INTER_AREA).astype(np.int16)",
    "    b, g, r = a[:, :, 0], a[:, :, 1], a[:, :, 2]",
    "    green = (g > 70) & (g > r + 35) & (g > b + 20)",
    "    mask = ((b > 130) & (g > 105) & (b > r + 38) & (g > r + 30) & (b > g + 5)).astype(np.uint8)",
    "    n, _, stats, _ = cv2.connectedComponentsWithStats(mask, 8)",
    "    if n <= 1:",
    "        return False",
    "    _, _, width, height, area = max(stats[1:], key=lambda x: x[4])",
    "    return bool(green.mean() > 0.30 and 55 <= area <= 350",
    "                and 7 <= width <= 26 and 9 <= height <= 29)",
    "",
    "",
    "def mini_candidates_experimental(img):",
    "    `"`"`"Грубая геометрия HUD из кадров пользователя; не универсальна.",
    "    Цифры — номера областей 1..5, лишь гипотезы; могут быть вообще не слотами.",
    "    `"`"`"",
    "    h, w = img.shape[:2]",
    "    if frame_kind(w, h) != `"frame`":",
    "        return []",
    "    k = w / 1280.0",
    "    xend, bottom = round(w - 25 * k), round(h - 40 * k)",
    "    size, gap = max(1, round(50 * k)), max(1, round(57 * k))",
    "    result = []",
    "    for slot in range(1, 6):",
    "        x, y = xend - size - (5 - slot) * gap, bottom - size",
    "        if x < 0 or y < 0 or x + size > w or bottom > h:",
    "            continue",
    "        if mini_candidate_tile(img[y:bottom, x:x + size]):",
    "            result.append(slot)",
    "    return result",
    "",
    "",
    "def mini_stripe_candidates_experimental(img):",
    "    `"`"`"Координаты цветовых кандидатов для ОФЛАЙН отчёта, не управление.",
    "",
    "    Ищет полосу редкости, затем компактный голубой компонент внутри плашки.",
    "    Важные пропуски: выделенный слот может иметь белую полосу; другая версия",
    "    HUD, размер/цвет плашки или игра могут отличаться. Порог обучен на малой",
    "    связанной выборке и не подтверждает тип предмета или номер слота.",
    "    `"`"`"",
    "    h, w = img.shape[:2]",
    "    if w < 480 or h == 0 or w / float(h) < 1.35:",
    "        return []",
    "    k = w / 1280.0",
    "    left = max(0, int(w * .72))",
    "    top = max(0, int(h - 150 * k))",
    "    bottom = min(h, int(h - 8 * k))",
    "    if top >= bottom:",
    "        return []",
    "    area = img[top:bottom, left:w].astype(np.int16)",
    "    b, g, r = area[:, :, 0], area[:, :, 1], area[:, :, 2]",
    "    mask = (g >= 135) & (g >= r + 65) & (g >= b + 50)",
    "    size = max(1, round(50 * k))",
    "    candidates = []",
    "    for yi, row in enumerate(mask):",
    "        runs = np.diff(np.r_[0, row.astype(np.int8), 0])",
    "        starts, ends = np.flatnonzero(runs == 1), np.flatnonzero(runs == -1)",
    "        for start, end in zip(starts, ends):",
    "            if not (33 * k <= end - start <= 62 * k):",
    "                continue",
    "            mid, y = left + int((start + end) // 2), top + yi",
    "            x, y0 = round(mid - size / 2), round(y - 46 * k)",
    "            if x < 0 or y0 < 0 or x + size > w or y0 + size > h:",
    "                continue",
    "            if any(abs(x - t[0]) < 12 * k and abs(y0 - t[1]) < 12 * k for t in candidates):",
    "                continue",
    "            tile = img[y0:y0 + size, x:x + size]",
    "            if not mini_candidate_tile(tile):",
    "                continue",
    "            a = cv2.resize(tile, (50, 50), interpolation=cv2.INTER_AREA).astype(np.int16)",
    "            b, g, r = a[:, :, 0], a[:, :, 1], a[:, :, 2]",
    "            blue = ((b > 130) & (g > 105) & (b > r + 38) & (g > r + 30) & (b > g + 5)).astype(np.uint8)",
    "            n, _, stats, _ = cv2.connectedComponentsWithStats(blue, 8)",
    "            if n <= 1:",
    "                continue",
    "            cx, cy, cw, ch, _ = max(stats[1:], key=lambda z: z[4])",
    "            if cx < 5 or cy < 4 or cx + cw > 45 or cy + ch > 42:",
    "                continue",
    "            candidates.append((int(x), int(y0), int(size)))",
    "            if len(candidates) >= 8:",
    "                return candidates",
    "    return candidates",
    "",
    "",
    "def scan_file(path, root):",
    "    img = cv2.imread(path)",
    "    if img is None:",
    "        return None",
    "    h, w = img.shape[:2]",
    "    state, _info = detect_state(img)",
    "    hp = measure_bar(img, CFG[`"regHp`"], `"hp`")",
    "    hp_pct, shield_pct = estimate_bars(img)",
    "    chest = find_chest(img)",
    "    loot = find_loot(img)",
    "    # v7.5: врага ищем тремя каналами — как и сам бот:",
    "    #   1) полоска HP (главный признак);",
    "    #   2) разметка набора (в кропах полоски обрезаны, а бокс врага есть);",
    "    #   3) «фигура» — силуэт по перепадам (запасной канал).",
    "    fkind = frame_kind(w, h)",
    "    enemy = find_enemy(img)",
    "    if enemy is None:",
    "        enemy = find_enemy_label(path, img)",
    "    if enemy is None and fkind == `"frame`":",
    "        # «фигуру» ищем ТОЛЬКО на кадрах игры: в миниатюрах набора любой силуэт",
    "        # даёт ложную цель и портит итог",
    "        enemy = find_figure(img)",
    "    # Только горизонтальная близость кандидата к центру, не тест наводки.",
    "    aim_px, aim_ok = -1, False",
    "    if enemy:",
    "        aim_px = int(abs(enemy[`"cx`"] - w // 2))",
    "        aim_ok = aim_px <= max(46, int(w * 0.04))",
    "    # v7.8: подсказка игры «E ОБЫСКАТЬ / ПОДОБРАТЬ» — по ней бот жмёт E",
    "    prompt = find_interact_prompt(img)",
    "    hud, slots, _run = in_match_hud(img)",
    "    return dict(",
    "        file=os.path.relpath(path, root), w=w, h=h, state=state,",
    "        hp=hp[1] if isinstance(hp, tuple) else 0,",
    "        hp_pct=hp_pct, shield_pct=shield_pct,",
    "        mini_candidates=`"|`".join(map(str, mini_candidates_experimental(img))),",
    "        mini_stripe_xy=`"|`".join(`"%d,%d,%d`" % p for p in mini_stripe_candidates_experimental(img)),",
    "        chest_px=chest[`"area`"] if chest else 0,",
    "        loot_px=loot[`"area`"] if loot else 0,",
    "        enemy_px=(enemy[`"w`"] if enemy else 0),",
    "        enemy_src=(enemy[`"src`"] if enemy else `"`"),",
    "        aim_px=aim_px, aim_ok=aim_ok,",
    "        prompt=(prompt[`"span`"] if prompt else 0),",
    "        hud=hud, slots=round(slots, 3), kind=frame_kind(w, h),",
    "    )",
    "",
    "",
    "def collect(folder):",
    "    files = []",
    "    for root, _dirs, names in os.walk(folder):",
    "        for f in names:",
    "            if f.lower().endswith(EXTS):",
    "                files.append(os.path.join(root, f))",
    "    files.sort()",
    "    return files",
    "",
    "",
    "LINES = []",
    "",
    "",
    "def out(text=`"`"):",
    "    `"`"`"Печать + запоминание строки для --out.`"`"`"",
    "    print(text)",
    "    LINES.append(text)",
    "",
    "",
    "def verdict(rows):",
    "    `"`"`"Эвристики диагностики, а не измерение точности или действий в игре.`"`"`"",
    "    out(`"`")",
    "    out(`"ВЕРДИКТ: приблизительная диагностика статических картинок`")",
    "    if not rows:",
    "        out(`"  Нет изображений для анализа.`")",
    "        return",
    "    thumb = sum(r.get(`"kind`") == `"thumb`" for r in rows)",
    "    unk = sum(r[`"state`"] == `"UNKNOWN`" for r in rows)",
    "    pm = sum(bool(r.get(`"prompt`")) for r in rows)",
    "    out(`"  Всего %d; классифицированы по размеру как миниатюры: %d.`" % (len(rows), thumb))",
    "    out(`"  Размер не подтверждает, что изображение является кадром Fortnite.`")",
    "    out(`"  Сцена UNKNOWN: %d; кандидаты на плашку взаимодействия: %d.`" % (unk, pm))",
    "    out(`"  Оценка HP/щита: -1 означает неизвестно, а не ноль; не равна подтверждению.`")",
    "    out(`"  Плашка не читается как E: возможны пропуски и ложные срабатывания.`")",
    "    out(`"  Кандидат на врага, горизонтальный допуск и HUD не подтверждают`")",
    "    out(`"  правильное распознавание, действия, попадания или частоту бота.`")",
    "    out(`"  Сверяйте с исходными изображениями; настройки автоматически не меняются.`")",
    "",
    "",
    "def main():",
    "    ap = argparse.ArgumentParser()",
    "    ap.add_argument(`"folder`", nargs=`"?`", default=`"`")",
    "    ap.add_argument(`"--csv`", default=`"`")",
    "    ap.add_argument(`"--out`", default=`"`", help=`"писать текст отчёта ещё и в файл`")",
    "    ap.add_argument(`"--limit`", type=int, default=0,",
    "                    help=`"сколько кадров считать (0 = все). 300 хватает для сверки порогов`")",
    "    ap.add_argument(`"--step`", type=int, default=0,",
    "                    help=`"брать каждый K-й кадр (0 = подобрать автоматически под --limit)`")",
    "    args = ap.parse_args()",
    "",
    "    # без аргументов: берём snapshots рядом со скриптом, затем его папку",
    "    if not args.folder:",
    "        here = os.path.dirname(os.path.abspath(__file__))",
    "        for cand in (os.path.join(here, `"snapshots`"), here):",
    "            if os.path.isdir(cand) and collect(cand):",
    "                args.folder = cand",
    "                out(`"папка не указана — беру: `" + cand)",
    "                break",
    "    if not args.folder:",
    "        out(`"не нашёл кадров рядом со скриптом.`")",
    "        out(`"укажите папку: python photo_check.py \`"C:\\путь\\к\\папке\`"`")",
    "        if sys.stdin.isatty():",
    "            input(`"\nНажмите Enter, чтобы закрыть…`")",
    "        return 1",
    "    if not os.path.isdir(args.folder):",
    "        out(`"нет такой папки: `" + args.folder)",
    "        return 1",
    "    files = collect(args.folder)",
    "    if not files:",
    "        out(`"в папке нет картинок (`" + `", `".join(EXTS) + `")`")",
    "        return 1",
    "",
    "    total_found = len(files)",
    "    # Делим папку на настоящие кадры игры и всё остальное (миниатюры набора",
    "    # данных). Кадры игры берём ВСЕГДА: их единицы, и именно они показывают,",
    "    # правильно ли бот видит игру. Остальное — ровно по папке.",
    "    real, rest = [], []",
    "    for p in files:",
    "        w, h = img_size(p)",
    "        (real if frame_kind(w, h) == `"frame`" else rest).append(p)",
    "    if args.step > 1:",
    "        picked = real + rest[::args.step]",
    "    elif args.limit and total_found > args.limit:",
    "        picked = real[:args.limit]",
    "        left = args.limit - len(picked)",
    "        if left > 0 and rest:",
    "            k = max(1, len(rest) // left)",
    "            picked += rest[::k][:left]",
    "    else:",
    "        picked = files",
    "    files = picked",
    "    if len(files) != total_found:",
    "        out(`"файлов в папке: %d · размер frame: %d · размер thumb: %d · считаю %d`"",
    "            % (total_found, len(real), len(rest), len(files)))",
    "",
    "    rows = []",
    "    for p in files:",
    "        r = scan_file(p, args.folder)",
    "        if r:",
    "            rows.append(r)",
    "        if len(rows) % 200 == 0 and rows:",
    "            out(`"  ... обработано %d`" % len(rows))",
    "",
    "    out(`"`")",
    "    out(`"%-30s %-10s %-10s %4s %6s %6s %5s %-9s %-8s %4s %6s`"",
    "          % (`"файл`", `"кадр`", `"сцена`", `"HP`", `"сундук`", `"лут`", `"враг`", `"канал`",",
    "             `"отступ X`", `"HUD?`", `"E?`"))",
    "    out(`"  HP в таблице — длина серии пикселей; оценки HP/щита в процентах — в CSV.`")",
    "    out(`"-`" * 111)",
    "    for r in rows[:400]:",
    "        out(`"%-30s %-10s %-10s %4d %6d %6d %5s %-9s %-8s %4s %6s`"",
    "              % (r[`"file`"][-30:], `"%dx%d`" % (r[`"w`"], r[`"h`"]), r[`"state`"],",
    "                 r[`"hp`"], r[`"chest_px`"], r[`"loot_px`"],",
    "                 r[`"enemy_px`"] if r[`"enemy_px`"] else `"нет`",",
    "                 r.get(`"enemy_src`") or `"-`",",
    "                 (`"X %d px`" % r[`"aim_px`"]) if r.get(`"aim_px`", -1) >= 0 else `"-`",",
    "                 `"да`" if r[`"hud`"] else `"нет`",",
    "                 (`"%d px`" % r[`"prompt`"]) if r.get(`"prompt`") else `"-`"))",
    "    if len(rows) > 400:",
    "        out(`"... показаны первые 400 из %d (все — в csv)`" % len(rows))",
    "",
    "    out(`"`")",
    "    out(`"ЭКСПЕРИМЕНТ: кандидаты миников по цвету и примерным координатам HUD`")",
    "    out(`"  Это отдельный Python-тест, НЕ детектор AHK. Известны ложные кандидаты`")",
    "    out(`"  на пустом прозрачном слоте в полёте; не использовать для лечения.`")",
    "    out(`"  Числа — предполагаемые номера слотов; отсутствие не доказывает, что миников нет.`")",
    "    candidates = [r for r in rows if r.get(`"mini_candidates`")]",
    "    for r in candidates[:100]:",
    "        out(`"  %s: предполагаемые области %s`" % (r[`"file`"], r[`"mini_candidates`"]))",
    "    if not candidates:",
    "        out(`"  Кандидаты не найдены.`")",
    "    elif len(candidates) > 100:",
    "        out(`"  ... показаны первые 100 из %d; все — в CSV`" % len(candidates))",
    "    out(`"`")",
    "    out(`"ДОПОЛНИТЕЛЬНЫЙ ЭКСПЕРИМЕНТ: поиск по зелёной полосе плашки`")",
    "    out(`"  x,y,размер — предположительная область, а не номер слота. Ложные`")",
    "    out(`"  кандидаты и пропуски возможны; выделенный слот и старый HUD могут не подойти.`")",
    "    out(`"  Используется только в Python-отчёте, не управляет игрой и не размечает данные.`")",
    "    found = [r for r in rows if r.get(`"mini_stripe_xy`")]",
    "    for r in found[:100]:",
    "        out(`"  %s: %s`" % (r[`"file`"], r[`"mini_stripe_xy`"]))",
    "    if not found:",
    "        out(`"  Кандидаты не найдены; это не доказывает отсутствие миников.`")",
    "    elif len(found) > 100:",
    "        out(`"  ... показаны первые 100 из %d; все — в CSV`" % len(found))",
    "    out(`"-`" * 92)",
    "    stats = {}",
    "    for r in rows:",
    "        stats[r[`"state`"]] = stats.get(r[`"state`"], 0) + 1",
    "    out(`"кадров: %d`" % len(rows))",
    "    out(`"сцены: `" + `", `".join(`"%s=%d`" % (k, v) for k, v in sorted(stats.items())))",
    "    # Итоги по сундуку/луту/врагу/HP считаем ТОЛЬКО по кадрам игры: в миниатюрах",
    "    # набора данных цветных пятен сколько угодно, и они портят картину.",
    "    gm = [r for r in rows if r.get(`"kind`") != `"thumb`"]",
    "    base = gm if gm else rows",
    "    out(`"по выборке: кандидаты сундук %d · лут %d · враг %d · HUD %d · HP %d`"",
    "          % (sum(1 for r in base if r[`"chest_px`"]),",
    "             sum(1 for r in base if r[`"loot_px`"]),",
    "             sum(1 for r in base if r[`"enemy_px`"]),",
    "             sum(1 for r in base if r[`"hud`"]),",
    "             sum(1 for r in base if r[`"hp`"])))",
    "    # v7.5: «прогон не заметил, что бот наводится на противника» — теперь в",
    "    # отчёте отдельная строка: сколько кадров с целью и в скольких бот попал",
    "    # бы прицелом (промах меньше допуска 46 px).",
    "    srcs = {}",
    "    for r in base:",
    "        k = r.get(`"enemy_src`") or `"`"",
    "        if k:",
    "            srcs[k] = srcs.get(k, 0) + 1",
    "    with_enemy = [r for r in base if r[`"enemy_px`"]]",
    "    aimed = [r for r in with_enemy if r.get(`"aim_ok`")]",
    "    if with_enemy:",
    "        out(`"кандидаты на цель: %d (%s); из них в горизонтальном допуске: %d из %d`"",
    "              % (len(with_enemy),",
    "                 `", `".join(`"%s=%d`" % kv for kv in sorted(srcs.items())) or `"—`",",
    "                 len(aimed), len(with_enemy)))",
    "        out(`"  Горизонтальный допуск не проверяет вертикаль, действия или точность.`")",
    "        out(`"  Это отдельная Python-эвристика, не точная модель текущего AHK.`")",
    "    else:",
    "        out(`"кандидат на цель не найден. Это не доказывает отсутствие врагов.`")",
    "    unk = [r[`"file`"] for r in base if r[`"state`"] == `"UNKNOWN`"]",
    "    if unk:",
    "        out(`"НЕ РАСПОЗНАНО (%d): %s%s`"",
    "              % (len(unk), `", `".join(unk[:8]), `" ...`" if len(unk) > 8 else `"`"))",
    "    sizes = {}",
    "    for r in rows:",
    "        sizes[`"%dx%d`" % (r[`"w`"], r[`"h`"])] = sizes.get(`"%dx%d`" % (r[`"w`"], r[`"h`"]), 0) + 1",
    "    top = sorted(sizes.items(), key=lambda kv: -kv[1])[:5]",
    "    out(`"размеры кадров: `" + `", `".join(`"%s=%d`" % (k, v) for k, v in top))",
    "",
    "    verdict(rows)",
    "",
    "    if args.csv and rows:",
    "        with open(args.csv, `"w`", newline=`"`", encoding=`"utf-8`") as f:",
    "            wr = csv.DictWriter(f, fieldnames=list(rows[0].keys()))",
    "            wr.writeheader()",
    "            wr.writerows(rows)",
    "        out(`"подробный отчёт: `" + args.csv)",
    "    out(`"ГОТОВО`")",
    "    if not args.csv and sys.stdin.isatty():",
    "        # двойной клик: без этого окно закроется и результат никто не увидит",
    "        if not args.out:",
    "            try:",
    "                with open(os.path.join(os.path.dirname(os.path.abspath(__file__)),",
    "                                       `"photo_check_out.txt`"), `"w`", encoding=`"utf-8`") as f:",
    "                    f.write(`"\n`".join(LINES) + `"\n`")",
    "                out(`"отчёт сохранён: photo_check_out.txt`")",
    "            except OSError:",
    "                pass",
    "        input(`"\nНажмите Enter, чтобы закрыть…`")",
    "    if args.out:",
    "        try:",
    "            with open(args.out, `"w`", encoding=`"utf-8`") as f:",
    "                f.write(`"\n`".join(LINES) + `"\n`")",
    "        except OSError as e:",
    "            print(`"не смог записать отчёт: %s`" % e)",
    "    return 0",
    "",
    "",
    "if __name__ == `"__main__`":",
    "    sys.exit(main())",
]
