PanelRelease() {
    global UI
    p := UI.panel
    UI.panel := 0
    if UI.detailGui
        try UI.detailGui.Destroy()
    UI.detailGui := 0, UI.detailOpen := false
    if p {
        OnMessage(0x2B, PanelDrawButton, 0)
        OnMessage(0x4E, PanelDrawSlider, 0)
        if p.token
            DllCall("gdiplus\GdiplusShutdown", "UPtr", p.token)
        if p.gdiModule
            DllCall("kernel32\FreeLibrary", "Ptr", p.gdiModule)
    }
}

PanelPut(control, text) {
    global UI
    cache := UI.panel.values
    if (!cache.Has(control) || cache[control] != text) {
        control.Value := text
        cache[control] := text
    }
}

PanelGo(view) {
    global UI
    p := UI.panel
    if (!p || !p.views.Has(view))
        return
    old := p.view
    if (old != view) {
        if (old != "") {
            for control in p.views[old]
                control.Visible := false
        }
        p.view := view
        PanelBackdrop()
        PanelPut(p.heading, p.titles[view])
        for control in p.views[view]
            control.Visible := true
        if (old != "")
            p.nav[old].Redraw()
        if UI.visible
            p.nav[view].Focus()
        p.nav[view].Redraw()
    }
    if (view = "log")
        RefreshLog()
    else if (view = "finds")
        RefreshPanelFindings(true)
    else if (view = "settings")
        PanelUpdateCoords(true)
    else if (view = "startup")
        RefreshStartupReport()
    UpdateUiStatus()
}

OnPanelThemeChange(theme, *) {
    global CFG, UI
    p := UI.panel, theme := PanelThemeKey(theme)
    if (!p || (CFG.panelTheme = theme && p.themeWarning = ""))
        return
    if (CFG.panelTheme != theme) {
        CFG.panelTheme := theme
        p.colors := PanelPalette(theme), p.gui.BackColor := p.colors.canvas, p.ringKey := -1
        PanelBackdrop()
        for item in p.paint {
            if (item.control.Type != "Slider")
                item.control.SetFont("c" p.colors.%item.tone%)
            item.control.Opt("+Background" p.colors.%item.surface%)
            if item.control.Visible
                item.control.Redraw()
        }
        for _, item in p.buttons {
            if item.control.Visible
                item.control.Redraw()
        }
        ApplyWindowChrome(p.gui.Hwnd, false, theme != "light")
    }
    ; Не записываем настройки игрового ввода или счётчики при смене вида.
    p.themeWarning := ""
    try IniWrite(theme, IniPath(), "ui", "theme")
    catch
        p.themeWarning := "Тема применена, но не записалась в forma.ini. Попробуйте выбрать её ещё раз."
}

ReadPanelFindings(path) {
    ; Не грузим старый журнал целиком и не показываем обрезанную UTF-8 строку.
    if !FileExist(path)
        return ""
    file := FileOpen(path, "r", "UTF-8-RAW")
    try {
        length := file.Length
        size := Min(length, 48 * 1024)
        if !size
            return ""
        raw := Buffer(size + 1, 0), start := length - size
        file.Pos := start
        count := file.RawRead(raw, size), skip := 0
        if start {
            while (skip < count && NumGet(raw, skip, "UChar") != 10)
                skip += 1
            skip += 1
        } else if (count >= 3 && NumGet(raw, 0, "UChar") = 0xEF
            && NumGet(raw, 1, "UChar") = 0xBB && NumGet(raw, 2, "UChar") = 0xBF) {
            skip := 3
        }
        if (skip >= count)
            return ""
        text := StrGet(raw.Ptr + skip, "UTF-8")
    } finally {
        file.Close()
    }
    lines := StrSplit(RTrim(text, "`r`n"), "`n", "`r"), result := ""
    Loop Min(lines.Length, 80)
        result .= lines[lines.Length - A_Index + 1] "`n"
    return RTrim(result, "`n")
}

RefreshPanelFindings(force := false) {
    global CFG, ST, UI
    if !UI.panel
        return
    size := ""
    try size := FileGetSize(CFG.tokenFile)
    key := ST.tokensFound "|" CFG.totalTokens "|" size
    if (!force && key = UI.findingsKey)
        return
    UI.findingsKey := key
    UI.findingsSession.Value := "За сеанс: " ST.tokensFound
    UI.findingsTotal.Value := "Всего: " CFG.totalTokens
    try {
        text := ReadPanelFindings(CFG.tokenFile)
        UI.findingsEdit.Value := text != "" ? text : "Записей пока нет. Источник: ЖЕТОН_НАЙДЕН.txt рядом с FORMA."
    } catch {
        UI.findingsEdit.Value := "Не удалось прочитать ЖЕТОН_НАЙДЕН.txt. Повторите попытку кнопкой «Обновить»."
    }
}

