    "",
    "def region_to_pixels(img, r):",
    "    h, w = img.shape[:2]",
    "    return max(0, int(r[0]*w)), max(0, int(r[1]*h)), min(w, max(1, int(r[2]*w))), min(h, max(1, int(r[3]*h)))",
    "",
    "def mask_clusters(img, region, mode, cell=16, step=4, min_cells=2):",
    "    x1, y1, x2, y2 = region_to_pixels(img, region)",
    "    sub = img[y1:y2, x1:x2].astype(np.int16)",
    "    cells = {}",
    "    for y in range(0, sub.shape[0], step):",
    "        row = sub[y]",
    "        for x in range(0, sub.shape[1], step):",
    "            b, g, r = int(row[x, 0]), int(row[x, 1]), int(row[x, 2])",
    "            if mode == `"yellow`":",
    "                hit = r >= CFG['yRMin'] and g >= CFG['yGMin'] and b <= CFG['yBMax'] and abs(r-g) <= CFG['yRGDelta']",
    "            elif mode == `"cream`":",
    "                hit = r >= CFG['creamMin'] and g >= CFG['creamMin']-10 and CFG['creamBMin'] <= b <= CFG['creamBMax'] and abs(r-g) <= 25",
    "            elif mode == `"gold`":",
    "                hit = r >= 140 and 80 <= g <= 155 and b <= 85 and (r-b) >= 90",
    "            elif mode == `"green`":",
    "                hit = g >= 120 and (g-r) >= 40 and (g-b) >= 40",
    "            elif mode == `"blue`":",
    "                hit = b >= 140 and (b-r) >= 55 and (b-g) >= 20",
    "            elif mode == `"purple`":",
    "                hit = r >= 105 and b >= 145 and (b-g) >= 55 and (r-g) >= 35",
    "            elif mode == `"red`":",
    "                hit = r >= 110 and (r-g) >= 45 and (r-b) >= 45",
    "            elif mode == `"white`":",
    "                hit = r >= 215 and g >= 215 and b >= 205 and abs(r-b) <= 45",
    "            elif mode == `"pure`":",
    "                hit = r >= 245 and g >= 245 and b >= 238",
    "            else:",
    "                raise ValueError(mode)",
    "            if hit:",
    "                key = ((y+y1)//cell, (x+x1)//cell)",
    "                c = cells.get(key)",
    "                if c: c[0] += 1; c[1] += x+x1; c[2] += y+y1",
    "                else: cells[key] = [1, x+x1, y+y1]",
    "    if not cells: return []",
    "    keys = set(cells); out = []",
    "    while keys:",
    "        k0 = keys.pop(); group = [k0]; qi = 0",
    "        while qi < len(group):",
    "            cy, cx = group[qi]",
    "            for dy in (-1, 0, 1):",
    "                for dx in (-1, 0, 1):",
    "                    nk = (cy+dy, cx+dx)",
    "                    if nk in keys: keys.discard(nk); group.append(nk)",
