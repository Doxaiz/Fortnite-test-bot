    ; текущей игре: своя полоса HP есть только внизу слева, а над головой врага
    ; показываются лишь всплывающие ЦИФРЫ УРОНА (белые — по здоровью, синие — по
    ; щиту, золотые — в голову) и, если включена настройка «Визуализация
    ; звуковых эффектов», красные/оранжевые метки выстрелов и шагов (золотые —
    ; сундук, белые — шаги/зверьё). Поэтому детектор врага больше не ищет
    ; «тонкую красную полоску»: он ищет САМОГО ИГРОКА (кожу и силуэт), цифры
    ; урона и метки звука. Старые пороги «полоски» удалены.
    fireTolerancePx: 46,
    fireBurstMs:     220,
    fireCooldownMs:  420,       ; пауза между очередями
    enemyConfirmHits: 2,        ; столько сканов подряд = цель подтверждена
    enemyCenterFrac: 0.40,      ; дальше этого от центра кадра не стреляем
    skinCell:        8,         ; ячейка карты «кожи», px
    skinStep:        6,         ; шаг выборки пикселей в скане фигуры
    skinStepWide:    8,         ; v7.8: широкий скан — крупнее шаг, он реже
    enemySkinMaxPct: 60,        ; кожи почти весь бокс — это стена, песок, кожаная
                                ; постройка (а не игрок)
    ; обратная связь: если бот отстрелял очередь за очередью, а цифр урона нет —
    ; значит «враг» был декорацией. Место запоминается, и бот туда не стреляет.
    fireNoHitMax:    2,         ; столько пробных очередей без цифр урона — и цель
                                ; считается декорацией (бот больше в неё не бьёт)
    fireNoHitMs:     2000,      ; столько ждём цифру урона после очереди
    falseEnemyMs:    7000,      ; место «не врага» помним столько
    falseEnemyPx:    110,       ; и не ближе этого к тому месту
    ; цифры урона и метки выстрела ЖИВУТ около секунды. Если «цифра» стоит на
    ; одном месте много сканов подряд — это иконка предмета, HUD или красная
    ; деталь декорации. Такие места запоминаем и за попадания не считаем.
    transientMaxN:   8,         ; столько сканов подряд на одном месте = декорация
    transientPx:     40,        ; «то же место» — в пределах этого
    enemyMinBoxW:    18,        ; ширина бокса в px при кадре 1280 (мелкие пятна
                                ; вроде камешков и бликов за врага не считаем)
    enemyMaxBoxW:    300,
    enemyMinBoxH:    34,        ; высота: дальний враг ≈ 34 px, ближний — сотни
    enemyMaxBoxH:    470,
    enemyAspectMin:  0.30,      ; ширина/высота: игрок вытянут вертикально
    enemyAspectMax:  1.10,      ; бокс шире, чем высотой — это не человек, а стена
    enemyHeadNarrow: 0.92,      ; голова должна быть УЖЕ плеч (так устроен человек,
                                ; а у камня/стены верх и середина одинаковые)
    enemySkinMinPct: 8,         ; кожи в боксе меньше (%) — это не человек
    enemyHeadFrac:   0.30,      ; голова — верхние 30 % бокса (туда и целимся)
    ; ---- цифры урона: единственное ЧЕСТНОЕ подтверждение попадания ----------
    featDamageAim:   true,      ; наводиться по цифрам урона
    damageScanMs:    70,        ; как часто искать цифры
    damageMinPx:     14,        ; цифра меньше — это блик, больше — надпись
    damageMaxPx:     90,
    damageAspectMin: 0.40,      ; цифры урона идут группой: ширина и высота
    damageAspectMax: 2.50,      ; сопоставимы (одиночная вертикальная палочка —
                                ; это не цифра, а блик на краю объекта)
    damageNearFrac:  0.42,      ; цифра дальше этого от центра — не наша
    damageCrossPx:   18,        ; прицел в центре белый — его за цифру не берём
    ; ---- v7.8: режим игры и подсказка взаимодействия ------------------------
    zeroBuild:       true,      ; ZERO BUILD (так играет пользователь): постройки
