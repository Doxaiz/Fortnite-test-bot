    hkCheck:       "F7",
    hkMenu:        "F1",
    hkVision:      "F3",      ; окно «зрение»: живой кадр с рамками (как в примере)
    visMs:         33,        ; v7.2: окно зрения — до 30 кадров/с (было 250 мс = 4)
    visionReuseMs: 250,       ; v7.6: окно зрения берёт кадр тика, если он свежее
                              ; 250 мс (было 90 — при тике 140 мс почти всегда
                              ; приходилось снимать окно второй раз)
    capSlowMs:     260,       ; порог длительности успешного PrintWindow
    capCooldownMs: 6000,      ; время, когда DC пробуется первым
    ; ---- v7.6: свой датасет для самообучения ----
    autoSnap:      true,      ; сам сохранять кадры матча в snapshots\auto
    autoSnapMs:    1800,      ; не чаще одного кадра за это время
    autoSnapMax:   300,       ; столько кадров за один запуск, потом стоп
