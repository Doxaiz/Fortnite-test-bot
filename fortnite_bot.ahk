    stuckSampleMs: 800,
    stuckCameraQuietMs: 700,
    stuckRecoveryMs: 350,
    stuckRecoveryMax: 2,
    confirmGapMs: 1400,
    promptConfirmHits: 2,
    ; ---- бег / паркур (v5.8) ----
    sprintPct:        85,     ; с таким шансом начинаем отрезок бегом
