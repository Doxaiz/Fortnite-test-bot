}

PanelScale(wDesign, hDesign) {
    w := A_ScreenWidth, h := A_ScreenHeight
    try {
        MonitorGetWorkArea(MonitorGetPrimary(), &l, &t, &r, &b)
        w := r - l, h := b - t
    }
    return Max(0.5, Floor(100 * Min(A_ScreenDPI / 96, (w - 26) / wDesign, (h - 46) / hDesign)) / 100)
}

PanelPos(box) {
    global UI
    s := UI.panel.scale, x := Round(box[1] * s), y := Round(box[2] * s)
    return "x" x " y" y " w" (Round((box[1] + box[3]) * s) - x) " h" (Round((box[2] + box[4]) * s) - y)
}

PanelFont(points, weight, tone := "ink", family := "Segoe UI") {
    global UI
    p := UI.panel
    size := Max(6, Round(points * p.scale * 96 / A_ScreenDPI))
    p.gui.SetFont("s" size " " weight " c" (tone = "Default" ? tone : p.colors.%tone%), family)
}

PanelAdd(kind, box, value, points := 10, weight := "norm", tone := "ink", surface := "card", opts := "") {
    global UI
    p := UI.panel
    if (kind != "Picture")
        PanelFont(points, weight, tone, kind = "Edit" && InStr(opts, "ReadOnly") ? "Consolas" : "Segoe UI")
    control := p.gui.Add(kind, (kind = "DropDownList" ? RegExReplace(PanelPos(box), " h\d+$") : PanelPos(box)) (p.buildView != "" ? " Hidden" : "") " " opts
        . (surface != "" ? " +Background" p.colors.%surface% : "") (kind = "CheckBox" ? " -Theme" : ""), value)
    if (p.buildView != "")
        p.views[p.buildView].Push(control)
    if (surface != "")
        p.paint.Push({control:control, tone:tone, surface:surface})
    return control
}

PanelText(box, value, points := 10, weight := "norm", tone := "ink", surface := "card", opts := "") {
    return PanelAdd("Text", box, value, points, weight, tone, surface, opts)
}

PanelCombo(box, choices) {
    ; Высота DropDownList определяется шрифтом, а не общей сеткой.
    return PanelAdd("DropDownList", box, choices, 10, "norm", "Default", "", "Choose1")
}

PanelButton(box, text, action, style := "normal", surface := "card", key := "", points := 10, name := "") {
    global UI
    p := UI.panel
    control := PanelAdd("Button", box, text, points, "bold", "Default", "", "-Theme" (name != "" ? " v" name : ""))
    ; AHK нормализует стиль при создании Button. Включаем BS_OWNERDRAW после,
    ; сохраняя фокус, клавиатуру и события обычной Win32-кнопки.
    styleBits := DllCall("user32\GetWindowLongW", "Ptr", control.Hwnd, "Int", -16, "UInt")
    DllCall("user32\SetWindowLongW", "Ptr", control.Hwnd, "Int", -16, "UInt", (styleBits & ~0xF) | 0xB, "UInt")
    p.buttons[control.Hwnd] := {control:control, style:style, surface:surface, key:key}
    control.OnEvent("Click", PanelInvoke.Bind(action))
    return control
}

PanelInvoke(action, *) {
    action.Call()
    UpdateUiStatus()
}

PanelRgb(hex) {
    rgb := Integer("0x" hex)
    return (rgb & 0xff) << 16 | (rgb & 0xff00) | (rgb >> 16)
}

PanelFillDc(dc, rect, color) {
    brush := DllCall("gdi32\CreateSolidBrush", "UInt", PanelRgb(color), "Ptr")
    try DllCall("user32\FillRect", "Ptr", dc, "Ptr", rect, "Ptr", brush)
    finally DllCall("gdi32\DeleteObject", "Ptr", brush)
}

PanelFillBox(dc, x, y, w, h, color) {
    if (w <= 0 || h <= 0)
        return
    rect := Buffer(16)
    NumPut("Int", x, "Int", y, "Int", x + w, "Int", y + h, rect)
    PanelFillDc(dc, rect, color)
}

PanelNavIcon(dc, view, x, y, s, color) {
    ; Векторные значки вместо символов из необязательных шрифтов.
    switch view {
        case "home": shapes := [[0,0,5,5], [7,0,5,5], [0,7,5,5], [7,7,5,5]]
        case "log": shapes := [[0,1,2,2], [4,1,8,2], [0,5,2,2], [4,5,8,2], [0,9,2,2], [4,9,8,2]]
        case "settings": shapes := [[0,2,12,2], [3,0,3,6], [0,9,12,2], [8,7,3,6]]
        case "startup": shapes := [[0,0,12,2], [0,0,2,9], [10,0,2,9], [0,7,12,2], [4,10,4,2]]
        default: shapes := [[5,0,2,12], [0,5,12,2], [3,3,6,6]]
    }
    for b in shapes
        PanelFillBox(dc, x + Round(b[1]*s), y + Round(b[2]*s), Max(1, Round(b[3]*s)), Max(1, Round(b[4]*s)), color)
}

PanelDrawSlider(id, info, msg, hwnd) {
    global UI
    p := UI.panel
    if (!p || hwnd != p.gui.Hwnd || !info || NumGet(info, 2 * A_PtrSize, "Int") != -12)
        return
    ; NM_CUSTOMDRAW только для Slider главной панели. Клавиатура и мышь — Win32.
    slider := p.sliders.Get(NumGet(info, 0, "Ptr"), 0)
    if (!slider || NumGet(info, A_PtrSize = 8 ? 24 : 12, "UInt") != 1)
        return
    dc := NumGet(info, A_PtrSize = 8 ? 32 : 16, "Ptr"), c := p.colors
    rect := Buffer(16), thumb := Buffer(16), track := Buffer(16)
    DllCall("user32\GetClientRect", "Ptr", slider.Hwnd, "Ptr", rect)
    SendMessage(0x419, 0, thumb, slider) ; TBM_GETTHUMBRECT
    SendMessage(0x41A, 0, track, slider) ; TBM_GETCHANNELRECT
    PanelFillDc(dc, rect, c.card)
    l := NumGet(track, 0, "Int"), r := NumGet(track, 8, "Int")
    mid := (NumGet(thumb, 0, "Int") + NumGet(thumb, 8, "Int")) // 2
    y := NumGet(rect, 12, "Int") // 2, h := Max(2, Round(4 * p.scale))
    dot := Max(4, Round(6 * p.scale))
    PanelFillBox(dc, l, y - h // 2, r - l, h, c.line)
    PanelFillBox(dc, l, y - h // 2, mid - l, h, slider.Enabled ? c.violet : c.quiet)
    brush := DllCall("gdi32\CreateSolidBrush", "UInt", PanelRgb(slider.Enabled ? c.accent : c.quiet), "Ptr")
    saved := DllCall("gdi32\SaveDC", "Ptr", dc, "Int")
    try {
        DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", brush, "Ptr")
        pen := DllCall("gdi32\GetStockObject", "Int", 8, "Ptr") ; NULL_PEN
        DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", pen, "Ptr")
        DllCall("gdi32\Ellipse", "Ptr", dc, "Int", mid - dot, "Int", y - dot, "Int", mid + dot, "Int", y + dot)
    } finally {
        DllCall("gdi32\RestoreDC", "Ptr", dc, "Int", saved)
        DllCall("gdi32\DeleteObject", "Ptr", brush)
    }
    if slider.Focused
        DllCall("user32\DrawFocusRect", "Ptr", dc, "Ptr", rect)
    return 4 ; CDRF_SKIPDEFAULT
}

PanelDrawButton(id, info, msg, hwnd) {
    global UI, CFG
    p := UI.panel
    if (!p || hwnd != p.gui.Hwnd || !info)
        return
    ; DRAWITEMSTRUCT: hwndItem is 8-byte aligned on x64.
    offset := A_PtrSize = 8 ? 24 : 20
    data := p.buttons.Get(NumGet(info, offset, "Ptr"), 0)
    if !data
        return
    dc := NumGet(info, offset + A_PtrSize, "Ptr"), rect := info + offset + 2 * A_PtrSize
    state := NumGet(info, 16, "UInt"), c := p.colors, kind := data.style
    picked := (kind = "nav" && p.view = data.key) || (kind = "theme" && CFG.panelTheme = data.key)
    disabled := state & 0x4, pressed := state & 0x1, focus := state & 0x10
    base := c.%data.surface%, fill := c.chip, border := c.line, color := c.ink
    if (kind = "nav" || kind = "theme") {
        fill := base, border := base, color := c.muted
        if picked
            fill := c.mark, border := c.line, color := c.accent
    } else if (kind = "primary") {
        fill := c.primary, border := c.violet, color := c.onPrimary
    } else if (kind = "danger") {
        fill := base, border := c.danger, color := c.danger
    }
    if disabled
        fill := base, border := c.line, color := c.quiet
    else if pressed
        fill := c.mark, color := c.accent
    if (focus && !disabled)
        border := c.accent

    l := NumGet(rect, 0, "Int"), t := NumGet(rect, 4, "Int")
    r := NumGet(rect, 8, "Int"), b := NumGet(rect, 12, "Int")
    PanelFillDc(dc, rect, base)
    saved := DllCall("gdi32\SaveDC", "Ptr", dc, "Int")
    brush := DllCall("gdi32\CreateSolidBrush", "UInt", PanelRgb(fill), "Ptr")
    pen := DllCall("gdi32\CreatePen", "Int", 0, "Int", 1, "UInt", PanelRgb(border), "Ptr")
    try {
        DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", brush, "Ptr")
        DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", pen, "Ptr")
        corner := Round((kind = "theme" || kind = "danger" ? 18 : 14) * p.scale)
        DllCall("gdi32\RoundRect", "Ptr", dc, "Int", l, "Int", t, "Int", r, "Int", b, "Int", corner, "Int", corner)
        if (kind = "nav" && picked) {
            accentRect := Buffer(16)
            NumPut("Int", l + 2, "Int", t + 7, "Int", l + 5, "Int", b - 7, accentRect)
            PanelFillDc(dc, accentRect, c.violet)
        }
        if (kind = "nav")
            PanelNavIcon(dc, data.key, l + Round(16 * p.scale), (t + b - Round(12 * p.scale)) // 2, p.scale, color)
        font := DllCall("user32\SendMessageW", "Ptr", data.control.Hwnd, "UInt", 0x31, "Ptr", 0, "Ptr", 0, "Ptr")
        if font
            DllCall("gdi32\SelectObject", "Ptr", dc, "Ptr", font, "Ptr")
        DllCall("gdi32\SetBkMode", "Ptr", dc, "Int", 1)
        DllCall("gdi32\SetTextColor", "Ptr", dc, "UInt", PanelRgb(color))
        textRect := Buffer(16)
        NumPut("Int", l + Round((kind = "nav" ? 39 : 6) * p.scale), "Int", t, "Int", r - Round(6 * p.scale), "Int", b, textRect)
        ; DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX | DT_END_ELLIPSIS
        flags := 0x8824 | (kind = "nav" ? 0 : 1)
        DllCall("user32\DrawTextW", "Ptr", dc, "Str", data.control.Text, "Int", -1, "Ptr", textRect, "UInt", flags)
    } finally {
        DllCall("gdi32\RestoreDC", "Ptr", dc, "Int", saved)
        DllCall("gdi32\DeleteObject", "Ptr", pen)
        DllCall("gdi32\DeleteObject", "Ptr", brush)
    }
    return 1
}

; GDI+ входит в Windows. Рисуются только рамки и декоративные акценты,
; никаких сторонних картинок, браузера или сетевой загрузки.
PanelArtStart(p) {
    p.gdiModule := DllCall("kernel32\LoadLibraryW", "Str", A_WinDir "\System32\gdiplus.dll", "Ptr")
    if !p.gdiModule
        throw Error("Оформление GDI+ недоступно")
    opt := Buffer(A_PtrSize = 8 ? 24 : 16, 0), token := 0
    NumPut("UInt", 1, opt)
    if DllCall("gdiplus\GdiplusStartup", "UPtr*", &token, "Ptr", opt, "Ptr", 0) || !token
        throw Error("Оформление GDI+ недоступно")
    p.token := token
}

class PanelArt {
    bmp := 0
    dc := 0

    __New(w, h, scale, color) {
        bmp := 0, dc := 0
        rc := DllCall("gdiplus\GdipCreateBitmapFromScan0", "Int", Round(w * scale), "Int", Round(h * scale)
            , "Int", 0, "Int", 0x26200A, "Ptr", 0, "Ptr*", &bmp)
        this.bmp := bmp
        if rc || !bmp
            throw Error("Не удалось создать фон панели")
        rc := DllCall("gdiplus\GdipGetImageGraphicsContext", "Ptr", bmp, "Ptr*", &dc)
        this.dc := dc
        if rc || !dc
            throw Error("Не удалось открыть фон панели")
        DllCall("gdiplus\GdipGraphicsClear", "Ptr", dc, "UInt", PanelArt.Color(color))
        DllCall("gdiplus\GdipSetSmoothingMode", "Ptr", dc, "Int", 4)
        DllCall("gdiplus\GdipScaleWorldTransform", "Ptr", dc, "Float", scale, "Float", scale, "Int", 0)
    }

    __Delete() {
        if this.dc
            DllCall("gdiplus\GdipDeleteGraphics", "Ptr", this.dc)
        if this.bmp
            DllCall("gdiplus\GdipDisposeImage", "Ptr", this.bmp)
    }

    static Color(hex) => 0xFF000000 | Integer("0x" hex)

    Rect(x, y, w, h, color) {
        brush := 0
        DllCall("gdiplus\GdipCreateSolidFill", "UInt", PanelArt.Color(color), "Ptr*", &brush)
        try DllCall("gdiplus\GdipFillRectangle", "Ptr", this.dc, "Ptr", brush
            , "Float", x, "Float", y, "Float", w, "Float", h)
        finally DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
    }

    Card(x, y, w, h, radius, color, stroke := "") {
        path := 0, brush := 0, pen := 0, d := radius * 2
        DllCall("gdiplus\GdipCreatePath", "Int", 0, "Ptr*", &path)
        try {
            for corner in [[x,y,180], [x+w-d,y,270], [x+w-d,y+h-d,0], [x,y+h-d,90]]
                DllCall("gdiplus\GdipAddPathArc", "Ptr", path, "Float", corner[1], "Float", corner[2]
                    , "Float", d, "Float", d, "Float", corner[3], "Float", 90)
            DllCall("gdiplus\GdipClosePathFigure", "Ptr", path)
            DllCall("gdiplus\GdipCreateSolidFill", "UInt", PanelArt.Color(color), "Ptr*", &brush)
            DllCall("gdiplus\GdipFillPath", "Ptr", this.dc, "Ptr", brush, "Ptr", path)
            if (stroke != "") {
                DllCall("gdiplus\GdipCreatePen1", "UInt", PanelArt.Color(stroke), "Float", 1, "Int", 2, "Ptr*", &pen)
                DllCall("gdiplus\GdipDrawPath", "Ptr", this.dc, "Ptr", pen, "Ptr", path)
            }
        } finally {
            if pen
                DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
            if brush
                DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
            DllCall("gdiplus\GdipDeletePath", "Ptr", path)
        }
    }

    Gradient(x, y, w, h, a, b) {
        rect := Buffer(16), brush := 0
        NumPut("Float", x, "Float", y, "Float", w, "Float", h, rect)
        DllCall("gdiplus\GdipCreateLineBrushFromRect", "Ptr", rect, "UInt", PanelArt.Color(a)
            , "UInt", PanelArt.Color(b), "Int", 0, "Int", 1, "Ptr*", &brush)
        return brush
    }

    Stroke(brush, width) {
        pen := 0
        DllCall("gdiplus\GdipCreatePen2", "Ptr", brush, "Float", width, "Int", 2, "Ptr*", &pen)
        DllCall("gdiplus\GdipSetPenStartCap", "Ptr", pen, "Int", 2)
        DllCall("gdiplus\GdipSetPenEndCap", "Ptr", pen, "Int", 2)
        return pen
    }

    Ribbon(x, y, w, a, b, slope) {
        brush := this.Gradient(x, y - 8, w, 24, a, b), pen := this.Stroke(brush, 2)
        try DllCall("gdiplus\GdipDrawBezier", "Ptr", this.dc, "Ptr", pen, "Float", x, "Float", y
            , "Float", x + w * 0.33, "Float", y + 24 * slope, "Float", x + w * 0.62, "Float", y - 36 * slope
            , "Float", x + w, "Float", y + 1)
        finally {
            DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
            DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
        }
    }

    Ring(c, percent) {
        pen := 0
        DllCall("gdiplus\GdipCreatePen1", "UInt", PanelArt.Color(c.line), "Float", 8, "Int", 2, "Ptr*", &pen)
        try this.Arc(pen, 360)
        finally DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
        if (percent > 0) {
            brush := this.Gradient(8, 8, 122, 122, c.pink, c.violet), pen := this.Stroke(brush, 8)
            try this.Arc(pen, 3.6 * percent)
            finally {
                DllCall("gdiplus\GdipDeletePen", "Ptr", pen)
                DllCall("gdiplus\GdipDeleteBrush", "Ptr", brush)
            }
        }
    }

    Arc(pen, angle) {
        DllCall("gdiplus\GdipDrawArc", "Ptr", this.dc, "Ptr", pen, "Float", 9, "Float", 9
            , "Float", 120, "Float", 120, "Float", -90, "Float", angle)
    }

    Into(control) {
        bitmap := 0
        if DllCall("gdiplus\GdipCreateHBITMAPFromBitmap", "Ptr", this.bmp, "Ptr*", &bitmap, "UInt", 0xFF000000) || !bitmap
            throw Error("Не удалось отобразить фон панели")
        try control.Value := "HBITMAP:*" bitmap ; копия принадлежит Picture
        finally DllCall("gdi32\DeleteObject", "Ptr", bitmap)
    }
}

PanelBackdrop() {
    global UI
    p := UI.panel, c := p.colors
    art := PanelArt(p.w, p.h, p.scale, c.canvas)
    art.Rect(0, 0, 184, p.h, c.side)
    art.Rect(183, 0, 1, p.h, c.line)
    art.Card(18, 23, 39, 39, 10, c.mark, c.line)
    art.Ribbon(207, 60, 45, c.violet, c.pink, 0)
    art.Card(695, 24, 150, 34, 13, c.chip, c.line)
    art.Rect(206, 72, 852, 1, c.line)
    switch p.view {
        case "home":
            for i, x in [206, 494, 782] {
                art.Card(x, 85, 276, 99, 15, c.card, c.line)
                art.Ribbon(x + 18, 113, 240, i = 1 ? c.cyan : (i = 2 ? c.violet : c.peach)
                    , i = 1 ? c.violet : c.pink, i = 2 ? -0.6 : 0.5)
            }
            art.Card(206, 196, 852, 76, 15, c.card, c.line)
            art.Card(222, 214, 39, 39, 10, c.mark, c.line)
            art.Card(229, 221, 25, 25, 12, c.chip, c.accent)
            art.Card(590, 215, 117, 37, 10, c.chip)
            art.Card(717, 215, 117, 37, 10, c.chip)
            art.Card(206, 284, 268, 236, 15, c.card, c.line)
            art.Card(486, 284, 572, 236, 15, c.card, c.violet)
            art.Card(206, 532, 852, 69, 15, c.card, c.line)
            art.Card(206, 612, 852, 54, 15, c.card, c.line)
        case "settings":
            for x in [206, 638] {
                art.Card(x, 109, 420, 111, 15, c.card, c.line)
                art.Card(x, 232, 420, 111, 15, c.card, c.line)
                art.Card(x, 525, 420, 66, 15, c.card, c.line)
            }
            art.Card(206, 355, 852, 158, 15, c.card, c.line)
            for x in [434, 628, 822]
                art.Card(x, 432, 182, 61, 10, c.well, c.line)
            art.Card(206, 603, 852, 63, 15, c.card, c.line)
        case "startup":
            art.Card(206, 85, 852, 378, 15, c.card, c.line)
            art.Card(206, 475, 852, 191, 15, c.card, c.line)
        case "log", "finds":
            art.Card(206, 85, 852, 581, 15, c.card, c.line)
