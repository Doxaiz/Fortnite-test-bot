    glideMaxPresses:  1,      ; это попытка, не гарантия раскрытия

    ; ---- тайминги ----
    stateConfirmFrames: 2,      ; столько кадров подряд нужно для смены состояния
    rewardConfirmFrames: 8,     ; экран награды подтверждаем дольше (0.4 с)
