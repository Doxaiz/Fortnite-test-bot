; Нативное оформление рамки окна и исключение из захвата (Win10/11).
ApplyWindowChrome(hwnd, hideCapture := true, dark := true) {
    global CFG
    if !hwnd
        return
    ; DWMWA_USE_IMMERSIVE_DARK_MODE = 20 (запасной 19 для ранних сборок Win10)
    darkVal := dark ? 1 : 0
    try {
        if (DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 20, "Int*", &darkVal, "UInt", 4, "Int") != 0)
            DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 19, "Int*", &darkVal, "UInt", 4, "Int")
    }
    ; DWMWA_WINDOW_CORNER_PREFERENCE = 33, DWMWCP_ROUND = 2 (Win11)
    cornerVal := 2
    try DllCall("dwmapi\DwmSetWindowAttribute", "Ptr", hwnd, "UInt", 33, "Int*", &cornerVal, "UInt", 4, "Int")
    ; WDA_EXCLUDEFROMCAPTURE = 0x11: окно бота не перекрывает снимок игры
    if (hideCapture && CFG.hideFromCapture)
        try DllCall("user32\SetWindowDisplayAffinity", "Ptr", hwnd, "UInt", 0x00000011, "Int")
}

