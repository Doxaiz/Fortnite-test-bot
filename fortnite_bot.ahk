UpdateTrayChecks() {
    global CFG, UI
    try {
        if UI.trayModeMenu {
            for label, code in Map(
                "Авто-игра (Zero Build)", "auto",
                "AFK-очередь (цикл матчей)", "queue",
                "Только Анти-АФК (движение)", "antiafk",
                "AFK XP (LEGO / Creative)", "xp") {
                if (CFG.botMode = code)
                    UI.trayModeMenu.Check(label)
                else
                    UI.trayModeMenu.Uncheck(label)
            }
        }
        if UI.trayTimerMenu {
            for label, mins in Map(
                "Без лимита", 0, "30 минут", 30, "1 час", 60,
                "2 часа", 120, "4 часа", 240, "8 часов", 480) {
                if (Round(CFG.stopAfterMin) = mins)
                    UI.trayTimerMenu.Check(label)
                else
                    UI.trayTimerMenu.Uncheck(label)
            }
        }
        if UI.trayPerfMenu {
            for label, pcode in Map(
                "Быстрый (50 мс)", "fast",
                "Сбалансированный (85 мс)", "balanced",
                "Экономия ЦП (150 мс)", "low_cpu") {
                if (CFG.perfProfile = pcode)
                    UI.trayPerfMenu.Check(label)
                else
                    UI.trayPerfMenu.Uncheck(label)
            }
        }
    } catch {
    }
