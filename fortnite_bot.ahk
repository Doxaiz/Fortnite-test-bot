PanelSliderFollow(slider, maxValue, source, *) {
    value := ParseNumSafe(source.Value, -1, 0, maxValue)
    if (value >= 0 && slider.Value != value) {
        slider.Value := value
        slider.Redraw()
    }
}

PanelSliderEdit(edit, slider, *) {
    edit.Value := slider.Value
    slider.Redraw()
}

PanelCanEditTimers() {
    global ST
    return !ST.running && !ST.startWorkers && !ST.stopWorkers && !ST.mouseCalActive
}

OnPanelSaveTimers(*) {
    global CFG, UI
    p := UI.panel
    if (!p || !PanelCanEditTimers())
        return
    changes := []
    for timer in p.timers {
        value := ParseNumSafe(timer.edit.Value, -1, 0, timer.max, timer.integer)
        if (value < 0) {
            PanelPut(p.settingsNote, "Во всех четырёх полях должны быть числа; 0 отключает соответствующий лимит или задержку.")
            return
        }
        changes.Push(value)
    }
    prev := Critical("On")
    try {
        if !PanelCanEditTimers()
            return
        for i, timer in p.timers
            CFG.%timer.key% := changes[i]
    } finally Critical(prev)
    ; Только четыре числа, без перезаписи режима, хоткеев и других параметров.
    ok := true
    for i, timer in p.timers {
        timer.loaded := -1
        try IniWrite(changes[i], IniPath(), "afk", timer.key)
        catch
            ok := false
        if UI.afkGui
            try UI.%timer.legacy%.Value := changes[i]
    }
    UpdateTrayChecks()
    PanelPut(p.settingsNote, ok ? "Таймеры применены и сохранены в forma.ini."
        : "Таймеры применены, но не все параметры записались в forma.ini.")
    Log(ok ? "[i] Быстрые таймеры сохранены." : "[!] Не удалось полностью записать быстрые таймеры в forma.ini.")
}

PanelRefreshSettings() {
    global CFG, UI
    p := UI.panel, canEdit := PanelCanEditTimers()
    for timer in p.timers {
        value := CFG.%timer.key%
        if (timer.loaded != value) {
            timer.loaded := value
            timer.edit.Value := Format("{:g}", value)
            timer.slider.Value := Round(value)
            timer.slider.Redraw()
        }
        timer.edit.Enabled := canEdit, timer.slider.Enabled := canEdit
    }
    p.saveTimers.Enabled := canEdit
    PanelUpdateCoords()
}

PanelClientPreview() {
    global CFG, ST
    ; Только размер: не активируем окно и не меняем ST.cloudTarget или ST.hwnd.
    if ST.hwnd {
        try {
            if (WinGetMinMax("ahk_id " ST.hwnd) != -1) {
                area := GetClientArea(ST.hwnd)
                if area
                    return area
            }
        }
    }
    for criterion in [CFG.winTitle, CFG.winExe] {
        for h in WinGetList(criterion) {
            try {
                if (!IsSelfWindow(h) && WinGetMinMax("ahk_id " h) != -1) {
                    area := GetClientArea(h)
                    if area
                        return area
                }
            }
        }
    }
    return 0
}

PanelUpdateCoords(force := false) {
    global CFG, UI
    p := UI.panel, choice := p.coordPick.Value
    if (choice < 1 || choice > 6)
        choice := 1
    if (force || p.coordChoice != choice) {
        p.coordChoice := choice, p.preview := 0
        switch choice {
            case 2, 3, 4:
                size := [[1920,1080], [2560,1440], [3840,2160]][choice - 1]
                p.preview := {w:size[1], h:size[2]}
            case 5:
                p.preview := {w:A_ScreenWidth, h:A_ScreenHeight}
            case 6:
                try p.preview := PanelClientPreview()
        }
    }
    ref := p.preview ? p.preview : {w:CFG.coordRefW, h:CFG.coordRefH}
    PanelPut(p.coordHint, (choice = 6 && !p.preview) ? "Нет окна · показана база" : ref.w " × " ref.h " · X / Y")
    for i, point in [[CFG.playNormX, CFG.playNormY], [CFG.optNormX, CFG.optNormY], [CFG.leaveNormX, CFG.leaveNormY]]
        PanelPut(p.coordValues[i], Round(point[1] * ref.w) "  /  " Round(point[2] * ref.h))
}

PanelMatchClock(now) {
    global CFG, ST
    applies := CFG.botMode = "auto" || CFG.botMode = "queue"
    limit := Round(CFG.matchMaxMin * 60000)
    if !applies
        return {label:"НЕАКТИВЕН", text:"—", percent:0, note:"Не используется`nв этом режиме"}
    if (limit <= 0)
        return {label:"БЕЗ ЛИМИТА", text:"—", percent:0, note:"Лимит: до конца`nматча"}
    if (ST.running && ST.leaveActive)
        return {label:"ВЫХОД", text:"—", percent:0, note:"В процессе`nвозврата в лобби"}
    if (!ST.running || ST.state != "GAME" || ST.matchStartT <= 0)
        return {label:"ЗАДАНО", text:FmtCountdown(limit), percent:100, note:"Отсчёт начнётся`nв матче"}
    if (ST.paused || ST.cancelHold)
        return {label:"ОЖИДАНИЕ", text:"—", percent:0, note:"Автовыход`nприостановлен"}
    remaining := Clamp(limit - (now - ST.matchStartT), 0, limit)
    return {label:remaining > 0 ? "ДО ВЫХОДА" : "ЛИМИТ ИСТЁК", text:FmtCountdown(remaining)
        , percent:Round(100 * remaining / limit), note:"Лимит: " FmtCountdown(limit) (CFG.dryRun ? "`nDryRun" : "")}
}

PanelUpdateHome() {
    global CFG, ST, UI, LogBuf
    p := UI.panel
    PanelPut(p.scene, !ST.running ? (ST.startWorkers ? "Запуск…" : "Ожидание")
        : (ST.paused ? "Пауза" : (ST.cancelHold ? "Жду игрока" : StateRu(ST.leaveActive ? "LEAVING" : ST.state))))
    PanelPut(p.rounds, ST.rounds (CFG.maxRounds > 0 ? " / " CFG.maxRounds : ""))
    PanelPut(p.elapsed, FmtClock(SessionElapsedSec()))
    PanelPut(p.homeFound, "Сеанс: " ST.tokensFound)
    PanelPut(p.homeTotal, "Всего: " CFG.totalTokens)
    p.resetFinds.Enabled := PanelCanEditTimers() && (ST.tokensFound || CFG.totalTokens)
    PanelPut(p.lastLog, LogBuf.Length ? RegExReplace(LogBuf[-1], "[\r\n].*", " …") : "Новых событий пока нет.")
    PanelPut(p.inputLabel, CFG.dryRun ? "DRYRUN  /  БЕЗ ВВОДА" : "РЕАЛЬНЫЙ ВВОД")
    note := ST.lastAction
    if ST.cancelHold
        note := "Подбор приостановлен. Возобновите очередь вручную."
    else if (note = "")
        note := "Проверьте окно и HUD, затем нажмите «Старт»."
    PanelPut(p.action, note)
    PanelUpdateRing()
}

PanelUpdateRing() {
    global UI
    p := UI.panel
    clock := PanelMatchClock(A_TickCount)
    if (p.ringKey != clock.percent) {
        art := PanelArt(138, 138, p.scale, p.colors.card)
        art.Ring(p.colors, clock.percent)
        art.Into(p.ring)
        p.ringKey := clock.percent
    }
    PanelPut(p.clockLabel, clock.label)
    PanelPut(p.clockValue, clock.text)
    PanelPut(p.clockNote, clock.note)
}

PanelBadge() {
    global CFG, ST
    if ST.macroRec
        return "ЗАПИСЬ МАРШРУТА"
    if (ST.stopActionKind != "")
        return "АВТО-СТОП · " ST.stopActionLeft " с"
    if ST.mouseCalActive
        return "ТЕСТ МЫШИ"
    if !ST.running
        return ST.startWorkers ? "ЗАПУСК" : "СТОП"
    if ST.paused
        return "ПАУЗА"
    if ST.cancelHold
        return "ЖДУ ИГРОКА"
    if ST.finishMatchArmed
        return "ДОИГРЫВАЮ"
    if ST.leaveActive
        return "ВЫХОД В ЛОББИ"
    if (ST.state = "MATCHMAKING")
        return "ИЩУ МАТЧ"
    return CFG.dryRun ? "DRYRUN" : "РАБОТАЕТ"
}

UpdateUiStatus() {
    global CFG, ST, UI
    UpdateStatus()
    p := UI.panel
    if (!p || !UI.visible)
        return
    PanelPut(UI.badge, PanelBadge())
    for i, key in [CFG.hkStart, CFG.hkDry, CFG.hkMenu, "Esc", "Ctrl+F5"]
        PanelPut(p.keys[i], key)
    source := (ST.capW > 0 && ST.capH > 0) ? (ST.capW "×" ST.capH " · " Fps() " к/с") : "нет кадра"
    PanelPut(UI.foot, p.themeWarning != "" ? p.themeWarning : ModeShortRu(CFG.botMode) "  ·  " (CFG.dryRun ? "DryRun" : "Боевой") "  ·  Захват: " source
        . "  ·  Интервал " CFG.loopMs " мс  ·  " CFG.hkHud " мини-HUD  ·  " CFG.hkVision " зрение")
    switch p.view {
        case "home":
            UI.btnStart.Enabled := PanelCanEditTimers() && !ST.macroRec && !ST.macroCountdown && !ST.pickActive
            UI.btnPause.Enabled := ST.running || ST.mouseCalActive
            text := ST.mouseCalActive ? "Отменить тест" : (ST.paused ? "Снять паузу" : "Пауза")
            if (UI.btnPause.Text != text)
                UI.btnPause.Text := text
            UI.btnCont.Enabled := ST.running && ST.cancelHold
            UI.btnBypass.Enabled := ST.running && !ST.paused && !ST.leaveActive && (ST.state = "GAME" || ST.state = "DEATH")
            PanelUpdateHome()
        case "log":
            if p.logDirty
                RefreshLog()
        case "finds":
            RefreshPanelFindings()
        case "settings":
            PanelRefreshSettings()
    }
}

OnPanelResetFinds(*) {
    global CFG, ST, UI
    if (!UI.panel || !PanelCanEditTimers())
        return
    answer := MsgBox("Обнулить счётчики находок за сеанс и за всё время? История и остальные показатели не изменятся."
        , "FORMA — сброс находок", "YesNo Default2 Icon? Owner" UI.gui.Hwnd)
    if (answer != "Yes" || !PanelCanEditTimers())
        return
    try IniWrite(0, IniPath(), "stats", "totalTokens")
    catch {
        Flash("Счётчики не сброшены: не удалось записать forma.ini", 2600)
        return
    }
    ST.tokensFound := 0, CFG.totalTokens := 0
    Log("[i] Счётчики находок сброшены. История сохранена.")
}

