    glideHoldW:    true,        ; в глайдере держать W (летим вперёд)
    airMaxMs:      75000,       ; дольше этого «воздухом» не считаем
    lootPhaseMs:   22000,       ; столько после посадки собираем лут
    featWeaponPick: true,       ; пробовать 1..4; 5 не перебирать для боя
    weaponSlotGapMs: 500,
    weaponCycleMax: 4,          ; 1..4 по просьбе; в 4 может оказаться лечение
    weaponRetryMs:  45000,       ; и через сколько повторить проход, если оружия нет
    hpSeenWindowMs: 25000,      ; столько «МАТЧ» держим без полосы HP (автобус/глайдер)
    prepMaxMs:     60000,       ; столько максимум ждём в предматче (остров ожидания)
    prepSlotsMin:  0.02,        ; в слотах что-то есть => мы уже на земле
    weaponHaveMin: 0.05,        ; v7.6: яркость слотов, при которой считаем,
