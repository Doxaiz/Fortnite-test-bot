            . " Чтобы он реально играл: снимите галочку «Тест: без нажатий» и нажмите Старт снова.")
        Flash("DryRun: только журнал, клавиши не нажимаются", 2500)
    } else {
        Log("[i] подготовка запуска (боевой режим)")
    }
    Log("[i] Режим: " ModeRu(CFG.botMode)
        . (CFG.botMode = "auto" ? (" · " (CFG.teamSafe ? "КОМАНДА (бой вручную)" : "СОЛО (автобой)")) : "")
        . (CFG.smartRestore ? " · Умный фон ВКЛ" : "")
        . (CFG.squadAutoLeave ? " · Выход без отряда ВКЛ" : "")
        . (CFG.matchMaxMin > 0 ? " · матч до " CFG.matchMaxMin " мин" : "")
        . (CFG.stopAfterMin > 0 ? " · стоп через " CFG.stopAfterMin " мин" : ""))
    if (CFG.botMode = "auto") {
        Log("[i] Авто-игра: лечение и перезарядка выполняются игроком вручную; Zero Build без построек.")
    }
    if !StartPermit(startGen)
        return
    CancelStopAction()
    ; Старые отложенные отпускания не относятся к новому запуску.
    InputCancelDeferred()
    if ST.cancelHold {
        ST.cancelHold := false
        ST.queueTries := 0, ST.lastQueueT := 0
