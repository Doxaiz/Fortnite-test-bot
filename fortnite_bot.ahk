SetBadge(txt) {
    ; текст-бейдж в шапке меню; молча ничего не делает, если меню упрощённое
    global UI
    try {
        UI.badge.Value := txt
    } catch {
        try
            UI.badge.Text := txt
    }
}

Rep(ch, n) {
    ; n копий символа — без Format, чтобы не зависеть от версии .NET-формата
    ; ПРЕДОХРАНИТЕЛЬ: пустой символ раньше означал вечный цикл (StrLen("") = 0)
    if (ch = "" || n <= 0)
        return ""
    n := Round(n)
    out := ""
    while (StrLen(out) < n)
        out .= ch
    return out
}

Bar(pct, width := 14) {
    ; текстовая полоса для панели состояния: [██████████░░░░] 87%
    if (pct < 0)
        return "[" Rep("·", width) "]   —"
    n := Clamp(Round(width * pct / 100), 0, width)
    return "[" Rep("█", n) Rep("░", width - n) "] " pct "%"
}

Fps() {
    ; Средняя частота успешных захватов основного цикла за текущий запуск.
    ; Это НЕ частота завершённых анализов и не FPS самой игры; паузы включены.
    global ST
    elapsed := A_TickCount - ST.startedAt
    if (!ST.running || elapsed < 500)
        return 0
    return Round(ST.frames / (elapsed / 1000), 1)
}

UpdateStatus() {
    global CFG, ST, UI, MODEL_LIVE, MODEL_SETUP
    if (!UI.status || !UI.visible)
        return
    up := A_TickCount - ST.startedAt
    upS := Format("{:02}:{:02}:{:02}", up // 3600000, Mod(up // 60000, 60), Mod(up // 1000, 60))
    mode := "СТОП"
    if ST.running
        mode := ST.paused ? "ПАУЗА" : (CFG.dryRun ? "DRY-RUN · не нажимает" : "РАБОТА · нажимает")
    if ST.mouseCalActive
        mode := "МЫШЬ: ТЕСТ / ОЖИДАНИЕ"
    if ST.running && ST.cancelHold
        mode := "ЖДУ ИГРОКА · подбор отменён"
    if ST.running && !ST.cancelHold && !ST.paused && ST.state = "MATCHMAKING"
        mode := "ИЩУ МАТЧ"
    SetBadge("  " mode)

    mm := (ST.mmSince > 0 && ST.running) ? (" · поиск " Round((A_TickCount - ST.mmSince) / 1000) " с") : ""
    hpPct := ST.hpPercent, shPct := ST.shPercent
    dot := "●"
    txt := ""
    txt .= "СЦЕНА   " StateRu(ST.state) mm "`n"
    if ST.cancelHold
        txt .= "ВНИМАНИЕ Подбор остановлен, причина неизвестна — «Играть» не нажимаю.`n"
            . "         Возобновить: F8 или «▶ Поиск».`n"
    txt .= "РЕЖИМ   " (CFG.teamSafe ? "команда · бой вручную" : "соло · бой автоматически") "`n"
    txt .= "ВРЕМЯ   " (ST.running ? upS : "—") "    кадров " ST.frames "`n`n"
    txt .= "ЗДОРОВЬЕ   " Bar(hpPct, 14) "`n"
    txt .= "ЩИТ (оценка)  " Bar(shPct, 14) "`n`n"
    txt .= "ВРАГ   " (ST.enemy ? "кандидат" : "не найден")
        . "    СУНДУК   " (ST.chest ? "кандидат" : "не найден") "`n"
    if MODEL_SETUP.active
        txt .= MODEL_SETUP.progressText "`n"
    else
        txt .= "МОДЕЛЬ (диагностика)   " MODEL_LIVE.status "`n"
    txt .= "ПОПЫТКИ:  сундуки " ST.chests "    лут " ST.loots
        . "    очереди " ST.bursts "`n"
    try {
        UI.status.Value := txt
    } catch {
    }
    try {
        UI.foot.Value := "  " StateRu(ST.state) " · окно " ST.capW "×" ST.capH
            . " · захват в цикле (среднее) " Fps() " кадр/с · " (CFG.dryRun ? "DryRun: клавиши не нажимаются" : "боевой режим")
    } catch {
    }
}

; ------------------------------ обработчики меню ---------------------------
ResetRunDiagnostics() {
    global ST, LogThrMap
    ; Фокус измеряем внутри конкретного запуска, а не с момента старого
    ; Alt+Tab до Stop. Первый новый переход не подавляем старым троттлом.
    ST.focusLostAt := 0, ST.focusBackAt := 0, ST.focusNoteAt := 0, ST.bgWarned := false
    ST.tickProfile := 0, ST.tickMs := 0, ST.lastTickMs := 0
    ST.slowTicks := 0, ST.fastTicks := 0
    for key in ["[focusgrace]", "[focus]", "[tickperf]", "[tickcancel:бюджет]", "[tickcancel:запрос сторожа]"] {
        if LogThrMap.Has(key)
            LogThrMap.Delete(key)
    }
}

ResetSceneEvidence() {
    global ST
    ST.sceneRaw := "", ST.sceneRawAt := 0
    ST.menuCache := 0, ST.scanMenuAt := 0
    ST.lastLobbyAt := 0, ST.playSeenAt := 0, ST.menuSeenAt := 0
    ST.inMatchT := 0, ST.hudLastT := 0, ST.hudWindow := 0
    ST.hudFound := 0, ST.hudFoundSeq := 0, ST.hudScore := 0, ST.hudWhy := ""
    ST.hudSlots := 0.0, ST.hudHp := 0
    ST.hpPercent := -1, ST.shPercent := -1
    ST.lastShot := 0, ST.lastShotAt := 0, ST.prevShot := 0
    ST.deadSince := 0
}

StartPermit(gen) {
    global ST
    return ST.startWorkers > 0 && ST.startGeneration = gen && !ST.stopWorkers && !ST.mouseCalActive
}

OnStart(expectedGen := 0, *) {
    global CFG, ST, UI
    ; Зарезервировать запуск атомарно: Stop должен видеть даже ещё не
    ; включивший running поток, а новый запуск не пересекаться со старым.
    prev := Critical("On")
    ; Автовозобновление не может отменить ручной стоп или чужой активный запуск.
    if (expectedGen && (expectedGen != ST.startGeneration || ST.running || ST.startWorkers > 0 || ST.mouseCalActive)) {
        Critical(prev)
        return
    }
    if ST.mouseCalActive {
        Critical(prev)
        OnStop()
        Flash("Тест мыши отменён; бот остановлен", 2500)
        return
    }
    if ST.running {
        Critical(prev)
        OnStop()
        Flash("СТОП — бот остановлен (F8 — снова запустить)", 2500)
        return
    }
    if ST.startWorkers > 0 {
        Critical(prev)
        OnStop()
        Flash("Незавершённый запуск отменён", 2500)
        return
    }
    if (ST.mouseCalWorkers > 0 || ST.stopWorkers > 0 || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0) {
        Critical(prev)
        Flash("Жду завершения старых действий; затем нажмите Старт", 3500)
        return
    }
    ST.startWorkers += 1, startGen := ST.startGeneration
    Critical(prev)
    try {
    Flash("Подготовка запуска · " CFG.hkStart " — стоп", 2000)
    if !StartPermit(startGen)
        return
    ApplyToggles()
    if !StartPermit(startGen)
        return
    hwnd := GetGameWindow()
    if !StartPermit(startGen)
        return
    if !hwnd {
        Flash("Окно игры не найдено:`n" CFG.winTitle, 2500)
        Log("[!] старт отменён: окно не найдено")
        return
    }
    if !A_IsAdmin
        Log("[!] Скрипт запущен БЕЗ прав администратора. Fortnite часто не принимает"
            . " нажатия от обычного процесса — если бот стоит на месте, перезапустите"
            . " AutoHotkey «от имени администратора».")
    if CFG.dryRun {
        Log("[i] подготовка запуска (DryRun: только логи)")
        Log("[!] Внимание: DryRun включён — клавиши НЕ нажимаются, бот только пишет сюда."
            . " Чтобы он реально играл: снимите галочку «Тест: без нажатий» и нажмите Старт снова.")
        Flash("DryRun: только журнал, клавиши не нажимаются", 2500)
    } else {
        Log("[i] подготовка запуска (боевой режим)")
    }
    Log("[i] Боевой режим: " (CFG.teamSafe ? "КОМАНДА — бой вручную, союзники не распознаются" : "СОЛО — автоматический бой разрешён"))
    Log("[!] В слотах 1–4 может оказаться не оружие; слот 4 иногда содержит лечение. Проверяйте предмет вручную.")
    Log("[!] v8.8: автоматическое лечение отключено: содержимое слотов пока не распознаётся. Лечитесь вручную.")
    Log("[!] Автоперезарядка приостановлена: запас патронов неизвестен. Перезаряжайте вручную.")
    Log("[!] Полосы HP и щита — приблизительные оценки; фон может быть принят за щит, очень низкий HP может быть неизвестен.")
    if !StartPermit(startGen)
        return
    ; Старые отложенные отпускания не относятся к новому запуску.
    InputCancelDeferred()
    ; Новый запуск через F8/Старт — явное возобновление после остановки.
    if ST.cancelHold {
        ST.cancelHold := false
        ST.queueTries := 0, ST.lastQueueT := 0
        Log("[игрок] запуск после остановки: снимаю ожидание после отмены")
    }
    ST.frames := 0          ; счётчик и средняя частота только за этот запуск
    ST.queuePending := false, ST.queueSeen := false, ST.leftQueueT := 0
    ST.state := "", ST.pendingState := "", ST.pendingCount := 0, ST.pendingSince := 0
    ST.mmEnterAt := 0, ST.mmSince := 0
    ResetSceneEvidence()
    ST.matchStarted := false, ST.matchFromQueue := false
    ST.roundActive := false, ST.lobbyRequeue := false
    ST.promptConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.enemyConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.enemyWideConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ResetMoveWatch(true)
    ST.tickReentry := 0
    ST.lastTickAt := A_TickCount
    ST.sprintUntil := 0
    ST.combatBrakeUntil := 0, ST.combatMoveUntil := 0
    ST.moveMode := ""
    ST.mmSince := 0
    ST.phase := "", ST.phaseAt := 0, ST.busJumped := false, ST.glideDeploys := 0
    ST.weaponTries := 0
    SaveSettings()
    ; Последняя проверка поколения и запуск таймера — единый короткий
    ; участок без журнала/GUI. Stop не может вклиниться между ними.
    prev := Critical("On")
    try {
        if (!StartPermit(startGen) || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0)
            return
        ResetRunDiagnostics()
        ST.tickAbort := true, ST.running := true, ST.paused := false
        ST.startedAt := A_TickCount
        try {
            StopTickSlots()
            ST.tickSlot := 1
            SetTimer(TickSlot1, CFG.loopMs)
        } catch as e {
            ST.running := false, ST.tickAbort := true, ST.tickSlot := 0
            throw e
        }
    } finally {
        Critical(prev)
    }
    if (!StartPermit(startGen) || !ST.running)
        return
    Log(CFG.dryRun ? "=== СТАРТ (DryRun: только логи) ===" : "=== СТАРТ (БОЕВОЙ режим) ===")
    if (!StartPermit(startGen) || !ST.running)
        return
    Flash(CFG.dryRun ? "СТАРТ · DryRun: только журнал" : "СТАРТ · нажимаю клавиши", 2500)
    if (!StartPermit(startGen) || !ST.running)
        return
    ; Предыдущая версия могла оставить Fortnite TOPMOST. Убираем только этот
    ; стиль, без активации, перемещения или изменения размера окна.
    try {
        if (WinGetExStyle("ahk_id " hwnd) & 0x8)
            DllCall("user32\SetWindowPos", "Ptr", hwnd, "Ptr", -2
                , "Int", 0, "Int", 0, "Int", 0, "Int", 0
                , "UInt", 0x0001 | 0x0002 | 0x0010)
    }
    if CFG.bgMode
        Log("[i] фон-режим: окно не поднимаю; клавиши — попытка через сообщения. Мышь только при фокусе.")
    else if !WinActive("ahk_id " hwnd)
        Log("[i] Окно игры не активирую: для управления вручную переключитесь в игру.")
    if (!StartPermit(startGen) || !ST.running)
        return
    if (CFG.hideOnStart && UI.gui)
        HideGui()
    UpdateStatus()
    } finally {
        prev := Critical("On")
        ST.startWorkers -= 1
        Critical(prev)
    }
}

; Снять паузу после ручной отмены подбора и снова искать матч.
OnResumeQueue(*) {
    global ST
    if !ST.cancelHold {
        Flash("Бот и так ищет матч", 1800)
        Log("[i] «Продолжить»: паузы после отмены нет")
        return
    }
    ST.cancelHold := false
    ST.queuePending := false, ST.queueSeen := false, ST.leftQueueT := 0
    ST.queueTries := 0
    ST.lastQueueT := 0
    Log("[игрок] «Продолжить» — возвращаюсь к поиску матча")
    Flash("Продолжаю: жму «Играть»", 2500)
    UpdateStatus()
}

OnPause(*) {
    global ST
    ; Пауза, её очистка и повторный запуск не должны пересекаться.
    prev := Critical("On")
    if ST.mouseCalActive {
        ST.mouseCalCancel := true, ST.mouseCalResumePaused := true
        Critical(prev)
        Log("[i] Тест мыши отменён: бот останется на паузе после завершения тика.")
        return
    }
    if !ST.running {
        Critical(prev)
        return
    }
    if ST.paused {
        if (ST.stopWorkers > 0 || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0) {
            Critical(prev)
            Flash("Жду завершения старого действия; повторите продолжение", 2500)
            return
        }
        InputCancelDeferred()
        ST.paused := false
        Critical(prev)
    } else {
        InputCancelDeferred()
        ST.paused := true
        ; Пока очистка не вернулась, запрещены старт, F6 и снятие паузы.
        ST.inputReleasesLive += 1
        Critical(prev)
        try {
            ReleaseKeysSafe()
            ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
            ResetMoveWatch(true)
        } finally {
            prev := Critical("On")
            ST.inputReleasesLive -= 1
            Critical(prev)
        }
    }
    Log(ST.paused ? "пауза" : "продолжаем")
    UpdateStatus()
}

OnStop(*) {
    global ST, MC_RAW
    ; Запрещаем новый запуск и просим тик выйти до любых журналов и ввода.
    prev := Critical("On")
    ST.stopWorkers += 1, ST.startGeneration += 1
    resumeTimer := ST.autoResumeTimer, ST.autoResumeTimer := 0
    ST.mouseCalActive := false, ST.mouseCalGeneration += 1
    ST.running := false, ST.paused := false, ST.tickAbort := true
    MC_RAW.active := false
    ST.inputEpoch += 1
    Critical(prev)
    try {
        if resumeTimer
            SetTimer(resumeTimer, 0) ; очередь отключена; уже запущенный проверит поколение
        InputCancelDeferred()
        ST.tgt := 0
        ST.promptAt := 0
        ST.promptCache := 0
        ST.promptAvailable := false
        ST.enemyConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
        ST.enemyWideConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
        ST.promptConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
        ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
        ResetMoveWatch(true)
        StopTickSlots()
        ; tickStart нельзя обнулять, пока старый тик ещё жив.
        busySecs := (ST.tickBusy && (A_TickCount - ST.tickStart > 1000))
            ? Round((A_TickCount - ST.tickStart) / 1000) : 0
        if !ST.tickBusy
            ST.tickStart := 0
        ST.tickReentry := 0
        ; Без отдельных KeyUp через SprintSet/CrouchSet до этого вызова:
        ; ReleaseKeysSafe уже отпускает учтённые клавиши и обе кнопки мыши.
        ReleaseKeysSafe()
        try MouseCalRawStop()
        if busySecs
            Log("[i] стоп: тик работает " busySecs " с — прошу завершиться")
        Log("стоп. сундуки " ST.chests ", лут " ST.loots ", лечение " ST.heals
            . ", очереди " ST.bursts ", «снова» " ST.clickAgain ", сбои поиска " ST.mmErrors)
        UpdateStatus()
    } finally {
        prev := Critical("On")
        ST.stopWorkers -= 1
        Critical(prev)
    }
}

OnGuiClose(*) {
    global ST, UI
    if (ST.running || ST.mouseCalActive || ST.startWorkers > 0)
        OnStop()
    try HideKeySettings()
    try {
        UI.gui.Hide()
    } catch {
    }
    UI.visible := false
    TrayTip("Бот остановлен, окно скрыто. F1 — открыть снова.", "FORMA", 1)
}

HideGui() {
    global UI
