    pauseMinMs:   120,
    pauseMaxMs:   260,
    runKeepW:     true,     ; на смене отрезка НЕ отпускать W (идём непрерывно)
    turnMinPx:    40,
    turnMaxPx:    260,
    mouseGain:    1.0,
    mouseMicroPx: 7,        ; v7.6: один шаг мыши — не больше 7 px (было до 30)
    invertTurn:   false,
    stuckDiffThreshold: 1.2,  ; порог средней разницы яркости области мира
