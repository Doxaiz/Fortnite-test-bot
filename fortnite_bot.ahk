    ; ~20 000 пикселей, врага — ~65 000. Частота ниже подобрана так, чтобы за
    ; тик успевал ровно один-два скана; остальное берётся из кэша.
    skinWideMs:    300,         ; v7.8: широкий скан фигуры (вместо старого
