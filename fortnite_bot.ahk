    promptSpanMin:   54,        ; ширина строки подсказки, px при кадре 1280
    promptSpanMax:   155,
    promptHMin:      5,         ; высота букв подсказки
    promptHMax:      24,
    promptDarkMax:   145,       ; подложка подсказки тёмная (средняя яркость)
    promptDxFrac:    0.27,      ; подсказка висит рядом с прицелом
    promptDyFrac:    0.12,
    ; ---- метки визуализации звука (настройка игры «Visualize Sound Effects») ----
    alertMinPx:      8,
    alertMaxPx:      90,
    alertFillMax:    0.72,      ; метка — дуга/кольцо, заливка маленькая
    alertCenterFrac: 0.48,
    aimGain:         0.42,      ; базовая доля ошибки за один шаг наведения
