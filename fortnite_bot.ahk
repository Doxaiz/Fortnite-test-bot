; Стоп выполняется ДО журнала и всплывающей подсказки: GUI/диск могут
; задержаться, и до остановки они не должны блокировать аварийную команду.
StartStopHotkey(*) {
    global ST
    if (ST.stopActionKind != "") {
        CancelStopAction()
        return
    }
    if (ST.running || ST.mouseCalActive || ST.startWorkers > 0) {
        OnStop()
        Flash("СТОП — бот остановлен", 2500)
        return
    }
    if ST.stopWorkers {
        Flash("Остановка ещё завершается — повторите запуск позже", 2500)
        return
    }
    ; Не писать журнал до резервирования запуска: Stop должен иметь
    ; возможность отменить запуск даже при задержке GUI/диска.
    OnStart()
}

HkFire(label, fn) {
    global ST
    Log("[клавиша] " label)
    Toast(label)
    muted := ST.tickCheckMuted
    ST.tickCheckMuted := true          ; хоткей не прерываем просьбой сторожа
    try
        fn()
    catch as e {
        Log("[!] ошибка в обработчике «" label "»: " e.Message)
        Toast(label " — ошибка", e.Message, 3200)
    }
    ST.tickCheckMuted := muted
}

RndF(lo, hi) {
    return lo + (hi - lo) * Random(0, 10000) / 10000
}

Clamp(v, lo, hi) {
    return v < lo ? lo : (v > hi ? hi : v)
}

SortNums(arr) {
    ; Сортировка чисел вставками (в AHK v2 у Array нет встроенного метода Sort).
    n := arr.Length
    if (n < 2)
        return arr
    i := 2
    while (i <= n) {
        v := arr[i], j := i - 1
        while (j >= 1 && arr[j] > v) {
            arr[j + 1] := arr[j]
            j -= 1
        }
        arr[j + 1] := v
        i += 1
    }
    return arr
}

