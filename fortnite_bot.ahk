}

GetGameWindow() {
    global CFG, UI, ST
    ; ГЛАВНАЯ ЛОВУШКА (из-за неё бот «не видел окно», хотя игра запущена):
    ; заголовок меню — «FORMA — Fortnite AFK», а режим поиска окна — «содержит
    ; текст». Поэтому WinActive("Fortnite") находил СОБСТВЕННОЕ МЕНЮ бота, и
    ; дальше бот захватывал кадр 776x728 своего же окна вместо игры.
    ; Теперь: сначала окна по классу UnrealWindow, своё окно и свой процесс
    ; отбрасываются, потом запасной путь по имени процесса игры.
    cands := []
    try {
        for h in WinGetList(CFG.winTitle) {
            if IsSelfWindow(h)
                continue
            cands.Push(h)
        }
    }
    if !cands.Length {
        try {
            for h in WinGetList(CFG.winExe) {
                if IsSelfWindow(h)
                    continue
                cands.Push(h)
            }
        }
    }
    if !cands.Length {
        if CFG.cloudGaming {
            ch := FindCloudGameWindow()
            if ch
                return ch
        }
        ST.cloudTarget := ""
        return 0
    }
    ST.cloudTarget := ""
    ; активное — в приоритете, иначе первое найденное
    for h in cands {
        if WinActive("ahk_id " h)
            return h
    }
    return cands[1]
}

; Поиск окна облачного гейминга (GeForce NOW / GeForce Infinity / Xbox Cloud / Amazon Luna),
; если нативный клиент Fortnite не запущен и включена опция CFG.cloudGaming.
; Обычные вкладки браузера про Fortnite (YouTube/форум) строго отсекаются.
CloudWindowValid(h) {
    if (!h || IsSelfWindow(h))
        return false
    try {
        if DllCall("user32\IsIconic", "Ptr", h, "Int")
            return false
        WinGetClientPos(, , &cw, &ch, "ahk_id " h)
        return (cw >= 400 && ch >= 300)
    } catch {
        return false
    }
}

MatchCloudBrowserTitle(title) {
    t := StrLower(Trim(String(title)))
    if (t = "")
        return ""
    if InStr(t, "geforce now")
        return "GeForce NOW (браузер)"
    if (InStr(t, "xbox cloud gaming") || (InStr(t, "fortnite") && InStr(t, "xbox")))
        return "Xbox Cloud (браузер)"
    if (InStr(t, "amazon luna") || (InStr(t, "fortnite") && InStr(t, "luna")))
        return "Amazon Luna (браузер)"
    return ""
}

FindCloudGameWindow() {
    global ST
    found := []
    for spec in [["ahk_exe GeForceNOW.exe", "GeForce NOW", ""]
               , ["ahk_exe GeForceInfinity.exe", "GeForce Infinity", ""]
               , ["ahk_exe XboxPcApp.exe", "Xbox Cloud", ""]
               , ["ahk_exe ApplicationFrameHost.exe", "Xbox Cloud", "xbox"]] {
        try {
            for h in WinGetList(spec[1]) {
                if !CloudWindowValid(h)
                    continue
                if (spec[3] != "") {
                    ttl := ""
                    try ttl := StrLower(WinGetTitle("ahk_id " h))
                    if !InStr(ttl, spec[3])
                        continue
                }
                found.Push({h: h, label: spec[2]})
            }
        }
    }
    if !found.Length {
        for br in ["chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "vivaldi.exe"] {
            try {
                for h in WinGetList("ahk_exe " br) {
                    if !CloudWindowValid(h)
                        continue
                    ttl := ""
                    try ttl := WinGetTitle("ahk_id " h)
                    lbl := MatchCloudBrowserTitle(ttl)
                    if (lbl != "")
                        found.Push({h: h, label: lbl})
                }
            }
        }
    }
    if !found.Length {
        ST.cloudTarget := ""
        return 0
    }
    for item in found {
        if WinActive("ahk_id " item.h) {
            ST.cloudTarget := item.label
            return item.h
        }
    }
    ST.cloudTarget := found[1].label
    return found[1].h
}

; Защита Alt+Tab: пока пользователь держит Alt и ещё CFG.altSettleMs после отпускания,
; бот мгновенно прекращает любой ввод, чтобы не кликнуть в переключатель окон Windows.
AltTabGuardActive() {
    global CFG, ST
    altNow := false
    try altNow := GetKeyState("LAlt", "P") || GetKeyState("RAlt", "P") || GetKeyState("Alt", "P")
    now := A_TickCount
    if altNow {
        ST.altWasDown := true
        ST.altSettleUntil := now + CFG.altSettleMs
        return true
    }
    if ST.altWasDown {
        ST.altWasDown := false
        ST.altSettleUntil := now + CFG.altSettleMs
        return true
    }
    return (ST.altSettleUntil > 0 && now < ST.altSettleUntil)
}

; Своё окно (любое окно бота) или свой процесс — это НЕ игра.
IsSelfWindow(h) {
    global UI, VIS, HUD, MC_RAW
    try {
        if (UI.gui && h = UI.gui.Hwnd)
            return true
        if (UI.keyGui && h = UI.keyGui.Hwnd)
            return true
        if (UI.afkGui && h = UI.afkGui.Hwnd)
            return true
        if (UI.extGui && h = UI.extGui.Hwnd)
            return true
        if (HUD.gui && h = HUD.gui.Hwnd)
            return true
        if (VIS.gui && h = VIS.gui.Hwnd)
            return true
        if (MC_RAW.sink && h = MC_RAW.sink.Hwnd)
            return true
    } catch {
    }
    pid := 0
    try
        pid := WinGetPID("ahk_id " h)
    return (pid && pid = ProcessExist())
}

; Сколько окон игры реально видно (для журнала и диагностики).
GameWindowCount() {
    global CFG
    seen := Map()
    try {
        for h in WinGetList(CFG.winTitle) {
            if !IsSelfWindow(h)
                seen[h] := true
        }
    }
    try {
        for h in WinGetList(CFG.winExe) {
            if !IsSelfWindow(h)
                seen[h] := true
        }
    }
    return seen.Count
}

; Координаты клиентской области Fortnite на виртуальном рабочем столе.
; Корректно работает при любом расположении мониторов (в т.ч. отрицательные X/Y).
GetClientArea(hwnd) {
    try {
        WinGetClientPos(&cx, &cy, &cw, &ch, "ahk_id " hwnd)
        if (cw >= 50 && ch >= 50)
            return {x: cx, y: cy, w: cw, h: ch}
    } catch {
    }
    try {
        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " hwnd)
        if (ww >= 50 && wh >= 50)
            return {x: wx, y: wy, w: ww, h: wh}
    } catch {
    }
    return 0
}

ActivateGame(hwnd, startGen := 0) {
    ; Без «Умного фона» не активируем игру автоматически: фоновым клавишам
    ; не нужен фокус, а мышь разрешена только при активном окне игры.
    if !hwnd
        return false
    return WinActive("ahk_id " hwnd) || BgInputActive()
}

; Надёжная передача фокуса окну с обходом блокировки ForegroundLock в Windows
; (корректно работает между несколькими мониторами; AttachThreadInput всегда
; снимается в finally). Используется ТОЛЬКО если пользователь включил smartRestore.
ForceActivateWindow(hwnd, waitMs := 700) {
    if (!hwnd || !IsWindow(hwnd))
        return false
    if DllCall("user32\IsIconic", "Ptr", hwnd, "Int")
        return false
    if WinActive("ahk_id " hwnd)
        return true
    foreHwnd := DllCall("user32\GetForegroundWindow", "Ptr")
    foreTid := foreHwnd ? DllCall("user32\GetWindowThreadProcessId", "Ptr", foreHwnd, "Ptr", 0, "UInt") : 0
    appTid := DllCall("kernel32\GetCurrentThreadId", "UInt")
    attached := false
    try {
        if (foreTid && appTid && foreTid != appTid)
            attached := !!DllCall("user32\AttachThreadInput", "UInt", appTid, "UInt", foreTid, "Int", 1)
        try DllCall("user32\BringWindowToTop", "Ptr", hwnd)
        try DllCall("user32\SetForegroundWindow", "Ptr", hwnd)
        try WinActivate("ahk_id " hwnd)
    } finally {
        if attached
            try DllCall("user32\AttachThreadInput", "UInt", appTid, "UInt", foreTid, "Int", 0)
    }
    deadline := A_TickCount + Max(80, waitMs)
    while (A_TickCount < deadline) {
        if WinActive("ahk_id " hwnd) {
            Sleep(60)
            return true
        }
        Sleep(30)
    }
    return WinActive("ahk_id " hwnd) ? true : false
}

RestoreUserFocus(prevHwnd, prevX, prevY, gameHwnd := 0) {
    ; Безопасно возвращает предыдущее окно пользователя и координаты курсора.
    try DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    try DllCall("mouse_event", "UInt", 0x0010, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    if (prevHwnd && prevHwnd != gameHwnd && IsWindow(prevHwnd) && !IsSelfWindow(prevHwnd)) {
        Sleep(110)
        ForceActivateWindow(prevHwnd, 450)
    }
    try DllCall("SetCursorPos", "Int", Round(prevX), "Int", Round(prevY), "Int")
}

; Неблокирующее предупреждение за CFG.preAlertMs перед перехватом фокуса,
; чтобы клик бота не прервал набор текста неожиданно.
SmartAlertReady(key, label, hwnd, now) {
    global CFG, ST
    if (!CFG.smartRestore || CFG.dryRun || !hwnd || WinActive("ahk_id " hwnd)) {
        SmartAlertClear(key)
        return true
    }
    if (!CFG.audioAlert || CFG.preAlertMs <= 0)
        return true
    if (ST.smartAlertKey != key) {
        ST.smartAlertKey := key
        ST.smartAlertAt := now
        PlayAlertBeep(880, 120)
        sec := Max(1, Round(CFG.preAlertMs / 1000))
        Flash("FORMA: «" label "» через " sec " с (окно и курсор вернутся)", CFG.preAlertMs)
        return false
    }
    if (now - ST.smartAlertAt < CFG.preAlertMs)
        return false
    SmartAlertClear(key)
    return true
}

SmartAlertClear(key := "") {
    global ST
    if (key = "" || ST.smartAlertKey = key) {
        ST.smartAlertKey := ""
        ST.smartAlertAt := 0
    }
}

; Можно ли сейчас нажать кнопку меню (игра активна ИЛИ включён Умный фон / DryRun).
MenuClickPossible(hwnd := 0) {
    global CFG
    if CFG.dryRun
        return true
    if !hwnd
        hwnd := GetGameWindow()
    if (!hwnd || !IsWindow(hwnd) || DllCall("user32\IsIconic", "Ptr", hwnd, "Int"))
        return false
    return WinActive("ahk_id " hwnd) || CFG.smartRestore
}

; Выполняет короткое меню-действие (клик по «Играть», «Играть снова», «Забрать»,
; «Продолжить игру» или «\»): если игра в фоне и включён smartRestore, поднимает
; Fortnite на долю секунды и гарантированно возвращает окно и курсор пользователя.
RunMenuAction(hwnd, label, actionFn, preX := "", preY := "") {
    global CFG, ST
    if CFG.dryRun
        return actionFn()
    if (!hwnd || !IsWindow(hwnd) || !ST.running || ST.paused || ST.tickAbort)
        return false
    if WinActive("ahk_id " hwnd)
        return actionFn()
    if !CFG.smartRestore
        return MouseBlockedNote(label)
    if DllCall("user32\IsIconic", "Ptr", hwnd, "Int") {
        LogThrottledKey("[smarticonic]", "[!] Умный фон: окно Fortnite свёрнуто — разверните его (можно оставить за другими окнами).")
        return false
    }
    epoch := ST.inputEpoch
    CoordMode("Mouse", "Screen")
    prevHwnd := 0, prevX := 0, prevY := 0
    try prevHwnd := WinActive("A")
    try MouseGetPos(&prevX, &prevY)
    BeginAction("умный фон: " label)
    restored := false
    try {
        ; Переносим курсор на монитор игры перед активацией (важно для мульти-монитора)
        if (preX != "" && preY != "")
            try DllCall("SetCursorPos", "Int", Round(preX), "Int", Round(preY), "Int")
        if !ForceActivateWindow(hwnd, 800) {
            LogThrottledKey("[smartfail]", "[!] Умный фон: не удалось временно активировать Fortnite для «" label "».")
            return false
        }
        if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != epoch)
            return false
        ok := actionFn()
        Sleep(90)
        return ok
    } finally {
        if !restored {
            restored := true
            RestoreUserFocus(prevHwnd, prevX, prevY, hwnd)
        }
        EndAction()
    }
}

; Быстрый клик по экранной точке с учётом Умного фона (при перехвате фокуса не
; тратим полсекунды на длинную траекторию через два монитора).
ClickMenuBox(shot, box, label := "", alertKey := "") {
    global CFG, ST
    cx := shot.x + box.x + box.w // 2 + (CFG.humanize ? Random(-3, 3) : 0)
    cy := shot.y + box.y + box.h // 2 + (CFG.humanize ? Random(-2, 2) : 0)
    if CFG.dryRun {
        Log("[dry-run] клик" (label != "" ? " «" label "»" : "") " (" Round(cx) ", " Round(cy) ")")
        return true
    }
    hwnd := GetGameWindow()
    if !MenuClickPossible(hwnd) {
        if (label != "")
            LogThrottledKey("[nobgclick]", "[i] «" label "»: игра не в фокусе. Включите «Умный фон» или переключитесь в игру.")
        return false
    }
    if (alertKey != "" && !SmartAlertReady(alertKey, label, hwnd, A_TickCount))
        return false
    wasBg := !WinActive("ahk_id " hwnd)
    return RunMenuAction(hwnd, label, () => ClickScreenMode(cx, cy, wasBg), cx, cy)
}


; ----------------------------------------------------------------------------
; КАДР ТОЛЬКО ИЗ ОКНА ИГРЫ (v7.4)
; По просьбе пользователя захват С ЭКРАНА убран полностью: он не только мешал
; (в кадр попадали браузер и своё же меню), но и портил окно зрения — оно
; «видело само себя» и показывало чёрный прямоугольник.
;
; Два способа, оба — СОДЕРЖИМОЕ ОКНА, а не экрана:
;   1) PrintWindow с PW_RENDERFULLCONTENT (Win 8.1+);
;   2) BitBlt с DC самого окна (GetDC(hwnd)).
; Если оба вернули пустоту — честно говорим причину.
; ----------------------------------------------------------------------------
CaptureClient(hwnd) {
    global ST, CFG
    if (!hwnd || !IsWindow(hwnd))
        return 0
    if DllCall("user32\IsIconic", "Ptr", hwnd, "Int")
        return 0                        ; свёрнуто в панель задач — не снять
    area := GetClientArea(hwnd)
    if !area
        return 0
    ; Три подряд медленных успешных PrintWindow временно меняют порядок
    ; методов, но не отключают запасной: оба могут отказать на разных ПК.
    previous := Critical("On")
    try {
        t0 := A_TickCount, cameraAtStart := ST.cameraSeq, inputEpochAtStart := ST.inputEpoch
        cameraCmdXAtStart := ST.cameraCmdX, cameraCmdYAtStart := ST.cameraCmdY
    } finally {
        Critical(previous)
    }
    shot := 0, primaryPrint := false, printMs := 0, printOk := false
    if (ST.capNoPrintT && A_TickCount < ST.capNoPrintT) {
        shot := CaptureWindowDC(hwnd, area)
        if shot
            ST.capSource := "DC окна (первый выбор)"
        else {
            shot := CaptureWindowPrint(hwnd, area)
            if shot
                ST.capSource := "PrintWindow (резерв DC)"
        }
    } else {
        primaryPrint := true
        printStart := A_TickCount
        shot := CaptureWindowPrint(hwnd, area)
        printMs := A_TickCount - printStart, printOk := !!shot
        if shot
            ST.capSource := "PrintWindow"
        else {
            shot := CaptureWindowDC(hwnd, area)
            if shot
                ST.capSource := "DC окна (резерв PrintWindow)"
        }
    }
    ST.capMs := A_TickCount - t0
    ; Учитываем только время самого первого PrintWindow, не резервного DC.
    ; Медленный DC не продлевает отсрочку PrintWindow бесконечно.
    if primaryPrint {
        if (printOk && printMs > CFG.capSlowMs) {
            ST.capSlowN += 1
            if (ST.capSlowN >= 3) {
                ST.capSlowN := 0
                ST.capNoPrintT := A_TickCount + CFG.capCooldownMs
                Log("[i] PrintWindow занял " printMs " мс; сначала пробую DC окна "
                    . Round(CFG.capCooldownMs / 1000) " с, затем снова PrintWindow. Скорость и качество DC не гарантированы.")
            }
        } else
            ST.capSlowN := 0
    }
    if !shot {
        ST.capSource := ""
        ST.visSrc := ""
        return 0
    }
    ST.visSrc := ST.capSource
    ST.captureSeq += 1
    shot.captureId := ST.captureSeq
    ; Время НАЧАЛА захвата — консервативная оценка возраста кадра. При медленном
    ; PrintWindow время детектора нельзя принимать за время съёмки.
    shot.capturedAt := t0
    shot.cameraSeqAtCapture := cameraAtStart
    shot.inputEpochAtCapture := inputEpochAtStart
    shot.cameraCmdXAtCapture := cameraCmdXAtStart
    shot.cameraCmdYAtCapture := cameraCmdYAtStart
    return shot
}

IsWindow(hwnd) {
    return hwnd && DllCall("user32\IsWindow", "Ptr", hwnd, "Int") ? true : false
}

; --- способ 1: PrintWindow всего окна, потом вырезаем клиентскую область ------
CaptureWindowPrint(hwnd, area) {
    wx := 0, wy := 0, ww := 0, wh := 0
    try
        WinGetPos(&wx, &wy, &ww, &wh, "ahk_id " hwnd)
    catch
        return 0
    if (ww < 50 || wh < 50)
        return 0
    ; смещение клиентской области внутри окна (рамка/заголовок)
    ox := Max(0, area.x - wx), oy := Max(0, area.y - wy)
    if (ox + area.w > ww)
        ox := Max(0, ww - area.w)
    if (oy + area.h > wh)
        oy := Max(0, wh - area.h)

    hdcScreen := 0, hdcMem := 0, hbm := 0, old := 0
    try {
        hdcScreen := DllCall("GetDC", "Ptr", 0, "Ptr")
        if !hdcScreen
            return 0
        bi := Buffer(40, 0)
        NumPut("UInt", 40, bi, 0), NumPut("Int", ww, bi, 4), NumPut("Int", -wh, bi, 8)
        NumPut("UShort", 1, bi, 12), NumPut("UShort", 32, bi, 14)
        pbits := 0
        hbm := DllCall("gdi32\CreateDIBSection", "Ptr", hdcScreen, "Ptr", bi
            , "UInt", 0, "Ptr*", &pbits, "Ptr", 0, "UInt", 0, "Ptr")
        if (!hbm || !pbits)
            return 0
        hdcMem := DllCall("gdi32\CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
        if !hdcMem
            return 0
        old := DllCall("gdi32\SelectObject", "Ptr", hdcMem, "Ptr", hbm, "Ptr")
        if (!old || old = -1) {
            old := 0
            return 0
        }
        if !DllCall("user32\PrintWindow", "Ptr", hwnd, "Ptr", hdcMem, "UInt", 0x00000002, "Int")
            return 0
        stride := area.w * 4
        buf := Buffer(stride * area.h, 0)
        ; Вырезаем клиентскую область построчно: ширина может отличаться.
        rowBytes := area.w * 4
        y := 0
        while (y < area.h) {
            src := pbits + (oy + y) * ww * 4 + ox * 4
            dst := buf.Ptr + y * stride
            DllCall("kernel32\RtlMoveMemory", "Ptr", dst, "Ptr", src, "UPtr", rowBytes)
            y += 1
        }
        if IsBlankPixels(buf, area.w, area.h)
            return 0
        return {buf: buf, w: area.w, h: area.h, stride: stride, x: area.x, y: area.y}
    } finally {
        ; Даже при TickCheck/ошибке сначала отвязать bitmap, потом освободить.
        if (old && hdcMem)
            DllCall("gdi32\SelectObject", "Ptr", hdcMem, "Ptr", old, "Ptr")
        if hdcMem
            DllCall("gdi32\DeleteDC", "Ptr", hdcMem)
        if hbm
            DllCall("gdi32\DeleteObject", "Ptr", hbm)
        if hdcScreen
            DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
    }
}

; --- способ 2: BitBlt с DC окна (тоже окно, не экран) -------------------------
CaptureWindowDC(hwnd, area) {
    hdcWin := 0, hdcScreen := 0, hdcMem := 0, hbm := 0, old := 0
    try {
        hdcWin := DllCall("user32\GetDC", "Ptr", hwnd, "Ptr")
        if !hdcWin
            return 0
        hdcScreen := DllCall("GetDC", "Ptr", 0, "Ptr")
        if !hdcScreen
            return 0
        bi := Buffer(40, 0)
        NumPut("UInt", 40, bi, 0), NumPut("Int", area.w, bi, 4), NumPut("Int", -area.h, bi, 8)
        NumPut("UShort", 1, bi, 12), NumPut("UShort", 32, bi, 14)
        pbits := 0
        hbm := DllCall("gdi32\CreateDIBSection", "Ptr", hdcScreen, "Ptr", bi
            , "UInt", 0, "Ptr*", &pbits, "Ptr", 0, "UInt", 0, "Ptr")
        if (!hbm || !pbits)
            return 0
        hdcMem := DllCall("gdi32\CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
        if !hdcMem
            return 0
        old := DllCall("gdi32\SelectObject", "Ptr", hdcMem, "Ptr", hbm, "Ptr")
        if (!old || old = -1) {
            old := 0
            return 0
        }
        if !DllCall("gdi32\BitBlt", "Ptr", hdcMem, "Int", 0, "Int", 0, "Int", area.w, "Int", area.h
            , "Ptr", hdcWin, "Int", 0, "Int", 0, "UInt", 0x00CC0020, "Int")
            return 0
        stride := area.w * 4
        buf := Buffer(stride * area.h, 0)
        DllCall("kernel32\RtlMoveMemory", "Ptr", buf, "Ptr", pbits, "UPtr", stride * area.h)
        if IsBlankPixels(buf, area.w, area.h)
            return 0
        return {buf: buf, w: area.w, h: area.h, stride: stride, x: area.x, y: area.y}
    } finally {
        if (old && hdcMem)
            DllCall("gdi32\SelectObject", "Ptr", hdcMem, "Ptr", old, "Ptr")
        if hdcMem
            DllCall("gdi32\DeleteDC", "Ptr", hdcMem)
        if hbm
            DllCall("gdi32\DeleteObject", "Ptr", hbm)
        if hdcScreen
            DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
        if hdcWin
            DllCall("ReleaseDC", "Ptr", hwnd, "Ptr", hdcWin)
    }
}

; Пустой кадр: однотонный (обычно чёрный) — значит окно содержимое не отдало.
IsBlankPixels(buf, w, h) {
    stepY := Max(2, h // 24), stepX := Max(2, w // 24)
    seen := Map()
    y := 0
    while (y < h) {
        TickCheck("проверка кадра окна")
        x := 0
        while (x < w) {
            o := y * (w * 4) + x * 4
            ; v7.5: ключом служит само значение пикселя (UInt), а не строка —
            ; проверка «кадр пустой» перестала быть дорогой
            seen[NumGet(buf, o, "UInt")] := true
            if (seen.Count > 24)
                return false
            x += stepX
        }
        y += stepY
    }
    return true
}

; Средняя яркость кадра, % — чтобы в окне зрения было видно: кадр живой или чёрный
ShotBrightPct(shot) {
    stepY := Max(2, shot.h // 40), stepX := Max(2, shot.w // 40)
    sum := 0, n := 0
    y := 0
    while (y < shot.h) {
        x := 0
        while (x < shot.w) {
            o := y * shot.stride + x * 4
            px := NumGet(shot.buf, o, "UInt")
            sum += (px & 0xFF) + ((px >> 8) & 0xFF) + ((px >> 16) & 0xFF)
            n += 1
            x += stepX
        }
        y += stepY
    }
    return n ? Round(sum / n / 765 * 100) : 0
}

; ============================================================================
;                              ЗРЕНИЕ
; ============================================================================
RegionToPixels(shot, region) {
    x1 := Round(region[1] * shot.w), y1 := Round(region[2] * shot.h)
    x2 := Round(region[3] * shot.w), y2 := Round(region[4] * shot.h)
    x1 := Clamp(x1, 0, shot.w - 2), y1 := Clamp(y1, 0, shot.h - 2)
    x2 := Clamp(x2, x1 + 2, shot.w), y2 := Clamp(y2, y1 + 2, shot.h)
    return {x1: x1, y1: y1, x2: x2, y2: y2}
}

Bright(shot, x, y) {
    x := Clamp(Round(x), 0, shot.w - 1), y := Clamp(Round(y), 0, shot.h - 1)
    o := y * shot.stride + x * 4
    b := NumGet(shot.buf, o, "UChar"), g := NumGet(shot.buf, o + 1, "UChar")
    r := NumGet(shot.buf, o + 2, "UChar")
    return (r * 299 + g * 587 + b * 114) // 1000
}

RgbAt(shot, x, y) {
    x := Clamp(Round(x), 0, shot.w - 1), y := Clamp(Round(y), 0, shot.h - 1)
    o := y * shot.stride + x * 4
    return {r: NumGet(shot.buf, o + 2, "UChar"), g: NumGet(shot.buf, o + 1, "UChar")
          , b: NumGet(shot.buf, o, "UChar")}
}

; --- кластеризация цветовой маски в блоки (общая для кнопок/лута/врагов) -----
MaskClustersMulti(shot, region, modes, cell := 14, step := 4, minCells := 2) {
    ; ОДИН проход по области сразу для нескольких цветов.
    ; Возвращает Map: цвет -> массив блоков.
    ; Зачем (run-13.log): на область лута делалось четыре отдельных прохода
    ; (золото + зелёный + синий + фиолетовый) — это ~60 000 пикселей за тик,
    ; и тик не укладывался в бюджет. Один проход делает ту же работу вчетверо
    ; дешевле.
    global CFG
    r := RegionToPixels(shot, region)
    buf := shot.buf, stride := shot.stride
    want := Map()
    for m in modes
        want[m] := true
    ; Список цветов не меняется во время одного прохода: не ищем ключи Map
    ; заново для каждого пикселя. Приоритет gold/cream и порядок тестов прежние.
    wantGold := want.Has("gold"), wantCream := want.Has("cream")
    wantChestG := want.Has("chestGold"), wantChestR := want.Has("chestRare")
    wantGreen := want.Has("green"), wantBlue := want.Has("blue"), wantPurple := want.Has("purple")
    wantRed := want.Has("red"), wantWhite := want.Has("white"), wantPure := want.Has("pure")
    wantYellow := want.Has("yellow")
    cells := Map()                       ; цвет -> Map(ключ ячейки -> {n, sx, sy})
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан пикселей")
        x := r.x1
        while (x < r.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            hit := ""
            ; v11.0: полное свечение золотого сундука (и тёплый корпус, и яркий золотой ореол)
            ; и редкого синего сундука (бирюзово-голубое свечение) за тот же один проход.
            if (wantChestG && rr >= 150 && g >= 85 && g <= 232 && b <= 98
                && (rr - b) >= 88 && rr >= g && (rr - g) <= 125) {
                hit := "chestGold"
            } else if (wantChestR && b >= 210 && g >= 148 && g <= 242 && rr <= 98
                && (b - rr) >= 120 && (g - rr) >= 62) {
                hit := "chestRare"
            } else if (wantGold) {
                if (rr >= 140 && g >= 80 && g <= 155 && b <= 85 && (rr - b) >= 90)
                    hit := "gold"
            } else if (wantCream) {
                if (rr >= CFG.creamMin && g >= CFG.creamMin - 10 && b >= CFG.creamBMin
                    && b <= CFG.creamBMax && Abs(rr - g) <= 25)
                    hit := "cream"
            }
            if (hit = "" && wantGreen && g >= 120 && (g - rr) >= 40 && (g - b) >= 40)
                hit := "green"
            if (hit = "" && wantBlue && b >= 140 && (b - rr) >= 55 && (b - g) >= 20)
                hit := "blue"
            if (hit = "" && wantPurple && rr >= 105 && b >= 145 && (b - g) >= 55 && (rr - g) >= 35)
                hit := "purple"
            if (hit = "" && wantRed && rr >= 110 && (rr - g) >= 45 && (rr - b) >= 45)
                hit := "red"
            if (hit = "" && wantWhite && rr >= 215 && g >= 215 && b >= 205 && Abs(rr - b) <= 45)
                hit := "white"
            if (hit = "" && wantPure && rr >= 245 && g >= 245 && b >= 238)
                hit := "pure"
            if (hit = "" && wantYellow && rr >= CFG.yRMin && g >= CFG.yGMin
                && b <= CFG.yBMax && Abs(rr - g) <= CFG.yRGDelta)
                hit := "yellow"
            if (hit != "") {
                if !cells.Has(hit)
                    cells[hit] := Map()
                cm := cells[hit]
                key := (y // cell) * 10000 + (x // cell)
                if cm.Has(key) {
                    c := cm[key]
                    c.n += 1, c.sx += x, c.sy += y
                } else
                    cm[key] := {n: 1, sx: x, sy: y}
            }
            x += step
        }
        y += step
    }
    ; раскладываем по цветам и склеиваем соседние ячейки
    out := Map()
    for m in modes
        out[m] := []
    for m, cm in cells
        out[m] := GroupCells(cm, cell, step, minCells)
    return out
}

MaskClusters(shot, region, mode, cell := 14, step := 4, minCells := 2) {
    ; mode: yellow | cream | gold | green | blue | purple | red | white | pure
    ; Один цвет — через общий проход (чтобы правила цвета были в одном месте).
    res := MaskClustersMulti(shot, region, [mode], cell, step, minCells)
    return res.Has(mode) ? res[mode] : []
}

GroupCells(cells, cell, step, minCells) {
    ; Склейка соседних ячеек (8-связность) в блоки. Вынесено из MaskClusters,
    ; чтобы общий проход по нескольким цветам считал блоки той же логикой.
    used := Map()
    out := []
    for key in cells {
        if used.Has(key)
            continue
        group := [key]
        used[key] := true
        qi := 1
        while (qi <= group.Length) {
            ck := group[qi]
            cy := ck // 10000, cx := Mod(ck, 10000)
            for dy in [-1, 0, 1] {
                for dx in [-1, 0, 1] {
                    nk := (cy + dy) * 10000 + (cx + dx)
                    if (cells.Has(nk) && !used.Has(nk)) {
                        used[nk] := true
                        group.Push(nk)
                    }
                }
            }
            qi += 1
        }
        if (group.Length < minCells)
            continue
        minX := 999999, minY := 999999, maxX := -1, maxY := -1, n := 0, sx := 0, sy := 0
        for ck in group {
            c := cells[ck]
            cy := ck // 10000, cx := Mod(ck, 10000)
            n += c.n, sx += c.sx, sy += c.sy
            if (cx < minX)
                minX := cx
            if (cy < minY)
                minY := cy
            if (cx > maxX)
                maxX := cx
            if (cy > maxY)
                maxY := cy
        }
        bx := minX * cell, by := minY * cell
        bw := (maxX - minX + 1) * cell, bh := (maxY - minY + 1) * cell
        area := n * step * step
        out.Push({x: bx, y: by, w: bw, h: bh, area: area, n: n
                , cx: Round(sx / n), cy: Round(sy / n)
                , fill: n * step * step / Max(1, bw * bh)
                , cells: group.Length})
    }
    return out
}

; ---------------------------------------------------- кнопки (цвет из игры)
FindYellowButtons(shot, region := 0) {
    ; «ИГРАТЬ» и «ИГРАТЬ СНОВА»: чистая жёлтая заливка RGB(203,203,0)
    global CFG
    if !region
        region := CFG.regEnd
    list := MaskClusters(shot, region, "yellow", 16, 4, 3)
    out := []
    for c in list {
        if (c.w < shot.w * CFG.btnMinW || c.w > shot.w * CFG.btnMaxW)
            continue
        aspect := c.w / Max(1, c.h)
        if (aspect < CFG.btnMinAspect || aspect > 10)
            continue
        if (c.fill < 0.45)
            continue
        if !ButtonHasDarkText(shot, c, 0.010, 0.55)
            continue
        out.Push(c)
    }
    ; сверху вниз
    i := 2
    while (i <= out.Length) {
        cur := out[i], j := i - 1
        while (j >= 1 && out[j].y > cur.y) {
            out[j + 1] := out[j]
            j -= 1
        }
        out[j + 1] := cur
        i += 1
    }
    return out
}

LobbyButton(shot) {
    ; «ИГРАТЬ» в лобби: самый большой сплошной жёлтый блок в левой панели.
    ; Ищем по строкам самую длинную серию и склеиваем строки с зазором до 64 px —
    ; тогда чёрная надпись «ИГРАТЬ» внутри кнопки не разрывает её на части.
    global CFG
    r := RegionToPixels(shot, CFG.regLobbyPanel)
    buf := shot.buf, stride := shot.stride
    rows := []
    bestRun := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        run := 0, start := -1, bestRow := 0, bcx := 0
        x := r.x1
        while (x < r.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= CFG.yRMin && g >= CFG.yGMin && b <= CFG.yBMax && Abs(rr - g) <= CFG.yRGDelta) {
                if (start < 0)
                    start := x
                run += 2
                if (run > bestRow)
                    bestRow := run, bcx := start + run // 2
            } else
                run := 0, start := -1
            x += 2
        }
        rows.Push({run: bestRow, cx: bcx})
        if (bestRow > bestRun)
            bestRun := bestRow
        y += 2
    }
    if (bestRun < shot.w * 0.08)
        return 0

    thresh := Max(Round(bestRun * 0.6), Round(shot.w * 0.08))
    blocks := [], cur := 0, lastIdx := -999
    for i, row in rows {
        if (row.run >= thresh) {
            if (cur && (i - lastIdx) <= 32) {
                cur.bot := i, cur.runs.Push(row)
            } else {
                if cur
                    blocks.Push(cur)
                cur := {top: i, bot: i, runs: [row]}
            }
            lastIdx := i
        }
    }
    if cur
        blocks.Push(cur)
    if !blocks.Length
        return 0

    ; самый «массивный» блок
    best := 0, bestScore := 0
    for bl in blocks {
        score := 0, bw := 0, sumCx := 0
        for row in bl.runs {
            score += row.run
            sumCx += row.cx
            if (row.run > bw)
                bw := row.run
        }
        if (score > bestScore)
            bestScore := score, best := bl, best.w := bw
               , best.cx := Round(sumCx / bl.runs.Length)
    }
    if !best
        return 0
    bh := (best.bot - best.top + 1) * 2
    bw := best.w
    asp := bw / Max(1, bh)
    ; отсекаем тонкие полосы и «не кнопки»
    if (bw < shot.w * 0.10 || bw > shot.w * 0.32)
        return 0
    if (bh < shot.h * 0.025 || bh > shot.h * 0.20)
        return 0
    if (asp < 1.6 || asp > 6.5)
        return 0
    return {x: best.cx - bw // 2, y: r.y1 + best.top * 2, w: bw, h: bh
          , cx: best.cx, cy: r.y1 + best.top * 2 + bh // 2, fill: 1.0, area: bw * bh}
}

FindCreamButton(shot, region := 0) {
    ; «ОТМЕНИТЬ» во время поиска матча: кремовая (B ≈ 150..215, не жёлтая)
    global CFG
    if !region
        region := CFG.regLobbyBtn
    list := MaskClusters(shot, region, "cream", 16, 4, 3)
    best := 0
    for c in list {
        ; настоящая кнопка: широкая (>=12% экрана), приплюснутая (аспект 1.6..4),
        ; заливка >= 0.35 и центр там, где обычно стоит «Играть» (y 0.78..0.96)
        if (c.w < shot.w * 0.12 || c.w > shot.w * 0.40)
            continue
        asp := c.w / Max(1, c.h)
        if (asp < 1.6 || asp > 4.5)
            continue
        if (c.fill < 0.35)
            continue
        if (c.cy < shot.h * 0.76 || c.cy > shot.h * 0.97)
            continue
        if (!best || c.area > best.area)
            best := c
    }
    return best
}

ButtonHasDarkText(shot, box, minDark := 0.010, maxDark := 0.55) {
    ; Внутри настоящей кнопки («ИГРАТЬ», «ГОТОВО», «ИГРАТЬ СНОВА», «ПРОДОЛЖИТЬ»)
    ; есть тёмные штрихи букв, а у жёлтой полоски опыта или баннера — их нет.
    x1 := Clamp(box.x + Round(box.w * 0.14), 0, shot.w - 1)
    x2 := Clamp(box.x + Round(box.w * 0.86), x1 + 1, shot.w)
    y1 := Clamp(box.y + Round(box.h * 0.20), 0, shot.h - 1)
    y2 := Clamp(box.y + Round(box.h * 0.80), y1 + 1, shot.h)
    buf := shot.buf, stride := shot.stride
    step := Max(2, Min(4, (y2 - y1) // 6))
    dark := 0, total := 0
    y := y1
    while (y < y2) {
        row := y * stride, x := x1
        while (x < x2) {
            px := NumGet(buf, row + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            total += 1
            if (rr < 82 && g < 82 && b < 88)
                dark += 1
            x += step
        }
        y += step
    }
    if (total < 12)
        return true
    frac := dark / total
    return (frac >= minDark && frac <= maxDark)
}

BoxHasDarkSurround(shot, box) {
    ; Проверяет, что сверху и снизу от кнопки тёмный фон меню (не яркий пейзаж).
    buf := shot.buf, stride := shot.stride
    pad := Max(4, Round(shot.h * 0.012))
    ys := [Clamp(box.y - pad, 0, shot.h - 1), Clamp(box.y + box.h + pad, 0, shot.h - 1)]
    x1 := Clamp(box.x + box.w // 6, 0, shot.w - 1)
    x2 := Clamp(box.x + box.w - box.w // 6, x1 + 1, shot.w)
    step := Max(4, (x2 - x1) // 16)
    dark := 0, tot := 0
    for yy in ys {
        row := yy * stride, x := x1
        while (x < x2) {
            px := NumGet(buf, row + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            tot += 1
            if (rr < 90 && g < 95 && b < 130)
                dark += 1
            x += step
        }
    }
    return tot > 0 && (dark / tot >= 0.65)
}

; Защита от ложных кликов на экране итогов: отсекаем зоны «Пожаловаться на игрока»
; (верхняя шапка и правый нижний угол), центральные баннеры и квадратные значки XP.
IsForbiddenResultBox(shot, box) {
    if (!shot || !box || shot.w < 100 || shot.h < 100)
        return true
    cx := box.HasOwnProp("cx") ? box.cx : (box.x + box.w // 2)
    cy := box.HasOwnProp("cy") ? box.cy : (box.y + box.h // 2)
    if (cx < shot.w * 0.60)
        return true
    if (cy < shot.h * 0.26 || cy > shot.h * 0.83)
        return true
    if (box.w < shot.w * 0.08 || box.w > shot.w * 0.36)
        return true
    if (box.h < shot.h * 0.026 || box.h > shot.h * 0.115)
        return true
    asp := box.w / Max(1, box.h)
    return (asp < 1.85 || asp > 9.0)
}

; Выбор безопасной кнопки «Играть снова» в правой колонке итогов (включая смещённую
; раскладку Squad Fill с кнопкой «Остаться с командой» над ней).
PickResultPlayAgain(shot, boxes) {
    if (!boxes || !boxes.Length)
        return 0
    valid := []
    for b in boxes {
        if IsForbiddenResultBox(shot, b)
            continue
        pk := PlateKind(shot, b)
        if (pk = "cancel")
            continue
        hasTxt := ButtonHasDarkText(shot, b, 0.03, 0.58)
        score := (pk = "play" ? 100 : 30) + (hasTxt ? 50 : 0) + Round((b.w / Max(1, shot.w)) * 100)
        valid.Push({box: b, score: score, pk: pk, hasTxt: hasTxt})
    }
    if !valid.Length
        return 0
    best := valid[1]
    for v in valid {
        if (v.score > best.score)
            best := v
    }
    ; Если в той же колонке сразу под выбранной стоит вторая жёлтая кнопка с текстом
    ; (раскладка «Остаться с командой» сверху + «Играть снова» ниже) — берём нижнюю.
    for v in valid {
        if (v.box = best.box || v.pk != "play" || !v.hasTxt)
            continue
        dy := v.box.cy - best.box.cy
        if (dy >= shot.h * 0.035 && dy <= shot.h * 0.16 && Abs(v.box.cx - best.box.cx) <= shot.w * 0.06)
            best := v
    }
    return best.box
}

; Распознавание центрального модального окна Fortnite (опрос «Пропустить / SKIP»
; или всплывающее окно ошибки подбора/сети): тёмная виньетка со всех 4 сторон,
; непустая карточка в центре и чёткая кнопка действия по оси X.
FindModalDismissButton(shot) {
    global CFG
    if (!shot || shot.w < 320 || shot.h < 200)
        return 0
    if (DarkRatio(shot, [0.03, 0.20, 0.18, 0.80]) < 0.68)
        return 0
    if (DarkRatio(shot, [0.82, 0.20, 0.97, 0.80]) < 0.68)
        return 0
    if (DarkRatio(shot, [0.20, 0.03, 0.80, 0.14]) < 0.68)
        return 0
    if (DarkRatio(shot, [0.20, 0.87, 0.80, 0.97]) < 0.68)
        return 0
    ; Отличаем модальное окно от полностью чёрного экрана загрузки
    midDark := DarkRatio(shot, [0.30, 0.26, 0.70, 0.56])
    if (midDark >= 0.92)
        return 0
    btn := FindLightPlateButton(shot, CFG.regModalBtn, 0.08, 0.30, 2.0, 8.2, true)
    if !btn {
        yl := FindYellowButtons(shot, CFG.regModalBtn)
        for c in yl {
            if (PlateKind(shot, c) = "play" && ButtonHasDarkText(shot, c, 0.03, 0.58)) {
                btn := c
                break
            }
        }
    }
    if !btn
        return 0
    if (Abs(btn.cx - shot.w * 0.5) > shot.w * 0.15)
        return 0
    if !BoxHasDarkSurround(shot, btn)
        return 0
    return btn
}

FindLightPlateButton(shot, region, minWFrac := 0.08, maxWFrac := 0.36, minAsp := 2.0, maxAsp := 8.5, allowLavender := false) {
    ; Универсальный поиск светлой/лавандовой кнопки Fortnite по горизонтальным
    ; сериям («ПРОДОЛЖИТЬ ИГРУ» в спящем режиме, «В ЛОББИ» на итогах, «ДА» в диалоге).
    r := RegionToPixels(shot, region)
    buf := shot.buf, stride := shot.stride
    stepX := Max(2, ScanStep(3)), stepY := Max(2, ScanStep(3))
    minRun := Max(24, Round(shot.w * minWFrac))
    rows := [], bestRun := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан кнопки")
        row := y * stride, run := 0, stX := -1, bRun := 0, bCx := 0
        x := r.x1
        while (x < r.x2) {
            px := NumGet(buf, row + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            ok := (rr >= 188 && g >= 188 && b >= 192 && Max(rr, g, b) - Min(rr, g, b) <= 36)
            if (!ok && allowLavender)
                ok := (rr >= 150 && g >= 158 && b >= 185 && b >= rr && b - rr <= 72)
            if ok {
                if (stX < 0)
                    stX := x
                run += stepX
                if (run > bRun)
                    bRun := run, bCx := stX + run // 2
            } else {
                run := 0, stX := -1
            }
            x += stepX
        }
        rows.Push({y: y, run: bRun, cx: bCx})
        if (bRun > bestRun)
            bestRun := bRun
        y += stepY
    }
    if (bestRun < minRun)
        return 0
    thr := Max(minRun, Round(bestRun * 0.62))
    gapRows := Max(4, Round(shot.h * 0.032 / stepY))
    blocks := [], cur := 0, lastI := -999
    for i, rw in rows {
        if (rw.run >= thr) {
            if (cur && (i - lastI) <= gapRows) {
                cur.botY := rw.y, cur.runs.Push(rw)
            } else {
                if cur
                    blocks.Push(cur)
                cur := {topY: rw.y, botY: rw.y, runs: [rw]}
            }
            lastI := i
        }
    }
    if cur
        blocks.Push(cur)
    best := 0, bestScore := 0
    for bl in blocks {
        if (bl.runs.Length < 3)
            continue
        bw := 0, sumCx := 0
        for rw in bl.runs {
            sumCx += rw.cx
            if (rw.run > bw)
                bw := rw.run
        }
        bh := bl.botY - bl.topY + stepY
        if (bw < shot.w * minWFrac || bw > shot.w * maxWFrac)
            continue
        if (bh < shot.h * 0.028 || bh > shot.h * 0.14)
            continue
        asp := bw / Max(1, bh)
        if (asp < minAsp || asp > maxAsp)
            continue
        cx := Round(sumCx / bl.runs.Length)
        cand := {x: cx - bw // 2, y: bl.topY, w: bw, h: bh, cx: cx, cy: bl.topY + bh // 2, area: bw * bh}
        if !ButtonHasDarkText(shot, cand, 0.008, 0.55)
            continue
        if !BoxHasDarkSurround(shot, cand)
            continue
        if (cand.area > bestScore)
            bestScore := cand.area, best := cand
    }
    return best
}

FindRedMenuButton(shot, region := 0) {
    ; Красная кнопка «ВЫЙТИ В ЛОББИ» / «ПОКИНУТЬ МАТЧ» в правой панели меню Esc.
    global CFG
    if !region
        region := CFG.regLeaveMenu
    r := RegionToPixels(shot, region)
    buf := shot.buf, stride := shot.stride
    stepX := Max(2, ScanStep(3)), stepY := Max(2, ScanStep(3))
    minRun := Max(28, Round(shot.w * 0.085))
    rows := [], bestRun := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан кнопки выхода")
        row := y * stride, run := 0, stX := -1, bRun := 0, bCx := 0
        x := r.x1
        while (x < r.x2) {
            px := NumGet(buf, row + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 160 && g <= 82 && b <= 92 && rr - g >= 92 && rr - b >= 82) {
                if (stX < 0)
                    stX := x
                run += stepX
                if (run > bRun)
                    bRun := run, bCx := stX + run // 2
            } else {
                run := 0, stX := -1
            }
            x += stepX
        }
        rows.Push({y: y, run: bRun, cx: bCx})
        if (bRun > bestRun)
            bestRun := bRun
        y += stepY
    }
    if (bestRun < minRun)
        return 0
    thr := Max(minRun, Round(bestRun * 0.65))
    gapRows := Max(3, Round(shot.h * 0.028 / stepY))
    blocks := [], cur := 0, lastI := -999
    for i, rw in rows {
        if (rw.run >= thr) {
            if (cur && (i - lastI) <= gapRows) {
                cur.botY := rw.y, cur.runs.Push(rw)
            } else {
                if cur
                    blocks.Push(cur)
                cur := {topY: rw.y, botY: rw.y, runs: [rw]}
            }
            lastI := i
        }
    }
    if cur
        blocks.Push(cur)
    best := 0, bestArea := 0
    for bl in blocks {
        if (bl.runs.Length < 3)
            continue
        bw := 0, sumCx := 0
        for rw in bl.runs {
            sumCx += rw.cx
            if (rw.run > bw)
                bw := rw.run
        }
        bh := bl.botY - bl.topY + stepY
        asp := bw / Max(1, bh)
        if (bw > shot.w * 0.28 || bh < shot.h * 0.025 || bh > shot.h * 0.11 || asp < 2.2 || asp > 8.5)
            continue
        cx := Round(sumCx / bl.runs.Length)
        area := bw * bh
        if (area > bestArea)
            bestArea := area, best := {x: cx - bw // 2, y: bl.topY, w: bw, h: bh, cx: cx, cy: bl.topY + bh // 2, area: area}
    }
    return best
}

FindSleepScreen(shot) {
    ; Экран спящего режима Fortnite (появляется после долгого простоя в лобби):
    ; однородный тёмно-синий фон по периметру + крупная центральная кнопка
    ; «ПРОДОЛЖИТЬ ИГРУ» / «KEEP PLAYING» (светло-лавандовая, белая или жёлтая).
    global CFG
    buf := shot.buf, stride := shot.stride
    stepX := Max(12, shot.w // 48), stepY := Max(12, shot.h // 32)
    navy := 0, tot := 0
    y := stepY
    while (y < shot.h - stepY) {
        row := y * stride, x := stepX
        while (x < shot.w - stepX) {
            if (x > shot.w * 0.24 && x < shot.w * 0.76 && y > shot.h * 0.22 && y < shot.h * 0.78) {
                x += stepX
                continue
            }
            px := NumGet(buf, row + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            tot += 1
            if (rr <= 44 && g <= 52 && b >= 14 && b <= 98 && b + 4 >= rr && b >= g - 8)
                navy += 1
            x += stepX
        }
        y += stepY
    }
    if (tot < 40)
        return 0
    navyFrac := navy / tot
    if (navyFrac < CFG.sleepNavyMin)
        return 0
    btn := FindLightPlateButton(shot, CFG.regSleepBtn, 0.10, 0.38, 2.0, 7.8, true)
    if !btn {
        yl := FindYellowButtons(shot, CFG.regSleepBtn)
        if yl.Length
            btn := yl[1]
    }
    if !btn
        return 0
    if (Abs(btn.cx - shot.w // 2) > shot.w * 0.10)
        return 0
    btn.navy := navyFrac
    return btn
}

SquadScanHud(shot) {
    ; Поиск полос здоровья/щита союзников в HUD отряда по буферу кадра
    ; (работает в любом разрешении и даже если окно игры закрыто другим окном).
    ; Проверяем обе раскладки HUD Fortnite: верхний левый список отряда и
    ; нижний левый блок над собственной полосой HP игрока.
    global ST
    ownHpTop := (IsObject(ST.hudFound) && ST.hudFound.HasOwnProp("y"))
        ? ST.hudFound.y - Round(shot.h * 0.035) : Round(shot.h * 0.855)
    botY2 := Clamp(ownHpTop / Max(1, shot.h), 0.70, 0.855)
    zones := [
        [0.015, 0.042, 0.155, 0.255],
        [0.020, 0.675, 0.155, botY2]
    ]
    buf := shot.buf, stride := shot.stride
    minRun := Max(26, Round(shot.w * 0.026))
    maxRun := Max(60, Round(shot.w * 0.125))
    minSepY := Max(12, Round(shot.h * 0.024))
    namePadY := Max(6, Round(shot.h * 0.015))
    bars := []
    for z in zones {
        if (z[4] <= z[2] + 0.03)
            continue
        r := RegionToPixels(shot, z)
        prevRun := 0, prevX := -999
        y := r.y1
        while (y < r.y2) {
            row := y * stride, run := 0, stX := -1, bRun := 0, bX := 0
            x := r.x1
            while (x < r.x2) {
                px := NumGet(buf, row + x * 4, "UInt")
                b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
                isHp := (g >= 155 && g > rr + 38 && g >= b && b >= 25 && b <= 170)
                isSh := (b >= 175 && g >= 105 && g <= 238 && rr <= 92 && b > rr + 90)
                isDbno := (rr >= 175 && g <= 72 && b <= 72 && rr - g >= 108)
                if (isHp || isSh || isDbno) {
                    if (stX < 0)
                        stX := x
                    run += 2
                    if (run > bRun)
                        bRun := run, bX := stX
                } else {
                    run := 0, stX := -1
                }
                x += 2
            }
            if (bRun >= minRun && bRun <= maxRun) {
                if (prevRun >= minRun && Abs(bX - prevX) <= 8) {
                    dup := false
                    for ex in bars {
                        if (Abs(y - ex.y) < minSepY) {
                            dup := true
                            break
                        }
                    }
                    if (!dup && SquadBarHasNameAbove(buf, stride, shot.w, shot.h, bX, y, bRun, namePadY)) {
                        bars.Push({x: bX, y: y - 2, w: bRun, h: 6})
                        if (bars.Length >= 3)
                            return {count: bars.Length, bars: bars}
                    }
                }
                prevRun := bRun, prevX := bX
            } else {
                prevRun := 0, prevX := -999
            }
            y += 2
        }
    }
    return {count: bars.Length, bars: bars}
}

SquadBarHasNameAbove(buf, stride, sw, sh, bx, by, bw, padY) {
    ; Над полосой союзника всегда идёт яркая белая подпись ника (отсекает траву/небо).
    y1 := Clamp(by - padY - 6, 0, sh - 1)
    y2 := Clamp(by - 2, y1 + 1, sh)
    x1 := Clamp(bx, 0, sw - 1)
    x2 := Clamp(bx + Max(bw, Round(sw * 0.05)), x1 + 1, sw)
    white := 0
    y := y1
    while (y < y2) {
        row := y * stride, x := x1
        while (x < x2) {
            px := NumGet(buf, row + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 208 && g >= 208 && b >= 208) {
                white += 1
                if (white >= 4)
                    return true
            }
            x += 3
        }
        y += 2
    }
    return false
}

; ------------------------------------------------------------------ сундук
FindRewardButton(shot) {
    ; Кнопка внизу по центру экрана награды:
    ;   «ЗАБРАТЬ ВСЁ»  — белая с тёмным текстом   (RGB ~255,255,255)
    ;   «ПОЛУЧИТЬ ВСЁ»/«ИСПОЛЬЗОВАТЬ» — кремовые (RGB ~255,233,180)
    global CFG
    best := 0, bestKind := ""
    for c in MaskClusters(shot, CFG.regRewardBtn, "cream", 16, ScanStep(5), 3) {
        asp := c.w / Max(1, c.h)
        if (c.w < shot.w * 0.10 || asp < 2.0 || asp > 12 || c.fill < 0.45)
            continue
        if (c.cx < shot.w * 0.30 || c.cx > shot.w * 0.70)   ; «Забрать всё» — по центру
            continue
        if (!best || c.area > best.area)
            best := c, bestKind := "cream"
    }
    for c in MaskClusters(shot, CFG.regRewardBtn, "white", 16, ScanStep(5), 3) {
        asp := c.w / Max(1, c.h)
        if (c.w < shot.w * 0.10 || asp < 2.0 || asp > 12 || c.fill < 0.50)
            continue
        if (c.cx < shot.w * 0.30 || c.cx > shot.w * 0.70)
            continue
        if (!best || c.area > best.area)
            best := c, bestKind := "white"
    }
    if !best
        return 0
    best.kind := bestKind
    return best
}

FindToken(shot) {
    ; Жетон «пиратского магазина»: золотой круг со стилизованной белой «F».
    ; Признак — БЕЛАЯ буква: вытянутая по вертикали (аспект ~0.35-0.55), плотная,
    ; окружённая золотом. Обычный белый текст сюда не попадает (он мелкий/широкий).
    global CFG
    for c in MaskClusters(shot, CFG.regToken, "pure", 14, ScanStep(7), 6) {
        asp := c.w / Max(1, c.h)
        if (asp < 0.28 || asp > 0.58)
            continue
        if (c.fill < 0.40 || c.fill > 0.90)
            continue
        if (c.w < shot.w * 0.015 || c.w > shot.w * 0.14)
            continue
        if (c.h < shot.h * 0.06 || c.h > shot.h * 0.30)
            continue
        ; вокруг буквы должно быть много золота
        ring := {x1: Max(0, c.x - c.w), y1: Max(0, c.y - c.h)
               , x2: Min(shot.w - 1, c.x + c.w * 2), y2: Min(shot.h - 1, c.y + c.h * 2)}
        if (GoldRatio(shot, ring) < 0.35)
            continue
        return c
    }
    return 0
}

RareBanner(shot) {
    ; Баннер «ВАША НАХОДКА · ДОСТУП В ПИРАТСКИЙ МАГАЗИН» (а также выпадение
    ; скина/машины): сверху по центру много золота и крупные светлые буквы.
    ; Золотой сундук в кадре даёт золото без светлых букв — не путается.
    global CFG
    r := RegionToPixels(shot, CFG.regBanner)
    g := GoldRatio(shot, r)
    if (g < CFG.bannerGoldMin)
        return false
    light := LightRatio(shot, r)
    ; Буквы баннера — это НЕМНОГО светлых пикселей поверх золота. Если светлого
    ; много, значит в этой области картинка/видео/светлая сцена, а не баннер
    ; (run-17: так бот «находил» баннер на скриншоте рабочего стола).
    if (light < CFG.bannerLightMin || light > CFG.bannerLightMax)
        return false
    ; Главный признак: у баннера есть ШИРОКАЯ золотая полоса — десятки строк,
    ; где золото занимает больше половины ширины. У фото/видео таких строк нет.
    return (GoldBandRows(shot, r) >= CFG.bannerBandRows)
}

ChestGlowInfo(shot, c, isRare := false) {
    ; v11.0: проверяем контраст ядра сундука и внешнего ореола свечения.
    ; Плоские золотые крыши, песок и стены имеют ровную яркость без яркого ядра,
    ; а настоящий сундук заметно ярче в центре, чем на периферии.
    coreSum := 0, coreN := 0, ringSum := 0, ringN := 0
    padX := Max(8, Floor(c.w * 0.35)), padY := Max(8, Floor(c.h * 0.35))
    x1 := Max(0, c.x - padX), y1 := Max(0, c.y - padY)
    x2 := Min(shot.w - 1, c.x + c.w + padX), y2 := Min(shot.h - 1, c.y + c.h + padY)
    step := Max(4, Floor(Min(c.w, c.h) / 4))
    y := y1
    while (y <= y2) {
        x := x1
        while (x <= x2) {
            o := y * shot.stride + x * 4
            px := NumGet(shot.buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            lum := isRare ? ((b * 2 + g) // 3) : ((rr * 2 + g) // 3)
            if (x >= c.x && x <= c.x + c.w && y >= c.y && y <= c.y + c.h)
                coreSum += lum, coreN += 1
            else
                ringSum += lum, ringN += 1
            x += step
        }
        y += step
    }
    coreAvg := coreN ? (coreSum / coreN) : 0
    ringAvg := ringN ? (ringSum / ringN) : coreAvg
    return {core: coreAvg, ring: ringAvg, contrast: coreAvg - ringAvg}
}

FindChest(shot) {
    ; v11.0: ищем и обычные золотые сундуки (chestGold), и редкие синие (chestRare).
    ; Отсекаем небо, собственный аватар, плоские стены/крыши и плохие точки.
    global CFG
    masks := CachedLootMasks(shot)
    sc := Max(0.5, shot.w / 1280.0)
    minArea := Round(CFG.chestGoldArea * sc * sc)
    maxArea := Round(CFG.chestGoldMax * sc * sc)
    maxW := Round(CFG.chestMaxW * sc), maxH := Round(CFG.chestMaxH * sc)
    cxMid := shot.w * 0.5, cyMid := shot.h * 0.5
    best := 0, bestScore := -1
    for mode in ["chestGold", "chestRare"] {
        isRare := (mode = "chestRare")
        for c in LootMask(masks, mode) {
            if (c.area < minArea || c.area > maxArea)
                continue
            if (c.w < Round(14 * sc) || c.h < Round(12 * sc))
                continue
            if (c.w > maxW || c.h > maxH)
                continue
            asp := c.w / Max(1, c.h)
            if (asp < 0.35 || asp > 2.65)
                continue
            if (c.cy < shot.h * 0.24)
                continue
            if IsOwnPlayerZone(shot, c.cx, c.cy)
                continue
            if SpotIsBad(c.cx, c.cy)
                continue
            glow := ChestGlowInfo(shot, c, isRare)
            if (glow.core < (isRare ? 125 : 118))
                continue
            if (c.area > Round(2800 * sc * sc) && glow.contrast < 6)
                continue
            dist := Hypot(c.cx - cxMid, c.cy - cyMid)
            prox := Max(0.2, 1.0 - dist / (shot.w * 0.85))
            score := (c.area * (isRare ? 1.25 : 1.0) + glow.contrast * 35.0) * prox
            if (!best || score > bestScore) {
                best := {x: c.cx, y: c.cy, w: c.w, h: c.h, area: c.area
                    , kind: mode, score: score, glow: glow.core
                    , drawX: c.x, drawY: c.y}
                bestScore := score
            }
        }
    }
    return best
}

FindLoot(shot) {
    ; v11.0: предметы по редкости (фиолетовый > синий > зелёный) + близость к прицелу
    global CFG
    masks := CachedLootMasks(shot)
    cxMid := shot.w * 0.5, cyMid := shot.h * 0.5
    best := 0, bestScore := -1
    for mode in ["purple", "blue", "green"] {
        prio := (mode = "purple") ? 1.65 : ((mode = "blue") ? 1.30 : 1.0)
        for c in LootMask(masks, mode) {
            if (c.area < CFG.lootMinArea)
                continue
            if (c.area > shot.w * shot.h * 0.03 || c.w > shot.w * 0.30 || c.h > shot.h * 0.25)
                continue
            if (c.cy < shot.h * 0.26)
                continue
            if IsOwnPlayerZone(shot, c.cx, c.cy)
                continue
            if SpotIsBad(c.cx, c.cy)
                continue
            dist := Hypot(c.cx - cxMid, c.cy - cyMid)
            score := c.area * prio * Max(0.25, 1.0 - dist / (shot.w * 0.9))
            if (!best || score > bestScore) {
                best := {x: c.cx, y: c.cy, w: c.w, h: c.h, area: c.area, kind: mode
                    , score: score, drawX: c.x, drawY: c.y}
                bestScore := score
            }
        }
    }
    return best
}

; ------------------------------------------------------- звук (визуализация)
Hypot(x, y) {
    return Sqrt(x * x + y * y)
}

Atan2Deg(x, y) {
    ; Угол в градусах (-180..180): 0 = прямо вверх, +90 = вправо, -90 = влево
    if (x = 0 && y = 0)
        return 0.0
    if (y > 0)
        rad := ATan(x / y)
    else if (y < 0)
        rad := (x >= 0) ? (ATan(x / y) + 3.14159265) : (ATan(x / y) - 3.14159265)
    else
        rad := (x >= 0) ? 1.57079633 : -1.57079633
    return rad * 57.2957795
}

SoundRingScan(shot) {
    ; v11.0: раздельное чтение кольца «Visualize Sound Effects» вокруг прицела.
    ; Возвращает {shot, chest, step, best}, у каждой метки есть angleDeg (-180..180).
    global CFG
    out := {shot: 0, chest: 0, step: 0, best: 0}
    res := MaskClustersMulti(shot, CFG.regSound, ["white", "gold", "red"], 14, ScanStep(5), 2)
    cx := shot.w * 0.5, cy := shot.h * 0.5
    rMin := shot.h * 0.10, rMax := shot.h * 0.45
    bestRank := -1
    for mode, list in res {
        rank := (mode = "red") ? 3 : ((mode = "gold") ? 2 : 1)
        for c in list {
            side := Max(c.w, c.h)
            if (side < CFG.soundRingMin || side > CFG.soundRingMax)
                continue
            if (c.fill > CFG.alertFillMax)
                continue
            asp := c.w / Max(1, c.h)
            if (asp < 0.40 || asp > 2.40)
                continue
            dist := Hypot(c.cx - cx, c.cy - cy)
            if (dist < rMin || dist > rMax)
                continue
            ang := Atan2Deg(c.cx - cx, -(c.cy - cy))
            item := {x: c.cx, y: c.cy, w: c.w, h: c.h, area: c.area, kind: mode, angleDeg: ang}
            if (mode = "red" && (!out.shot || c.area > out.shot.area))
                out.shot := item
            else if (mode = "gold" && (!out.chest || c.area > out.chest.area))
                out.chest := item
            else if (mode = "white" && (!out.step || c.area > out.step.area))
                out.step := item
            if (!out.best || rank > bestRank || (rank = bestRank && c.area > out.best.area))
                out.best := item, bestRank := rank
        }
    }
    return out
}

SoundMarks(shot) {
    return SoundRingScan(shot).best
}

FindIncomingHitArc(shot) {
    ; v11.0: красная дуга входящего урона вокруг прицела (показывает, откуда стреляют).
    cx := shot.w * 0.5, cy := shot.h * 0.5
    rMin := Round(shot.h * 0.08), rMax := Round(shot.h * 0.24)
    step := Max(4, ScanStep(5))
    sumX := 0.0, sumY := 0.0, hits := 0
    y := Max(0, Round(cy - rMax))
    yEnd := Min(shot.h - 1, Round(cy + rMax))
    xStart := Max(0, Round(cx - rMax))
    xEnd := Min(shot.w - 1, Round(cx + rMax))
    while (y <= yEnd) {
        x := xStart
        while (x <= xEnd) {
            dx := x - cx, dy := y - cy
            d := Hypot(dx, dy)
            if (d >= rMin && d <= rMax) {
                o := y * shot.stride + x * 4
                px := NumGet(shot.buf, o, "UInt")
                b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
                if (rr >= 195 && g <= 85 && b <= 85 && (rr - g) >= 115 && (rr - b) >= 120) {
                    sumX += dx, sumY += dy, hits += 1
                }
            }
            x += step
        }
        y += step
    }
    if (hits < 4)
        return 0
    mx := sumX / hits, my := sumY / hits
    return {angleDeg: Atan2Deg(mx, -my), strength: hits, x: Round(cx + mx), y: Round(cy + my)}
}

SoundFlash(shot) {
    ; Вспышка (выстрел/взрыв): резкий прирост яркости центра по сравнению с прошлым кадром
    global CFG, ST
    prev := ST.prevShot
    if (!prev || prev.w != shot.w || prev.h != shot.h)
        return 0
    sumNow := 0, sumPrev := 0, n := 0
    r := RegionToPixels(shot, [0.20, 0.20, 0.80, 0.80])
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        x := r.x1
        while (x < r.x2) {
            o := y * shot.stride + x * 4
            vNow := NumGet(shot.buf, o, "UChar") + NumGet(shot.buf, o + 1, "UChar") + NumGet(shot.buf, o + 2, "UChar")
            vPrev := NumGet(prev.buf, o, "UChar") + NumGet(prev.buf, o + 1, "UChar") + NumGet(prev.buf, o + 2, "UChar")
            if (vNow - vPrev > 90)
                sumNow += 1
            n += 1
            x += 12
        }
        y += 12
    }
    if (n = 0)
        return 0
    pct := sumNow / n * 100
    return (pct >= CFG.soundFlashDelta) ? pct : 0
}

; ------------------------------------------------------------------- враги
; Прицел в матче — светлый крестик/точка в самом центре. Это дешёвый и очень
; устойчивый признак «мы в игре»: в лобби там курсор, а не центр экрана.
CrosshairCenter(shot) {
    cx := shot.w // 2, cy := shot.h // 2
    hits := 0
    for pt in [[0, 0], [2, 0], [-2, 0], [0, 2], [0, -2], [1, 1], [-1, -1], [4, 0], [-4, 0]] {
        px := RgbAt(shot, cx + pt[1], cy + pt[2])
        if (px.r >= 200 && px.g >= 200 && px.b >= 200)
            hits += 1
    }
    return (hits >= 3)
}

CrosshairRed(shot) {
    cx := shot.w // 2, cy := shot.h // 2
    cnt := 0
    d := -14
    while (d <= 14) {
        for pt in [[cx + d, cy], [cx, cy + d], [cx + d, cy + d], [cx + d, cy - d]] {
            px := RgbAt(shot, pt[1], pt[2])
            if (px.r >= 130 && (px.r - px.g) >= 45 && (px.r - px.b) >= 45)
                cnt += 1
        }
        d += 2
    }
    return cnt >= 6
}

; Кандидаты в «врага» для калибровки (F5): видно, что именно нашлось и что
; отсеялось. v7.7: полосок HP у врага в игре нет, поэтому кандидаты — фигуры,
; цифры урона и метки звука.
EnemyCandidates(shot) {
    global CFG, ST
    out := []
    f := FindEnemySkin(shot, CFG.enemyFastFrac)
    if f
        out.Push({w: f.w, h: f.h, cx: f.cx, cy: f.cy, dist: f.dist, pass: true
                , src: "фигура (кожа " f.skin "%)"})
    else
        out.Push({w: 0, h: 0, cx: 0, cy: 0, dist: ST.enemySkinPct
                , pass: false, src: "фигуры нет (кожи " ST.enemySkinPct "%)"})
    d := FindDamageNumber(shot)
    if d
        out.Push({w: d.w, h: d.h, cx: d.cx, cy: d.cy
                , dist: Abs(d.cx - shot.w // 2), pass: true, src: "цифра урона " d.kind})
    a := FindAlertMark(shot)
    if a
        out.Push({w: a.w, h: a.h, cx: a.cx, cy: a.cy
                , dist: Abs(a.cx - shot.w // 2), pass: true, src: "метка звука (выстрел)"})
    return out
}

; ============================================================================
;   ВРАГ В ТЕКУЩЕМ FORTNITE (v7.7): полосы HP над противником НЕТ
; ============================================================================
; Как игра выглядит сейчас:
;   • своя полоса здоровья и щита — ВНИЗУ СЛЕВА (её читает BarProfile);
;   • над противником НЕТ полосы здоровья. Когда вы попадаете, над ним
;     всплывают ЦИФРЫ УРОНА: белые — по здоровью, синие — по щиту, золотые —
;     попадание в голову;
;   • если в настройках включена «Визуализация звуковых эффектов», вокруг
;     центра экрана появляются метки: красные/оранжевые — выстрелы и взрывы,
;     золотые — сундук и лут, белые — шаги, звери, машины.
; Поэтому «враг» определяется по трём каналам, без всякой полоски:
;   1) ФИГУРА — компактное пятно кожи/одежды нужного размера около центра;
;   2) ЦИФРЫ УРОНА — мы точно попали, значит противник там;
;   3) МЕТКА ЗВУКА — враг рядом (выстрел), хотя самого его не видно.
; ----------------------------------------------------------------------------
SkinGrid(shot, x1, y1, x2, y2, stepIn := 0) {
    ; Карта плотности «кожи» по ячейкам CFG.skinCell. Кожа — тёплые пиксели:
    ; красного заметно больше синего, зелёного больше синего. Белое и пересвет
    ; отсекаем отдельно, иначе небо, песок и снег считались бы игроками.
    global CFG
    cell := CFG.skinCell
    step := ScanStep(stepIn > 0 ? stepIn : CFG.skinStep)
    cw := (x2 - x1) // cell + 2
    ch := (y2 - y1) // cell + 2
    n := cw * ch
    cnt := [], tot := []
    i := 1
    while (i <= n) {
        cnt.Push(0), tot.Push(0)
        i += 1
    }
    buf := shot.buf, stride := shot.stride
    y := y1
    while (y < y2) {
        TickCheck("скан фигуры врага")
        x := x1
        while (x < x2) {
            px := NumGet(buf, y * stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            k := ((y - y1) // cell) * cw + ((x - x1) // cell) + 1
            tot[k] += 1
            if (rr >= 120 && rr > g + 16 && g >= b + 6 && (rr - b) >= 26
                && !(rr >= 232 && g >= 232 && b >= 225))
                cnt[k] += 1
            x += step
        }
        y += step
    }
    return {cnt: cnt, tot: tot, cw: cw, ch: ch, cw2: cw, x1: x1, y1: y1
          , cell: cell, step: step}
}

; Суммы кожи по столбцу/строке карты — по ним бокс растягивается от центра
GridColSum(g, c) {
    sum := 0, r := 1
    while (r <= g.ch) {
        sum += g.cnt[(r - 1) * g.cw + c]
        r += 1
    }
    return sum
}

GridRowSum(g, r) {
    sum := 0, c := 1
    while (c <= g.cw) {
        sum += g.cnt[(r - 1) * g.cw + c]
        c += 1
    }
    return sum
}

; Ширина пятна кожи в полосе строк (для проверки «голова уже плеч»)
BandSpan(g, c0, c1, r0, r1) {
    left := -1, right := -1
    r := Max(1, r0)
    while (r <= Min(g.ch, r1)) {
        c := Max(1, c0)
        while (c <= Min(g.cw, c1)) {
            if (g.cnt[(r - 1) * g.cw + c] > 0) {
                if (left < 0 || c < left)
                    left := c
                if (c > right)
                    right := c
            }
            c += 1
        }
        r += 1
    }
    return (left < 0) ? 0 : (right - left + 1)
}

; Цифры урона и метки выстрела существуют меньше секунды. Если один и тот же
; бокс висит на месте десяток сканов — это иконка предмета или деталь HUD.
TransientOk(x, y) {
    global CFG, ST
    now := A_TickCount
    key := Round(x / CFG.transientPx) "-" Round(y / CFG.transientPx)
    if (key = ST.seenKey && (now - ST.seenAt) < 400) {
        ST.seenN += 1
    } else {
        ST.seenKey := key
        ST.seenN := 1
    }
    ST.seenAt := now
    return (ST.seenN <= CFG.transientMaxN)
}

; «не враг»: бот стрелял по этому месту и ни разу не попал
NearFalseEnemy(x, y) {
    global CFG, ST
    if !ST.falseEnAt
        return false
    if (A_TickCount - ST.falseEnAt > CFG.falseEnemyMs) {
        ST.falseEnAt := 0
        return false
    }
    return (Abs(x - ST.falseEnX) < CFG.falseEnemyPx)
        && (Abs(y - ST.falseEnY) < CFG.falseEnemyPx)
}

MarkFalseEnemy(x, y) {
    global ST
    ST.falseEnX := x, ST.falseEnY := y, ST.falseEnAt := A_TickCount
}

; --- канал 1: фигура игрока -------------------------------------------------
FindEnemySkin(shot, frac := 0, stepIn := 0) {
    global CFG, ST
    if (frac <= 0)
        frac := CFG.enemyFastFrac
    x1 := Max(0, Round(shot.w * (0.5 - frac / 2)))
    x2 := Min(shot.w - 1, Round(shot.w * (0.5 + frac / 2)))
    y1 := Max(0, Round(shot.h * 0.12))
    y2 := Min(shot.h - 1, Round(shot.h * 0.92))
    g := SkinGrid(shot, x1, y1, x2, y2, stepIn)
    ; 1) самая густая точка: максимум кожи в окне 3x3 ячейки
    bx := 0, by := 0, best := 0
    row := 1
    while (row <= g.ch - 2) {
        col := 1
        while (col <= g.cw - 2) {
            sum := 0
            for oy in [0, 1, 2] {
                base := (row + oy - 1) * g.cw
                for ox in [0, 1, 2]
                    sum += g.cnt[base + col + ox]
            }
            if (sum > best)
                best := sum, bx := col, by := row
            col += 1
        }
        row += 1
    }
    if (best < 3)
        return 0
    ; 2) растягиваем бокс в стороны, пока в соседних столбцах/строках есть кожа
    thr := Max(2, best // 10)
    c0 := bx, c1 := bx + 1, r0 := by, r1 := by + 1
    while (c0 > 1 && GridColSum(g, c0 - 1) >= thr)
        c0 -= 1
    while (c1 < g.cw && GridColSum(g, c1 + 1) >= thr)
        c1 += 1
    while (r0 > 1 && GridRowSum(g, r0 - 1) >= thr)
        r0 -= 1
    while (r1 < g.ch && GridRowSum(g, r1 + 1) >= thr)
        r1 += 1
    bx1 := x1 + (c0 - 1) * g.cell, bx2 := x1 + c1 * g.cell
    by1 := y1 + (r0 - 1) * g.cell, by2 := y1 + r1 * g.cell
    bw := bx2 - bx1, bh := by2 - by1
    if (bw < 4 || bh < 4)
        return 0
    ; 3) проверки размера: масштаб считаем относительно ширины 1280 px
    k := shot.w / 1280
    if (bw < CFG.enemyMinBoxW * k || bw > CFG.enemyMaxBoxW * k)
        return 0
    if (bh < CFG.enemyMinBoxH * k || bh > CFG.enemyMaxBoxH * k)
        return 0
    asp := bw / bh
    if (asp < CFG.enemyAspectMin || asp > CFG.enemyAspectMax)
        return 0
    ; 4) сколько кожи внутри бокса: и «слишком мало», и «слишком много» — не игрок
    skin := 0, all := 0
    r := r0
    while (r <= r1) {
        c := c0
        while (c <= c1) {
            idx := (r - 1) * g.cw + c
            skin += g.cnt[idx], all += g.tot[idx]
            c += 1
        }
        r += 1
    }
    if (all < 40)
        return 0
    pct := skin / all * 100
    ST.enemySkinPct := Round(pct)
    if (pct < CFG.enemySkinMinPct || pct > CFG.enemySkinMaxPct)
        return 0
    ; 5) голова должна быть УЖЕ плеч: у человека верх бокса узкий, у камня,
    ; стены и куста верх такой же, как середина
    headH := Max(1, Round((r1 - r0 + 1) * 0.22))
    headSpan := BandSpan(g, c0, c1, r0, r0 + headH)
    midFrom := r0 + Round((r1 - r0 + 1) * 0.35)
    midTo := r0 + Round((r1 - r0 + 1) * 0.75)
    midSpan := BandSpan(g, c0, c1, midFrom, midTo)
    if (headSpan < 1 || midSpan < 2)
        return 0
    if (headSpan > midSpan * CFG.enemyHeadNarrow)
        return 0
    cx := bx1 + bw // 2
    dist := Abs(cx - shot.w // 2)
    if (dist > shot.w * CFG.enemyCenterFrac)
        return 0
    ; СВОЙ персонаж виден всегда и стоит в центре-снизу кадра. Раньше именно он
    ; попадал в «враги» (и бот стрелял в собственную спину).
    if (cx > shot.w * 0.34 && cx < shot.w * 0.66
        && (by1 + bh) > shot.h * 0.55 && bw > shot.w * 0.08)
        return 0
    if NearFalseEnemy(cx, by1 + bh // 2)
        return 0
    return {x: bx1, y: by1, w: bw, h: bh, cx: cx
          , cy: by1 + Round(bh * 0.55)
          , hy: by1 + Round(bh * CFG.enemyHeadFrac)
          , src: "фигура", dist: dist, score: 2000 - dist, skin: Round(pct)}
}

IsOwnPlayerZone(shot, cx, cy, bw := 0, bh := 0) {
    ; Зона собственного персонажа от 3-го лица (центр-низ экрана)
    if (cx > shot.w * 0.33 && cx < shot.w * 0.62 && cy > shot.h * 0.68)
        return true
    if (bw > shot.w * 0.06 && cx > shot.w * 0.34 && cx < shot.w * 0.64 && (cy + bh * 0.5) > shot.h * 0.56)
        return true
    return false
}

CrosshairOnEnemy(shot) {
    ; v11.0: мгновенный захват, когда прицел Fortnite покраснел на живом враге.
    ; Проверяем красное ядро в радиусе 6..14 px и отсутствие такого же красного фона снаружи.
    global CFG
    if !CFG.featRedCrosshair
        return 0
    cx := shot.w // 2, cy := shot.h // 2
    innerRed := 0, outerRed := 0
    dy := -14
    while (dy <= 14) {
        dx := -14
        while (dx <= 14) {
            d := Abs(dx) + Abs(dy)
            if (d >= 3 && d <= 14) {
                x := cx + dx, y := cy + dy
                if (x >= 0 && x < shot.w && y >= 0 && y < shot.h) {
                    px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
                    b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
                    if (rr >= 200 && g <= 82 && b <= 82 && (rr - g) >= 120 && (rr - b) >= 120) {
                        if (d <= 8)
                            innerRed += 1
                        else
                            outerRed += 1
                    }
                }
            }
            dx += 2
        }
        dy += 2
    }
    if (innerRed >= 5 && outerRed <= innerRed * 0.7) {
        sc := Max(0.5, shot.w / 1280.0)
        bw := Round(52 * sc), bh := Round(110 * sc)
        return {x: cx - bw // 2, y: cy - Round(bh * 0.30), w: bw, h: bh
            , cx: cx, cy: cy + Round(bh * 0.18), hy: cy
            , src: "прицел", dist: 0, score: 3400, confirmed: true}
    }
    return 0
}

HasTeammateMarkerAbove(shot, x1, y1, w, h) {
    ; Отсекаем союзников по бирюзовому/белому маркеру или нику над головой
    global CFG
    if !CFG.featTeammateGuard
        return false
    rx1 := Max(0, x1 - Round(w * 0.25)), rx2 := Min(shot.w - 1, x1 + w + Round(w * 0.25))
    ry1 := Max(0, y1 - Max(22, Round(h * 0.35))), ry2 := Max(0, y1 - 2)
    if (ry2 <= ry1 || rx2 <= rx1)
        return false
    cyan := 0, step := Max(2, ScanStep(3))
    y := ry1
    while (y <= ry2) {
        x := rx1
        while (x <= rx2) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (b >= 195 && g >= 175 && rr <= 135 && (b - rr) >= 75)
                cyan += 1
            x += step
        }
        y += step
    }
    return (cyan >= 5)
}

FigureGroundScore(shot, x1, y1, w, h) {
    ; Контраст фигуры с левым и правым фоном (стена/камень дают низкий контраст)
    inR := 0, inG := 0, inB := 0, inN := 0
    outR := 0, outG := 0, outB := 0, outN := 0
    pad := Max(8, Round(w * 0.35))
    step := Max(4, Round(Min(w, h) / 5))
    y := Max(0, y1 + Round(h * 0.20))
    yEnd := Min(shot.h - 1, y1 + Round(h * 0.80))
    while (y <= yEnd) {
        x := Max(0, x1 + Round(w * 0.25))
        xEnd := Min(shot.w - 1, x1 + Round(w * 0.75))
        while (x <= xEnd) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            inB += px & 0xFF, inG += (px >> 8) & 0xFF, inR += (px >> 16) & 0xFF, inN += 1
            x += step
        }
        for fx in [Max(0, x1 - pad), Min(shot.w - 1, x1 + w + pad)] {
            px := NumGet(shot.buf, y * shot.stride + fx * 4, "UInt")
            outB += px & 0xFF, outG += (px >> 8) & 0xFF, outR += (px >> 16) & 0xFF, outN += 1
        }
        y += step
    }
    if (!inN || !outN)
        return 0
    return Abs(inR / inN - outR / outN) + Abs(inG / inN - outG / outN) + Abs(inB / inN - outB / outN)
}

HasTreeCanopyAbove(shot, x1, y1, w, h) {
    ; Если прямо над боксом густая зелёная крона — это ствол дерева, а не игрок
    ry1 := Max(0, y1 - Max(18, Round(h * 0.40))), ry2 := Max(0, y1 - 2)
    rx1 := Max(0, x1 - Round(w * 0.30)), rx2 := Min(shot.w - 1, x1 + w + Round(w * 0.30))
    if (ry2 <= ry1 || rx2 <= rx1)
        return false
    green := 0, tot := 0, step := Max(4, ScanStep(5))
    y := ry1
    while (y <= ry2) {
        x := rx1
        while (x <= rx2) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (g >= 75 && g > rr + 14 && g > b + 16)
                green += 1
            tot += 1
            x += step
        }
        y += step
    }
    return (tot > 8 && (green / tot) >= 0.42)
}

FindEnemyMotion(shot) {
    ; v11.0: детектор бегущего/прыгающего врага любого скина при тихой камере
    global CFG, ST
    if (!CFG.featMotionEnemy || !ST.prevShot)
        return 0
    if (A_TickCount - ST.lastCamMoveAt < 240)
        return 0
    prev := ST.prevShot
    if (prev.w != shot.w || prev.h != shot.h)
        return 0
    x1 := Round(shot.w * 0.14), x2 := Round(shot.w * 0.86)
    y1 := Round(shot.h * 0.18), y2 := Round(shot.h * 0.82)
    step := Max(6, ScanStep(7))
    minX := x2, maxX := x1, minY := y2, maxY := y1, hits := 0
    y := y1
    while (y < y2) {
        x := x1
        while (x < x2) {
            o := y * shot.stride + x * 4
            p1 := NumGet(shot.buf, o, "UInt"), p0 := NumGet(prev.buf, o, "UInt")
            d := Abs(((p1 >> 16) & 255) - ((p0 >> 16) & 255))
               + Abs(((p1 >> 8) & 255) - ((p0 >> 8) & 255))
               + Abs((p1 & 255) - (p0 & 255))
            if (d >= 78 && !IsOwnPlayerZone(shot, x, y)) {
                hits += 1
                if (x < minX)
                    minX := x
                if (x > maxX)
                    maxX := x
                if (y < minY)
                    minY := y
                if (y > maxY)
                    maxY := y
            }
            x += step
        }
        y += step
    }
    if (hits < 7)
        return 0
    bw := maxX - minX + step, bh := maxY - minY + step
    sc := Max(0.5, shot.w / 1280.0)
    if (bw < 14 * sc || bw > 260 * sc || bh < 26 * sc || bh > 420 * sc)
        return 0
    asp := bw / Max(1, bh)
    if (asp < 0.22 || asp > 1.15)
        return 0
    cx := minX + bw // 2
    if (NearFalseEnemy(cx, minY + bh // 2) || HasTeammateMarkerAbove(shot, minX, minY, bw, bh))
        return 0
    dist := Abs(cx - shot.w // 2)
    return {x: minX, y: minY, w: bw, h: bh, cx: cx
        , cy: minY + Round(bh * 0.50), hy: minY + Round(bh * CFG.enemyHeadFrac)
        , src: "движение", dist: dist, score: 1750 - dist}
}

FindEnemyMulti(shot, frac := 0, stepIn := 0) {
    ; v11.0: 4-канальный детектор врага (красный прицел -> цифры урона -> фигура -> движение)
    global CFG
    rc := CrosshairOnEnemy(shot)
    if rc
        return rc
    if CFG.featDamageAim {
        dmg := FindDamageNumber(shot)
        if dmg
            return dmg
    }
    fig := FindEnemySkin(shot, frac, stepIn)
    if fig {
        if (HasTeammateMarkerAbove(shot, fig.x, fig.y, fig.w, fig.h)
            || HasTreeCanopyAbove(shot, fig.x, fig.y, fig.w, fig.h))
            fig := 0
        else if (FigureGroundScore(shot, fig.x, fig.y, fig.w, fig.h) < CFG.enemyContrastMin)
            fig := 0
        if fig
            return fig
    }
    return FindEnemyMotion(shot)
}

; v8.4: короткие горизонтальные полосы вместо объединения белого по всей высоте.
; Ищем тёмную подложку и компактный светлый значок слева от строки. Текст не
; читается: это только кандидат, возможны ложные срабатывания и пропуски.
PromptWhiteStats(shot, x0, y0, x1, y1) {
    x0 := Max(0, Round(x0)), y0 := Max(0, Round(y0))
    x1 := Min(shot.w, Round(x1)), y1 := Min(shot.h, Round(y1))
    count := 0, left := x1, right := -1, top := y1, bottom := -1
    y := y0
    while (y < y1) {
        TickCheck("подсказка: область")
        x := x0
        while (x < x1) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            if (((px >> 16) & 255) >= 185 && ((px >> 8) & 255) >= 185 && (px & 255) >= 178) {
                count += 1
                left := Min(left, x), right := Max(right, x)
                top := Min(top, y), bottom := Max(bottom, y)
            }
            x += 1
        }
        y += 1
    }
    return {n: count, w: count ? right - left + 1 : 0, h: count ? bottom - top + 1 : 0}
}

PromptLumaMean(shot, x0, y0, x1, y1, step) {
    x0 := Max(0, Round(x0)), y0 := Max(0, Round(y0))
    x1 := Min(shot.w, Round(x1)), y1 := Min(shot.h, Round(y1))
    step := Max(1, Round(step)), sum := 0, count := 0
    y := y0
    while (y < y1) {
        TickCheck("подсказка: область")
        x := x0
        while (x < x1) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            sum += (px & 255) + ((px >> 8) & 255) + ((px >> 16) & 255)
            count += 1
            x += step
        }
        y += step
    }
    return count ? sum / count / 3 : 255
}

FindInteractPrompt(shot) {
    global CFG, ST
    now := A_TickCount
    if (ST.promptAt && (now - ST.promptAt) < CFG.promptScanMs) {
        ST.promptAvailable := true
        return ST.promptCache
    }
    if !ScanAllow(1) {
        ST.promptAvailable := false
        return 0
    }
    k := shot.w / 1280
    stepX := Max(1, Round(2 * k)), stepY := Max(1, Round(3 * k))
    bandHop := Max(2, Round(7 * k)), bandH := Max(6, Round(15 * k))
    pad := Max(2, Round(5 * k))
    xMin := Max(0, (Round(shot.w * 0.38) // stepX) * stepX)
    xMax := Min(shot.w, Round(shot.w * 0.82))
    yMin := Max(0, Round(shot.h * 0.38))
    yMax := Min(shot.h - bandH - 1, Round(shot.h * 0.63))
    best := 0, y0 := yMin
    while (y0 < yMax) {
        TickCheck("подсказка взаимодействия")
        cols := [], x := xMin
        while (x < xMax) {
            count := 0, yy := y0
            while (yy < y0 + bandH) {
                px := NumGet(shot.buf, yy * shot.stride + x * 4, "UInt")
                if (((px >> 16) & 255) >= 185 && ((px >> 8) & 255) >= 185 && (px & 255) >= 178)
                    count += 1
                yy += stepY
            }
            cols.Push(count)
            x += stepX
        }
        i := 1
        while (i <= cols.Length) {
            if !cols[i] {
                i += 1
                continue
            }
            j := i, last := i, gap := 0
            while (j <= cols.Length) {
                if cols[j]
                    last := j, gap := 0
                else {
                    gap += 1
                    if (gap > 3)
                        break
                }
                j += 1
            }
            x0 := xMin + (i - 1) * stepX
            x1 := xMin + (last - 1) * stepX
            span := x1 - x0 + stepX
            tot := 0, ci := i
            while (ci <= last)
                tot += cols[ci], ci += 1
            if (span >= CFG.promptSpanMin * k && span <= CFG.promptSpanMax * k
                && tot >= Max(8, Round(16 * k))) {
                hi := -1, lo := -1, yy := y0
                while (yy < y0 + bandH) {
                    xx := x0, found := false
                    while (xx <= x1) {
                        px := NumGet(shot.buf, yy * shot.stride + xx * 4, "UInt")
                        if (((px >> 16) & 255) >= 185 && ((px >> 8) & 255) >= 185 && (px & 255) >= 178) {
                            found := true
                            break
                        }
                        xx += stepX
                    }
                    if found {
                        if (hi < 0)
                            hi := yy
                        lo := yy
                    }
                    yy += stepY
                }
                hgt := lo - hi + 1
                cx := (x0 + x1) // 2, cy := (hi + lo) // 2
                dx := cx - shot.w // 2, dy := cy - shot.h // 2
                if (hi >= 0 && hgt >= CFG.promptHMin * k && hgt <= CFG.promptHMax * k
                    && Abs(dx) <= shot.w * CFG.promptDxFrac && Abs(dy) <= shot.h * CFG.promptDyFrac) {
                    back := PromptLumaMean(shot, x0 - pad, hi - pad, x1 + pad + 1, lo + pad + 1, Max(1, Round(3 * k)))
                    above := PromptLumaMean(shot, x0, hi - Round(10 * k), x1 + 1, hi - Round(5 * k), 2)
                    below := PromptLumaMean(shot, x0, lo + Round(5 * k), x1 + 1, lo + Round(10 * k), 2)
                    if (back <= CFG.promptDarkMax && above <= 110 && below <= 110) {
                        icon := PromptWhiteStats(shot, x0 - Round(38 * k), hi - Round(5 * k), x0 - Round(21 * k), lo + Round(6 * k))
                        compact := (icon.n >= Max(3, Round(8 * k * k))
                            && icon.w >= 2 * k && icon.w <= 10 * k
                            && icon.h >= 4 * k && icon.h <= 14 * k)
                        if compact {
                            gapPx := Max(2, Round(3 * k)), outPx := Max(5, Round(17 * k))
                            upper := PromptWhiteStats(shot, x0, hi - outPx, x1 + 1, hi - gapPx)
                            lower := PromptWhiteStats(shot, x0, lo + gapPx, x1 + 1, lo + outPx)
                            middle := PromptWhiteStats(shot, x0, hi, x1 + 1, lo + 1)
                            isolated := (upper.n + lower.n <= Max(10, Round(0.08 * middle.n)))
                            if isolated {
                                score := 1000 - (Abs(dx) + Abs(dy))
                                if (!best || score > best.score)
                                    best := {x: x0, y: hi, w: span, h: hgt, cx: cx
                                        , cy: cy, span: span, back: Round(back)
                                        , dx: dx, dy: dy, score: score}
                            }
                        }
                    }
                }
            }
            i := last + 1
        }
        y0 += bandHop
    }
    ST.promptCache := best
    ST.promptSeq := shot.captureId
    ST.promptAvailable := true
    ST.promptAt := A_TickCount
    return best
}

; Подтверждение не является распознаванием: два похожих наблюдения разных
; снимков могут повторить одну и ту же систематическую ошибку детектора.
ConfirmCandidate(tr, item, frameId, width, height, now, needed := 2) {
    global CFG
    if (!frameId || frameId = tr.seq)
        return (item && tr.hits >= needed && now - tr.at <= CFG.confirmGapMs) ? item : 0
    if !item {
        tr.seq := frameId, tr.at := now, tr.hits := 0
        return 0
    }
    nearby := (Abs(item.cx - tr.x) <= width * 0.10)
        && (Abs(item.cy - tr.y) <= height * 0.10)
    if (tr.hits && now - tr.at <= CFG.confirmGapMs && nearby)
        tr.hits += 1
    else
        tr.hits := 1
    tr.seq := frameId, tr.at := now, tr.x := item.cx, tr.y := item.cy
    return (tr.hits >= needed) ? item : 0
}

; Учитываем в подтверждении только свежий скан текущего кадра и той же
; сессии/камеры/размера. Два кандидата всё равно не читают E или тип объекта.
PromptConfirmFresh(shot, item) {
    global CFG, ST
    previous := Critical("On")
    try {
        if (!IsObject(shot) || !shot.HasOwnProp("captureId") || !shot.captureId
            || !shot.HasOwnProp("capturedAt") || !shot.HasOwnProp("cameraSeqAtCapture")
            || !shot.HasOwnProp("inputEpochAtCapture") || !shot.HasOwnProp("w") || !shot.HasOwnProp("h")
            || !ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != shot.inputEpochAtCapture
            || ST.cameraSeq != shot.cameraSeqAtCapture || A_TickCount < shot.capturedAt
            || A_TickCount - shot.capturedAt > 250)
            return 0
        if (!ST.promptAvailable || ST.promptSeq != shot.captureId)
            return 0
        tr := ST.promptConfirm
        if (!IsObject(tr) || !tr.HasOwnProp("epoch") || !tr.HasOwnProp("camera")
            || !tr.HasOwnProp("w") || !tr.HasOwnProp("h")
            || tr.epoch != shot.inputEpochAtCapture || tr.camera != shot.cameraSeqAtCapture
            || tr.w != shot.w || tr.h != shot.h) {
            tr := {seq:0, at:0, hits:0, x:0, y:0, epoch:shot.inputEpochAtCapture
                , camera:shot.cameraSeqAtCapture, w:shot.w, h:shot.h}
            ST.promptConfirm := tr
        }
        ; Поздно завершившийся старый скан не должен подтверждать или очищать
        ; уже обработанный более новый кадр.
        if (tr.seq && (shot.captureId < tr.seq || shot.capturedAt < tr.at))
            return 0
        return ConfirmCandidate(tr, item, shot.captureId, shot.w, shot.h
            , shot.capturedAt, CFG.promptConfirmHits)
    } finally {
        Critical(previous)
    }
}

; --- канал 2: цифры урона (мы попали) ---------------------------------------
FindDamageNumber(shot) {
    global CFG
    k := shot.w / 1280                    ; размеры HUD масштабируются с кадром
    frac := CFG.damageNearFrac
    r := [0.5 - frac / 2, 0.12, 0.5 + frac / 2, 0.92]
    list := MaskClustersMulti(shot, r, ["white", "pure", "blue", "yellow"], 6, 3, 2)
    best := 0
    for mode, arr in list {
        for c in arr {
            side := Max(c.w, c.h)
            if (side < CFG.damageMinPx * k || side > CFG.damageMaxPx * k)
                continue
            if (c.w > c.h * 3 || c.h > c.w * 3)       ; длинная полоса — не цифра
                continue
            aspD := c.w / Max(1, c.h)
            if (aspD < CFG.damageAspectMin || aspD > CFG.damageAspectMax)
                continue
            ; прицел сам белый и стоит ровно в центре: его не считаем попаданием
            if (Abs(c.cx - shot.w // 2) <= CFG.damageCrossPx * k
                && Abs(c.cy - shot.h // 2) <= CFG.damageCrossPx * k)
                continue
            kind := (mode = "blue") ? "по щиту" : (mode = "yellow" ? "в голову" : "по здоровью")
            dist := Abs(c.cx - shot.w // 2) + Abs(c.cy - shot.h // 2) // 2
            if (!best || dist < best.dist)
                best := {x: c.cx - c.w // 2, y: c.cy - c.h // 2, w: c.w, h: c.h
                       , cx: c.cx, cy: c.cy, kind: kind, dist: dist, fill: c.fill}
        }
    }
    return best
}

; --- канал 3: красная/оранжевая метка выстрела (визуализация звука) ---------
FindAlertMark(shot) {
    global CFG
    k := shot.w / 1280
    frac := CFG.alertCenterFrac
    r := RegionToPixels(shot, CFG.regEnemy)
    half := Min(frac, 0.48)
    x1 := Max(r.x1, Round(shot.w * (0.5 - half))), x2 := Min(r.x2, Round(shot.w * (0.5 + half)))
    y1 := Max(r.y1, Round(shot.h * 0.10)), y2 := Min(r.y2, Round(shot.h * 0.92))
    if (x2 - x1 < 40 || y2 - y1 < 40)
        return 0
    reg := [x1 / shot.w, y1 / shot.h, x2 / shot.w, y2 / shot.h]
    list := MaskClusters(shot, reg, "red", 10, ScanStep(5), 2)
    best := 0
    for c in list {
        side := Max(c.w, c.h)
        if (side < CFG.alertMinPx * k || side > CFG.alertMaxPx * k)
            continue
        if (c.fill > CFG.alertFillMax)             ; метка — дуга, а не пятно
            continue
        if (c.w > c.h * 3 || c.h > c.w * 3)
            continue
        if (!best || c.area > best.area)
            best := {x: c.cx - c.w // 2, y: c.cy - c.h // 2, w: c.w, h: c.h
                   , cx: c.cx, cy: c.cy, area: c.area, src: "метка звука"}
    }
    return best
}

; --------------------------------------------------------------- здоровье
BarProfile(shot, region, kind, minRun := 0) {
    ; Профиль полосы: длина самой длинной непрерывной серии в строке,
    ; число строк с серией >= barMinRun и заливка найденного прямоугольника.
    ; Полоса здоровья — это ТОЛСТАЯ ровная линия; разрозненные зелёные
    ; пиксели (пальмы, трава, золото в лобби) так себя не ведут.
    global CFG
    r := RegionToPixels(shot, region)
    buf := shot.buf, stride := shot.stride
    if (minRun <= 0)
        minRun := CFG.barMinRun
    best := 0, rows := 0, bx := 0, bw := 0, by := 0, lastY := -9
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        run := 0, start := -1, bestRow := 0, bxs := -1
        x := r.x1
        while (x < r.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            hit := (kind = "hp")
                ? (g >= 110 && (g - b) >= 30 && (g - rr) >= 20)
                : (b >= 140 && (b - rr) >= 40 && (b - g) >= 15)
            if (hit) {
                if (start < 0)
                    start := x
                run += 1
                if (run > bestRow)
                    bestRow := run, bxs := start
            } else
                run := 0, start := -1
            x += 1
        }
        if (bestRow >= minRun) {
            if (y - lastY <= 2)
                rows += 1
            else if (!rows || bestRow > bw)
                rows := 1
            lastY := y
            if (bestRow > bw)
                bw := bestRow, bx := bxs
            if (!by)
                by := y
        }
        if (bestRow > best)
            best := bestRow
        y += 2
    }
    return {run: best, thick: rows, x: bx, y: by, w: bw}
}


; Щит измеряем отдельно от здоровья и только по расположению рядом с HP.
; Отсутствие уверенного признака НЕ означает ноль: полоска может быть скрыта,
; закрыта эффектом, иметь другой цвет или масштаб интерфейса.
ShieldAtHealth(shot, hp) {
    global CFG
    if !hp
        return {run: 0, thick: 0, pct: -1}
    k := shot.w / 1280
    x1 := Max(0, hp.x - Round(5 * k))
    x2 := Min(shot.w, hp.x + Round(220 * k))
    y1 := Max(0, hp.y - Round(23 * k))
    y2 := Min(shot.h, hp.y - Round(2 * k))
    minRun := Max(12, Round(35 * k))
    posTol := Max(2, Round(3 * k))
    rows := [], best := 0, y := y1
    while (y < y2) {
        TickCheck("измерение щита")
        x := x1, start := -1, run := 0, rowRun := 0, rowX := 0
        while (x <= x2) {
            hit := false
            if (x < x2) {
                px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
                b := px & 255, g := (px >> 8) & 255, r := (px >> 16) & 255
                hit := (b >= 205 && g >= 125 && r <= 65 && b - r >= 130 && g - r >= 65)
            }
            if hit {
                if (start < 0)
                    start := x, run := 0
                run += 1
            } else {
                if (start >= 0 && Abs(start - hp.x) <= posTol && run >= minRun && run > rowRun)
                    rowRun := run, rowX := start
                start := -1, run := 0
            }
            x += 1
        }
        if rowRun {
            rows.Push({y: y, x: rowX, len: rowRun})
            best := Max(best, rowRun)
        }
        y += 2
    }
    ; Несколько соседних строк с похожей шириной; фон не обязан давать
    ; прямоугольную заливку. Это всё равно эвристика, а не гарантия.
    seq := 0, maxSeq := 0, prev := -100
    for row in rows {
        if (Abs(row.len - best) <= Max(4, Round(best * 0.12))) {
            seq := row.y - prev = 2 ? seq + 1 : 1
            prev := row.y
            maxSeq := Max(maxSeq, seq)
        }
    }
    required := Max(3, Round(4 * k))
    pct := (maxSeq >= required) ? Min(100, Round(best / (shot.w * CFG.shBarFrac) * 100)) : -1
    return {run: best, thick: maxSeq, pct: pct}
}

HealthBars(shot) {
    global CFG
    fullHp := shot.w * CFG.hpBarFrac
    ; Порог обнаружения HUD матча НЕ является порогом измерения здоровья:
    ; на записи 40 HP = 81px при 1280, а прежние 100px скрывали это значение.
    k := shot.w / 1280
    hpMin := Max(12, Round(CFG.barMinRun * k))
    hpThick := Max(4, Round(CFG.hpBarMinThick * k))
    hp := BarProfile(shot, CFG.regHp, "hp", hpMin)
    hpValid := (hp.w >= hpMin && hp.thick >= hpThick
        && hp.x >= shot.w * 0.025 && hp.x <= shot.w * 0.07)
    sh := ShieldAtHealth(shot, hpValid ? hp : 0)
    return {
        hp: {run: hp.run, thick: hp.thick,
             pct: hpValid ? Min(100, Round(hp.w / fullHp * 100)) : -1},
        sh: {run: sh.run, thick: sh.thick, pct: sh.pct}
    }
}

; --------------------------------------------------- общие характеристики
EdgeDensity(shot) {
    buf := shot.buf, stride := shot.stride, w := shot.w, h := shot.h
    step := 14, cnt := 0, total := 0
    y := 0
    while (y < h - step) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        x := 0
        while (x < w - step) {
            o1 := y * stride + x * 4
            o2 := (y + step) * stride + x * 4
            v1 := NumGet(buf, o1, "UChar") + NumGet(buf, o1 + 1, "UChar") + NumGet(buf, o1 + 2, "UChar")
            v2 := NumGet(buf, o2, "UChar") + NumGet(buf, o2 + 1, "UChar") + NumGet(buf, o2 + 2, "UChar")
            if (Abs(v1 - v2) > 60)
                cnt += 1
            total += 1
            x += step
        }
        y += step
    }
    return total ? cnt / total : 0.0
}

WorldMotionDiff(a, b) {
    if (!a || !b || a.w != b.w || a.h != b.h)
        return -1
    ; Только верхняя часть игрового мира: исключаем низ с персонажем и HUD.
    sum := 0, count := 0, low := 255, high := 0
    loop 9 {
        yy := Round(b.h * (0.20 + (A_Index - 1) * 0.045))
        loop 15 {
            xx := Round(b.w * (0.10 + (A_Index - 1) * 0.055))
            oa := yy * a.stride + xx * 4, ob := yy * b.stride + xx * 4
            va := NumGet(a.buf, oa, "UInt"), vb := NumGet(b.buf, ob, "UInt")
            la := ((va & 255) + ((va >> 8) & 255) + ((va >> 16) & 255)) / 3
            lb := ((vb & 255) + ((vb >> 8) & 255) + ((vb >> 16) & 255)) / 3
            sum += Abs(la - lb), count += 1
            low := Min(low, lb), high := Max(high, lb)
        }
    }
    ; Однотонный или чёрный кадр не годится для выводов.
    if (!count || high - low < 18)
        return -1
    return sum / count
}

; Пассивная подготовка автокалибровки: выбираем выразительные точки сцены.
; Это НЕ измерение поворота, не определение оружия и не оценка чувствительности.
; Ни мышь, ни клавиатуру не трогаем; используется только захваченный кадр.
MouseCalLuma(shot, x, y) {
    o := y * shot.stride + x * 4
    v := NumGet(shot.buf, o, "UInt")
    return (((v & 255) * 29 + ((v >> 8) & 255) * 150
        + ((v >> 16) & 255) * 77) >> 8)
}

MouseCalSceneFeatures(shot, budgetMs := 150) {
    result := {points: [], complete: false, reason: "", elapsedMs: 0}
    start := A_TickCount
    if (!shot || shot.w < 128 || shot.h < 128 || shot.stride < shot.w * 4
        || shot.buf.Size < shot.stride * shot.h) {
        result.reason := "кадр отсутствует или слишком мал"
        return result
    }
    w := shot.w, h := shot.h, k := w / 1280
    step := Max(1, Round(2 * k)), margin := Round(43 * k) + 2
    ; Каждая ячейка даёт не более одного угла. Центр снизу исключён:
    ; персонаж и прицел не являются надёжными ориентирами мира.
    loop 4 {
        row := A_Index - 1
        loop 6 {
            col := A_Index - 1
            if (row >= 2 && (col = 2 || col = 3))
                continue
            if (A_TickCount - start >= budgetMs) {
                result.reason := "превышен бюджет анализа"
                result.elapsedMs := A_TickCount - start
                return result
            }
            x0 := w * (0.10 + col * 0.8 / 6)
            x1 := w * (0.10 + (col + 1) * 0.8 / 6)
            y0 := h * (0.19 + row * 0.42 / 4)
            y1 := h * (0.19 + (row + 1) * 0.42 / 4)
            best := 0, bestX := 0, bestY := 0
            loop 5 {
                iy := A_Index - 1
                y := Round(y0 + (iy + 0.5) * (y1 - y0) / 5)
                loop 5 {
                    ix := A_Index - 1
                    x := Round(x0 + (ix + 0.5) * (x1 - x0) / 5)
                    ; Запас нужен и для градиента, и для будущего поиска патча.
                    if (x < margin || y < margin || x >= w - margin || y >= h - margin)
                        continue
                    xx := 0, yy := 0, xy := 0
                    for oy in [-step, 0, step] {
                        for ox in [-step, 0, step] {
                            px := x + ox, py := y + oy
                            gx := MouseCalLuma(shot, px + step, py) - MouseCalLuma(shot, px - step, py)
                            gy := MouseCalLuma(shot, px, py + step) - MouseCalLuma(shot, px, py - step)
                            xx += gx * gx, yy += gy * gy, xy += gx * gy
                        }
                    }
                    disc := (xx - yy) ** 2 + 4 * xy * xy
                    score := (xx + yy - Sqrt(Max(0, disc))) / 2
                    if (score > best)
                        best := score, bestX := x, bestY := y
                }
            }
            if (best >= 400)
                result.points.Push({x: bestX, y: bestY, row: row, col: col, score: Round(best)})
        }
    }
    result.complete := true
    result.elapsedMs := A_TickCount - start
    result.reason := "кандидаты, не подтверждённые ориентиры"
    return result
}

; Быстрая проверка необходимых условий распределения точек одного кадра.
; Не подтверждает их неподвижность, совпадение или пригодность к калибровке.
MouseCalFeatureReadiness(features) {
    out := {ready:false, fit:0, verify:0, fitCols:0, fitRows:0, verifyCols:0, reason:""}
    if (!IsObject(features) || !features.HasOwnProp("complete") || !features.complete
        || !features.HasOwnProp("points") || !IsObject(features.points)) {
        out.reason := "анализ участков не завершён"
        return out
    }
    fc := Map(), fr := Map(), vc := Map(), seen := Map()
    for point in features.points {
        if (!IsObject(point) || !point.HasOwnProp("row") || !point.HasOwnProp("col")
            || !IsInteger(point.row) || !IsInteger(point.col)
            || point.row < 0 || point.row > 3 || point.col < 0 || point.col > 5)
            continue
        cell := point.row * 6 + point.col
        if seen.Has(cell)
            continue
        seen[cell] := true
        if !Mod(point.col, 2) {
            out.fit += 1, fc[point.col] := true, fr[point.row] := true
        } else
            out.verify += 1, vc[point.col] := true
    }
    out.fitCols := fc.Count, out.fitRows := fr.Count, out.verifyCols := vc.Count
    out.ready := out.fit >= 3 && out.verify >= 2 && fc.Count >= 2 && fr.Count >= 2 && vc.Count >= 2
    out.reason := out.ready ? "участки распределены; совпадение не проверено"
        : "недостаточно распределённых участков"
    return out
}

; Экспериментальная диагностика двух кадров: только показ в F7, без управления.
; Все оценки в пикселях кадра, не в углах и не в чувствительности мыши.
MouseCalF7Guard() {
    global ST
    prev := Critical("On")
    try {
        if (ST.running || ST.tickBusy || ST.tickLiveCount > 0 || ST.inputReleasesLive > 0
            || ST.inputDownsLive > 0 || ST.mouseCalActive || ST.mouseCalWorkers > 0
            || ST.startWorkers > 0 || ST.stopWorkers > 0)
            return 0
        return {epoch:ST.inputEpoch, gen:ST.startGeneration
            , calGen:ST.mouseCalGeneration, camera:ST.cameraSeq}
    } finally {
        Critical(prev)
    }
}

MouseCalProbeStop(deadline, guard := 0) {
    global ST
    if (A_TickCount >= deadline || ST.running || ST.tickBusy || ST.tickLiveCount > 0
        || ST.inputReleasesLive > 0 || ST.inputDownsLive > 0)
        return true
    if guard
        return (ST.inputEpoch != guard.epoch || ST.startGeneration != guard.gen
            || ST.mouseCalGeneration != guard.calGen || ST.cameraSeq != guard.camera
            || ST.mouseCalActive || ST.mouseCalWorkers > 0 || ST.startWorkers > 0 || ST.stopWorkers > 0)
    return false
}

MouseCalPatchScore(shot, x, y, k, sample, refMean, sx, sy) {
    values := [], sum := 0
    for oy in [-8, -4, 0, 4, 8] {
        for ox in [-8, -4, 0, 4, 8] {
            px := x + Round((ox + sx) * k)
            py := y + Round((oy + sy) * k)
            if (px < 0 || py < 0 || px >= shot.w || py >= shot.h)
                return 1.0e9
            rawPx := NumGet(shot.buf, py * shot.stride + px * 4, "UInt")
            v := (((rawPx & 255) * 29 + ((rawPx >> 8) & 255) * 150
                + ((rawPx >> 16) & 255) * 77) >> 8)
            values.Push(v), sum += v
        }
    }
    mean := sum / values.Length, err := 0
    for i, v in values
        err += Abs((v - mean) - (sample[i] - refMean))
    return err / values.Length
}

MouseCalMatchPatch(a, b, x, y, k, deadline, guard := 0) {
    sample := [], sum := 0
    for oy in [-8, -4, 0, 4, 8] {
        for ox in [-8, -4, 0, 4, 8] {
            px := x + Round(ox * k), py := y + Round(oy * k)
            if (px < 0 || py < 0 || px >= a.w || py >= a.h)
                return 0
            v := MouseCalLuma(a, px, py)
            sample.Push(v), sum += v
        }
    }
    ordered := SortNums(sample.Clone())
    if (ordered[23] - ordered[3] < 15)
        return 0
    mean := sum / sample.Length, coarse := []
    ; Небольшой диапазон и ограничение времени обязательны: F7 не должен
    ; зависнуть даже на однотонной или сложной сцене.
    loop 17 {
        if MouseCalProbeStop(deadline, guard)
            return 0
        dy := -32 + (A_Index - 1) * 4
        loop 17 {
            dx := -32 + (A_Index - 1) * 4
            score := MouseCalPatchScore(b, x, y, k, sample, mean, dx, dy)
            coarse.Push({x: dx, y: dy, cost: score})
        }
    }
    peaks := []
    loop 3 {
        best := 0
        for cand in coarse {
            allowed := true
            for peak in peaks {
                if (Abs(cand.x - peak.x) <= 5 && Abs(cand.y - peak.y) <= 5) {
                    allowed := false
                    break
                }
            }
            if (allowed && (!best || cand.cost < best.cost))
                best := cand
        }
        if best
            peaks.Push(best)
    }
    candidates := [], best := 0
    for peak in peaks {
        dy := Max(-32, peak.y - 3)
        while (dy <= Min(32, peak.y + 3)) {
            if MouseCalProbeStop(deadline, guard)
                return 0
            dx := Max(-32, peak.x - 3)
            while (dx <= Min(32, peak.x + 3)) {
                cost := MouseCalPatchScore(b, x, y, k, sample, mean, dx, dy)
                cand := {x: dx, y: dy, cost: cost}
                candidates.Push(cand)
                if (!best || cost < best.cost)
                    best := cand
                dx += 1
            }
            dy += 1
        }
    }
    if !best
        return 0
    second := 1.0e9
    for cand in candidates {
        if (Abs(cand.x - best.x) > 5 || Abs(cand.y - best.y) > 5)
            second := Min(second, cand.cost)
    }
    if (second = 1.0e9 || best.cost > 13 || second - best.cost < 2)
        return 0
    return {x: best.x * k, y: best.y * k}
}

MouseCalMedian(values) {
    if !values.Length
        return 0
    nums := SortNums(values.Clone()), n := nums.Length, mid := (n + 1) // 2
    return Mod(n, 2) ? nums[mid] : (nums[mid] + nums[mid + 1]) / 2
}

; Чистый расчёт кандидата для одной оси по серии замеров.
; ВНИМАНИЕ: это НЕ верификация ввода: ручное движение или движущийся мир
; могут совпадать с командами и давать стабильную, но ошибочную величину.
; Здесь нет записи INI, изменения CFG или запуска действий мыши.
MouseCalAxisEstimate(pairs, width) {
    out := {ok: false, gain: 0, count: 0, rejected: 0, spread: 0, reason: ""}
    if (!IsObject(pairs) || !IsNumber(width) || width < 128) {
        out.reason := "недопустимые данные или размер кадра"
        return out
    }
    accepted := [], values := [], scale := 1280 / width
    for p in pairs {
        if (!IsObject(p) || !p.HasProp("cmd") || !p.HasProp("delta") || !p.HasProp("quality")) {
            out.rejected += 1
            continue
        }
        if (!IsNumber(p.cmd) || !IsNumber(p.delta) || !IsNumber(p.quality)
            || p.cmd = 0 || p.quality < 4 || Abs(p.delta) < 2 / scale) {
            out.rejected += 1
            continue
        }
        q := p.delta / p.cmd * scale
        if (Abs(q) < 0.04 || Abs(q) > 8) {
            out.rejected += 1
            continue
        }
        accepted.Push({cmd: p.cmd, value: q}), values.Push(q)
    }
    if (accepted.Length < 4) {
        out.reason := "мало подходящих замеров"
        return out
    }
    mid := MouseCalMedian(values), good := [], pos := 0, neg := 0
    if (Abs(mid) < 0.000001) {
        out.reason := "направления противоречат друг другу"
        return out
    }
    for p in accepted {
        if (p.value * mid > 0 && Abs(p.value / mid - 1) <= 0.30) {
            good.Push(p.value)
            if (p.cmd > 0)
                pos += 1
            else
                neg += 1
        }
    }
    ; Учитываем ВСЕ попытки, в том числе нулевые и плохого качества:
    ; иначе четыре удачных измерения скрывали бы любое число отказов.
    if (good.Length < 4 || good.Length < pairs.Length * 0.75 || pos < 2 || neg < 2) {
        out.reason := "слишком много отказов, нестабильные замеры или мало попыток в каждом направлении"
        return out
    }
    center := MouseCalMedian(good), worst := 0
    for q in good
        worst := Max(worst, Abs(q / center - 1))
    out.ok := true, out.gain := center, out.count := good.Length
    out.rejected += accepted.Length - good.Length
    out.spread := worst, out.reason := "кандидат; физический ввод и игра не подтверждены"
    return out
}

MouseCalCompareFrames(a, b, budgetMs := 2500, guard := 0) {
    start := A_TickCount, deadline := start + budgetMs
    result := {ok: false, x: 0, y: 0, votes: 0, elapsedMs: 0, reason: ""}
    if (!a || !b || a.w != b.w || a.h != b.h) {
        result.reason := "кадры отсутствуют или размеры не совпадают"
        return result
    }
    if MouseCalProbeStop(deadline, guard) {
        result.reason := "анализ прерван: лимит времени или изменение состояния"
        return result
    }
    ; Обе стороны должны иметь полный буфер. Ранее проверялся только первый
    ; кадр; повреждённый второй мог вызвать исключение при чтении пикселя.
    if (a.w < 128 || a.h < 128 || a.stride < a.w * 4 || b.stride < b.w * 4
        || a.buf.Size < a.stride * a.h || b.buf.Size < b.stride * b.h) {
        result.reason := "повреждённый или слишком маленький буфер кадра"
        return result
    }
    fs := MouseCalSceneFeatures(a, Min(150, budgetMs))
    if !fs.complete {
        result.reason := "поиск участков не завершён"
        result.elapsedMs := A_TickCount - start
        return result
    }
    ; Сопоставление может лишь уменьшить число точек. Если ещё до него не
    ; хватает ячеек, требуемых в финальной проверке, дорогой поиск бесполезен.
    readiness := MouseCalFeatureReadiness(fs)
    if !readiness.ready {
        result.reason := readiness.reason
        result.elapsedMs := A_TickCount - start
        return result
    }
    k := a.w / 1280, votes := []
    for point in fs.points {
        if MouseCalProbeStop(deadline, guard)
            break
        f := MouseCalMatchPatch(a, b, point.x, point.y, k, deadline, guard)
        if !f
            continue
        rx := point.x + Round(f.x), ry := point.y + Round(f.y)
        back := MouseCalMatchPatch(b, a, rx, ry, k, deadline, guard)
        if (!back || Sqrt((f.x + back.x) ** 2 + (f.y + back.y) ** 2) > 2.5 * k)
            continue
        votes.Push({x: f.x, y: f.y, row: point.row, col: point.col})
    }
    result.elapsedMs := A_TickCount - start
    if MouseCalProbeStop(deadline, guard) {
        result.reason := "анализ прерван: лимит времени или работа бота"
        return result
    }
    fit := [], verify := [], xs := [], ys := []
    for v in votes {
        if !Mod(v.col, 2)
            fit.Push(v), xs.Push(v.x), ys.Push(v.y)
        else
            verify.Push(v)
    }
    if (fit.Length < 3 || verify.Length < 2) {
        result.reason := "недостаточно независимых участков"
        return result
    }
    mx := MouseCalMedian(xs), my := MouseCalMedian(ys)
    fx := [], fy := [], fitCols := Map(), fitRows := Map()
    for v in fit {
        if (Sqrt((v.x - mx) ** 2 + (v.y - my) ** 2) <= 4 * k)
            fx.Push(v.x), fy.Push(v.y), fitCols[v.col] := true, fitRows[v.row] := true
    }
    if (fx.Length < 3 || fx.Length < fit.Length * 0.70 || fitCols.Count < 2 || fitRows.Count < 2) {
        result.reason := "участки не согласны или сосредоточены в одном месте"
        return result
    }
    mx := MouseCalMedian(fx), my := MouseCalMedian(fy)
    valid := 0, verifyCols := Map()
    for v in verify {
        if (Sqrt((v.x - mx) ** 2 + (v.y - my) ** 2) <= 4 * k)
            valid += 1, verifyCols[v.col] := true
    }
    if (valid < 2 || valid < verify.Length * 0.67 || verifyCols.Count < 2) {
        result.reason := "проверочные участки не подтвердили смещение"
        return result
    }
    result.ok := true, result.x := mx, result.y := my
    result.votes := fx.Length + valid
    result.reason := "оценка видимого смещения, не чувствительность"
    return result
}

ResetMoveWatch(resetAttempts := false) {
    global ST
    ST.stuckShot := 0, ST.stuckSampleAt := 0, ST.stuckStillMs := 0
    ST.stuckMotionN := 0
    if resetAttempts
        ST.stuckRecoverN := 0
}

ScanNavCorridors(shot) {
    ; v11.0: оценка открытости 3 коридоров (лево / центр / право) по текстуре/перепадам
    global CFG, ST
    now := A_TickCount
    if (now - ST.navAt < CFG.navScanMs)
        return
    ST.navAt := now
    y1 := Round(shot.h * 0.42), y2 := Round(shot.h * 0.66)
    step := Max(8, ScanStep(9))
    zones := [[Round(shot.w * 0.14), Round(shot.w * 0.36)]
            , [Round(shot.w * 0.38), Round(shot.w * 0.62)]
            , [Round(shot.w * 0.64), Round(shot.w * 0.86)]]
    scores := [0, 0, 0]
    for idx, zr in zones {
        edges := 0, tot := 0
        y := y1
        while (y < y2) {
            prevLum := -1
            x := zr[1]
            while (x < zr[2]) {
                px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
                lum := (((px >> 16) & 255) + ((px >> 8) & 255) + (px & 255)) // 3
                if (prevLum >= 0 && Abs(lum - prevLum) > 22)
                    edges += 1
                prevLum := lum, tot += 1
                x += step
            }
            y += step
        }
        density := tot ? (edges / tot) : 0.3
        scores[idx] := Clamp(Round((1.0 - density * 1.65) * 100), 5, 98)
    }
    ST.navLeft := scores[1], ST.navCenter := scores[2], ST.navRight := scores[3]
    ST.navLowObs := (ST.navCenter < 36)
    if (ST.navCenter >= 45)
        ST.navSteer := 0
    else if (ST.navLeft >= ST.navRight + 10)
        ST.navSteer := -1, ST.navTurnSign := -1
    else if (ST.navRight >= ST.navLeft + 10)
        ST.navSteer := 1, ST.navTurnSign := 1
    else
        ST.navSteer := 2
}

SteerOpenSpace(shot, now) {
    ; Плавное подруливание в свободный коридор + карабканье (Mantle) через низкие препятствия
    global CFG, SC, ST
    ScanNavCorridors(shot)
    if (ST.navLowObs && (now - ST.lastObsJump > CFG.obstacleGapMs)) {
        ST.lastObsJump := now
        TapKey(SC.space, 190)
    }
    if (now - ST.navSteerAt < 280)
        return
    if (ST.navSteer = -1) {
        ST.navSteerAt := now
        TurnBy(-Random(28, 52), 0, CFG.turnMaxPx)
    } else if (ST.navSteer = 1) {
        ST.navSteerAt := now
        TurnBy(Random(28, 52), 0, CFG.turnMaxPx)
    } else if (ST.navSteer = 2) {
        ST.navSteerAt := now
        TurnBy(ST.navTurnSign * Random(70, 115), 0, CFG.turnMaxPx)
    }
}

LevelHorizonStep(now) {
    ; Плавно возвращаем камеру к горизонту (ST.camPitch -> 0) во время бега
    global ST
    if (ST.enemy || ST.chest || Abs(ST.camPitch) < 16)
        return
    if (now - ST.lastAimT < 140)
        return
    stepY := Clamp(Round(-ST.camPitch * 0.25), -14, 14)
    if (stepY != 0)
        MouseRel(0, stepY, true)
}

CheckStormAndZone(shot, now) {
    ; v11.0: проверка фиолетовой Бури по краям кадра и белой линии зоны на миникарте
    global CFG, ST
    if (now - ST.stormAt < CFG.stormScanMs)
        return
    ST.stormAt := now
    purple := 0, tot := 0, step := Max(10, ScanStep(12))
    for rx in [Round(shot.w * 0.04), Round(shot.w * 0.96)] {
        y := Round(shot.h * 0.25)
        while (y < shot.h * 0.75) {
            px := NumGet(shot.buf, y * shot.stride + rx * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (b >= 135 && rr >= 95 && g <= 95 && (b - g) >= 55)
                purple += 1
            tot += 1
            y += step
        }
    }
    ST.inStorm := (tot > 6 && (purple / tot) >= 0.35)
    ; Белая линия безопасной зоны на миникарте (правый верхний угол)
    mx := Round(shot.w * 0.912), my := Round(shot.h * 0.135)
    rad := Round(shot.w * 0.055)
    sumX := 0.0, sumY := 0.0, wHits := 0
    y := Max(0, my - rad)
    while (y <= Min(shot.h - 1, my + rad)) {
        x := Max(0, mx - rad)
        while (x <= Min(shot.w - 1, mx + rad)) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 220 && g >= 220 && b >= 220)
                sumX += (x - mx), sumY += (y - my), wHits += 1
            x += 4
        }
        y += 4
    }
    ST.zoneAngle := (wHits >= 5) ? Atan2Deg(sumX / wHits, -(sumY / wHits)) : 999
    if (ST.inStorm && ST.zoneAngle != 999 && Abs(ST.zoneAngle) > 18)
        TurnBy(Clamp(ST.zoneAngle * 2.0, -CFG.turnMaxPx, CFG.turnMaxPx), 0, CFG.turnMaxPx)
}

MoveWatch(shot, now) {
    global CFG, SC, ST
    ; Любой бой/смена режима отменяет боковую попытку.
    allowed := ST.running && !ST.paused && !CFG.dryRun && CFG.featMove
        && (ST.phase = "loot" || ST.phase = "roam") && !ST.enemy && !ST.breakTarget && !ST.tgt
    if !allowed {
        if (ST.stuckRecoverKey != "")
            KeyUp(ST.stuckRecoverKey)
        ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
        ResetMoveWatch()
        return false
    }
    if ST.stuckRecoverUntil {
        if (now < ST.stuckRecoverUntil)
            return true
        KeyUp(ST.stuckRecoverKey)
        ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0, ST.segUntil := 0
        ResetMoveWatch()
        return false
    }
    if (!ST.held.Has(SC.w) || now - ST.cameraAt < CFG.stuckCameraQuietMs) {
        ResetMoveWatch()
        return false
    }
    if !ST.stuckShot {
        ST.stuckShot := shot, ST.stuckSampleAt := now
        return false
    }
    dt := now - ST.stuckSampleAt
    if (dt < CFG.stuckSampleMs || shot.captureId = ST.stuckShot.captureId)
        return false
    if (dt > CFG.stuckSampleMs * 3) {
        ResetMoveWatch()
        return false
    }
    diff := WorldMotionDiff(ST.stuckShot, shot)
    ST.stuckShot := shot, ST.stuckSampleAt := now
    if (diff < 0) {
        ResetMoveWatch()
        LogThrottledKey("[stuckunknown]", "[i] движение: кадр слишком однотонный — проверка неубедительна")
        return false
    }
    if (diff >= CFG.stuckDiffThreshold) {
        ST.stuckStillMs := 0, ST.stuckMotionN += 1
        if (ST.stuckMotionN >= 3)
            ST.stuckRecoverN := 0
        return false
    }
    ST.stuckMotionN := 0, ST.stuckStillMs += dt
    if (ST.stuckStillMs < CFG.stuckMs)
        return false
    ST.stuckRecoverN += 1
    ST.stuckTotal += 1
    KeyUp(SC.w)
    if (ST.stuckRecoverN = 1) {
        ; Ступень 1: открыть дверь (E) и перелезть препятствие (Space 190 мс)
        TapKey(SC.e, 75)
        TapKey(SC.space, 190)
        ST.stuckRecoverKey := (ST.navTurnSign > 0) ? SC.d : SC.a
        KeyDown(ST.stuckRecoverKey)
        ST.stuckRecoverUntil := now + 380
        Log("[~] застревание (1/5): дверь E + карабканье + обход")
        return true
    } else if (ST.stuckRecoverN = 2) {
        ; Ступень 2: шаг назад (S) + разворот на 75°
        KeyDown(SC.s)
        ST.stuckRecoverKey := SC.s
        ST.stuckRecoverUntil := now + 420
        TurnBy(ST.navTurnSign * 140, 0, CFG.turnMaxPx)
        Log("[~] застревание (2/5): отход назад + поворот")
        return true
    } else if (ST.stuckRecoverN = 3) {
        ; Ступень 3: спринт-прыжок + боковой стрейф
        SprintSet(true)
        TapKey(SC.space, 140)
        ST.stuckRecoverKey := (ST.navTurnSign > 0) ? SC.a : SC.d
        KeyDown(ST.stuckRecoverKey)
        ST.stuckRecoverUntil := now + 480
        TurnBy(-ST.navTurnSign * 110, 0, CFG.turnMaxPx)
        Log("[~] застревание (3/5): прыжок с разбега + стрейф")
        return true
    } else if (ST.stuckRecoverN = 4 && CFG.featBreakBox) {
        ; Ступень 4: пролом преграды киркой (если включено)
        TapKey(SC.pickaxe, 55)
        Sleep(160)
        Loop 3 {
            if (!ST.running || ST.paused)
                break
            MouseDown("кирка")
            Sleep(110)
            MouseUp()
            Sleep(180)
        }
        TapKey("1", 45)
        ST.stuckRecoverUntil := now + 300
        Log("[~] застревание (4/5): пролом препятствия киркой")
        return true
    } else {
        ; Ступень 5: разворот на 180° и сброс счётчика
        ST.stuckRecoverN := 0
        TurnBy(ST.navTurnSign * 220, 0, CFG.turnMaxPx)
        KeyDown(SC.w)
        ST.stuckRecoverUntil := now + 420
        ST.stuckRecoverKey := SC.w
        Log("[~] застревание (5/5): полный разворот на 180°")
        return true
    }
}

; Сколько строк в области почти целиком золотые. Баннер находки — это широкая
; плашка, а фотография или видео дают золото вразброс: в строках его мало.
GoldBandRows(shot, r) {
    buf := shot.buf, stride := shot.stride
    width := (r.x2 - r.x1) / 2
    rows := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("широкая золотая полоса")
        cnt := 0
        x := r.x1
        while (x < r.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 140 && g >= 80 && g <= 200 && b <= 90 && (rr - b) >= 80)
                cnt += 1
            x += 2
        }
        if (cnt > width * 0.5)
            rows += 1
        y += 2
    }
    return rows * 2
}

GoldRatio(shot, rect) {
    ; доля «золота» (как у сундуков и жетона) в прямоугольнике {x1,y1,x2,y2}
    buf := shot.buf, stride := shot.stride
    cnt := 0, tot := 0
    y := rect.y1
    while (y < rect.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        x := rect.x1
        while (x < rect.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 200 && g >= 120 && g <= 215 && b <= 110)
                cnt += 1
            tot += 1
            x += 3
        }
        y += 3
    }
    return tot ? cnt / tot : 0.0
}

LightRatio(shot, rect) {
    ; доля светлых (кремово-белых) пикселей — буквы баннера находки
    buf := shot.buf, stride := shot.stride
    cnt := 0, tot := 0
    y := rect.y1
    while (y < rect.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        x := rect.x1
        while (x < rect.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if (rr >= 225 && g >= 215 && b >= 170)
                cnt += 1
            tot += 1
            x += 3
        }
        y += 3
    }
    return tot ? cnt / tot : 0.0
}

BrightRatio(shot, region, thr := 165) {
    r := RegionToPixels(shot, region)
    cnt := 0, tot := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        x := r.x1
        while (x < r.x2) {
            o := y * shot.stride + x * 4
            b := NumGet(shot.buf, o, "UChar"), g := NumGet(shot.buf, o + 1, "UChar")
            rr := NumGet(shot.buf, o + 2, "UChar")
            if ((rr * 299 + g * 587 + b * 114) // 1000 >= thr)
                cnt += 1
            tot += 1
            x += 4
        }
        y += 4
    }
    return tot ? cnt / tot : 0.0
}

; ----------------------------------------------------------------------------
; ПОИСК ПОЛОСЫ HP/ЩИТА ПО ШИРОКОЙ ПОЛОСЕ (run-17.log)
; Раньше годился только фиксированный прямоугольник regHp. На деле в матче он
; читался как «0…11 px», и бот вообще не понимал, что он в игре: «во время
; матча просто зависал и ничего не делал». Теперь полоса ищется по всей нижней
; левой полосе (CFG.hudBand), а не по одному месту.
; Возвращает {run, thick, x, y, kind} или 0.
; ----------------------------------------------------------------------------
FindHealthBar(shot) {
    global CFG
    r := RegionToPixels(shot, CFG.hudBand)
    buf := shot.buf, stride := shot.stride
    best := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("поиск полосы HP")
        run := 0, start := -1, bestRow := 0, bxs := -1, kind := ""
        x := r.x1
        while (x < r.x2) {
            o := y * stride + x * 4
            ; v7.5: одно чтение 4 байт вместо трёх — горячий цикл стал быстрее
            px := NumGet(buf, o, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            ; зелёная (здоровье) или голубая (щит) ровная линия
            hit := ""
            if (g >= 120 && (g - b) >= 35 && (g - rr) >= 25)
                hit := "hp"
            else if (b >= 150 && (b - rr) >= 45 && (b - g) >= 18)
                hit := "sh"
            if (hit != "") {
                if (start < 0)
                    start := x, run := 0
                run += 1
                if (run > bestRow)
                    bestRow := run, bxs := start, kind := hit
            } else
                run := 0, start := -1
            x += 2
        }
        if (bestRow >= CFG.hudDetectRun / 2)
            if (!best || bestRow > best.run + 8)
                best := {run: bestRow * 2, thick: 2, x: bxs, y: y, kind: kind}
            else if (best && Abs(y - best.y) <= 8 && kind = best.kind)
                best.thick += 2, best.y := Min(best.y, y)
        y += 2
    }
    if (best && (best.run < CFG.hudDetectRun || best.thick < CFG.hudDetectThick))
        return 0
    return best
}

; СКОЛЬКО ПРИЗНАКОВ МАТЧА ВИДНО. Раньше ответ был «да/нет» по одной полосе, и
; от одного дрогнувшего замера рушилось всё. Теперь это сумма признаков, а
; решение принимает InMatchHud с «памятью» (hudHoldMs / hudLostMs).
HudEvidence(shot) {
    global CFG, ST
    ; InMatchHud зовут несколько раз за тик (детектор сцены, фазa матча,
    ; смерть) — незачем искать полосу заново каждые 50 мс.
    if (ST.hudEvAt && A_TickCount - ST.hudEvAt < 120 && ST.hudEvShot = shot.w "x" shot.h)
        return ST.hudEvScore
    ST.hudEvAt := A_TickCount
    ST.hudEvShot := shot.w "x" shot.h
    score := 0, why := ""

    hpb := FindHealthBar(shot)
    ; Полоса и id записываются вместе: F3 не должен рисовать старую рамку
    ; поверх другого снимка, включая отдельный захват при остановленном боте.
    prev := Critical("On")
    ST.hudFound := hpb, ST.hudFoundSeq := shot.captureId
    Critical(prev)
    if hpb {
        score += 2
        why .= (hpb.kind = "sh" ? "щит " : "HP ") hpb.run "px "
    }

    ; панель слотов: в матче она почти пустая и тёмная, в лобби — залитая
    ST.hudSlots := BrightRatio(shot, CFG.regSlots, 170)
    if (ST.hudSlots > 0.004 && ST.hudSlots < 0.35) {
        score += 1
        why .= "слоты " Round(ST.hudSlots * 1000) / 1000 " "
    }

    ; прицел: в матче он есть всегда, в лобби вместо него курсор
    if (CrosshairCenter(shot)) {
        score += 1
        why .= "прицел "
    }

    ST.hudScore := score
    ST.hudWhy := why
    ST.hudEvScore := score
    return score
}

InMatchHud(shot) {
    ; Признак матча — полоса HP/щита (ищем по широкой полосе) плюс «память»:
    ; если HUD был виден только что, матч продолжается, даже если один замер
    ; дрогнул. В лобби полосы нет вовсе, поэтому ложных «матчей» это не даёт.
    global CFG, ST
    hb := CachedHealth(shot)
    ST.hudHp := hb.hp.run
    score := HudEvidence(shot)
    now := A_TickCount
    ; Два слабых признака (яркие «слоты» и «прицел» на фоне лобби)
    ; не доказывают матч. Нужна полоса в области HUD и ещё один признак.
    if (score >= 3 && ST.hudFound && hb.hp.pct >= 0) {
        ST.hudLastT := now
        ST.hudFoundT := now
        return true
    }
    if (ST.hudLastT && (now - ST.hudLastT < CFG.hudHoldMs))
        return true
    return false
}

DarkRatio(shot, region) {
    r := RegionToPixels(shot, region)
    cnt := 0, tot := 0
    y := r.y1
    while (y < r.y2) {
        TickCheck("скан пикселей")   ; run-11: скан тоже обязан уметь прерваться
        x := r.x1
        while (x < r.x2) {
            o := y * shot.stride + x * 4
            if (NumGet(shot.buf, o, "UChar") + NumGet(shot.buf, o + 1, "UChar") + NumGet(shot.buf, o + 2, "UChar") < 120)
                cnt += 1
            tot += 1
            x += 4
        }
        y += 4
    }
    return tot ? cnt / tot : 0.0
}

; ============================================================================
;                            ВВОД
; ============================================================================
; ----------------------------------------------------------------------------
; ФОНОВЫЙ ВВОД (v7.0). Если вы ушли в браузер, игра не в фокусе — и обычный
; SendEvent отправил бы клавиши в браузер (или никуда). Тогда клавиши посылаются
; ПРЯМО В ОКНО ИГРЫ сообщениями (PostMessage WM_KEYDOWN/WM_KEYUP).
; Что важно понимать:
;   * в FPS-игре обзор камеры читается из АКТИВНОГО окна, поэтому мышь в фоне
;     не работает — повороты и прицеливание в фон-режиме недоступны;
;   * движение, E, слоты, пробел — работают, если игра принимает такие сообщения.
;     Проверить просто: включите фон-режим и смотрите, идёт ли бот.
; ----------------------------------------------------------------------------
VkFromScan(code) {
    ; "sc030" -> виртуальный код клавиши
    n := SubStr(code, 3)
    v := DllCall("user32\MapVirtualKey", "UInt", Integer("0x" n), "UInt", 6, "UInt")  ; VSC_TO_VK_EX
    if !v
        v := DllCall("user32\MapVirtualKey", "UInt", Integer("0x" n), "UInt", 1, "UInt")
    return v
}

PostKeyToGame(code, down, hwnd := 0) {
    global ST
    ; Для компенсации нужно отпустить в том же окне, куда ушло нажатие.
    if !hwnd
        hwnd := GetGameWindow()
    if !hwnd
        return false
    vk := VkFromScan(code)
    if !vk
        return false
    scan := DllCall("user32\MapVirtualKey", "UInt", vk, "UInt", 4, "UInt")   ; VK_TO_VSC
    lp := 1
    lp |= (scan << 16)
    if down
        lp |= 0x00000001              ; repeat count = 1
    else
        lp |= 0xC0000000              ; переход вверх + предыдущее состояние
    msg := down ? 0x0100 : 0x0101     ; WM_KEYDOWN / WM_KEYUP
    try {
        PostMessage(msg, vk, lp, , "ahk_id " hwnd)
        ; некоторым играм нужен и WM_CHAR-поток — не шлём: он ломает удержания
    } catch {
        return false
    }
    return true
}

; Можно ли слать клавиши в окно (фон-режим включён и игра не активна)
BgInputActive() {
    global CFG
    try {
        if !CFG.bgMode
            return false
    } catch {
        return false
    }
    hwnd := GetGameWindow()
    if !hwnd
        return false
    return !WinActive("ahk_id " hwnd)
}

InputDownAllowed(epoch) {
    global ST
    return ST.running && !ST.paused && !ST.tickAbort && epoch = ST.inputEpoch
}

KeyDown(code, expectedEpoch := -1) {
    global ST
    ; Учёт каждого вызова до проверок/внешних API: Stop может прервать поток
    ; сразу после отправки, но до внесения в held. Для одного кода допускаем
    ; только одно незавершённое нажатие.
    prev := Critical("On")
    if (!ST.running || ST.paused || ST.tickAbort || ST.held.Has(code) || ST.inputDownPending.Has(code)
        || (expectedEpoch >= 0 && ST.inputEpoch != expectedEpoch)) {
        Critical(prev)
        return false
    }
    epoch := ST.inputEpoch
    ST.inputDownPending[code] := true, ST.inputDownsLive += 1
    Critical(prev)
    try {
        bg := BgInputActive(), target := 0, sent := false, attempted := false
        if bg {
            target := GetGameWindow()
            if (!target || !InputDownAllowed(epoch))
                return false
            attempted := true
            try sent := PostKeyToGame(code, true, target)
            catch
                sent := false
        } else {
            fg := GetGameWindow()
            if (!fg || !WinActive("ahk_id " fg) || !GameResponsive() || !InputDownAllowed(epoch))
                return false
            attempted := true
            try {
                SendLevel 0
                SendEvent("{" code " down}")
                sent := true
            } catch {
                sent := false
            }
        }
        ; Фиксация held и финальная проверка поколения неделимы относительно
        ; Stop/Pause. Если вызов прерван, компенсируем ПОСЛЕ его возвращения.
        prev := Critical("On")
        try {
            keep := sent && InputDownAllowed(epoch)
            if keep {
                ; Сохраняем способ и адрес НАЖАТИЯ: фокус/окно могут
                ; измениться до отпускания. 0 означает системный ввод.
                ST.held[code] := {target: bg ? target : 0}
                if bg
                    ST.bgKeys += 1
            }
        } finally {
            Critical(prev)
        }
        if (!keep && attempted) {
            if bg {
                try PostKeyToGame(code, false, target)
            } else {
                try ForceKeyUp(code)
            }
        }
        return keep
    } finally {
        prev := Critical("On")
        ST.inputDownPending.Delete(code)
        ST.inputDownsLive -= 1
        Critical(prev)
    }
}

KeyUp(code) {
    global ST
    previous := Critical("On")
    if !ST.held.Has(code) {
        Critical(previous)
        return false
    }
    origin := ST.held[code]
    Critical(previous)
    ; Старые/искусственные записи без объекта трактуем как системный ввод.
    target := IsObject(origin) ? origin.target : 0
    if target {
        if !PostKeyToGame(code, false, target)
            throw Error("Не удалось отправить отпускание в исходное окно")
    } else {
        SendLevel 0
        SendEvent("{" code " up}")
    }
    ; Stop/Pause мог очистить или заменить запись, пока ОС обрабатывала up.
    ; Не удалять чужую новую запись и не падать на уже очищенной Map.
    previous := Critical("On")
    try {
        if (ST.held.Has(code) && ST.held[code] = origin)
            ST.held.Delete(code)
    } finally {
        Critical(previous)
    }
    return true
}

; Отложенные отпускания принадлежат поколению действий, которое их создало.
; После стопа/паузы/нового старта устаревший таймер не должен отпускать новую
; клавишу или новый прицел. Для будущей эксклюзивной калибровки одного epoch
; мало: обработчик мог уже пройти проверку и быть прерван, поэтому его жизнь
; отдельно учитывается в inputReleasesLive до выхода из finally.
InputCancelDeferred() {
    global ST
    previous := Critical("On")
    ST.inputEpoch += 1
    Critical(previous)
}

InputReleaseLater(kind, code, ms) {
    global ST
    epoch := ST.inputEpoch
    SetTimer(InputReleaseRun.Bind(epoch, kind, code), -Max(1, Round(ms)))
}

InputReleaseRun(epoch, kind, code) {
    global ST
    previous := Critical("On")
    ST.inputReleasesLive += 1
    Critical(previous)
    try {
        if (epoch != ST.inputEpoch)
            return false
        if (kind = "key")
            return KeyUp(code)
        else if (kind = "crouch")
            CrouchSet(false)
        else if (kind = "ads")
            AdsSet(false)
    } finally {
        previous := Critical("On")
        ST.inputReleasesLive -= 1
        Critical(previous)
    }
}

TapKey(code, holdMs := 70, expectedEpoch := -1) {
    global CFG, ST
    ; Зафиксировать поколение до KeyDown даже для обычных коротких нажатий.
    ; Для E сохраняем переданное поколение кадра, а не подменяем его текущим.
    previous := Critical("On")
    epoch := expectedEpoch >= 0 ? expectedEpoch : ST.inputEpoch
    Critical(previous)
    ; Наши нажатия — физического уровня 0, чтобы не считаться действиями игрока.
    SendLevel 0
    if CFG.humanize
        holdMs := Round(holdMs * RndF(0.8, 1.35))
    if !KeyDown(code, epoch)
        return false
    previous := Critical("On")
    if (ST.inputEpoch != epoch) {
        Critical(previous)
        return false
    }
    ST.tapKey := code               ; если тик прервётся, AbortCleanup снимет
    Critical(previous)
    Sleep(Max(30, holdMs))
    ; Учёт отпускания блокирует повторный Start/Pause-resume до его возврата,
    ; но не задерживает Stop. Проверка поколения находится в обработчике.
    released := InputReleaseRun(epoch, "key", code)
    previous := Critical("On")
    try {
        if (ST.inputEpoch != epoch)
            return false
        if (ST.tapKey = code)
            ST.tapKey := ""
        return !!released
    } finally {
        Critical(previous)
    }
}

ReleaseKeys() {
    global ST
    for code, _ in ST.held.Clone()
        KeyUp(code)
    ST.held := Map()
    ; страховка: если действие прервалось между MouseDown и MouseUp, кнопка
    ; осталась бы зажатой — в игре это «стрельба без остановки»
    try
        DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    ; то же и для прицела (ПКМ): зажатый прицел после сбоя мешает идти и стрелять
    try
        DllCall("mouse_event", "UInt", 0x0010, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    ST.sprintOn := false
    ST.crouchOn := false
    ST.adsOn := false
}

ForceKeyUp(code) {
    ; Отпустить клавишу «физически», не спрашивая окно: keybd_event не ходит
    ; через очередь сообщений окна и потому не может заблокировать поток.
    ; Нужно, когда игра перестала отвечать (загрузка после приземления).
    if (SubStr(code, 1, 2) != "sc")
        return
    scan := Integer("0x" SubStr(code, 3))
    if !scan
        return
    vk := DllCall("MapVirtualKey", "UInt", scan, "UInt", 3, "UInt")
    try
        DllCall("keybd_event", "UChar", vk, "UChar", scan, "UInt", 0x0002, "UPtr", 0)
}

ReleaseKeysSafe() {
    ; ReleaseKeys() шлёт клавиши через SendEvent. В окно, которое не отвечает,
    ; такой вызов не возвращается — именно на этом и встал тик в run-11.log.
    ; Здесь: окно живо — обычное снятие; окно молчит — снимаем через keybd_event
    ; (без ожидания) и всё равно обнуляем список зажатого.
    global ST
    if GameResponsive() {
        try {
            ReleaseKeys()
            return
        } catch {
            ; Если обычное отпускание выбросило ошибку, не выходить молча:
            ; попытаться снять оставшиеся клавиши резервным способом.
        }
    }
    for code, _ in ST.held.Clone() {
        ; Ошибка одного кода не должна пропускать остальные.
        try {
            origin := ST.held[code]
            target := IsObject(origin) ? origin.target : 0
            if target
                PostKeyToGame(code, false, target)
            else
                ForceKeyUp(code)
        }
    }
    ST.held := Map()
    ST.sprintOn := false, ST.crouchOn := false, ST.adsOn := false
    try
        DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    try
        DllCall("mouse_event", "UInt", 0x0010, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
}

HeldCount() {
    global ST
    return ST.held.Count
}

MouseSmooth(dx, dy := 0, durMs := 0) {
    ; Короткие шаги без случайной дрожи и без финального скачка остатка.
    ; Условие сохранения поколения не позволяет старому повороту продолжиться
    ; после Stop/паузы и быстрого нового запуска. Фокус проверяется на шагах.
    global CFG, ST
    dx := Round(dx), dy := Round(dy)
    if (!dx && !dy)
        return
    epoch := ST.inputEpoch
    micro := Max(3, CFG.mouseMicroPx)
    dist := Sqrt(dx * dx + dy * dy)
    steps := Clamp(Ceil(dist * 1.9 / micro) + 2, 5, 90)
    if (durMs <= 0)
        durMs := Clamp(Round(steps * 7), 40, 600)
    stepMs := Clamp(Round(durMs / steps), 5, 10)
    sx := 0, sy := 0
    BeginAction("плавный поворот")
    try {
        i := 1
        while (i <= steps) {
            TickCheck("плавный поворот")
            if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != epoch || !MouseAllowed())
                return
            t := i / steps
            e := 10 * t ** 3 - 15 * t ** 4 + 6 * t ** 5
            stepX := Round(Clamp(Round(dx * e) - sx, -micro, micro))
            stepY := Round(Clamp(Round(dy * e) - sy, -micro, micro))
            if (stepX || stepY) {
                MouseRel(stepX, stepY, true)
                sx += stepX, sy += stepY
            }
            Sleep(stepMs)
            i += 1
        }
        ; Если лимит числа шагов сработал, остаток тоже идёт мелкими шагами.
        while (sx != dx || sy != dy) {
            TickCheck("доводка поворота")
            if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != epoch || !MouseAllowed())
                return
            stepX := Round(Clamp(dx - sx, -micro, micro))
            stepY := Round(Clamp(dy - sy, -micro, micro))
            MouseRel(stepX, stepY, true)
            sx += stepX, sy += stepY
            Sleep(stepMs)
        }
    } finally {
        EndAction()
    }
}

MoveCursorHuman(x, y) {
    ; Курсор проходит промежуточные точки; после F8/паузы/утраты фокуса
    ; не продолжаем движение и не кликаем. Не используем прыжок в конце.
    global CFG, ST
    if (!ST.running || ST.paused || ST.tickAbort)
        return false
    if !MouseAllowed()
        return MouseBlockedNote("движение курсора")
    CoordMode("Mouse", "Screen")
    MouseGetPos(&cx, &cy)
    dx := x - cx, dy := y - cy
    dist := Sqrt(dx * dx + dy * dy)
    if (dist < 1)
        return true
    ; Ограничение длины шага; очень длинное движение может быть прервано
    ; бюджетом тика и продолжено при следующей попытке, без финального скачка.
    ; 5 мс × сотни микрошагов превышали бюджет тика до клика. Ограничиваем
    ; число промежуточных точек: движение остаётся плавным, без финального прыжка.
    steps := Clamp(Ceil(dist / Max(12, CFG.mouseMicroPx)), 5, 60)
    i := 1
    while (i <= steps) {
        TickCheck("движение курсора")
        if (!ST.running || ST.paused || ST.tickAbort)
            return false
        if !MouseAllowed()
            return MouseBlockedNote("движение курсора")
        t := i / steps
        e := 10 * t ** 3 - 15 * t ** 4 + 6 * t ** 5
        nx := Round(cx + dx * e), ny := Round(cy + dy * e)
        try {
            if !DllCall("SetCursorPos", "Int", nx, "Int", ny, "Int")
                return false
        } catch {
            return false
        }
        Sleep(1)
        i += 1
    }
    return true
}

TurnBy(dx, dy := 0, maxPx := 0) {
    ; Поворот камеры «как человек»: ограничение за один проход + плавность.
    global CFG
    lim := (maxPx > 0) ? maxPx : CFG.turnMaxPx
    dx := Clamp(dx, -lim, lim)
    dy := Clamp(dy, -lim * 0.6, lim * 0.6)
    if (Abs(dx) < 2 && Abs(dy) < 2)
        return
    MouseSmooth(Round(dx * CFG.mouseGain), Round(dy * CFG.mouseGain))
}

MouseAllowed() {
    ; ГЛАВНОЕ ПРАВИЛО ФОН-РЕЖИМА (жалоба: «в фон-режиме сам нажимает мышь,
    ; хотя я не в игре, и очень часто»).
    ; Раньше проверка стояла ТОЛЬКО в ClickScreen, а стрельба, удары киркой,
    ; лечение и укрытие жали кнопку напрямую через mouse_event — они и щёлкали
    ; вашей мышью в браузере. Теперь один шлюз на все мышиные действия.
    ; Одинаково для обоих режимов: только активное окно Fortnite. Фоновые
    ; сообщения клавиатуры не дают разрешения управлять системной мышью.
    ; Не кэшируем: фокус мог уйти после предыдущего шага.
    if AltTabGuardActive()
        return false
    hwnd := GetGameWindow()
    return (hwnd && WinActive("ahk_id " hwnd)) ? true : false
}

MouseBlockedNote(where) {
    ; Говорим один раз и коротко: почему в фоне бот не жмёт мышь.
    global CFG, ST
    ST.mouseBlocked += 1
    now := A_TickCount
    if (now - ST.mouseBlockedAt > 15000) {
        ST.mouseBlockedAt := now
        Log("[i] мышь НЕ трогаю (" where "). Игра без фокуса не принимает"
            . " клики, а ваш курсор нужен вам. Всего отбито попыток: " ST.mouseBlocked)
    }
    return false
}

MouseRel(dx, dy := 0, smooth := false) {
    global CFG, ST
    if (!ST.running || ST.paused || ST.tickAbort)
        return false
    if !MouseAllowed()
        return MouseBlockedNote("поворот камеры")
    if (CFG.humanize && !smooth) {
        dx *= RndF(0.92, 1.08)
        dy *= RndF(0.92, 1.08)
    }
    sentX := Round(dx), sentY := Round(dy)
    ST.cameraAt := A_TickCount
    ST.cameraSeq += 1 ; фиксируем собственный ввод до отправки команды
    DllCall("mouse_event", "UInt", 0x0001, "Int", sentX, "Int", sentY, "UInt", 0, "UPtr", 0)
    ; Только сумма команд ПОСЛЕ округления и humanize. Приём игрой неизвестен;
    ; настоящая мышь пользователя в этот счётчик не входит.
    ST.cameraCmdX += sentX, ST.cameraCmdY += sentY
    ST.camPitch := Clamp(ST.camPitch + sentY, -280, 280)
}

MouseDown(where := "кнопка мыши") {
    global ST
    if (!ST.running || ST.paused || ST.tickAbort)
        return false
    if !MouseAllowed()
        return MouseBlockedNote(where)
    DllCall("mouse_event", "UInt", 0x0002, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    return true
}

MouseUp() {
    ; Отпускание НЕ блокируем: если кнопка осталась зажатой до перехода в фон,
    ; её обязательно нужно отпустить, иначе она «залипнет» у вас в браузере.
    DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    return true
}

ClickScreen(x, y) {
    return ClickScreenMode(x, y, false)
}

ClickScreenMode(x, y, quick := false) {
    ; Возвращает true, только если клик РЕАЛЬНО сделан и окно игры активно.
    ; При quick=true (Умный фон / шаг выхода) курсор ставится сразу с коротким
    ; микросдвигом, чтобы Unreal Engine обновил hover кнопки, и окно пользователя
    ; вернулось менее чем за полсекунды.
    global CFG, ST
    if !MouseAllowed()
        return MouseBlockedNote("клик по игре")
    now := A_TickCount
    if (ST.lastClickAt && now - ST.lastClickAt < CFG.clickGapMs)
        return false
    ST.lastClickAt := now
    rx := Round(x), ry := Round(y)
    if quick {
        try {
            if !DllCall("SetCursorPos", "Int", rx - 2, "Int", ry, "Int")
                return false
            Sleep(22)
            if !DllCall("SetCursorPos", "Int", rx, "Int", ry, "Int")
                return false
        } catch {
            return false
        }
        Sleep(Random(35, 65))
    } else {
        if !MoveCursorHuman(rx, ry)
            return false
        Sleep(Random(20, 50))
    }
    if (!ST.running || ST.paused || ST.tickAbort || !MouseAllowed())
        return false
    if !MouseDown("клик по игре")
        return false
    Sleep(Random(35, 75))
    MouseUp()
    return true
}

ClickBox(shot, box, label := "") {
    global CFG
    cx := shot.x + box.x + box.w // 2 + (CFG.humanize ? Random(-3, 3) : 0)
    cy := shot.y + box.y + box.h // 2 + (CFG.humanize ? Random(-2, 2) : 0)
    if CFG.dryRun {
        Log("[dry-run] клик" (label ? " «" label "»" : "") " (" Round(cx) ", " Round(cy) ")")
        return true
    }
    ok := ClickScreen(cx, cy)
    if (!ok && label != "")
        LogThrottledKey("[nobgclick]", "[i] «" label "»: клик не сделан (фон-режим или слишком часто)")
    return ok
}

ClickNorm(shot, frac, label := "") {
    ; клик по доле экрана — резервный путь, если кнопку не распознали
    box := {x: Round(frac[1] * shot.w) - 10, y: Round(frac[2] * shot.h) - 8, w: 20, h: 16}
    return ClickBox(shot, box, label)
}

ClickNormMenu(shot, frac, label := "", alertKey := "") {
    ; клик по доле экрана с поддержкой Умного фона и любого монитора/разрешения
    box := {x: Round(frac[1] * shot.w) - 10, y: Round(frac[2] * shot.h) - 8, w: 20, h: 16}
    return ClickMenuBox(shot, box, label, alertKey)
}

; Короткие паузы вместо одного длинного Sleep: тик не «замирает» на секунды,
; сторож и хоткеи успевают отработать, а действие всё равно выдерживает паузу.
SleepC(ms) {
    left := ms
    while (left > 0) {
        TickCheck("пауза " ms " мс")     ; прерывание по бюджету/сторожу
        chunk := (left > 120) ? 120 : left
        Sleep(chunk)
        left -= chunk
    }
}

Throttle() {
    global CFG, ST
    limit := CFG.maxActionsPerMin
    if (limit <= 0)
        return true
    now := A_TickCount
    keep := []
    for t in ST.actionTimes {
        if (now - t < 60000)
            keep.Push(t)
    }
    ST.actionTimes := keep
    if (ST.actionTimes.Length >= limit)
        return false
    ST.actionTimes.Push(now)
    return true
}

; ============================================================================
;                            ДВИЖЕНИЕ
; ============================================================================
StartSegment() {
    ; Начало нового отрезка ходьбы. v7.5: W НЕ отпускается и не переставляется
    ; заново — персонаж идёт непрерывно, а отрезок меняет только «характер» бега
    ; (скорость, боковое смещение, поворот камеры).
    global CFG, SC, ST
    now := A_TickCount
    BeginAction("шаг")
    KeyDown(SC.w)
    CrouchSet(false)
    if (CFG.sprint && CFG.featMove && Random(0, 99) < CFG.sprintPct)
        SprintSet(true)
    else
        SprintSet(false)
    ; подкат на старте отрезка — только на бегу
    if (CFG.featParkour && ST.sprintOn && Random(0, 999) < Round(CFG.slideChance * 1000))
        SlideNow()
    if (Random(0, 99) / 100 < CFG.strafeChance)
        KeyDown(Random(0, 1) ? SC.a : SC.d)
    if (Random(0, 99) / 100 < CFG.jumpChance)
        TapKey(SC.space, 80)
    ; поворот плавный и НЕБОЛЬШОЙ: раньше за один отрезок камера уезжала на
    ; 260 px — со стороны это выглядело как рывок в сторону
    turn := RndF(CFG.turnMinPx, CFG.turnMaxPx) * (Random(0, 1) ? 1 : -1)
    if CFG.invertTurn
        turn := -turn
    MouseSmooth(Round(turn * CFG.mouseGain * 0.55), 0)   ; осмотр
    ST.segUntil := now + Random(CFG.fwdMinMs, CFG.fwdMaxMs)
    EndAction()
}

; Продолжение ходьбы без остановки: W остаётся зажатой, меняются только
; скорость/смещение/взгляд. Именно этого не хватало — Log run-20 показывал
; StopMove -> StartSegment по нескольку раз в 3 секунды.
RestartSegment() {
    global CFG, SC, ST
    if !CFG.runKeepW
        return StartSegment()
    now := A_TickCount
    if !ST.held.Has(SC.w)
        KeyDown(SC.w)
    ; скорость: раз в отрезок решаем «бегу / иду шагом», W не трогаем
    if (CFG.sprint && Random(0, 99) < CFG.sprintPct)
        SprintSet(true)
    else
        SprintSet(false)
    ; боковое смещение — коротким импульсом, потом снимаем
    if (Random(0, 99) / 100 < CFG.strafeChance * 0.6) {
        k := Random(0, 1) ? SC.a : SC.d
        if !ST.held.Has(k) {
            KeyDown(k)
            InputReleaseLater("key", k, Random(120, 260))
        }
    }
    ; лёгкий поворот, чтобы бот «осматривался», а не шёл по линейке
    if (Random(0, 99) < 70)
        MouseSmooth(Round(RndF(-CFG.turnMinPx, CFG.turnMaxPx) * 0.35), 0)
    ST.segUntil := now + Random(CFG.fwdMinMs, CFG.fwdMaxMs)
}

StopMove() {
    global CFG, ST
    SprintSet(false)
    CrouchSet(false)
    AdsSet(false)
    ST.moveMode := "стою"
    ReleaseKeys()
    ST.segUntil := 0
    ST.idleUntil := A_TickCount + Random(CFG.idleMinMs, CFG.idleMaxMs)
    ; v7.5: пауза короткая и явная — раньше был «стоп на 0.1-0.35 с» без причины
    ST.pauseUntil := 0
}

WalkTo(targetX, targetY, shot, sprint := false) {
    global CFG, SC, ST
    ; Без свежего кадра или после нашего поворота нельзя двигаться по старым
    ; координатам. Ручное движение мыши это условие пока не отслеживает.
    if (A_TickCount - shot.capturedAt > 250 || ST.cameraSeq != shot.cameraSeqAtCapture)
        return false
    dx := targetX - shot.w / 2
    ; Цветное пятно не является высотой объекта. Не накапливаем вертикальный
    ; угол в пол; поворачиваем только горизонтально, коротким плавным шагом.
    if (Abs(dx) > 20)
        MouseSmooth(Round(Clamp(dx * 0.12, -24, 24) * CFG.mouseGain), 0, 60)
    if (!ST.running || ST.paused || ST.tickAbort)
        return false
    if !ST.held.Has(SC.w)
        KeyDown(SC.w)
    SprintSet(sprint)
    ST.segUntil := A_TickCount + 300
    return true
}

; ============================================================================
;        ДВИЖЕНИЕ КАК У ПРО: БЕГ, ПРЫЖОК, ПОДКАТ, ПРИСЕД, ПРИЦЕЛ
; ============================================================================
; Раньше «ходить» означало «держать W и иногда жать Пробел». Этого мало:
; в игре нужно бежать, перепрыгивать забор и ящик, подкатываться с горки,
; приседать под огнём, лечиться сидя и брать прицел по дальнему врагу.
; Ниже — маленький «водитель», который всем этим управляет.

SprintSet(on) {
    global CFG, SC, ST
    if !CFG.featMove
        on := false
    if on {
        if !ST.held.Has(SC.shift) {
            KeyDown(SC.shift)
            ST.sprintOn := true
        }
    } else if ST.held.Has(SC.shift) {
        KeyUp(SC.shift)
        ST.sprintOn := false
    }
}

CrouchSet(on) {
    global CFG, SC, ST
    if !CFG.featMove
        on := false
    if on {
        if !ST.held.Has(SC.ctrl) {
            KeyDown(SC.ctrl)
            ST.crouchOn := true
            ST.crouches += 1
        }
    } else if ST.held.Has(SC.ctrl) {
        KeyUp(SC.ctrl)
        ST.crouchOn := false
    }
}

; Прицел (ПКМ). Игра слушает правую кнопку мыши, а не клавишу.
AdsSet(on) {
    global ST
    if (on = ST.adsOn)
        return
    ; Не нажимаем ПКМ после F8/паузы и без фокуса в фон-режиме.
    if (on && (!ST.running || ST.paused || ST.tickAbort))
        return false
    if (on && !MouseAllowed())
        return MouseBlockedNote("прицел ПКМ")
    try {
        if on
            DllCall("mouse_event", "UInt", 0x0008, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
        else
            DllCall("mouse_event", "UInt", 0x0010, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    }
    ST.adsOn := on
}

JumpNow(reason := "") {
    global CFG, SC, ST
    if !CFG.featParkour
        return false
    if (A_TickCount - ST.lastJumpT < CFG.jumpMinGapMs)
        return false
    ST.lastJumpT := A_TickCount
    ST.jumps += 1
    if CFG.dryRun {
        LogThrottledKey("[dryjump]", "[dry-run] прыжок — " reason)
        return true
    }
    TapKey(SC.space, 90)
    ST.lastAction := "прыжок"
    LogThrottledKey("[jump]", "[~] прыжок — " reason)
    return true
}

; Подскок на бегу (как делают про, чтобы держать темп и не терять скорость).
BhopOnce() {
    global CFG, SC, ST
    if !JumpNow("подскок на бегу")
        return false
    if !ST.held.Has(SC.w)
        KeyDown(SC.w)
    return true
}

; Подкат: в Fortnite присед на бегу превращается в слайд.
SlideNow() {
    global CFG, SC, ST
    if (!CFG.featParkour || !CFG.sprint)
        return false
    if (A_TickCount - ST.lastSlideT < CFG.slideGapMs)
        return false
    if (ST.hpPercent >= 0 && ST.hpPercent < 35)
        return false                    ; на последних HP не рискуем
    ST.lastSlideT := A_TickCount
    ST.slides += 1
    if CFG.dryRun {
        LogThrottledKey("[dryslide]", "[dry-run] подкат (присед на бегу)")
        return true
    }
    if !ST.held.Has(SC.w)
        KeyDown(SC.w)
    if !ST.held.Has(SC.shift)
        KeyDown(SC.shift)
    KeyDown(SC.ctrl)
    ST.crouchOn := true
    SleepC(CFG.slideHoldMs)
    KeyUp(SC.ctrl)
    ST.crouchOn := false
    ST.lastAction := "подкат"
    return false
}

; Боковое уклонение на 0.2–0.4 с и отпускание клавиши таймером.
StrafeBurst(ms := 0) {
    global CFG, SC
    if (ms <= 0)
        ms := CFG.strafeMs
    k := Random(0, 1) ? SC.a : SC.d
    KeyDown(k)
    InputReleaseLater("key", k, Random(Round(ms * 0.7), Round(ms * 1.3)))
}

; Плотность перепадов яркости в полосе кадра: стена/ящик/уступ дают много
; перепадов, открытая земля — мало. Дешевле, чем искать геометрию.
BandEdges(shot, x1, y1, x2, y2, step := 5) {
    r := RegionToPixels(shot, [x1, y1, x2, y2])
    hits := 0, total := 0
    y := r.y1
    while (y < r.y2 - step) {
        x := r.x1
        while (x < r.x2 - step) {
            b1 := Bright(shot, x, y)
            b2 := Bright(shot, x + step, y)
            b3 := Bright(shot, x, y + step)
            total += 1
            if (Abs(b2 - b1) > 34 || Abs(b3 - b1) > 34)
                hits += 1
            x += step
        }
        y += step
    }
    return (total > 0) ? hits / total : 0.0
}

ObstacleAhead(shot, now) {
    global CFG, ST
    if (now - ST.obstacleT < CFG.obstacleStepMs)
        return ST.obstacleVal
    ST.obstacleT := now
    ; полоса прямо перед игроком: чуть ниже центра и до низа экрана
    ST.obstacleVal := BandEdges(shot, 0.36, 0.50, 0.64, 0.72)
    return ST.obstacleVal
}

; «Водитель». Вызывается каждый тик в матче, работает поверх обычных
; отрезков движения: держит бег, перепрыгивает препятствия, подкатывается,
; приседает под огнём. Возвращает true, если что-то сделал.
SmartMove(shot, now) {
    global CFG, SC, ST
    TraceStep("вождение")
    if !CFG.featMove {
        SprintSet(false)
        CrouchSet(false)
        AdsSet(false)
        return false
    }
    if !ST.held.Has(SC.w) {
        SprintSet(false)
        AdsSet(false)
        ST.moveMode := "стою"
        return false
    }

    ; ---- бег: 2.5–9 с бежим, потом 1–2 с шагом ----
    if (CFG.sprint && CFG.featParkour) {
        if (now >= ST.sprintUntil) {
            if ST.sprintOn {
                SprintSet(false)
                ST.sprintUntil := now + Random(900, 1800)
                ST.moveMode := "иду шагом"
            } else {
                SprintSet(true)
                ST.sprintUntil := now + Random(CFG.sprintMinMs, CFG.sprintMaxMs)
                ST.moveMode := "бегу"
            }
        }
    } else
        SprintSet(false)

    ; ---- подскок на бегу по открытой местности (держит темп, как у про) ----
    if (CFG.featParkour && ST.sprintOn
        && (now - ST.lastJumpT > CFG.jumpMinGapMs * 4) && Random(0, 999) < 18) {
        if BhopOnce()
            ST.moveMode := "подскок на бегу"
    }

    ; ---- препятствие впереди: прыжок или обход ----
    val := ObstacleAhead(shot, now)
    if (CFG.featParkour && (val >= CFG.obstacleEdges)
        && (now - ST.lastJumpT > CFG.obstacleGapMs)) {
        if (Random(0, 99) < 70) {
            JumpNow("препятствие впереди (" Round(val * 100) "%)")
            ST.moveMode := "перепрыгиваю"
        } else {
            StrafeBurst()
            ST.moveMode := "обхожу сбоку"
        }
        return true
    }

    ; ---- присели под огнём: сбиваем прицел врагу ----
    if (CFG.featCrouchFight && ST.damagedAt > 0
        && (now - ST.damagedAt < CFG.fightBackMs)
        && (now - ST.lastCrouchT > CFG.crouchHoldMs + CFG.crouchGapMs)) {
        ST.lastCrouchT := now
        CrouchSet(true)
        InputReleaseLater("crouch", "", CFG.crouchHoldMs)
        ST.moveMode := "присел под огнём"
    }
    return true
}

; ============================================================================
;                     ПОВЕДЕНИЕ: СУНДУКИ И ЛУТ
; ============================================================================
; ---- v7.6: «чёрный список» мест (run-21.log) -------------------------------
; Раньше после двух неудачных нажатий E бот решал «сундук в ящике», 20 секунд
; бил это место киркой, потом шёл дальше — и через пару секунд возвращался к
; тому же пятну света и повторял. За две минуты лога так набегало 40+ подходов,
; и матч выглядел как «весь матч машет киркой».
; Теперь место с неудачей запоминается на CFG.badSpotMs (45 с) в радиусе
; CFG.badSpotPx и все детекторы (сундук и лут) его пропускают.
MarkBadSpot(x, y, why) {
    global ST
    ST.badSpots.Push({x: x, y: y, at: A_TickCount, why: why})
    if (ST.badSpots.Length > 40)
        ST.badSpots.RemoveAt(1)
    LogThrottledKey("[badspot]", "[i] помечаю место (" Round(x) "," Round(y)
        . ") как «не трогать» на 45 с · причина: " why)
}

SpotIsBad(x, y) {
    global CFG, ST
    now := A_TickCount
    keep := []
    bad := false
    for s in ST.badSpots {
        if (now - s.at > CFG.badSpotMs)
            continue
        keep.Push(s)
        if (Abs(s.x - x) <= CFG.badSpotPx && Abs(s.y - y) <= CFG.badSpotPx)
            bad := true
    }
    ST.badSpots := keep
    return bad
}

; «Подпись» картинки вокруг точки: средняя яркость. Нужна, чтобы понять,
; меняется ли что-то от ударов киркой (настоящий ящик разлетается, а пятно
; света остаётся прежним).
SpotSignature(shot, x, y, r := 28) {
    sum := 0, n := 0
    y0 := Max(0, Round(y - r)), y1 := Min(shot.h - 1, Round(y + r))
    x0 := Max(0, Round(x - r)), x1 := Min(shot.w - 1, Round(x + r))
    yy := y0
    while (yy <= y1) {
        TickCheck("подпись места ящика")   ; скан обязан уметь прерваться
        xx := x0
        while (xx <= x1) {
            o := yy * shot.stride + xx * 4
            px := NumGet(shot.buf, o, "UInt")
            sum += (px & 0xFF) + ((px >> 8) & 0xFF) + ((px >> 16) & 0xFF)
            n += 1
            xx += 6
        }
        yy += 6
    }
    return n ? Round(sum / n) : 0
}

; Начать ломать объект киркой — с проверкой лимитов, чтобы не застрять на нём.
StartBreak(x, y, why) {
    global CFG, ST
    if SpotIsBad(x, y)
        return false
    now := A_TickCount
    keep := []
    for t in ST.breakTimes {
        if (now - t < 60000)
            keep.Push(t)
    }
    ST.breakTimes := keep
    if (keep.Length >= CFG.breakMaxPerMin) {
        LogThrottledKey("[breakrate]", "[i] киркой уже били " keep.Length
            . " раз за минуту — больше не беру, иду собирать")
        MarkBadSpot(x, y, "лимит кирки")
        return false
    }
    ST.breakTimes.Push(now)
    ST.breakTarget := {x: x, y: y, at: now, why: why, swings: 0, rounds: 0
        , stage: "seek", epoch: ST.inputEpoch, camera: ST.cameraSeq}
    ST.breakBefore := 0
    ST.breakNoChange := 0
    Log("[~] " why " — беру кирку (Q) и бью (" keep.Length + 1 "/"
        . CFG.breakMaxPerMin " за минуту)")
    return true
}

NearCrosshair(shot, x, y) {
    global CFG
    return (Abs(x - shot.w / 2) <= shot.w * CFG.interactCenterX)
        && (Abs(y - shot.h / 2) <= shot.h * CFG.interactCenterY)
}

; Взаимодействие с сундуком/предметом — с ПРОВЕРКОЙ результата.
; Раньше E жалась по таймеру, а «Сундук открыт» писалось сразу, без проверки:
; в run-4.log их набралось 26 штук подряд, хотя рядом ничего не открывалось.
HoldInteractKey(holdMs := 580) {
    ; v11.0: прерываемое удержание E — работает и при «Удерживать для обыска», и при «Нажать»
    global SC, ST
    if !KeyDown(SC.e)
        return false
    tEnd := A_TickCount + Max(120, holdMs)
    while (A_TickCount < tEnd) {
        if (!ST.running || ST.paused || ST.tickAbort)
            break
        Sleep(35)
    }
    KeyUp(SC.e)
    return true
}

SpotChestGlow(shot, cx, cy, w := 60, h := 60) {
    ; Средняя яркость золотого/голубого свечения сундука в области (cx, cy)
    x1 := Max(0, Round(cx - w * 0.5)), x2 := Min(shot.w - 1, Round(cx + w * 0.5))
    y1 := Max(0, Round(cy - h * 0.5)), y2 := Min(shot.h - 1, Round(cy + h * 0.5))
    sum := 0, n := 0, step := Max(4, ScanStep(5))
    y := y1
    while (y <= y2) {
        x := x1
        while (x <= x2) {
            px := NumGet(shot.buf, y * shot.stride + x * 4, "UInt")
            b := px & 0xFF, g := (px >> 8) & 0xFF, rr := (px >> 16) & 0xFF
            if ((rr >= 145 && g >= 85 && b <= 98 && (rr - b) >= 80)
                || (b >= 200 && g >= 140 && rr <= 100 && (b - rr) >= 100))
                sum += (rr + g + b) // 3
            n += 1
            x += step
        }
        y += step
    }
    return n ? (sum / n) : 0
}

PostChestLootTick(shot, now) {
    ; v11.0: после открытия сундука 2.4 с подбираем выпавший лут, затем возвращаем слот 1 и горизонт
    global CFG, SC, ST
    if (!ST.postChestUntil || now >= ST.postChestUntil) {
        if (ST.postChestUntil) {
            ST.postChestUntil := 0, ST.postChestPicks := 0
            if (ST.activeSlot != 1) {
                ST.activeSlot := 1
                TapKey("1", 45)
            }
        }
        return false
    }
    if (ST.enemy || ST.postChestPicks >= 4)
        return false
    loot := CachedLoot(shot)
    if loot {
        WalkTo(loot.x, loot.y, shot, false)
        if (Abs(loot.x - shot.w * 0.5) < shot.w * 0.16 && Abs(loot.y - shot.h * 0.5) < shot.h * 0.22) {
            TapKey(SC.e, 75)
            ST.postChestPicks += 1
        }
        return true
    }
    return false
}

SeekChestBySound(shot, now) {
    ; v11.0: идём на золотую метку сундука на кольце визуализации звука
    global CFG, SC, ST
    if (!CFG.featChest || !CFG.chestAudioSeek || ST.enemy || ST.chest)
        return false
    if (now < ST.chestAudioCooldown)
        return false
    ring := IsObject(ST.soundRing) ? ST.soundRing : SoundRingScan(shot)
    ST.soundRing := ring
    if (!IsObject(ring) || !ring.chest) {
        ST.chestAudioAt := 0
        return false
    }
    if (!ST.chestAudioAt)
        ST.chestAudioAt := now
    if (now - ST.chestAudioAt > 9500) {
        ST.chestAudioAt := 0
        ST.chestAudioCooldown := now + 12000
        return false
    }
    ang := ring.chest.angleDeg
    if (Abs(ang) > 14 && (now - ST.lastAimT >= 160)) {
        ST.lastAimT := now
        TurnBy(Clamp(ang * 2.2, -CFG.turnMaxPx, CFG.turnMaxPx), 0, CFG.turnMaxPx)
    }
    KeyDown(SC.w)
    SprintSet(true)
    ST.moveMode := "сундук по звуку"
    return true
}

; Плашка не читается; попытка E и её исчезновение не подтверждают открытие.
TryInteract(shot, now) {
    global CFG, SC, ST
    TraceStep("сундук/предмет")
    if (!CFG.featChest && !CFG.featLoot)
        return false
    ; Бой или кирка важнее. Старую попытку не подтверждаем после боя.
    if (ST.enemy || ST.breakTarget) {
        ST.tgt := 0
        return false
    }
    promptStarted := A_TickCount
    pmRaw := FindInteractPrompt(shot)
    TraceSlow("скан подсказки", promptStarted)
    if !ST.promptAvailable
        LogThrottledKey("[prompt-scan-budget]", "[i] Подсказка: скан пропущен из-за бюджета; это не означает, что подсказки нет.", 15000)
    pm := PromptConfirmFresh(shot, pmRaw)
    ; v7.9: автомат состояний: ожидаем новую проверку после E; исчезновение
    ; подсказки не доказывает ни тип объекта, ни успешное открытие.
    if ST.tgt {
        ; Нельзя делать вывод об исчезновении по кэшу, старому кадру или
        ; другому направлению/размеру. Даже достоверное исчезновение не
        ; подтверждает, что игра приняла E и сундук открылся.
        if (ST.cameraSeq != ST.tgt.camera || shot.cameraSeqAtCapture != ST.tgt.camera
            || ST.inputEpoch != ST.tgt.epoch || shot.inputEpochAtCapture != ST.tgt.epoch
            || shot.w != ST.tgt.w || shot.h != ST.tgt.h) {
            Log("[i] проверка после E отменена: камера, сессия или размер кадра изменились; результат неизвестен")
            ST.tgt := 0
            ST.promptConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
            return false
        }
        age := A_TickCount - shot.capturedAt
        postFrame := ST.promptAvailable && ST.promptSeq = shot.captureId
            && shot.captureId != ST.tgt.seq && shot.capturedAt > ST.tgt.at
            && age >= 0 && age <= 250
        if (postFrame && !pmRaw) {
            Log("[i] на свежем кадре плашка больше не найдена; результат E не подтверждён")
            ST.tgt := 0
            return false
        }
        if (A_TickCount - ST.tgt.at < CFG.interactVerifyMs)
            return true
        Log(postFrame ? "[~] плашка ещё видна; результат E неизвестен, возможен повтор"
            : "[~] после E нет подходящего свежего скана; результат неизвестен")
        ST.tgt := 0
        return false
    }
    if (pmRaw && !pm) {
        ; Два кадра могут повторять одну ошибку — буква и объект не читаются.
        LogThrottledKey("[prompt-candidate]", "[i] Похоже на подсказку: жду повторный кадр; текст и клавиша E не распознаны.", 10000)
        ; Ждём вторую проверку; без нажатий и с остановкой ног.
        KeyUp(SC.w), KeyUp(SC.a), KeyUp(SC.s), KeyUp(SC.d)
        SprintSet(false)
        return true
    }
    if pm {
        ; Подтверждённый кэш сам по себе НЕ даёт права нажать E по новому
        ; кадру: плашка могла исчезнуть, а камера — уже повернуться.
        if (ST.promptSeq != shot.captureId || A_TickCount - shot.capturedAt > 250
            || shot.capturedAt > A_TickCount || ST.cameraSeq != shot.cameraSeqAtCapture
            || ST.inputEpoch != shot.inputEpochAtCapture) {
            KeyUp(SC.w), KeyUp(SC.a), KeyUp(SC.s), KeyUp(SC.d)
            SprintSet(false)
            LogThrottledKey("[promptold]", "[i] Перед E нужен свежий скан: возраст кадра "
                . (A_TickCount - shot.capturedAt) " мс · скан другого кадра "
                . (ST.promptSeq != shot.captureId ? "да" : "нет") " · камера менялась "
                . (ST.cameraSeq != shot.cameraSeqAtCapture ? "да" : "нет") ".", 5000)
            return true
        }
        if (ST.lastPromptE && A_TickCount - ST.lastPromptE < CFG.promptEcooldownMs)
            return true
        ; Один ложный шаблон не должен порождать бесконечную частую серию E.
        ; Лимит глобальный, не сбрасывается от пропуска скана, паузы или Stop.
        attemptNow := A_TickCount, recentAttempts := []
        for attemptAt in ST.promptAttempts {
            if (attemptNow - attemptAt >= 0 && attemptNow - attemptAt < CFG.promptWindowMs)
                recentAttempts.Push(attemptAt)
        }
        ST.promptAttempts := recentAttempts
        if (recentAttempts.Length >= CFG.promptWindowMax) {
            LogThrottledKey("[prompt-rate]", "[i] Лимит попыток E: жду окно повтора; открытие не подтверждено.", 5000)
            return false
        }
        if CFG.dryRun {
            ST.lastPromptE := A_TickCount
            LogThrottledKey("[dryPrompt]", "[dry-run] похожая на подсказку плашка у прицела — нажал бы E")
            return true
        }
        ; Останавливаем только клавиатурное движение, без событий мыши в фоне.
        KeyUp(SC.w), KeyUp(SC.a), KeyUp(SC.s), KeyUp(SC.d)
        SprintSet(false)
        TickCheck("перед E по подсказке")
        if (!ST.running || ST.paused || ST.tickAbort)
            return false
        ; Контроль ещё раз после возможного прерывания потока.
        if (ST.promptSeq != shot.captureId || A_TickCount - shot.capturedAt > 250
            || shot.capturedAt > A_TickCount || ST.cameraSeq != shot.cameraSeqAtCapture
            || ST.inputEpoch != shot.inputEpochAtCapture)
            return true
        actionEpoch := ST.inputEpoch
        ST.lastPromptE := A_TickCount
        ST.promptAttempts.Push(ST.lastPromptE)
        isChestPrompt := (IsObject(ST.chest) || SpotChestGlow(shot, pm.cx, pm.cy) > 15)
        sentAttempt := isChestPrompt
            ? HoldInteractKey(CFG.chestHoldMs)
            : TapKey(SC.e, 80, shot.inputEpochAtCapture)
        ; Проверка поколения и запись цели атомарны относительно Stop/Pause.
        previous := Critical("On")
        cancelled := !ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != actionEpoch
        cameraChanged := ST.cameraSeq != shot.cameraSeqAtCapture
        if (sentAttempt && !cancelled && !cameraChanged) {
            ST.promptN += 1
            if isChestPrompt {
                ST.chests += 1
                CFG.totalChests += 1
                ST.postChestUntil := A_TickCount + 2400
                ST.postChestPicks := 0
            }
            ST.tgt := {x: pm.cx, y: pm.cy, kind: "prompt", color: "", at: A_TickCount
                , camera: shot.cameraSeqAtCapture, epoch: actionEpoch, seq: shot.captureId, w: shot.w, h: shot.h}
        }
        Critical(previous)
        if cancelled {
            LogThrottledKey("[prompt-interrupted]", "[i] Попытка E прервана; доставка и результат неизвестны.", 5000)
            return false
        }
        if cameraChanged {
            LogThrottledKey("[prompt-interrupted]", "[i] После попытки E камера изменилась; результат неизвестен.", 5000)
            return false
        }
        if !sentAttempt {
            LogThrottledKey("[prompt-not-sent]", "[i] Попытка E не завершилась штатно; результат неизвестен.", 5000)
            return false
        }
        LogThrottledKey("[promptE]", "[+] похожая плашка — попытка E (" ST.promptN
            . "); текст и клавиша не прочитаны, результат не подтверждён")
        return true
    }
    ; Золотая область и предметы помогают подойти, но E без подсказки не жмём.
    if (ST.blindChest && now > ST.blindChest)
        ST.blindChest := 0
    chest := (CFG.featChest && !ST.blindChest) ? CachedChest(shot) : 0
    loot := CFG.featLoot ? CachedLoot(shot) : 0
    ; Координаты из старых масок пригодны лишь для диагностики, не движения.
    if (chest && ST.chestCacheSeq != shot.captureId)
        chest := 0
    if (loot && ST.lootMasksSeq != shot.captureId)
        loot := 0
    ST.chest := chest ? chest : 0
    ST.loot := loot ? loot : 0
    target := chest ? chest : loot
    if !target
        return false
    kind := chest ? "chest" : "loot"
    tx := chest ? chest.cx : loot.x
    ty := chest ? chest.cy : loot.y
    if !NearCrosshair(shot, tx, ty) {
        if !ST.walkTgtAt
            ST.walkTgtAt := now
        else if (now - ST.walkTgtAt > 8000) {
            ST.walkTgtAt := 0
            if (kind = "chest") {
                ST.blindChest := now + 10000
                Log("[~] 8 с иду к предполагаемому сундуку — пауза 10 с")
            }
        }
        WalkTo(tx, ty, shot)
        return true
    }
    ST.walkTgtAt := 0
    LogThrottledKey("[waitPrompt]", "[i] объект рядом; жду подсказку, без неё E не жму")
    return false
}

BreakObstacle(shot, now) {
    ; Защитный механизм для будущего достоверного источника цели. Сейчас
    ; такого источника нет: ни метка звука, ни неподтверждённая E его не дают.
    global CFG, SC, ST
    TraceStep("кирка по ящику")
    tgt := ST.breakTarget
    if !tgt
        return false
    if (!CFG.featBreakBox || CFG.dryRun || CFG.teamSafe || ST.enemy || !ST.running
        || ST.paused || ST.tickAbort || !MouseAllowed()
        || !tgt.HasOwnProp("stage") || !tgt.HasOwnProp("epoch") || !tgt.HasOwnProp("camera")
        || tgt.epoch != ST.inputEpoch || tgt.camera != ST.cameraSeq || (ST.hpPercent >= 0 && ST.hpPercent < CFG.hpLowPercent)) {
        ST.breakTarget := 0
        LogThrottledKey("[breakcancel]", "[i] Попытка киркой отменена: условия изменились.", 5000)
        return false
    }
    if (A_TickCount - tgt.at > CFG.breakGiveUpMs) {
        ST.breakTarget := 0
        MarkBadSpot(tgt.x, tgt.y, "время проверки киркой истекло")
        return false
    }
    ; Кадр должен быть актуален, а направление камеры — неизменным.
    if (A_TickCount - shot.capturedAt > 250 || shot.capturedAt > A_TickCount
        || ST.cameraSeq != shot.cameraSeqAtCapture) {
        if (tgt.stage != "seek") {
            ST.breakTarget := 0
            Log("[i] Проверка киркой отменена: кадр устарел или камера изменилась.")
            return false
        }
        ReleaseKeys()
        return true
    }
    if (tgt.stage = "seek") {
        if !NearCrosshair(shot, tgt.x, tgt.y) {
            WalkTo(tgt.x, tgt.y, shot)
            ST.lastAction := "подхожу к ящику"
            return true
        }
        if (A_TickCount - ST.lastBreak < CFG.breakGapMs)
            return true
        ; Не анализируем кадр, который был снят до остановки ног.
        ReleaseKeys()
        if (!ST.running || ST.paused || ST.inputEpoch != tgt.epoch || !MouseAllowed()) {
            ST.breakTarget := 0
            return false
        }
        tgt.stage := "quiet", tgt.quietAt := A_TickCount, tgt.quietSeq := shot.captureId
        tgt.camera := ST.cameraSeq, tgt.w := shot.w, tgt.h := shot.h
        ST.lastAction := "жду свежий кадр для проверки кирки"
        return true
    }
    if (ST.cameraSeq != tgt.camera || shot.w != tgt.w || shot.h != tgt.h) {
        ST.breakTarget := 0
        Log("[i] Проверка киркой отменена: камера или размер кадра изменились.")
        return false
    }
    if (tgt.stage = "quiet") {
        if (shot.captureId = tgt.quietSeq || shot.capturedAt < tgt.quietAt + 150)
            return true
        if !Throttle()
            return true
        before := SpotSignature(shot, tgt.x, tgt.y)
        ; Подготовка и каждый удар могут быть прерваны Stop/паузой/фокусом.
        TapKey(SC.q, 80)
        SleepC(Random(160, 260))
        if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != tgt.epoch
            || ST.breakTarget != tgt || ST.cameraSeq != tgt.camera || !MouseAllowed()) {
            ST.breakTarget := 0
            return false
        }
        BeginAction("удары киркой")
        swings := 0
        try {
            Loop Max(1, CFG.breakSwingCount) {
                if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != tgt.epoch
                    || ST.breakTarget != tgt || ST.cameraSeq != tgt.camera || !MouseAllowed())
                    break
                if !MouseDown("удар по ящику")
                    break
                try SleepC(Random(110, 180))
                finally MouseUp()
                swings += 1
                SleepC(Random(200, 300))
            }
        } finally {
            EndAction()
        }
        if (!swings || !ST.running || ST.paused || ST.inputEpoch != tgt.epoch
            || ST.breakTarget != tgt || ST.cameraSeq != tgt.camera || !MouseAllowed()) {
            ST.breakTarget := 0
            return false
        }
        tgt.swings += swings, tgt.rounds += 1
        tgt.before := before, tgt.beforeSeq := shot.captureId, tgt.afterAt := A_TickCount
        tgt.stage := "verify"
        ST.lastBreak := A_TickCount, ST.breaks += 1, ST.segUntil := 0
        ST.lastAction := "жду кадр после ударов"
        Log("[~] Ударов киркой: " swings " — результат ещё не подтверждён.")
        return true
    }
    if (tgt.stage = "verify") {
        if (shot.captureId = tgt.beforeSeq || shot.capturedAt <= tgt.afterAt)
            return true
        after := SpotSignature(shot, tgt.x, tgt.y)
        changed := Abs(after - tgt.before)
        if (changed < CFG.breakChangeMin)
            ST.breakNoChange += 1
        else
            ST.breakNoChange := 0
        ; Изменение картинки не доказывает разрушение. Даже при изменениях
        ; ограничиваемся двумя сериями; E по золоту не нажимаем.
        if (ST.breakNoChange >= CFG.breakVerifySwings || tgt.rounds >= 2) {
            if (ST.breakNoChange >= CFG.breakVerifySwings)
                MarkBadSpot(tgt.x, tgt.y, "нет видимых изменений после ударов")
            ST.breakTarget := 0, ST.breakNoChange := 0
            Log("[i] Проверка киркой закончена: изменение яркости " changed
                . "; разрушение или открытие сундука не подтверждено.")
            return false
        }
        Log("[i] После ударов изменение яркости " changed " — это не подтверждает разрушение.")
        tgt.stage := "seek"
        return true
    }
    ST.breakTarget := 0
    return false
}


SeekLoot(shot, now) {
    ; Подбор предметов тоже переехал в TryInteract (с проверкой результата).
    ; Здесь остаётся только «идти к предмету», когда до него далеко.
    global CFG, ST
    if !CFG.featLoot
        return false
    if (CFG.combatOverLoot && ST.enemy && (A_TickCount - ST.combatAt < 1500))
        return false
    loot := CachedLoot(shot)
    if (!loot || ST.lootMasksSeq != shot.captureId)
        return false
    if NearCrosshair(shot, loot.x, loot.y)
        return false
    WalkTo(loot.x, loot.y, shot)
    if (!ST.lootAt || now - ST.lootAt > 4000) {
        ST.lootAt := now
        Log("[~] вижу предмет (" loot.kind ", " loot.area " px) — иду")
    }
    return true
}


; ============================================================================
;                          ПОВЕДЕНИЕ: ЛЕЧЕНИЕ
; ============================================================================
TryHarvest(shot, now) {
    global CFG, ST
    ; Пустая/тёмная панель слотов не доказывает отсутствие оружия, а удар по
    ; неизвестной точке не помогает найти лут в Zero Build. Раньше здесь
    ; вслепую выбиралась Q и серия ударов задерживала цикл на секунду.
    ; Пока нет подтверждённой цели — не посылаем Q/мышь и продолжаем поиск.
    ; Отдельная проверяемая ветка BreakObstacle не меняется.
    if (CFG.featHarvest && !CFG.teamSafe && !ST.enemy && ST.hudSlots < CFG.weaponHaveMin)
        LogThrottledKey("[harvest-unknown]", "[i] Кирка: содержимое слотов и цель не подтверждены — не машу вслепую, продолжаю поиск.", 60000)
    return false
}

TryHeal(shot, now) {
    global CFG, ST
    TraceStep("лечение")
    if !CFG.featHeal
        return false
    hb := CachedHealth(shot)
    ST.hpPercent := hb.hp.pct
    ST.shPercent := hb.sh.pct
    ; Слоты без распознавания могут содержать оружие. Случайный LMB — выстрел,
    ; а не лечение. Не утверждаем, что пустая / нечитабельная полоса равна 0.
    if ((hb.hp.pct >= 0 && hb.hp.pct < CFG.proHealPct)
        || (hb.sh.pct >= 0 && hb.sh.pct < 100))
        LogThrottledKey("[healunknown]", "[!] Автолечение приостановлено: тип предмета в слоте не определён; HP "
            . hb.hp.pct "%, щит " hb.sh.pct "% (-1 = неизвестно). Используйте лечение вручную.")
    return false
}

; ============================================================================
;                            ПОВЕДЕНИЕ: БОЙ
; ============================================================================
FireBurst(now, distHint := 0) {
    global CFG, SC, ST
    if (now < ST.reloadUntil)
        return false
    cd := (distHint > 0 && distHint <= 40) ? Max(95, Round(CFG.fireCooldownMs * 0.65)) : CFG.fireCooldownMs
    if (CFG.teamSafe || now - ST.lastFire < cd)
        return false
    if !Throttle()
        return false
    if CFG.dryRun {
        LogThrottled("[dry-run] цель в прицеле — дал бы очередь")
        ST.lastFire := now
        ST.bursts += 1
        return true
    }
    if !MouseDown("очередь")
        return false
    burstMs := (distHint > 0 && distHint <= 40) ? Round(CFG.fireBurstMs * 1.25) : CFG.fireBurstMs
    Sleep(Random(Round(burstMs * 0.78), Round(burstMs * 1.18)))
    MouseUp()
    ST.lastFire := now
    ST.bursts += 1
    ST.burstsSinceReload += 1
    ST.slotDirty := true
    MouseSmooth(Round(RndF(-2, 2)), Round(CFG.recoilPx + RndF(0, 2)), 32)   ; отдача вниз, плавно
    return true
}

TacticalReloadTick(now, inCombat := false) {
    ; v11.0: тактическая перезарядка и смена слота оружия (1 -> 2 -> 3)
    global CFG, ST
    if (now < ST.reloadUntil)
        return true
    if (inCombat && CFG.featReload && ST.burstsSinceReload >= CFG.reloadEvery) {
        nextSlot := (ST.activeSlot >= 3) ? 1 : (ST.activeSlot + 1)
        ST.activeSlot := nextSlot
        ST.burstsSinceReload := 0
        TapKey(String(nextSlot), 45)
        ST.slotAt := now
        LogThrottledKey("[swapslot]", "[боезапас] переключил слот оружия -> " nextSlot, 2500)
        return false
    }
    if (!inCombat && CFG.featReload && ST.slotDirty && (now - ST.lastFire >= 1400)) {
        ST.slotDirty := false
        ST.burstsSinceReload := 0
        ST.reloadUntil := now + CFG.reloadWaitMs
        TapKey("r", 65)
        if (ST.activeSlot != 1) {
            ST.activeSlot := 1
            TapKey("1", 45)
        }
        LogThrottledKey("[reload]", "[боезапас] перезарядка (R) после боя", 3000)
        return true
    }
    return false
}

Combat(shot, now) {
    global CFG, SC, ST
    if !CFG.featCombat {
        ST.enemy := 0
        return false
    }
    ; Фигура по цвету не различает союзника и врага. В команде все они
    ; неясны: автоматический бой выключен, пользователь ведёт его сам.
    if CFG.teamSafe {
        ST.enemy := 0, ST.enemyCache := 0, ST.enemyFirstAt := 0
        ST.combatBrakeUntil := 0, ST.combatMoveUntil := 0
        LogThrottledKey("[teamsafe]", "[i] Команда: союзники не распознаются, автоматическое наведение и огонь отключены; бой вручную.", 15000)
        return false
    }

    ; v7.3: в фон-режиме мышь недоступна. Наводиться и стрелять нельзя — иначе
    ; бот щёлкал бы вашей мышью в браузере (именно это и было в run-19.log).
    if !MouseAllowed() {
        ST.enemy := CachedEnemy(shot)      ; видеть врага можем, стрелять — нет
        if ST.enemy
            LogThrottledKey("[bgfight]", "[i] фон-режим: враг в кадре, но мышь недоступна"
                . " — не навожусь и не стреляю. Работают ходьба, E, слоты, пробел.")
        return false
    }

    enemy := CachedEnemy(shot)
    ; CachedEnemy уже требует наблюдения на разных захваченных кадрах.
    if !enemy {
        ST.enemyHits := 0, ST.enemyFirstAt := 0, ST.enemy := 0
        ST.combatBrakeUntil := 0, ST.combatMoveUntil := 0
        return false
    }
    if !ST.enemyFirstAt
        ST.enemyFirstAt := now
    ST.enemyHits := Max(ST.enemyConfirm.hits, ST.enemyWideConfirm.hits)
    ST.enemy := enemy

    ; Кэш сохраняет контекст боя, но не годится для поворота по старым
    ; координатам. Также учитываем длительность самого захвата и свой поворот.
    frameAge := A_TickCount - shot.capturedAt
    if (ST.enemySeenSeq != shot.captureId || frameAge > 250
        || ST.cameraSeq != shot.cameraSeqAtCapture) {
        ST.combatAt := A_TickCount
        ST.lastAction := "цель в кэше: жду свежий кадр для наведения"
        LogThrottledKey("[aimold]", "[i] Кандидат сохранён, но наведение ждёт свежий кадр: возраст "
            . frameAge " мс; поворот после захвата "
            . (ST.cameraSeq != shot.cameraSeqAtCapture ? "да" : "нет") ".", 5000)
        return true
    }

    ; ================= НАВЕДЕНИЕ (v7.2) =================
    ; Три части, которых раньше не было:
    ;  1) предсказание — ведём туда, где цель БУДЕТ (по её скорости);
    ;  2) поправка на промах — медленно копится, если пули идут мимо;
    ;  3) человеческая манера: задержка реакции, «доводка» на крупных ошибках,
    ;     мёртвая зона (без дрожания на цели) и лимит шага.
    ; Клавиши движения НЕ отпускаем — иначе бот вставал на месте.
    lead := CFG.aimLeadMs / 1000
    ; Позиция головы лишь приблизительная доля найденной рамки, а не её
    ; надёжное распознавание. Малую цель ведём в центр; крупную — выше.
    aimScale := shot.w / 1280
    largeTarget := enemy.h >= 96 * aimScale && enemy.w >= 40 * aimScale
    ty0 := (largeTarget && enemy.HasProp("hy") && enemy.hy) ? enemy.hy : enemy.cy
    tx := enemy.cx + ST.enemyVelX * lead
    ty := ty0 + ST.enemyVelY * lead
    ; не даём предсказанию уехать за пределы кадра
    tx := Clamp(tx, 8, shot.w - 8)
    ty := Clamp(ty, 8, shot.h - 8)
    prev := Critical("On")
    ST.enemyTrack := {x: Round(tx) - 12, y: Round(ty) - 12, w: 24, h: 24}
    ST.enemyTrackSeq := shot.captureId
    Critical(prev)

    dx := Round(tx - shot.w / 2)
    dy := Round(ty - shot.h / 2)
    err := Sqrt(dx * dx + dy * dy)

    ; затухание колебаний: если прицел «перелетает» цель (знак ошибки скачет),
    ; доля исправления уменьшается — так ведут мышь люди, а не маятник.
    if ((dx > 0) != (ST.aimLastDx > 0) && ST.aimLastDx != 0 && err < CFG.aimFlickPx)
        ST.aimDamp := Max(0.45, ST.aimDamp * 0.72)
    else
        ST.aimDamp := Min(1.0, ST.aimDamp * 1.03)
    ST.aimLastDx := dx

    ; Мёртвая зона не должна быть больше окна огня: иначе можно зависнуть
    ; в 10 px от маленькой цели, не доводя прицел и не стреляя.
    kAim := shot.w / 1280
    tolX := Min(CFG.fireTolerancePx * kAim, Max(4 * kAim, enemy.w * 0.30))
    tolY := Min(CFG.fireTolerancePx * 1.6 * kAim, Max(5 * kAim, enemy.h * 0.16))
    reacted := (now - ST.enemyFirstAt >= CFG.aimReactMs) || ST.redCrosshair
    TacticalReloadTick(now, true)
    ; v11.0: убираем слепую паузу 450 мс — ведём цель непрерывно, вблизи контр-стрейфим A/D,
    ; на средней/дальней дистанции притормаживаем и входим в прицел (ПКМ).
    closeTarget := (enemy.h >= 115 * kAim)
    if reacted {
        KeyUp(SC.w), KeyUp(SC.s)
        SprintSet(false)
        if (CFG.combatStrafe && closeTarget) {
            if (now >= ST.strafeFlipAt || !ST.strafeKey) {
                if (ST.strafeKey)
                    KeyUp(ST.strafeKey)
                ST.strafeDir := -ST.strafeDir
                ST.strafeKey := (ST.strafeDir > 0) ? SC.d : SC.a
                KeyDown(ST.strafeKey)
                ST.strafeFlipAt := now + Random(260, 440)
            }
            ST.moveMode := "бой: стрейф"
        } else {
            if (ST.strafeKey) {
                KeyUp(ST.strafeKey), ST.strafeKey := ""
            }
            KeyUp(SC.a), KeyUp(SC.d)
            ST.moveMode := "бой: прицел"
        }
    }
    aimMoved := false
    if (reacted && (Abs(dx) > tolX * 0.55 || Abs(dy) > tolY * 0.55)
        && (now - ST.lastAimT >= CFG.aimIntervalMs)) {
        ST.lastAimT := now
        gain := Clamp(CFG.aimGain + err / (shot.w * 1.4), CFG.aimGain, CFG.aimGainMax) * ST.aimDamp
        dErrX := dx - ST.aimPrevDx, dErrY := dy - ST.aimPrevDy
        ST.aimPrevDx := dx, ST.aimPrevDy := dy
        mdx := dx * gain - dErrX * 0.14
        mdy := dy * gain * 0.68 - dErrY * 0.10

        if (err > CFG.aimFlickPx) {
            lim := Min(CFG.aimStepPx * 2.2, CFG.aimFlickPx)
            mdx := Clamp(mdx, -lim, lim)
            mdy := Clamp(mdy, -lim * 0.65, lim * 0.65)
            aimMoved := (Round(mdx * CFG.mouseGain) != 0 || Round(mdy * CFG.mouseGain) != 0)
            MouseSmooth(Round(mdx * CFG.mouseGain), Round(mdy * CFG.mouseGain), 65)
        } else {
            mdx := Clamp(mdx, -CFG.aimStepPx * 0.65, CFG.aimStepPx * 0.65)
            mdy := Clamp(mdy, -CFG.aimStepPx * 0.45, CFG.aimStepPx * 0.45)
            aimMoved := (Round(mdx * CFG.mouseGain) != 0 || Round(mdy * CFG.mouseGain) != 0)
            MouseSmooth(Round(mdx * CFG.mouseGain), Round(mdy * CFG.mouseGain), 24)
        }
    } else {
        ST.aimPrevDx := dx, ST.aimPrevDy := dy
    }

    ST.lastAction := "бой: навожусь на кандидата"
    ST.combatAt := now
    ; v7.5: видно в журнале, что бот ВИДИТ врага и наводится. Раньше «враг да»
    ; в статусе было, а ни одной строки про наводку/выстрел — со стороны это
    ; выглядело как «противника вообще не видит».
    if (now - ST.aimLogAt > CFG.aimLogMs) {
        ST.aimLogAt := now
        srcRu := (enemy.HasProp("src") && enemy.src != "") ? enemy.src : "фигура"
        Log("[?] кандидат на врага: " srcRu " " enemy.w "x" enemy.h " px на ("
            . enemy.cx "," enemy.cy ")"
            . (enemy.HasProp("skin") ? " · кожи " enemy.skin "%" : "")
            . " · промах " err " px · веду прицел (" ST.enemyHits " подтв.)")
    }
    ; ---- v7.7: ПОПАДАНИЯ. Полосы HP над врагом в игре нет, поэтому единственное
    ; честное подтверждение — всплывшая цифра урона. Различаем по цвету:
    ; белая — по здоровью, синяя — по щиту, золотая — в голову.
    if (CFG.featDamageAim && ST.dmgAt && (now - ST.dmgAt < 900)
        && (ST.dmgN != ST.dmgLogN)) {
        ST.dmgLogN := ST.dmgN
        Log("[?] кандидат на цифру урона: " ST.dmgKind " · всего срабатываний "
            . ST.dmgN " · попадание не подтверждено")
    }

    ; Снимок, на котором были рассчитаны dx/dy, устаревает после поворота.
    ; Кэш цели годится для удержания внимания, но НЕ для слепого огня.
    ; Огонь только по проверенному кандидату этого кадра и без движения камеры
    ; в этом тике. Наличие кандидата всё ещё не доказывает, что это игрок.
    fresh := ST.enemySeenSeq = shot.captureId && (A_TickCount - ST.enemySeenAt <= 250)
        && (A_TickCount - shot.capturedAt <= 250) && ST.cameraSeq = shot.cameraSeqAtCapture
    fire := (reacted && fresh && !aimMoved && Abs(dx) <= tolX && Abs(dy) <= tolY)
    ; Низкий HP сам по себе не показывает, является ли противник «третьей
    ; стороной»: не блокируем защиту по этой неподтверждённой гипотезе.
    ; ---- прицел (ПКМ) по дальнему врагу: так попаданий больше ----
    if (fire && CFG.featAds) {
        dist := Sqrt(dx * dx + dy * dy)
        if (dist > CFG.adsRangePx) {
            AdsSet(true)
            InputReleaseLater("ads", "", CFG.adsHoldMs)
        }
    }
    ; ---- присед в перестрелке: меньше площадь тела, меньше попаданий ----
    if (fire && CFG.featCrouchFight
        && (now - ST.lastCrouchT > CFG.crouchHoldMs + CFG.crouchGapMs)) {
        ST.lastCrouchT := now
        CrouchSet(true)
        InputReleaseLater("crouch", "", CFG.crouchHoldMs)
    }
    if (fire || ST.redCrosshair) {
        if FireBurst(now, Round(enemy.dist)) {
            ST.shots += 1
            LogThrottledKey("[shot]", "[?] очередь по кандидату (очередей " ST.shots
                . " · прицел на (" Round(tx) "," Round(ty) ") · промах " err " px)")
            ; ---- ОБРАТНАЯ СВЯЗЬ (v7.7) ----
            ; Полосы HP над врагом в игре нет, поэтому единственный признак
            ; попадания — всплывшая цифра урона. Если бот отстрелял несколько
            ; очередей, а цифр так и не было, значит «врагом» оказался камень,
            ; куст или стена. Место запоминаем и туда больше не стреляем.
            if (now - ST.dmgAt > CFG.fireNoHitMs) {
                ST.fireMissN += 1
                if (ST.fireMissN >= CFG.fireNoHitMax) {
                    ST.fireMissN := 0
                    MarkFalseEnemy(enemy.cx, enemy.cy)
                    ST.enemy := 0
                    ST.enemyCache := 0
                    Log("[i] после " CFG.fireNoHitMax " очередей нет обнаруженного индикатора урона;"
                        . " это не доказывает, что цель — декорация. Временно не стреляю туда "
                        . Round(CFG.falseEnemyMs / 1000) " с")
                    return false
                }
            } else
                ST.fireMissN := 0
        }
    }
    return true
}


; ============================================================================
;                      ПОВЕДЕНИЕ: РЕАКЦИЯ НА ЗВУК
; ============================================================================
SoundReact(shot, now) {
    ; Визуализация звука: кольцевые метки (шаги/выстрелы) и яркие вспышки.
    global CFG, SC, ST
    if !CFG.featSound
        return false
    if (now - ST.lastSound < CFG.soundReactMs)
        return false

    soundEpoch := ST.inputEpoch
    mark := CachedSound(shot)
    ; Звук из кэша другого кадра или до поворота — не основание для движения.
    if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != soundEpoch
        || ST.soundCacheSeq != shot.captureId || ST.cameraSeq != shot.cameraSeqAtCapture
        || A_TickCount - shot.capturedAt > 250 || shot.capturedAt > A_TickCount)
        return false
    flashPct := (ST.sound > 0)
    if (!mark && !flashPct)
        return false

    ST.lastSound := now
    ST.sounds += 1
    if mark {
        ; поворачиваемся в сторону звука
        dx := mark.x - shot.w / 2
        if (Abs(dx) > 15 && !CFG.teamSafe)
            TurnBy(dx * 0.45, 0, CFG.turnMaxPx)
        near := (Abs(dx) < shot.w * 0.20)
        kindRu := (mark.kind = "red") ? "ВЫСТРЕЛ рядом"
            : ((mark.kind = "gold") ? "звук сундука/лута" : "шаги/зверьё")
        Log("[~] метка звука (" kindRu "), " Round(dx) " px от центра"
            . (near ? " — рядом" : ""))
        ; Индикатор звука — направление, а не координаты ящика или сундука.
        ; Он не создаёт цель для кирки и не подтверждает открытие сундука.
        if (mark.kind = "gold" && near && !ST.chest && !ST.loot)
            LogThrottledKey("[soundnotbox]", "[i] Звук сундука не показывает ящик: кирку по метке не применяю.", 10000)
        if (mark.kind != "gold" && near && ST.cameraSeq = shot.cameraSeqAtCapture && ST.running && !ST.paused
            && ST.inputEpoch = soundEpoch && Random(0, 99) < CFG.soundDodgeJumpChance && !CFG.dryRun) {
            StopMove()
            TapKey(SC.space, 90)                     ; уклоняемся прыжком
            k := (dx > 0) ? SC.a : SC.d
            KeyDown(k)
            InputReleaseLater("key", k, Random(160, 300))
        }
        return true
    }
    if flashPct {
        Log("[~] вспышка/выстрел рядом (" Round(ST.sound) "%) — уклоняюсь")
        if (!CFG.dryRun && Random(0, 99) < CFG.soundDodgeJumpChance) {
            StopMove()
            TapKey(SC.space, 90)
        }
        return true
    }
    return false
}

; ============================================================================
;                          КЭШ ТЯЖЁЛЫХ СКАНОВ
; ============================================================================
; РЕАЛЬНОЕ ВРЕМЯ (run-13.log). Тик на 1280x720 упирался в бюджет 4.5 с:
; «тик прерван по времени (скан пикселей)» каждые 5 секунд, «долгих тиков 13».
; Причина — в одном тике запускалось по 5-6 тяжёлых сканов, а на каждой смене
; сцены кэш сбрасывался и они шли заново. Теперь у сканов есть БЮДЖЕТ:
; за тик выполняется не больше CFG.scanPerTickMax единиц, остальные значения
; берутся из кэша (пусть чуть старые — это лучше, чем тик на 5 секунд).
ScanAllow(cost := 1) {
    global CFG, ST
    if (ST.scanWork + cost > CFG.scanPerTickMax) {
        ST.scanSkipped += 1
        return false
    }
    ST.scanWork += cost
    return true
}

; Шаг скана с поправкой на скорость машины: на слабом ПК шаг растёт сам.
ScanStep(base) {
    global ST
    return base + ST.stepBoost
}

CachedDensity(shot) {
    global CFG, ST
    if (A_TickCount - ST.scanDensityAt >= CFG.scanDensityMs && ScanAllow(1)) {
        ST.densityCache := EdgeDensity(shot)
        ST.scanDensityAt := A_TickCount
    }
    return ST.densityCache
}

CachedMenu(shot) {
    global CFG, ST
    ; ВАЖНО: раньше условие начиналось с «!ST.menuCache» — пустой кэш (когда
    ; кнопок не найдено) заставлял сканировать КАЖДЫЙ кадр. То же было у
    ; жетона, лута и врага: «ничего не найдено» = 0 = «кэша нет». Теперь
    ; смотрим только на время.
    ; структурные кэши (меню, HP) обязаны быть заполнены в любом случае:
    ; по ним читаются поля, а не только «есть/нет» — бюджет их не отменяет
    if (A_TickCount - ST.scanMenuAt >= CFG.scanMenuMs && (!ST.menuCache || ScanAllow(2))) {
        ST.menuCache := {
            ; Полноэкранный yellow нигде не использовался; не сканируем зря.
            results: FindYellowButtons(shot, CFG.regResults),
            lobbyY: FindYellowButtons(shot, CFG.regLobbyBtn),
            lobby:  LobbyButton(shot),
            cream:  FindCreamButton(shot, CFG.regLobbyBtn),
            dark:   DarkRatio(shot, [0.15, 0.10, 0.85, 0.90])
        }
        ST.scanMenuAt := A_TickCount
        lb := ST.menuCache.lobby ? ST.menuCache.lobby
            : (ST.menuCache.lobbyY.Length ? ST.menuCache.lobbyY[ST.menuCache.lobbyY.Length] : 0)
        if lb {
            ST.lastLobbyBtn := lb
            ST.lastLobbyAt := A_TickCount
        }
    }
    return ST.menuCache
}

CachedEnemy(shot) {
    global CFG, ST
    now := A_TickCount
    ; Два отдельных счётчика: отрицательный узкий скан не сбрасывает цель
    ; на краю кадра, где она доступна только редкому широкому скану.
    verified := 0
    rc := CrosshairOnEnemy(shot)
    if rc {
        ST.redCrosshair := true, ST.redCrossAt := now
        verified := rc
    } else if (now - ST.redCrossAt > 220) {
        ST.redCrosshair := false
    }
    if (!verified && now - ST.scanEnemyFastAt >= CFG.enemyFastMs && ScanAllow(2)) {
        ST.scanEnemyFastAt := now
        figure := FindEnemyMulti(shot, CFG.enemyFastFrac)
        if (A_TickCount - shot.capturedAt <= 250 && ST.cameraSeq = shot.cameraSeqAtCapture)
            verified := ConfirmCandidate(ST.enemyConfirm, figure, shot.captureId, shot.w, shot.h, now, CFG.enemyConfirmHits)
    }
    ; Индикатор урона не является телом врага. Сначала выделяем бюджет
    ; узкому скану фигуры, затем диагностике урона и широкому скану.
    ; ---- канал 1: ЦИФРЫ УРОНА. Если над целью мелькнуло число — мы попали,
    ; и противник ровно там. Это единственное честное подтверждение в игре,
    ; потому что полосы здоровья над врагом нет.
    if (CFG.featDamageAim && (now - ST.scanDmgAt >= CFG.damageScanMs) && ScanAllow(1)) {
        ST.scanDmgAt := now
        d := FindDamageNumber(shot)
        ; цифра должна ЖИТЬ недолго: иконка предмета или кнопка HUD висят долго
        if (d && !TransientOk(d.cx, d.cy))
            d := 0
        ; и должна быть рядом с найденной фигурой — иначе это подпись в HUD
        if (d && IsObject(ST.enemyCache)
            && (Abs(d.cx - ST.enemyCache.cx) > shot.w * 0.20))
            d := 0
        if d {
            if (d.kind != ST.dmgKind || (now - ST.dmgAt > 400)) {
                ST.dmgN += 1
                ST.hits += 1, ST.lastHitAt := now
            }
            ST.dmgKind := d.kind, ST.dmgBox := d, ST.dmgAt := now
            ; Индикатор урона — не фигура; не назначаем его целью для огня.
        }
    }
    ; Если узкий проход уже дал подтверждённого кандидата на ЭТОМ кадре,
    ; повторный широкий поиск в том же тике не нужен. При промахе — нужен.
    if (!verified && now - ST.scanWideAt >= CFG.skinWideMs && ScanAllow(2)) {
        ST.scanWideAt := now
        wide := FindEnemySkin(shot, 0.92, CFG.skinStepWide)
        wideVerified := 0
        if (A_TickCount - shot.capturedAt <= 250 && ST.cameraSeq = shot.cameraSeqAtCapture)
            wideVerified := ConfirmCandidate(ST.enemyWideConfirm, wide, shot.captureId, shot.w, shot.h, now, CFG.enemyConfirmHits)
        if (!verified && wideVerified)
            verified := wideVerified
        ; Звуковая метка — направление звука, не координата тела врага.
        a := FindAlertMark(shot)
        if (a && TransientOk(a.cx, a.cy))
            ST.alertAt := now
    }
    if (A_TickCount - shot.capturedAt > 250) {
        LogThrottledKey("[combat-late]", "[!] Бой: кадру уже "
            . (A_TickCount - shot.capturedAt) " мс после сканирования —"
            . " наведение и стрельба по нему запрещены.", 5000)
        verified := 0
    }
    if (ST.cameraSeq != shot.cameraSeqAtCapture)
        verified := 0
    if verified {
        ; Данные и id одного кадра должны читаться F3 как единая запись.
        prev := Critical("On")
        ST.enemyCache := verified, ST.enemySeenAt := now, ST.enemySeenSeq := shot.captureId
        Critical(prev)
        ST.enemySrc := verified.src
        TrackEnemy(verified, shot.capturedAt, shot.cameraSeqAtCapture)
    }
    ; ---- цель пропала: держим её CFG.enemyHoldMs, иначе бот палил бы в стену ----
    if IsObject(ST.enemyCache) && (now - ST.enemySeenAt > CFG.enemyHoldMs) {
        ST.enemyCache := 0
        ST.enemyVelX := 0, ST.enemyVelY := 0, ST.enemyLastAt := 0
    }
    return ST.enemyCache
}

TrackEnemy(e, now, cameraSeq) {
    ; Движение изображения после нашего поворота не является скоростью врага.
    ; Это только защита от собственного ввода: ручное движение мыши неизвестно.
    global ST
    if (cameraSeq != ST.enemyLastCameraSeq) {
        ST.enemyVelX := 0, ST.enemyVelY := 0, ST.enemyLastAt := 0
    }
    if (ST.enemyLastAt > 0 && now > ST.enemyLastAt) {
        dt := (now - ST.enemyLastAt) / 1000
        if (dt <= 0.45) {
            vx := (e.cx - ST.enemyLastX) / dt
            vy := (e.cy - ST.enemyLastY) / dt
            ; сглаживание: скорость не должна «прыгать» от одного кадра
            ST.enemyVelX := ST.enemyVelX * 0.55 + vx * 0.45
            ST.enemyVelY := ST.enemyVelY * 0.55 + vy * 0.45
        } else {
            ST.enemyVelX := 0, ST.enemyVelY := 0
        }
    }
    ; слишком быстрый «прыжок» — это скорее смена цели, а не бег
    if (Abs(ST.enemyVelX) > 1400)
        ST.enemyVelX := 0
    ST.enemyLastX := e.cx, ST.enemyLastY := e.cy, ST.enemyLastAt := now
    ST.enemyLastCameraSeq := cameraSeq
}

; Одна и та же область (regLoot) раньше сканировалась ЧЕТЫРЕ раза за тик:
; золото для сундука и три редкости для лута. Теперь — один проход на все
; цвета, и результат общий для сундука и лута (run-13.log, «долгих тиков 13»).
; ВАЖНО (run-14.log): MaskClustersMulti возвращает Map, а результат читался
; через точку — CachedLootMasks(shot).gold. В AHK v2 у Map НЕТ свойств:
;   This value of type "Map" has no property named "gold"
; и тик падал с ошибкой на каждой итерации, то есть бот не делал ничего.
; Теперь всегда Map и только [ключ]. Этот же помощник страхует от опечаток.
LootMask(masks, mode) {
    ; Читает маски ТОЛЬКО безопасно: Map -> [ключ], объект -> .свойство.
    ; Так сбой «Map has no property named …» (run-14.log) невозможен, даже если
    ; кто-то снова вернёт объект вместо Map.
    if !IsObject(masks)
        return []
    try {
        if masks.Has(mode)
            return masks[mode]
        return []
    } catch {
        try
            return masks.%mode%        ; объект-литерал: свойство по имени
        catch
            return []
    }
}

CachedLootMasks(shot) {
    global CFG, ST
    if (A_TickCount - ST.lootMasksAt >= CFG.scanLootMs && ScanAllow(2)) {
        ST.lootMasks := MaskClustersMulti(shot, CFG.regLoot
            , ["chestGold", "chestRare", "green", "blue", "purple"], 18, ScanStep(6), 2)
        ST.lootMasksAt := A_TickCount
        ST.lootMasksSeq := shot.captureId
    }
    if !IsObject(ST.lootMasks)
        ST.lootMasks := EmptyLootMasks()
    return ST.lootMasks
}

; Пустой набор масок — всегда Map той же формы, что и настоящий результат.
EmptyLootMasks() {
    m := Map()
    for mode in ["chestGold", "chestRare", "green", "blue", "purple"]
        m[mode] := []
    return m
}

CachedChest(shot) {
    global CFG, ST
    now := A_TickCount
    if (ST.chestCacheAt && (now - ST.chestCacheAt < CFG.scanChestMs))
        return ST.chestCache
    ; Не тратим ScanAllow дважды: FindChest сам обновит CachedLootMasks при необходимости.
    chestResult := FindChest(shot), chestSeq := ST.lootMasksSeq
    if (!chestResult && ST.chestCache && (shot.captureId - ST.chestCacheSeq) > 6)
        chestResult := 0
    prev := Critical("On")
    ST.chestCache := chestResult, ST.chestCacheSeq := chestSeq, ST.chestCacheAt := now
    Critical(prev)
    return chestResult
}

CachedLoot(shot) {
    global ST
    lootResult := FindLoot(shot), lootSeq := ST.lootMasksSeq
    prev := Critical("On")
    ST.lootCache := lootResult, ST.lootCacheSeq := lootSeq
    Critical(prev)
    return lootResult
}

CachedHealth(shot) {
    global CFG, ST
    if (A_TickCount - ST.scanHpAt >= CFG.scanHpMs && (!ST.hpCache || ScanAllow(1))) {
        ST.hpCache := HealthBars(shot)
        ST.scanHpAt := A_TickCount
    }
    return ST.hpCache
}

CachedSound(shot) {
    global CFG, ST
    if (A_TickCount - ST.scanSoundAt >= CFG.scanSoundMs && ScanAllow(2)) {
        ST.soundCache := SoundMarks(shot)
        ST.sound := SoundFlash(shot)
        ST.soundCacheSeq := shot.captureId
        ST.scanSoundAt := A_TickCount
    }
    return ST.soundCache
}

ResetCaches() {
    global ST
    ; РАНЬШЕ здесь обнулялись сами значения, и каждая смена сцены заставляла
    ; следующий тик пересканировать ВСЁ сразу — отсюда «превысил бюджет
    ; времени» каждые 5 секунд в run-13.log. Теперь помечаем кэш устаревшим:
    ; значения обновятся по одному в ближайших тиках (бюджет не даст все сразу).
    ST.scanMenuAt := 0, ST.scanDensityAt := 0, ST.scanEnemyAt := 0
    ST.scanLootAt := 0, ST.scanHpAt := 0, ST.scanSoundAt := 0
    ST.soundCache := 0, ST.sound := 0, ST.soundCacheSeq := 0
    ST.lootMasksAt := 0, ST.chestCacheAt := 0, ST.lootMasksSeq := 0, ST.lootCacheSeq := 0, ST.chestCacheSeq := 0
    ST.enemyCache := 0, ST.chestCache := 0, ST.lootCache := 0, ST.lootMasks := 0
    ST.enemyLastAt := 0, ST.enemyLastCameraSeq := -1, ST.enemyVelX := 0, ST.enemyVelY := 0
    ST.enemyConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.enemyWideConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.promptConfirm := {seq: 0, at: 0, hits: 0, x: 0, y: 0}
    ST.promptCache := 0, ST.promptAt := 0, ST.promptAvailable := false, ST.promptSeq := 0
    ST.breakTarget := 0, ST.breakNoChange := 0
    if (ST.stuckRecoverKey != "")
        KeyUp(ST.stuckRecoverKey)
    ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
    ResetMoveWatch(true)
}

; ============================================================================
;                       ОПРЕДЕЛЕНИЕ СОСТОЯНИЯ ЭКРАНА
; ============================================================================
; Цвет одной точки кадра (координаты кадра).
ColorAt(shot, x, y) {
    if (x < 0 || y < 0 || x >= shot.w || y >= shot.h)
        return {r: 0, g: 0, b: 0}
    o := y * shot.stride + x * 4
    return {b: NumGet(shot.buf, o, "UChar")
          , g: NumGet(shot.buf, o + 1, "UChar")
          , r: NumGet(shot.buf, o + 2, "UChar")}
}

; ЧТО ЭТО ЗА ПЛАШКА (run-13.log — главная причина «рандомных кликов»).
; В лобби на одном и том же месте две РАЗНЫЕ кнопки:
;   «ИГРАТЬ»  — насыщенно-жёлтая, синего почти нет (RGB ~203,203,0);
;   «ОТМЕНИТЬ»— кремовая, синего много (RGB ~255,233,180).
; Раньше обе проходили как «жёлтая кнопка», поэтому во время поиска бот
; принимал «Отменить» за «Играть» и жал по ней — очередь рвалась, и всё
; повторялось по кругу. Теперь цвет плашки читается в её центре.
PlateKind(shot, box) {
    ; Центр часто занят чёрными буквами «ИГРАТЬ». Оцениваем заливку по
    ; нескольким внутренним точкам, а не один пиксель по центру текста.
    if !box
        return "?"
    play := 0, cancel := 0
    for fy in [0.20, 0.50, 0.80] {
        for fx in [0.12, 0.24, 0.76, 0.88] {
            c := ColorAt(shot, Round(box.x + box.w * fx), Round(box.y + box.h * fy))
            if (c.r >= 150 && c.g >= 140 && c.b <= 95 && Abs(c.r - c.g) <= 70)
                play += 1
            else if (c.r >= 185 && c.g >= 170 && c.b >= 120)
                cancel += 1
        }
    }
    if (play >= 7 && play > cancel)
        return "play"
    if (cancel >= 7 && cancel > play)
        return "cancel"
    return "?"
}
DetectState(shot, density, now) {
    global CFG, ST
    ST.density := density

    ; В режимах «Только Анти-АФК» и «AFK XP (LEGO/Creative)» кнопки меню не ищем и не жмём.
    if (CFG.botMode = "xp") {
        ST.target := 0
        ; На Creative/LEGO/Festival-картах стандартная зелёная полоса HP может быть скрыта,
        ; поэтому режим XP работает прямо в активном окне игры без кликов по меню.
        return "GAME"
    }
    if (CFG.botMode = "antiafk") {
        ST.target := 0
        if InMatchHud(shot) {
            ST.inMatchT := now
            return "GAME"
        }
        return "UNKNOWN"
    }

    m := CachedMenu(shot)
    lobbyBox := m.lobby ? m.lobby : (m.lobbyY.Length ? m.lobbyY[m.lobbyY.Length] : 0)
    lobbyKind := lobbyBox ? PlateKind(shot, lobbyBox) : "?"
    ; Явная плашка лобби блокирует ложные итог/смерть/HUD по фону.
    lobbyPlate := lobbyKind = "play" || lobbyKind = "cancel"

    ; ---- 1) экран итогов: безопасная «ИГРАТЬ СНОВА» в правой колонке -------
    ; Отсекаем «Остаться с командой», «Пожаловаться на игрока» и мелкие значки XP.
    resBtn := (!lobbyPlate && m.results.Length) ? PickResultPlayAgain(shot, m.results) : 0
    if resBtn {
        ST.menuSeenAt := 0, ST.playSeenAt := 0
        ST.target := resBtn
        ST.mmSince := 0
        ST.wasDeadScene := false
        return "END_SCREEN"
    }

    ; ---- 2) экран смерти: яркая панель «ВАС УСТРАНЯЕТ» + полоса HP ---------
    if (!lobbyPlate && (BrightRatio(shot, CFG.regDeath, 200) >= CFG.deathBrightMin) && InMatchHud(shot)) {
        ST.menuSeenAt := 0, ST.playSeenAt := 0
        ST.target := 0
        if (ST.deadSince = 0)
            ST.deadSince := now
        return "DEATH"
    }
    ST.deadSince := 0

    ; ---- 3) матч: есть ровная толстая полоса здоровья ----------------------
    if (!lobbyPlate && InMatchHud(shot)) {
        ST.menuSeenAt := 0, ST.playSeenAt := 0
        ST.prompt := 0
        ST.inMatchT := now          ; матч точно идёт — защита от ложного лобби
        if ST.wasDeadScene {
            ST.wasDeadScene := false
            ST.spectateAlive := 0
            ST.rebootCount += 1
            Log("[+] Возрождение союзником (Reboot) подтверждено — возвращаюсь в матч (всего: " ST.rebootCount ")")
        }
        return "GAME"
    }

    ; ---- 3.5) сколько времени «лобби» видно НЕПРЕРЫВНО --------------------
    ; Нужно для защиты матча: в автобусе, на глайдере и на загрузке HUD
    ; пропадает, кадр похож на лобби — и раньше бот выходил из матча кликом по
    ; «Играть» (run-13.log: «МАТЧ -> ЛОББИ» три раза за минуту).
    lobbySeen := (m.lobby || m.lobbyY.Length) ? true : false
    if lobbySeen {
        if !ST.menuSeenAt
            ST.menuSeenAt := now
    } else {
        ST.menuSeenAt := 0
        ST.playSeenAt := 0
    }

    ; ---- 4) лобби: жёлтая «ИГРАТЬ» (RGB 203,203,0) ------------------------
    ; проверяем ДО поиска матча: кнопка «Играть» и кнопка «Отменить» вместе
    ; не встречаются, а кремовых пятен в пиратском лобби полным-полно.
    if lobbySeen {
        ; (а) матч ещё жив — «лобби» должно продержаться matchGuardMs подряд
        if (ST.inMatchT && (now - ST.inMatchT < CFG.matchGuardWindowMs)
            && (now - ST.menuSeenAt < CFG.matchGuardMs)) {
            ST.guardStops += 1
            LogThrottledKey("[matchguard]", "[=] кадр похож на лобби, но матч шёл "
                . Round((now - ST.inMatchT) / 1000) " с назад — остаюсь в матче"
                . " (так бот раньше бросал игру в автобусе)")
            ST.prompt := 0
            return "GAME"
        }
        ; (б) ЧТО ЗА ПЛАШКА: во время поиска на месте «Играть» стоит «Отменить».
        ; Это и была главная причина «рандомных нажатий» в run-13.log.
        box := m.lobby ? m.lobby : m.lobbyY[m.lobbyY.Length]
        kind := PlateKind(shot, box)
        if (kind = "cancel") {
            ; «ОТМЕНИТЬ»: очередь идёт, кликать нельзя ни в коем случае
            ST.cancelSeen += 1
            ST.target := 0
            if (ST.mmSince = 0)
                ST.mmSince := now
            ST.mmEnterAt := now
            ST.queueSeen := true
            ST.playSeenAt := 0
            return "MATCHMAKING"
        }
        ; «ИГРАТЬ» должна продержаться playConfirmMs подряд: одиночные
        ; кадры-выбросы (свет, вспышка, смена кадра) кликом не становятся
        confident := false
        if (kind = "play") {
            if !ST.playSeenAt
                ST.playSeenAt := now
            confident := (now - ST.playSeenAt >= CFG.playConfirmMs)
        } else
            ST.playSeenAt := 0

        ; (в) плашку не разобрали: держим «поиск», пока он свежий
        ; (15 с после нажатия «Играть» — очередь как раз успевает начаться)
        if (!confident && ST.mmEnterAt && (now - ST.mmEnterAt < CFG.mmStickyMs)) {
            ST.prompt := 0
            return "MATCHMAKING"
        }
        ; (г) сцена менялась только что — держим прежнюю
        if (!confident && (ST.state = "MENU" || ST.state = "MATCHMAKING")
            && ST.lastFlipAt && (now - ST.lastFlipAt < CFG.stateStickyMs)) {
            ST.prompt := 0
            return ST.state
        }
        ST.target := box
        ST.mmSince := 0
        return "MENU"
    }

    ; ---- 5) поиск матча: кремовая «ОТМЕНИТЬ» ------------------------------
    ; ВАЖНО: проверяется ДО «липкого» лобби — иначе после нажатия «Играть»
    ; бот мог бы ещё раз кликнуть по тому же месту, а там уже «Отменить».
    if m.cream {
        ST.target := 0
        if (ST.mmSince = 0)
            ST.mmSince := now
        ST.queueSeen := true
        return "MATCHMAKING"
    }

    ; ---- 5.4) только что видели «Отменить» — значит очередь идёт ----------
    ; ВАЖНО (run-9.log): пока идёт поиск, на месте кнопки «Играть» находится
    ; «Отменить». Если сцена мигнёт в ЛОББИ и бот кликнет по этому месту,
    ; он ОТМЕНИТ очередь — в журнале это «очередь оборвалась через 0 с» по
    ; кругу. Поэтому 5 секунд после входа в поиск состояние не меняем.
    if (ST.mmEnterAt && (now - ST.mmEnterAt < CFG.mmStickyMs)) {
        ST.prompt := 0
        return "MATCHMAKING"
    }

    ; ---- 5.5) кнопка «Играть» была только что — значит мы всё ещё в лобби
    if (ST.lastLobbyBtn && (now - ST.lastLobbyAt < CFG.lobbyStickyMs)
        && (now - ST.lastQueueT > 3000)) {
        ST.target := ST.lastLobbyBtn
        ST.mmSince := 0
        return "MENU"
    }

    ; ---- 6) экран награды / пиратского магазина ---------------------------
    if CFG.featReward {
        rb := FindRewardButton(shot)
        if rb {
            ST.target := rb
            return "REWARD"
        }
    }

    ; ---- 6.5) экран спящего режима Fortnite («ПРОДОЛЖИТЬ ИГРУ») -----------
    if (CFG.sleepAction != "ignore") {
        sb := FindSleepScreen(shot)
        if sb {
            ST.target := sb
            return "SLEEP"
        }
    }

    ; ---- 7) непонятный тёмный экран (загрузка/итоги без кнопки) ----------
    if (m.dark >= CFG.endDarkRatio) {
        ST.target := 0
        return "END_SCREEN"
    }
    ST.target := 0
    return "UNKNOWN"
}

; ============================================================================
;                     ОБРАБОТЧИКИ СОСТОЯНИЙ
; ============================================================================
HandleSleep(shot, now) {
    ; Fortnite перешёл в автоматический спящий режим из-за долгого простоя.
    global CFG, ST
    ReleaseKeys()
    if (CFG.sleepAction = "stop") {
        Log("[!] Обнаружен спящий режим Fortnite — останавливаю бота по настройке.")
        PlayAlertBeep(620, 220)
        OnStop("спящий режим Fortnite")
        return
    }
    if (CFG.sleepAction = "wait") {
        ST.lastAction := "спящий режим (ожидание)"
        LogThrottledKey("[sleepwait]", "[i] Fortnite в спящем режиме — жду (в настройках выбрано «Ждать»).", 12000)
        return
    }
    if (ST.lastSleepAct && now - ST.lastSleepAct < CFG.sleepCooldownMs)
        return
    btn := FindSleepScreen(shot)
    if !btn
        return
    ST.target := btn
    ST.uiBoxCache := btn, ST.uiBoxSeq := shot.captureId
    if !Throttle()
        return
    if !ClickMenuBox(shot, btn, "Продолжить игру", "sleep_wake")
        return
    ST.lastSleepAct := now
    ST.lastClickT := now
    ST.sleepWakes += 1
    ST.lastAction := "выход из спящего режима"
    Log("[>] Спящий режим Fortnite: нажал «Продолжить игру» (всего: " ST.sleepWakes ")")
}

HandleEndScreen(shot, now) {
    global CFG, SC, ST
    if (CFG.botMode = "antiafk" || CFG.botMode = "xp")
        return
    if (ST.endFirstSeen = 0)
        ST.endFirstSeen := now
    MacroPlayReset()

    ; Засчитываем раунд при реальной кнопке итогов (не на случайном тёмном экране загрузки).
    if (ST.target && ST.roundActive && !ST.roundCounted) {
        RecordRoundCompleted("итоги матча")
        if ST.tokenStopArmed {
            Log("[+] Жетон найден и матч завершён — останавливаю авто-очередь.")
            PlayAlertBeep(1040, 180)
            OnStop("жетон найден")
            return
        }
        if CheckSessionLimits(now, false)
            return
    } else if (ST.finishMatchArmed && CheckSessionLimits(now, false)) {
        return
    }

    if !CFG.featPlayAgain
        return

    ; Режим «Только через лобби»: никогда не жмём «Играть снова», а ищем кнопку «В лобби»
    ; (полезно в Squad Fill, чтобы каждый раунд собирать новый активный отряд).
    preferLobby := (CFG.endAction = "lobby_only")

    if (!preferLobby && ST.target) {
        ST.uiBoxCache := ST.target, ST.uiBoxSeq := shot.captureId
        if (ST.endRetry >= CFG.clickRetries && now - ST.lastClickT < CFG.retryAfterMs)
            return
        if (now - ST.lastClickT < CFG.verifyMs)
            return
        ReleaseKeys()
        if !Throttle()
            return
        if !ClickMenuBox(shot, ST.target, "Играть снова", "play_again") {
            LogThrottledKey("[resultsnoclick]", "[i] Клик «Играть снова» отложен или ждёт фокуса.")
            return
        }
        ST.lastClickT := now
        ST.endRetry += 1
        ST.clickAgain += 1
        ST.lastAction := "жму «Играть снова»"
        Log("[>] Итоги: жму «Играть снова» (попытка " ST.endRetry ")")
        return
    }

    ; Ищем реальную кнопку «В лобби» внизу справа (сразу при lobby_only, либо как резерв).
    waited := now - ST.endFirstSeen
    needWait := preferLobby ? 2200 : CFG.endReturnAfterMs
    gapWait := preferLobby ? CFG.verifyMs : CFG.retryAfterMs
    if (waited >= needWait && now - ST.lastClickT >= gapWait) {
        retBtn := FindLightPlateButton(shot, CFG.regReturnBtn, 0.08, 0.30, 2.0, 8.0, false)
        if !retBtn {
            yl := FindYellowButtons(shot, CFG.regReturnBtn)
            if yl.Length
                retBtn := yl[1]
        }
        if retBtn {
            ST.uiBoxCache := retBtn, ST.uiBoxSeq := shot.captureId
            ReleaseKeys()
            if Throttle() && ClickMenuBox(shot, retBtn, "В лобби", "end_return") {
                ST.lastClickT := now
                ST.clickAgain += 1
                ST.lobbyRequeue := true
                if (CFG.lobbyDelaySec > 0)
                    ST.lobbyCooldownUntil := A_TickCount + CFG.lobbyDelaySec * 1000
                if (ST.roundActive && !ST.roundCounted)
                    RecordRoundCompleted("выход с итогов в лобби")
                ST.lastAction := "жму «В лобби»"
                Log("[>] Итоги: нажал кнопку «В лобби»"
                    . (preferLobby ? " (режим «Только через лобби»)." : " (резерв после " Round(waited / 1000) " с)."))
                return
            }
        }
    }

    ; Послематчевый опрос Fortnite («Пропустить / SKIP»): закрываем, если нет жетона на экране.
    if (!ST.tokenShown && waited >= 6500 && now - ST.lastSurveyAt >= 9000 && now - ST.lastClickT >= CFG.verifyMs) {
        modalBtn := FindModalDismissButton(shot)
        if modalBtn {
            ST.uiBoxCache := modalBtn, ST.uiBoxSeq := shot.captureId
            ReleaseKeys()
            if Throttle() && ClickMenuBox(shot, modalBtn, "Пропустить опрос", "skip_survey") {
                ST.lastClickT := now
                ST.lastSurveyAt := now
                ST.surveySkips += 1
                ST.lastAction := "пропустил опрос"
                Log("[>] Итоги: закрыл послематчевый опрос / модальное окно (всего: " ST.surveySkips ")")
                return
            }
        }
    }

    LogThrottledKey("[resultsunknown]", "[?] Экран похож на итоги/загрузку, кнопка пока не найдена — жду.", 10000)
}

HandleReward(shot, now) {
    ; Экран награды / пиратского магазина: забираем и закрываем.
    ; Жетон с белой «F» на таком экране — повод один раз нажать «\».
    global CFG, ST
    ReleaseKeys()

    if (CFG.botMode = "antiafk" || CFG.botMode = "xp" || !CFG.featReward || !ST.target)
        return
    ; на экране с жетоном кнопки не трогаем: активация стартует 14-дневный таймер
    if (CFG.tokenNoClick && ST.tokenShown) {
        ST.lastAction := "жетон на экране (не жму)"
        LogThrottled("[i] на экране жетон — кнопки не жму, чтобы не запустить 14-дневную активацию")
        return
    }
    if (ST.rewardClicks >= CFG.rewardClickMax)
        return
    if (now - ST.lastClickT < CFG.rewardGapMs)
        return
    ST.uiBoxCache := ST.target, ST.uiBoxSeq := shot.captureId
    if !Throttle()
        return
    if CFG.dryRun {
        Log("[dry-run] экран награды: нажал бы «" (ST.target.kind = "white" ? "ЗАБРАТЬ ВСЁ" : "ПОЛУЧИТЬ ВСЁ") "»")
        ST.lastClickT := now
        ST.rewardClicks += 1
        return
    }
    if !ClickMenuBox(shot, ST.target, "Забрать награду", "reward_claim") {
        LogThrottledKey("[rewardnoclick]", "[i] Клик по награде отложен или ждёт фокуса.")
        return
    }
    ST.lastClickT := now
    ST.rewardClicks += 1
    ST.clickAgain += 1
    ST.lastAction := "забираю награду"
    Log("[>] Награда: жму кнопку внизу (" ST.rewardClicks "/" CFG.rewardClickMax ")")
}

RecordTokenFound(detail) {
    global CFG, ST
    ST.tokensFound += 1
    CFG.totalTokens += 1
    ST.tokenFoundMatch := true
    PersistStats(true)
    try {
        line := FormatTime(, "yyyy-MM-dd HH:mm:ss") "  " detail
            . " (сессия: " ST.tokensFound ", всего: " CFG.totalTokens ")`n"
        FileAppend(line, CFG.tokenFile, "UTF-8")
    } catch {
    }
    if CFG.audioAlert {
        PlayAlertBeep(988, 120)
        Sleep(40)
        PlayAlertBeep(1318, 180)
    }
    Toast("ЖЕТОН НАЙДЕН!", detail, 6000)
    SendTokenWebhook(detail)
    if CFG.stopOnToken {
        ST.tokenStopArmed := true
        Log("[!] Включён «Стоп при жетоне»: после этого экрана/матча новые игры запускаться не будут.")
    }
}

CheckToken(shot, now) {
    ; Жетон пиратского магазина (золотой круг с белой «F»): один раз жмём «\».
    ; Повторно — только если жетон исчез и не появлялся tokenRearmMs.
    global CFG, SC, ST
    if !CFG.featToken
        return false
    ; ВАЖНО (run-13.log): условие было «!ST.tokenCache || ...» — а «жетона нет»
    ; хранится как 0, то есть как «кэша нет». Из-за этого жетон и баннер
    ; сканировались КАЖДЫЙ кадр (это область 0.28..0.72 x 0.10..0.88 плюс
    ; отдельный подсчёт золота вокруг каждого кандидата). Теперь — по времени.
    if (now - ST.scanTokenAt >= CFG.scanTokenMs && ScanAllow(2)) {
        found := FindToken(shot)
        if found
            ST.tokenCache := found                      ; жетон (золото + белая «F»)
        else if RareBanner(shot)
            ST.tokenCache := 1                          ; баннер находки: скин/машина/жетон
        else
            ST.tokenCache := 0
        ST.scanTokenAt := now
    }
    tok := ST.tokenCache
    if !tok {
        if ST.tokenShown {
            if (ST.tokenGoneAt = 0)
                ST.tokenGoneAt := now                    ; запомнили момент пропажи
            else if (now - ST.tokenGoneAt >= CFG.tokenRearmMs) {
                ST.tokenShown := false
                ST.tokenGoneAt := 0
                Log("[i] жетон пропал — можно ловить следующий")
            }
        }
        return false
    }

    if ST.tokenShown
        return false
    ST.tokenShown := true
    ST.tokenGoneAt := 0

    if (ST.tokenPresses >= CFG.tokenPressMax) {
        LogThrottled("[i] жетон есть, но лимит нажатий «\» исчерпан (" CFG.tokenPressMax ")")
        return false
    }
    ST.tokenPresses += 1
    detail := (tok = 1)
        ? "Баннер редкой находки (скин/машина/жетон)"
        : "Жетон пиратского магазина (" Round(tok.cx / shot.w, 3) ", " Round(tok.cy / shot.h, 3) ")"
    Log("[+] " detail " — фиксирую в ЖЕТОН_НАЙДЕН.txt и жму «\»")
    RecordTokenFound(detail)
    if CFG.dryRun {
        Log("[dry-run] нажал бы «\»")
        return true
    }
    hwnd := GetGameWindow()
    if !hwnd
        return false
    if (WinActive("ahk_id " hwnd) || BgInputActive()) {
        TapKey(SC.backslash, 90)
    } else if CFG.smartRestore {
        RunMenuAction(hwnd, "Жетон (\)", () => TapKey(SC.backslash, 90))
    }
    ST.lastClickT := now
    return true
}

HandleDeath(shot, now) {
    ; Мы устранены: отпускаем управление, при живом отряде спокойно ждём финала
    ; или возрождения (Reboot Van), а когда отряд выбыл — переходим на итоги/в лобби.
    global CFG, SC, ST
    MacroPlayReset()
    ReleaseKeys()
    if (CFG.botMode = "antiafk" || CFG.botMode = "xp")
        return
    ST.wasDeadScene := true
    if (ST.tokenShown || ST.tokenFoundMatch) {
        ST.lastAction := "устранён · жетон защищён"
        return
    }
    ; Проверяем живых союзников в HUD раз в 4 с: пока отряд играет, они открывают
    ; сундуки и могут возродить нас — выходить в лобби преждевременно невыгодно.
    if (CFG.waitSquadOnDeath && now - ST.spectateSquadAt >= 4000) {
        ST.spectateSquadAt := now
        sq := SquadScanHud(shot)
        ST.spectateAlive := sq.count
    }
    elapsed := (ST.deadSince > 0) ? (now - ST.deadSince) : 0
    if (CFG.waitSquadOnDeath && ST.spectateAlive > 0 && elapsed < 1500000) {
        ST.lastAction := "наблюдение (" ST.spectateAlive " союзн.)"
        LogThrottledKey("[specwait]", "[i] Наблюдение за отрядом: в строю " ST.spectateAlive
            . " союзн. — жду возрождения или финала матча (" Round(elapsed / 1000) " с).", 15000)
        return
    }
    if (elapsed < CFG.deathEscMs)
        return
    ; Долгое наблюдение без живых союзников: выходим в лобби
    if !Throttle()
        return
    if (CFG.botMode = "queue" && MenuClickPossible()) {
        Log("[!] Экран смерти/наблюдения " Round(elapsed / 1000) " с (отряд не виден) — запускаю выход в лобби.")
        ST.deadSince := now
        LeaveStart("долгое наблюдение после устранения", false)
        return
    }
    Log("[!] висим на экране смерти " Round(elapsed / 1000) " с — жму Esc")
    if !CFG.dryRun {
        hwnd := GetGameWindow()
        if (hwnd && (WinActive("ahk_id " hwnd) || BgInputActive()))
            TapKey(SC.esc, 100)
        else if (hwnd && CFG.smartRestore)
            RunMenuAction(hwnd, "Esc после устранения", () => TapKey(SC.esc, 100))
    }
    ST.deadSince := now
}

LogUnknownDiag(shot) {
    ; Раз в 4 секунды объясняем, почему сцена не распознана — иначе кажется,
    ; что бот «ничего не делает».
    global CFG, ST
    hb := HealthBars(shot)
    m := CachedMenu(shot)
    LogThrottledKey("[unknown]", "[?] сцена не распознана: полоса HP " hb.hp.run " px"
        . " · жёлтых кнопок " (m.lobbyY.Length + m.results.Length)
        . " · кремовая «Отменить» " (m.cream ? "да" : "нет")
        . " · затемнение " Round(m.dark, 2) " · ищу по правилам README"
        . " (F5 — подробная калибровка)")
}

HandleUnknown(shot, now) {
    ; UNKNOWN не подтверждает ни матч, ни нужную кнопку: не ходим и не кликаем.
    global ST
    if (ST.unknownSince = 0)
        ST.unknownSince := now
    LogThrottledKey("[unknownwait]", "[?] Экран не распознан " Round((now - ST.unknownSince) / 1000)
        . " с — не иду и не нажимаю вслепую; F7 покажет диагностику.", 10000)
    LogUnknownDiag(shot)
}

HandleMenu(shot, now) {
    global CFG, ST
    MacroPlayReset()
    ST.wasDeadScene := false
    if (CFG.botMode = "antiafk" || CFG.botMode = "xp" || !CFG.featAutoQueue)
        return
    if ST.tokenStopArmed {
        Log("[+] Возврат в лобби после находки жетона — останавливаю бота по настройке.")
        PlayAlertBeep(1040, 200)
        OnStop("жетон найден")
        return
    }
    if CheckSessionLimits(now, false)
        return
    ; Латч отмены выше любых обходов ограничений.
    if ST.cancelHold {
        LogThrottled("[=] возможная отмена подбора · жду игрока · «Продолжить» или F8")
        return
    }
    ; Настраиваемая пауза в лобби между матчами (для AFK-очереди).
    if (ST.lobbyCooldownUntil && now < ST.lobbyCooldownUntil) {
        rem := ST.lobbyCooldownUntil - now
        ST.lastAction := "пауза в лобби " FmtCountdown(rem)
        LogThrottledKey("[lobbydelay]", "[i] Пауза в лобби перед следующим матчем: осталось " FmtCountdown(rem), 6000)
        return
    }
    ST.lobbyCooldownUntil := 0
    ; Один ускоренный старт после возврата; остальные попытки ограничены.
    if (!ST.lobbyRequeue && ST.lastPlayAt && (now - ST.lastPlayAt < CFG.playMinGapMs)) {
        LogThrottledKey("[playgap]", "[i] «Играть» уже жали недавно — жду ещё "
            . Max(1, Round((CFG.playMinGapMs - (now - ST.lastPlayAt)) / 1000)) " с")
        return
    }
    if (!ST.playSeenAt || now - ST.playSeenAt < CFG.lobbyStableMs) {
        seenMs := ST.playSeenAt ? now - ST.playSeenAt : 0
        LogThrottledKey("[lobbystable]", "[i] плашку «Играть» вижу " Round(seenMs / 1000, 1)
            . " с — проверяю стабильность (нужно "
            . Round(CFG.lobbyStableMs / 1000, 1) " с)")
        return
    }
    menuNow := CachedMenu(shot)
    box := menuNow.lobby ? menuNow.lobby : (menuNow.lobbyY.Length ? menuNow.lobbyY[menuNow.lobbyY.Length] : 0)
    if (!box || PlateKind(shot, box) != "play" || !ST.playSeenAt
        || now - ST.playSeenAt < CFG.playConfirmMs) {
        LogThrottledKey("[needplay]", "[?] Лобби возможно, но кнопка «Играть» не подтверждена — жду; F7 покажет состояние")
        return
    }
    ST.uiBoxCache := box, ST.uiBoxSeq := shot.captureId
    if (!ST.lobbyRequeue && ST.inMatchT && (now - ST.inMatchT < CFG.lobbyClickGuardMs)) {
        ST.guardStops += 1
        LogThrottledKey("[lobbyguard]", "[=] матч шёл " Round((now - ST.inMatchT) / 1000)
            . " с назад — «Играть» не жму (защита от случайного выхода)."
            . " Если это точно лобби — нажмите F8 дважды")
        return
    }
    if (ST.queueTries >= CFG.queueMaxTries) {
        if (now - ST.lastQueueT < CFG.queuePauseMs) {
            LogThrottled("[!] «Играть» нажато " ST.queueTries " раз, а очередь не началась — пауза "
                Round(CFG.queuePauseMs / 1000) " с")
            return
        }
        ST.queueTries := 0
    }
    if (!ST.lobbyRequeue && now - ST.lastQueueT < CFG.queueRetryMs)
        return
    ReleaseKeys()
    hwnd := GetGameWindow()
    if !MenuClickPossible(hwnd) {
        ST.lastQueueT := now
        ST.lastAction := "жду фокуса для «Играть»"
        LogThrottledKey("[bgqueue]", "[i] Игра не в фокусе — «Играть» не жму. Переключитесь в игру или включите «Умный фон» в настройках AFK.")
        return
    }
    ; В Умном фоне сначала звуковое предупреждение за preAlertMs, без списания Throttle.
    if !SmartAlertReady("lobby_play", "Играть", hwnd, now) {
        ST.lastAction := "сигнал перед «Играть»"
        return
    }
    if !Throttle()
        return
    ok := ClickMenuBox(shot, box, "Играть", "")
    if !ok {
        LogThrottledKey("[playnotclick]", "[!] Попытка «Играть» не выполнена — проверяю ввод")
        return
    }
    ST.lobbyRequeue := false
    ST.roundCounted := false
    ST.tokenFoundMatch := false
    ST.lastAction := "нажал «Играть»"
    Log("[>] Лобби: нажал «Играть» — жду подтверждения поиска")
    ST.lastQueueT := now
    ST.lastPlayAt := now
    ST.clickQueue += 1
    ST.queueTries += 1
    ST.mmSince := 0
}

; ============================================================================
;     v9.0: ВЫХОД ИЗ МАТЧА, ОТРЯД, АНТИ-АФК И ЛИМИТЫ СЕССИИ (ЧИСТЫЙ AHK v2)
; ============================================================================
RequestBypassMatch() {
    global CFG, ST
    if !ST.running {
        Flash("Сначала запустите бота (" CFG.hkStart ")", 2400)
        return
    }
    if ST.paused {
        Flash("Снимите паузу перед выходом из матча", 2400)
        return
    }
    if ST.leaveActive {
        Flash("Выход в лобби уже выполняется...", 2000)
        return
    }
    if (ST.state != "GAME" && ST.state != "DEATH") {
        Flash("Пропуск матча работает только в матче (сейчас: " StateRu(ST.state) ")", 2600)
        return
    }
    ST.bypassRequested := true
    Log("[>] Запрошен досрочный выход из матча в лобби (" CFG.hkBypass ").")
    Flash("Выхожу из матча в лобби...", 2400)
}

LeaveStart(reason, manual := false) {
    global CFG, ST
    if ST.leaveActive
        return true
    if (!manual && (ST.tokenShown || ST.tokenFoundMatch)) {
        LogThrottledKey("[leavetokblock]", "[!] В матче найден жетон — досрочный выход («" reason "») отменён!", 12000)
        return false
    }
    hwnd := GetGameWindow()
    if !MenuClickPossible(hwnd) {
        LogThrottledKey("[leavenofocus]", "[!] Пора выйти в лобби («" reason "»), но игра не в фокусе. Переключитесь в игру или включите «Умный фон».", 8000)
        return false
    }
    now := A_TickCount
    if (!manual && !SmartAlertReady("leave_match", "Выход в лобби", hwnd, now)) {
        ST.lastAction := "сигнал перед выходом"
        return true
    }
    SmartAlertClear("leave_match")
    AntiAfkReset()
    ReleaseKeysSafe()
    ST.bypassRequested := false
    ST.leaveActive := true
    ST.leaveStep := 1
    ST.leaveNextAt := now
    ST.leaveStartedAt := now
    ST.leaveReason := reason
    ST.leaveRetries := 0
    ST.leaveEpoch := ST.inputEpoch
    ST.leaveSavedHwnd := 0, ST.leaveSavedX := 0, ST.leaveSavedY := 0
    if (!CFG.dryRun && hwnd && !WinActive("ahk_id " hwnd) && CFG.smartRestore) {
        CoordMode("Mouse", "Screen")
        try ST.leaveSavedHwnd := WinActive("A")
                try {
                    MouseGetPos(&lmx, &lmy)
                    ST.leaveSavedX := lmx, ST.leaveSavedY := lmy
                }
        area := GetClientArea(hwnd)
        if area
            try DllCall("SetCursorPos", "Int", area.x + area.w // 2, "Int", area.y + area.h // 2, "Int")
        if !ForceActivateWindow(hwnd, 850) {
            Log("[!] Умный фон: не удалось активировать Fortnite для выхода из матча.")
            LeaveCancel(false)
            return false
        }
    }
    Log("[>] Выход в лобби: «" reason "» (шаг 1/4: Esc)")
    return true
}

LeaveCancel(logIt := true) {
    global ST
    if !ST.leaveActive
        return
    savedHwnd := ST.leaveSavedHwnd, sx := ST.leaveSavedX, sy := ST.leaveSavedY
    ST.leaveActive := false
    ST.leaveStep := 0
    ST.leaveNextAt := 0
    ST.leaveStartedAt := 0
    ST.leaveReason := ""
    ST.leaveRetries := 0
    ST.leaveSavedHwnd := 0, ST.leaveSavedX := 0, ST.leaveSavedY := 0
    SmartAlertClear("leave_match")
    if savedHwnd
        RestoreUserFocus(savedHwnd, sx, sy, GetGameWindow())
    if logIt
        Log("[i] Последовательность выхода в лобби отменена.")
}

LeaveFinish(reason) {
    global CFG, ST
    savedHwnd := ST.leaveSavedHwnd, sx := ST.leaveSavedX, sy := ST.leaveSavedY
    ST.leaveActive := false
    ST.leaveStep := 0
    ST.leaveNextAt := 0
    ST.leaveStartedAt := 0
    ST.leaveReason := ""
    ST.leaveRetries := 0
    ST.leaveSavedHwnd := 0, ST.leaveSavedX := 0, ST.leaveSavedY := 0
    if savedHwnd
        RestoreUserFocus(savedHwnd, sx, sy, GetGameWindow())
    RecordRoundCompleted(reason)
    ; Сбрасываем «память матча», чтобы по приходу в лобби не ждать 25 с lobbyClickGuardMs
    ; и не срабатывала защёлка отмены подбора.
    ST.inMatchT := 0
    ST.hudLastT := 0
    ST.lastHpSeenT := 0
    ST.matchStarted := false
    ST.matchFromQueue := false
    ST.queuePending := false
    ST.roundActive := true
    ST.lobbyRequeue := true
    ST.queueTries := 0
    if (CFG.lobbyDelaySec > 0)
        ST.lobbyCooldownUntil := A_TickCount + CFG.lobbyDelaySec * 1000
    ST.lastAction := "выхожу в лобби..."
    Log("[+] Команда выхода в лобби отправлена («" reason "») — жду загрузки лобби.")
    CheckSessionLimits(A_TickCount, false)
}

LeaveStep(shot, now) {
    ; Неблокирующий пошаговый выход: Esc -> вкладка Параметры -> Выйти в лобби
    ; -> подтверждение (если появилось). Координаты масштабируются под любое
    ; разрешение и привязаны к клиентской области на любом мониторе.
    global CFG, SC, ST
    if !ST.leaveActive
        return false
    if (!ST.running || ST.paused || ST.tickAbort || ST.inputEpoch != ST.leaveEpoch) {
        LeaveCancel(true)
        return false
    }
    ; Если уже оказались в лобби — завершаем сразу
    m := CachedMenu(shot)
    lb := m.lobby ? m.lobby : (m.lobbyY.Length ? m.lobbyY[m.lobbyY.Length] : 0)
    if (lb && PlateKind(shot, lb) = "play") {
        LeaveFinish(ST.leaveReason)
        return true
    }
    if (now < ST.leaveNextAt) {
        ST.lastAction := "выход в лобби (шаг " ST.leaveStep "/4)"
        return true
    }
    if (CFG.dryRun) {
        ox := shot.x + Round(CFG.optNormX * shot.w), oy := shot.y + Round(CFG.optNormY * shot.h)
        lx := shot.x + Round(CFG.leaveNormX * shot.w), ly := shot.y + Round(CFG.leaveNormY * shot.h)
        Log("[dry-run] Выход в лобби («" ST.leaveReason "»): Esc -> Параметры (" ox "," oy ") -> В лобби (" lx "," ly ")")
        LeaveFinish(ST.leaveReason " [dry-run]")
        return true
    }
    hwnd := GetGameWindow()
    if (!hwnd || !WinActive("ahk_id " hwnd)) {
        if (CFG.smartRestore && hwnd && ForceActivateWindow(hwnd, 650)) {
            ; восстановили фокус для завершения шага
        } else {
            Log("[!] Фокус игры потерян во время выхода в лобби — отменяю шаг.")
            LeaveCancel(false)
            return false
        }
    }
    reason := ST.leaveReason
    if (ST.leaveStep = 1) {
        ReleaseKeys()
        TapKey(SC.esc, 85)
        ST.leaveStep := 2
        ST.leaveNextAt := A_TickCount + Random(620, 780)
        ST.lastAction := "выход: открыл меню Esc"
        return true
    }
    if (ST.leaveStep = 2) {
        ; Вкладка бокового меню / выхода (1678,73 на 1080p · 2237,97 на 1440p · 3356,146 на 4K)
        ox := shot.x + Round(CFG.optNormX * shot.w) + (CFG.humanize ? Random(-3, 3) : 0)
        oy := shot.y + Round(CFG.optNormY * shot.h) + (CFG.humanize ? Random(-2, 2) : 0)
        ClickScreenMode(ox, oy, true)
        ST.leaveStep := 3
        ST.leaveNextAt := A_TickCount + Random(580, 740)
        ST.lastAction := "выход: открыл вкладку выхода"
        return true
    }
    if (ST.leaveStep = 3) {
        ; Сначала ищем реальную красную кнопку «Выйти в лобби» в правой панели,
        ; иначе жмём проверенные нормированные координаты (1556,173 на 1080p).
        redBtn := FindRedMenuButton(shot, CFG.regLeaveMenu)
        if redBtn {
            ST.uiBoxCache := redBtn, ST.uiBoxSeq := shot.captureId
            lx := shot.x + redBtn.cx + (CFG.humanize ? Random(-4, 4) : 0)
            ly := shot.y + redBtn.cy + (CFG.humanize ? Random(-2, 2) : 0)
            Log("[>] Выход в лобби: нашёл красную кнопку (" redBtn.cx "," redBtn.cy ") — жму")
        } else {
            lx := shot.x + Round(CFG.leaveNormX * shot.w) + (CFG.humanize ? Random(-4, 4) : 0)
            ly := shot.y + Round(CFG.leaveNormY * shot.h) + (CFG.humanize ? Random(-3, 3) : 0)
            Log("[>] Выход в лобби: жму точку выхода (" Round(lx - shot.x) "," Round(ly - shot.y) ")")
        }
        ClickScreenMode(lx, ly, true)
        ST.leaveStep := 4
        ST.leaveNextAt := A_TickCount + Random(680, 860)
        ST.lastAction := "выход: нажал «В лобби»"
        return true
    }
    if (ST.leaveStep = 4) {
        ; Проверяем диалог подтверждения («Да / Выйти») по центру, если режим его показал
        cfm := FindRedMenuButton(shot, CFG.regConfirmBtn)
        if !cfm {
            yl := FindYellowButtons(shot, CFG.regConfirmBtn)
            if yl.Length
                cfm := yl[1]
        }
        if !cfm
            cfm := FindLightPlateButton(shot, CFG.regConfirmBtn, 0.08, 0.28, 1.8, 7.5, false)
        if cfm {
            cx := shot.x + cfm.cx + (CFG.humanize ? Random(-3, 3) : 0)
            cy := shot.y + cfm.cy + (CFG.humanize ? Random(-2, 2) : 0)
            ClickScreenMode(cx, cy, true)
            Log("[>] Выход в лобби: подтвердил диалог выхода.")
            Sleep(120)
        } else if (InMatchHud(shot) && ST.leaveRetries < 1) {
            ; Меню Esc закрылось или не открылось — одна аккуратная повторная попытка
            ST.leaveRetries += 1
            ST.leaveStep := 1
            ST.leaveNextAt := A_TickCount + 500
            Log("[~] HUD матча всё ещё виден — повторяю выход в лобби (попытка 2/2).")
            return true
        }
        LeaveFinish(reason)
        return true
    }
    LeaveCancel(false)
    return false
}

CheckSquadAbandon(shot, now) {
    ; Авто-выход при пустом отряде (Squad Fill): проверяет HUD союзников по
    ; буферу кадра раз в squadCheckMs после squadGraceSec с момента приземления.
    global CFG, ST
    if (!CFG.squadAutoLeave || CFG.botMode = "antiafk" || CFG.botMode = "xp") {
        ST.squadStatus := "выкл"
        return false
    }
    if (ST.tokenShown || ST.tokenFoundMatch) {
        ST.squadStatus := "жетон (не выхожу)"
        ST.squadEmptyCount := 0
        return false
    }
    ; Не проверяем на острове ожидания, в автобусе и в полёте
    if (ST.phase = "prep" || ST.phase = "bus" || !InMatchHud(shot)) {
        ST.squadStatus := "ожидание высадки"
        return false
    }
    if !ST.groundAt
        ST.groundAt := now
    graceMs := Max(10, CFG.squadGraceSec) * 1000
    if (now - ST.groundAt < graceMs) {
        rem := Ceil((graceMs - (now - ST.groundAt)) / 1000)
        ST.squadStatus := "пауза " rem " с"
        return false
    }
    if (ST.squadCheckAt && now - ST.squadCheckAt < CFG.squadCheckMs)
        return false
    ST.squadCheckAt := now
    res := SquadScanHud(shot)
    if (res.count > 0) {
        ST.squadEverSeen := true
        if (ST.squadEmptyCount > 0)
            Log("[i] Отряд снова виден в HUD (" res.count " союзн.) — сброс счётчика выхода.")
        ST.squadEmptyCount := 0
        ST.squadStatus := res.count " союзн. в строю"
        return false
    }
    ST.squadEmptyCount += 1
    need := Max(2, CFG.squadEmptyNeed)
    ST.squadStatus := "пусто (" ST.squadEmptyCount "/" need ")"
    Log("[i] Проверка отряда: союзники в HUD не найдены (" ST.squadEmptyCount "/" need ")")
    if (ST.squadEmptyCount < need)
        return false
    ST.squadEmptyCount := 0
    ST.squadLeaves += 1
    Log("[!] Отряд пуст (" need " проверки подряд"
        . (ST.squadEverSeen ? "" : " · если играете Соло, выключите «Выход без отряда»")
        . ") — выхожу в лобби (всего выходов: " ST.squadLeaves ")")
    return LeaveStart("отряд покинул матч", false)
}

CheckMatchLeave(shot, now) {
    ; Единая проверка досрочного выхода из матча: ручной F4, таймер матча, пустой отряд.
    global CFG, ST
    if ST.leaveActive
        return LeaveStep(shot, now)
    if ST.bypassRequested
        return LeaveStart("ручной пропуск " CFG.hkBypass, true)
    if (CFG.botMode != "antiafk" && CFG.botMode != "xp" && CFG.matchMaxMin > 0 && ST.matchStartT > 0) {
        limitMs := Round(CFG.matchMaxMin * 60000)
        if (now - ST.matchStartT >= limitMs) {
            return LeaveStart("таймер матча " CFG.matchMaxMin " мин", false)
        }
    }
    if CheckSquadAbandon(shot, now)
        return true
    return false
}

AntiAfkReset() {
    global ST
    for k in ST.afkKeys
        try KeyUp(k)
    ST.afkKeys := []
    if ST.afkCrouched {
        try CrouchSet(false)
        ST.afkCrouched := false
    }
    SprintSet(false)
    ST.afkAct := ""
    ST.afkUntil := 0
    ST.afkSubAt := 0
    ST.afkSubStep := 0
}

AntiAfkTick(shot, now) {
    ; Неблокирующее «живое» движение для режимов «AFK-очередь» и «Только Анти-АФК»:
    ; ходьба, диагональ, стрейф, спринт с подкатом, парный присед, прыжок, смена
    ; предмета, плавный осмотр с ограничением вертикального угла и естественные паузы.
    global CFG, SC, ST
    if CFG.dryRun {
        ST.lastAction := "Анти-АФК (dry-run)"
        LogThrottledKey("[dryafk]", "[dry-run] Анти-АФК: выполнял бы живое движение", 8000)
        return
    }
    hwnd := GetGameWindow()
    if (!hwnd || (!WinActive("ahk_id " hwnd) && !BgInputActive())) {
        AntiAfkReset()
        ST.lastAction := CFG.smartRestore ? "умный фон: жду таймер / итоги" : "жду фокуса игры"
        return
    }
    ; Плавный микро-осмотр во время движения (только при активном окне, pitch в [-140..140])
    if (MouseAllowed() && ST.afkAct != "idle" && now - ST.afkLookAt >= Random(420, 760)) {
        ST.afkLookAt := now
        dx := Round(RndF(-26, 26))
        dy := Round(RndF(-10, 10))
        if (ST.afkPitch + dy > 140)
            dy := 140 - ST.afkPitch
        else if (ST.afkPitch + dy < -140)
            dy := -140 - ST.afkPitch
        if (Abs(dx) >= 3 || Abs(dy) >= 2) {
            if MouseSmooth(dx, dy)
                ST.afkPitch += dy
        }
    }
    ; Подшаг для спринта с подкатом (отпускаем подкат вовремя)
    if (ST.afkAct = "slide" && ST.afkSubStep = 1 && now >= ST.afkSubAt) {
        ST.afkSubStep := 2
        TapKey(SC.ctrl, 110)
        ST.lastAction := "Анти-АФК: подкат"
    }
    if (now < ST.afkUntil)
        return

    ; Завершаем предыдущее микро-действие чисто (присед всегда возвращаем в стоя)
    AntiAfkReset()

    roll := Random(1, 100)
    if (roll <= 24) {
        ST.afkAct := "walk"
        if KeyDown(SC.w)
            ST.afkKeys := [SC.w]
        ST.afkUntil := now + Random(1300, 3100)
        ST.lastAction := "Анти-АФК: шаг вперёд"
    } else if (roll <= 38) {
        ST.afkAct := "slide"
        if KeyDown(SC.w)
            ST.afkKeys := [SC.w]
        SprintSet(true)
        ST.afkSubStep := 1
        ST.afkSubAt := now + Random(850, 1350)
        ST.afkUntil := now + Random(1850, 2900)
        ST.lastAction := "Анти-АФК: спринт"
    } else if (roll <= 52) {
        side := Random(0, 1) ? SC.a : SC.d
        ST.afkAct := "diag"
        keys := []
        if KeyDown(SC.w)
            keys.Push(SC.w)
        if KeyDown(side)
            keys.Push(side)
        ST.afkKeys := keys
        ST.afkUntil := now + Random(950, 2200)
        ST.lastAction := "Анти-АФК: диагональ"
    } else if (roll <= 64) {
        side := Random(0, 1) ? SC.a : SC.d
        ST.afkAct := "strafe"
        if KeyDown(side)
            ST.afkKeys := [side]
        ST.afkUntil := now + Random(650, 1500)
        ST.lastAction := "Анти-АФК: стрейф"
    } else if (roll <= 71) {
        ST.afkAct := "back"
        if KeyDown(SC.s)
            ST.afkKeys := [SC.s]
        ST.afkUntil := now + Random(500, 1050)
        ST.lastAction := "Анти-АФК: шаг назад"
    } else if (roll <= 79) {
        ST.afkAct := "crouch"
        CrouchSet(true)
        ST.afkCrouched := true
        ST.afkUntil := now + Random(650, 1350)
        ST.lastAction := "Анти-АФК: присед"
    } else if (roll <= 85) {
        ST.afkAct := "jump"
        TapKey(SC.space, 85)
        ST.afkUntil := now + Random(700, 1250)
        ST.lastAction := "Анти-АФК: прыжок"
    } else if (roll <= 90) {
        ST.afkAct := "swap"
        TapKey(Random(0, 1) ? SC.q : SlotKey(1), 75)
        ST.afkUntil := now + Random(600, 1100)
        ST.lastAction := "Анти-АФК: смена слота"
    } else if (roll <= 95 && MouseAllowed()) {
        ST.afkAct := "look"
        dx := (Random(0, 1) ? 1 : -1) * Round(RndF(55, 145))
        dy := Round(RndF(-22, 22))
        dy := Clamp(dy, -140 - ST.afkPitch, 140 - ST.afkPitch)
        if MouseSmooth(dx, dy)
            ST.afkPitch += dy
        ST.afkUntil := now + Random(750, 1400)
        ST.lastAction := "Анти-АФК: осмотр"
    } else {
        ST.afkAct := "idle"
        ST.afkUntil := now + Random(1200, 3200)
        ST.lastAction := "Анти-АФК: пауза"
    }
}

HandleQueueGame(shot, now) {
    ; Поведение в матче для режима «AFK-очередь»:
    ;  1) проверяем досрочный выход (F4 / таймер матча / пустой отряд);
    ;  2) проходим предматч, прыжок из автобуса и раскрытие глайдера;
    ;  3) если у прицела появилась плашка [E] (сундук/тайник) — открываем;
    ;  4) выполняем живое движение Анти-АФК (или спокойно ждём таймера).
    global CFG, ST
    ST.inMatchT := now
    if CheckMatchLeave(shot, now)
        return
    if MatchPhase(shot, now)
        return
    if !ST.groundAt
        ST.groundAt := now
    if (CFG.featChest && (WinActive("ahk_id " ST.hwnd) || BgInputActive())) {
        if TryInteract(shot, now) {
            ST.lastAction := "AFK: взаимодействие (E)"
            return
        }
    }
    if (CFG.macroInQueue && ST.macroEvents.Length > 0) {
        if MacroPlayTick(now)
            return
    }
    if CFG.queueAntiAfk {
        AntiAfkTick(shot, now)
        return
    }
    if (HeldCount() > 0)
        ReleaseKeys()
    if (CFG.matchMaxMin > 0 && ST.matchStartT > 0) {
        rem := Max(0, Round(CFG.matchMaxMin * 60000) - (now - ST.matchStartT))
        ST.lastAction := "AFK: выход через " FmtCountdown(rem)
    } else {
        ST.lastAction := "AFK: ожидание в матче"
    }
}

; ============================================================================
;   v10.0: ДВИЖОК AFK XP (LEGO / JAM STAGE / CREATIVE / ОБЛАКО) + МАРШРУТЫ
; ============================================================================
XpNextNudgeDelayMs() {
    global CFG
    ; Интервал с ±11% разбросом, жёстко ограничен <= 385 с (таймаут AFK XP = 420 с).
    baseSec := Clamp(CFG.xpNudgeSec, 30, 380)
    jittered := Clamp(baseSec * RndF(0.89, 1.11), 20, 385)
    return Round(jittered * 1000)
}

XpReleaseLmb() {
    global ST
    if ST.xpLmbHeld {
        try DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
        ST.xpLmbHeld := false
    }
}

XpStepAbort() {
    global ST
    if (ST.xpStepKey1 != "")
        try KeyUp(ST.xpStepKey1)
    if (ST.xpStepKey2 != "")
        try KeyUp(ST.xpStepKey2)
    ST.xpStepPhase := 0
    ST.xpStepKey1 := "", ST.xpStepKey2 := ""
    ST.xpStepDur := 0, ST.xpStepAt := 0
}

XpModeReset() {
    XpReleaseLmb()
    XpStepAbort()
}

; Плавная кривая Эрмита (smoothstep + синусоидальная дуга) с ТОЧНОЙ суммой шагов (dx, dy).
ZeroNetSmoothStep(dx, dy) {
    global CFG, ST
    dx := Round(dx), dy := Round(dy)
    if (dx = 0 && dy = 0)
        return {ok: true, sentX: 0, sentY: 0}
    steps := Random(9, 17)
    mag := Sqrt(dx * dx + dy * dy)
    arc := RndF(-0.32, 0.32) * mag
    px := -dy / mag, py := dx / mag
    prevX := 0, prevY := 0, sentX := 0, sentY := 0
    loop steps {
        if (!ST.running || ST.paused || ST.tickAbort || !MouseAllowed())
            return {ok: false, sentX: sentX, sentY: sentY}
        t := A_Index / steps
        ease := t * t * (3.0 - 2.0 * t)
        bow := Sin(3.14159265358979 * t) * arc
        curX := (A_Index = steps) ? dx : Round(dx * ease + px * bow)
        curY := (A_Index = steps) ? dy : Round(dy * ease + py * bow)
        sx := curX - prevX, sy := curY - prevY
        if (sx != 0 || sy != 0) {
            ST.cameraSeq += 1, ST.cameraAt := A_TickCount
            ST.cameraCmdX += sx, ST.cameraCmdY += sy
            DllCall("mouse_event", "UInt", 0x0001, "Int", sx, "Int", sy, "UInt", 0, "UPtr", 0)
            sentX += sx, sentY += sy
        }
        prevX := curX, prevY := curY
        Sleep(Random(7, 18))
    }
    return {ok: true, sentX: sentX, sentY: sentY}
}

; Осмотр камеры с нулевым итоговым смещением (сумма dx=0, dy=0):
; уходит по одной случайной дуге, делает живую паузу и возвращается по другой дуге.
ZeroNetCameraNudge() {
    global CFG, ST
    if !MouseAllowed()
        return false
    dist := Max(12, CFG.xpNudgePx) * RndF(0.65, 1.25)
    mode := Random(1, 3)
    ang := (mode = 1) ? 0.0 : ((mode = 2) ? 1.5707963 : RndF(0.25, 1.32))
    if Random(0, 1)
        ang += 3.14159265
    dx := Round(Cos(ang) * dist)
    dy := Round(Sin(ang) * dist * 0.45)
    if (dx = 0 && dy = 0)
        dx := Random(0, 1) ? 12 : -12
    ST.xpSynthUntil := A_TickCount + 2200
    out := ZeroNetSmoothStep(dx, dy)
    if !out.ok
        return false
    Sleep(Random(65, 290))
    if (!ST.running || ST.paused || ST.tickAbort || !MouseAllowed())
        return false
    ST.xpSynthUntil := A_TickCount + 1800
    back := ZeroNetSmoothStep(-out.sentX, -out.sentY)
    try {
        MouseGetPos(&xmx, &xmy)
        ST.xpLastCurX := xmx, ST.xpLastCurY := xmy
    }
    return back.ok
}

XpCheckManualMouse(now) {
    global ST
    if (now < ST.xpSynthUntil)
        return
    mx := 0, my := 0
    try MouseGetPos(&mx, &my)
    catch
        return
    if (ST.xpLastCurX != -99999) {
        if (Abs(mx - ST.xpLastCurX) >= 8 || Abs(my - ST.xpLastCurY) >= 8) {
            ST.xpNextNudgeAt := now + XpNextNudgeDelayMs()
            ST.xpManualResets += 1
        }
    }
    ST.xpLastCurX := mx, ST.xpLastCurY := my
}

XpModeTick(shot, now) {
    global CFG, SC, ST
    ; Таймер-напоминание о сборе монет XP (работает даже когда вы свернулись в браузер)
    if (CFG.coinRemindMin > 0) {
        if (ST.coinNextAt = 0)
            ST.coinNextAt := now + Round(CFG.coinRemindMin * 60000)
        else if (now >= ST.coinNextAt) {
            ST.coinAlerts += 1
            ST.coinNextAt := now + Round(CFG.coinRemindMin * 60000)
            PlayAlertBeep(880, 110)
            Sleep(35)
            PlayAlertBeep(1175, 150)
            Toast("XP-монеты!", "Пора собрать монеты / проверить карту (#" ST.coinAlerts ")", 5000)
            Log("[+] Напоминание AFK XP: пора собрать монеты / проверить карту (#" ST.coinAlerts ")")
        }
    }
    if !ST.xpNextNudgeAt
        ST.xpNextNudgeAt := now + XpNextNudgeDelayMs()
    if !ST.xpNextActAt
        ST.xpNextActAt := now + 1800

    if CFG.dryRun {
        nudgeRem := Max(0, ST.xpNextNudgeAt - now)
        ST.lastAction := "AFK XP [dry-run] · камера " FmtCountdown(nudgeRem)
        LogThrottledKey("[dryxp]", "[dry-run] AFK XP: «" XpActRu(CFG.xpAction)
            . "» · до сдвига камеры " FmtCountdown(nudgeRem), 8000)
        return
    }

    hwnd := GetGameWindow()
    if (!hwnd || !WinActive("ahk_id " hwnd) || AltTabGuardActive()) {
        XpModeReset()
        ST.xpLastCurX := -99999
        ST.lastAction := "AFK XP: пауза (не в фокусе)"
        return
    }

    XpCheckManualMouse(now)

    ; Подшаги симметричного возвратного шага (W->S или A->D с нулевым уходом с точки)
    if (ST.xpStepPhase = 1 && now >= ST.xpStepAt) {
        KeyUp(ST.xpStepKey1)
        ST.xpStepPhase := 2
        ST.xpStepAt := now + Random(120, 260)
        return
    }
    if (ST.xpStepPhase = 2 && now >= ST.xpStepAt) {
        KeyDown(ST.xpStepKey2)
        ST.xpStepPhase := 3
        ST.xpStepAt := now + ST.xpStepDur
        return
    }
    if (ST.xpStepPhase = 3 && now >= ST.xpStepAt) {
        KeyUp(ST.xpStepKey2)
        ST.xpStepPhase := 0
        ST.xpStepKey1 := "", ST.xpStepKey2 := ""
    }

    ; 1) Интервальное действие XP (удержание ЛКМ / клик / возвратный шаг / [E])
    act := CFG.xpAction
    if (act = "hold_lmb") {
        if (!ST.xpLmbHeld && MouseAllowed()) {
            ; При возврате фокуса даём чистый Up -> Down, чтобы игра точно приняла зажатие
            try DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
            Sleep(35)
            if MouseAllowed() {
                try DllCall("mouse_event", "UInt", 0x0002, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
                ST.xpLmbHeld := true
                ST.xpActions += 1
            }
        }
    } else {
        XpReleaseLmb()
        if (act != "nudge_only" && ST.xpStepPhase = 0 && now >= ST.xpNextActAt) {
            baseMs := Clamp(CFG.xpActionSec, 2, 300) * 1000
            ST.xpNextActAt := now + Round(baseMs * RndF(0.88, 1.14))
            if (act = "click" && MouseAllowed()) {
                ST.xpSynthUntil := now + 500
                try {
                    DllCall("mouse_event", "UInt", 0x0002, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
                    Sleep(Random(35, 75))
                    DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
                }
                ST.xpActions += 1
            } else if (act = "interact") {
                TapKey(SC.e, Random(55, 95))
                ST.xpActions += 1
            } else if (act = "move") {
                pick := Random(1, 100)
                if (pick <= 70) {
                    axis := Random(0, 1)
                    flip := Random(0, 1)
                    k1 := axis ? (flip ? SC.w : SC.s) : (flip ? SC.a : SC.d)
                    k2 := axis ? (flip ? SC.s : SC.w) : (flip ? SC.d : SC.a)
                    dur := Random(240, 520)
                    KeyDown(k1)
                    ST.xpStepKey1 := k1, ST.xpStepKey2 := k2
                    ST.xpStepDur := dur, ST.xpStepPhase := 1, ST.xpStepAt := now + dur
                } else if (pick <= 86) {
                    TapKey(SC.space, Random(65, 105))
                } else {
                    ; Парное нажатие приседа: присел и сразу встал
                    TapKey(SC.ctrl, 65)
                    Sleep(Random(130, 220))
                    TapKey(SC.ctrl, 65)
                }
                ST.xpActions += 1
            }
        }
    }

    ; 2) Периодический сдвиг камеры с нулевой суммой (обход 7-мин таймаута AFK XP)
    if (ST.xpStepPhase = 0 && now >= ST.xpNextNudgeAt && MouseAllowed()) {
        wasHeld := ST.xpLmbHeld
        if wasHeld
            XpReleaseLmb()
        if ZeroNetCameraNudge() {
            ST.xpNudges += 1
            LogThrottledKey("[xpnudge]", "[~] AFK XP: сдвиг камеры 0 px (#" ST.xpNudges
                . ") · действий " ST.xpActions, 10000)
        }
        if (wasHeld && ST.running && !ST.paused && !ST.tickAbort && MouseAllowed()) {
            Sleep(25)
            if MouseAllowed() {
                try DllCall("mouse_event", "UInt", 0x0002, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
                ST.xpLmbHeld := true
            }
        }
        ST.xpNextNudgeAt := A_TickCount + XpNextNudgeDelayMs()
    }

    nudgeLeft := Max(0, ST.xpNextNudgeAt - A_TickCount)
    ST.lastAction := "AFK XP · камера через " FmtCountdown(nudgeLeft)
}

; ---- Безопасный рекордер/плеер маршрута (macro.txt, стиль TinyTask) ---------
; Разрешены ТОЛЬКО игровые клавиши движения/взаимодействия; Esc/Alt/Win/F1..F12
; строго запрещены, чтобы запись никогда не вызвала выход, жалобу или сбой ОС.
MacroSafeKeyMap() {
    global SC
    static km := 0
    if !km {
        km := Map(
            "w", SC.w, "a", SC.a, "s", SC.s, "d", SC.d,
            "space", SC.space, "shift", SC.shift, "ctrl", SC.ctrl,
            "e", SC.e, "q", SC.q, "r", SC.r,
            "1", "sc002", "2", "sc003", "3", "sc004", "4", "sc005", "5", "sc006"
        )
    }
    return km
}

MacroPhysKeyName(name) {
    if (name = "shift")
        return "LShift"
    if (name = "ctrl")
        return "LCtrl"
    if (name = "space")
        return "Space"
    return StrUpper(name)
}

MacroSave() {
    global CFG, ST
    try {
        out := "# FORMA-MACRO v1`n"
        for ev in ST.macroEvents
            out .= ev.dt "|" ev.kind "|" ev.a "|" ev.b "`n"
        if FileExist(CFG.macroFile)
            FileDelete(CFG.macroFile)
        FileAppend(out, CFG.macroFile, "UTF-8")
        return true
    } catch as e {
        Log("[!] Не удалось сохранить macro.txt: " e.Message)
        return false
    }
}

MacroLoad() {
    global CFG, ST
    ST.macroEvents := []
    if !FileExist(CFG.macroFile)
        return 0
    km := MacroSafeKeyMap()
    try {
        raw := FileRead(CFG.macroFile, "UTF-8")
        for line in StrSplit(raw, "`n", "`r") {
            s := Trim(line)
            if (s = "" || SubStr(s, 1, 1) = "#")
                continue
            parts := StrSplit(s, "|")
            if (parts.Length < 3)
                continue
            dt := ParseNumSafe(parts[1], 0, 0, 30000, true)
            kind := StrLower(Trim(parts[2]))
            if (kind = "kd" || kind = "ku") {
                k := StrLower(Trim(parts[3]))
                if !km.Has(k)
                    continue
                ST.macroEvents.Push({dt: dt, kind: kind, a: k, b: 0})
            } else if (kind = "mv" && parts.Length >= 4) {
                dx := ParseNumSafe(parts[3], 0, -400, 400, true)
                dy := ParseNumSafe(parts[4], 0, -300, 300, true)
                if (dx != 0 || dy != 0)
                    ST.macroEvents.Push({dt: dt, kind: "mv", a: dx, b: dy})
            }
            if (ST.macroEvents.Length >= 2500)
                break
        }
    } catch {
        ST.macroEvents := []
    }
    return ST.macroEvents.Length
}

MacroStartRec(*) {
    global ST, UI
    if (ST.macroRec || ST.macroCountdown > 0) {
        MacroStopRec()
        return
    }
    if ST.running {
        Flash("Остановите бота перед записью маршрута", 2600)
        return
    }
    ST.macroCountdown := 3
    SetTimer(MacroRecCountdownTick, 1000)
    MacroRecCountdownTick()
}

MacroRecCountdownTick() {
    global ST, UI
    if (ST.macroCountdown > 0) {
        Flash("Запись маршрута через " ST.macroCountdown " с — перейдите в Fortnite!", 1100)
        try {
            if UI.extGui
                UI.extResult.Value := "Запись маршрута через " ST.macroCountdown " с..."
        }
        ST.macroCountdown -= 1
        return
    }
    SetTimer(MacroRecCountdownTick, 0)
    ST.macroEvents := []
    ST.macroPrevKeys := Map()
    ST.macroRecStart := A_TickCount
    ST.macroLastT := A_TickCount
    try {
        MouseGetPos(&mmx, &mmy)
        ST.macroLastCurX := mmx, ST.macroLastCurY := mmy
    }
    ST.macroRec := true
    PlayAlertBeep(1046, 120)
    Flash("● ЗАПИСЬ МАРШРУТА ИДЁТ (Esc — сохранить и остановить)", 2600)
    Log("[>] Запись маршрута начата (макс. 180 с / 2500 шагов; Esc — стоп).")
    SetTimer(MacroRecSampleTick, 45)
}

MacroRecSampleTick() {
    global ST
    if !ST.macroRec {
        SetTimer(MacroRecSampleTick, 0)
        return
    }
    now := A_TickCount
    if (now - ST.macroRecStart >= 180000 || ST.macroEvents.Length >= 2480) {
        MacroStopRec("достигнут лимит записи")
        return
    }
    hwnd := GetGameWindow()
    if (!hwnd || !WinActive("ahk_id " hwnd) || AltTabGuardActive())
        return
    km := MacroSafeKeyMap()
    for k, _ in km {
        down := false
        try down := !!GetKeyState(MacroPhysKeyName(k), "P")
        was := ST.macroPrevKeys.Has(k) ? ST.macroPrevKeys[k] : false
        if (down != was) {
            ST.macroPrevKeys[k] := down
            dt := Clamp(now - ST.macroLastT, 0, 30000)
            ST.macroLastT := now
            ST.macroEvents.Push({dt: dt, kind: down ? "kd" : "ku", a: k, b: 0})
        }
    }
    cx := 0, cy := 0
    try MouseGetPos(&cx, &cy)
    dx := Clamp(cx - ST.macroLastCurX, -400, 400)
    dy := Clamp(cy - ST.macroLastCurY, -300, 300)
    if (Abs(dx) >= 4 || Abs(dy) >= 4) {
        ST.macroLastCurX := cx, ST.macroLastCurY := cy
        dt := Clamp(now - ST.macroLastT, 0, 30000)
        ST.macroLastT := now
        ST.macroEvents.Push({dt: dt, kind: "mv", a: dx, b: dy})
    }
}

MacroStopRec(why := "") {
    global ST, UI
    SetTimer(MacroRecCountdownTick, 0)
    SetTimer(MacroRecSampleTick, 0)
    ST.macroCountdown := 0
    if !ST.macroRec
        return
    ST.macroRec := false
    ; Гарантированно закрываем все зажатые в конце записи клавиши событием ku
    for k, was in ST.macroPrevKeys {
        if was
            ST.macroEvents.Push({dt: 25, kind: "ku", a: k, b: 0})
    }
    ST.macroPrevKeys := Map()
    cnt := ST.macroEvents.Length
    saved := (cnt > 0) ? MacroSave() : false
    PlayAlertBeep(784, 140)
    msg := (cnt > 0 && saved)
        ? ("Маршрут сохранён в macro.txt (" cnt " шагов" (why != "" ? ", " why : "") ").")
        : "Запись остановлена (движений в окне игры не зафиксировано)."
    Log("[i] " msg)
    Flash(msg, 3500)
    SyncExtraFields()
    try {
        if UI.extGui
            UI.extResult.Value := msg
    }
}

MacroPlayReset() {
    global ST
    km := MacroSafeKeyMap()
    for k in ST.macroPlayHeld {
        if km.Has(k)
            try KeyUp(km[k])
    }
    ST.macroPlayHeld := []
    ST.macroPlayIdx := 0
    ST.macroPlayNextAt := 0
}

MacroPlayTick(now) {
    global CFG, ST
    total := ST.macroEvents.Length
    if (total <= 0)
        return false
    if CFG.dryRun {
        ST.lastAction := "маршрут [dry-run] (" total " шаг.)"
        return true
    }
    hwnd := GetGameWindow()
    if (!hwnd || (!WinActive("ahk_id " hwnd) && !BgInputActive()) || AltTabGuardActive()) {
        MacroPlayReset()
        ST.lastAction := "маршрут: жду фокуса"
        return true
    }
    if (ST.macroPlayIdx <= 0) {
        ST.macroPlayIdx := 1
        ST.macroPlayNextAt := now + ST.macroEvents[1].dt
    }
    km := MacroSafeKeyMap()
    stepsDone := 0
    while (ST.macroPlayIdx <= total && now >= ST.macroPlayNextAt && stepsDone < 6) {
        ev := ST.macroEvents[ST.macroPlayIdx]
        if (ev.kind = "kd" && km.Has(ev.a)) {
            KeyDown(km[ev.a])
            already := false
            for hk in ST.macroPlayHeld {
                if (hk = ev.a)
                    already := true
            }
            if !already
                ST.macroPlayHeld.Push(ev.a)
        } else if (ev.kind = "ku" && km.Has(ev.a)) {
            KeyUp(km[ev.a])
        } else if (ev.kind = "mv" && MouseAllowed()) {
            MouseSmooth(ev.a, ev.b)
        }
        ST.macroPlayIdx += 1
        stepsDone += 1
        if (ST.macroPlayIdx <= total) {
            ST.macroPlayNextAt := A_TickCount + ST.macroEvents[ST.macroPlayIdx].dt
        } else {
            ; Конец маршрута: отпускаем клавиши и перезапускаем после живой паузы
            MacroPlayReset()
            ST.macroLoops += 1
            ST.macroPlayIdx := 1
            ST.macroPlayNextAt := A_TickCount + Random(1200, 2800)
            break
        }
    }
    ST.lastAction := "маршрут " ST.macroPlayIdx "/" total " (круг " (ST.macroLoops + 1) ")"
    return true
}

CheckSessionLimits(now, inLiveMatch := false) {
    ; Таймер остановки сессии и лимит раундов (с опцией «Доиграть текущий матч»).
    global CFG, ST
    if !ST.running
        return false
    reason := ""
    if (!inLiveMatch && ST.finishMatchArmed) {
        reason := (ST.finishMatchReason != "") ? ST.finishMatchReason : "истёк таймер сессии (матч доигран)"
    }
    if (reason = "" && CFG.stopAfterMin > 0) {
        limSec := Round(CFG.stopAfterMin * 60)
        if (SessionElapsedSec() >= limSec) {
            if (inLiveMatch && CFG.finishMatch && (CFG.botMode = "auto" || CFG.botMode = "queue")) {
                if !ST.finishMatchArmed {
                    ST.finishMatchArmed := true
                    ST.finishMatchReason := "истёк таймер " CFG.stopAfterMin " мин (матч доигран)"
                    Log("[i] Таймер сессии (" CFG.stopAfterMin " мин) истёк — доигрываю текущий матч и остановлюсь в лобби.")
                    Flash("Таймер истёк — доигрываю этот матч до конца", 3800)
                }
                return false
            }
            reason := "истёк таймер сессии (" CFG.stopAfterMin " мин)"
        }
    }
    if (reason = "" && CFG.maxRounds > 0 && ST.rounds >= CFG.maxRounds)
        reason := "достигнут лимит раундов (" ST.rounds "/" CFG.maxRounds ")"
    if (reason = "")
        return false
    ST.finishMatchArmed := false, ST.finishMatchReason := ""
    Log("[===] Авто-стоп: " reason)
    PlayAlertBeep(784, 150)
    Sleep(40)
    PlayAlertBeep(1046, 200)
    action := CFG.stopAction
    OnStop(reason)
    if (action = "close_game" || action = "sleep_pc")
        StartStopActionCountdown(action)
    return true
}

StartStopActionCountdown(kind) {
    global CFG, ST
    ST.stopActionKind := kind
    ST.stopActionLeft := 15
    actRu := (kind = "close_game") ? "Закрытие Fortnite" : "Перевод ПК в сон"
    Log("[!] " actRu " через 15 с — нажмите " CFG.hkStart " или Esc для отмены!")
    SetTimer(StopActionTick, 1000)
    StopActionTick()
}

CancelStopAction() {
    global ST
    if (ST.stopActionKind = "")
        return
    SetTimer(StopActionTick, 0)
    actRu := (ST.stopActionKind = "close_game") ? "закрытие Fortnite" : "перевод ПК в сон"
    ST.stopActionKind := ""
    ST.stopActionLeft := 0
    Log("[i] Отменено отложенное действие: " actRu ".")
    Flash("Отменено: " actRu, 3000)
    UpdateStatus()
}

StopActionTick() {
    global CFG, ST
    if (ST.stopActionKind = "") {
        SetTimer(StopActionTick, 0)
        return
    }
    actRu := (ST.stopActionKind = "close_game") ? "Закрытие Fortnite" : "Сон ПК"
    if (ST.stopActionLeft > 0) {
        Flash("FORMA: " actRu " через " ST.stopActionLeft " с`nОтмена: " CFG.hkStart " или Esc", 1300)
        ST.stopActionLeft -= 1
        UpdateStatus()
        return
    }
    kind := ST.stopActionKind
    ST.stopActionKind := ""
    ST.stopActionLeft := 0
    SetTimer(StopActionTick, 0)
    UpdateKeepAwake(false)
    if (kind = "close_game") {
        hwnd := GetGameWindow()
        if (hwnd && !CFG.dryRun) {
            Log("[>] Таймер сессии: закрываю окно Fortnite (WinClose).")
            try WinClose("ahk_id " hwnd)
        } else {
            Log("[i] Таймер сессии: закрытие Fortnite пропущено (dry-run или окно уже закрыто).")
        }
    } else if (kind = "sleep_pc") {
        if !CFG.dryRun {
            Log("[>] Таймер сессии: перевожу компьютер в спящий режим.")
            try DllCall("PowrProf\SetSuspendState", "UInt", 0, "UInt", 0, "UInt", 0)
        } else {
            Log("[dry-run] Таймер сессии: перевёл бы ПК в спящий режим.")
        }
    }
    UpdateStatus()
}

HandleMatchmaking(shot, now) {
    ; Слепых Esc и кликов во время обычной очереди нет. Но если включён mmRecoverSec
    ; и поверх экрана подтверждено реальное модальное окно ошибки сети/подбора — закрываем его.
    global CFG, ST
    ReleaseKeys()
    elapsed := (ST.mmSince > 0) ? (now - ST.mmSince) : 0
    if (CFG.mmRecoverSec >= 90 && elapsed >= CFG.mmRecoverSec * 1000
        && !ST.tokenShown && now - ST.lastMmRecoverAt >= 45000) {
        errBtn := FindModalDismissButton(shot)
        if errBtn {
            ST.uiBoxCache := errBtn, ST.uiBoxSeq := shot.captureId
            if Throttle() && ClickMenuBox(shot, errBtn, "Закрыть ошибку поиска", "mm_recover") {
                ST.lastMmRecoverAt := now
                ST.lastClickT := now
                ST.mmRecoveries += 1
                ST.mmSince := 0, ST.mmEnterAt := 0
                ST.queuePending := false, ST.lobbyRequeue := true
                ST.lastAction := "закрыл ошибку очереди"
                Log("[>] Очередь: закрыл модальное окно ошибки подбора после "
                    . Round(elapsed / 1000) " с (всего: " ST.mmRecoveries ")")
                return
            }
        }
    }
    if (elapsed >= CFG.mmStuckMs)
        LogThrottledKey("[mmtimeout]", "[?] Поиск отображается уже " Round(elapsed / 1000)
            . " с. Модальной ошибки нет — спокойно жду подключения.", 30000)
}

; ============================================================================
;                            ПОВЕДЕНИЕ В МАТЧЕ
; ============================================================================
; Логика «как играют про» — то, что реально переносится на бота, который видит
; только цвета (по разборам игры Malibuca, Kiryache, Toose, Letw1k3, SwizzY):
;   1) сначала оружие, потом всё остальное (без оружия в бой не лезем);
;   2) материалы не копятся «на потом» — фармятся между боями;
;   3) под огнём и с низким HP — укрытие и отход, а не размен;
;   4) за киллами не гоняемся: бой дольше proFightMaxMs — уходим;
;   5) не угадываем «чужой бой» по одному кандидату и низкому HP;
;   6) автоматическое лечение приостановлено до распознавания предметов.
ProDecision(shot, now) {
    global CFG, ST, SC
    TraceStep("про-решения")
    if !CFG.featProStyle
        return false

    ; Один кандидат и низкий HP не доказывают, что это чужой бой.
    ; ---- 1) бой затянулся -> выходим из него ----
    ; v7.5: раньше «8 секунд в бою» считались от ПЕРВОГО кадра с врагом, и уход
    ; срабатывал даже когда враг стоял прямо перед нами: бот разворачивался и
    ; уходил вместо стрельбы (run-20.log: «бой идёт дольше 8 с — ухожу» восемь
    ; раз подряд при «враг да»). Теперь уходим, только если бой не складывается:
    ; нас сильно пробили.
    if ST.enemy {
        if !ST.engageAt
            ST.engageAt := now
        fightBad := ((ST.hpPercent >= 0) && (ST.hpPercent < CFG.proRetreatHp))
        if ((now - ST.engageAt > CFG.proFightMaxMs) && fightBad) {
            ST.engageAt := 0
            Log("[i] бой идёт дольше " Round(CFG.proFightMaxMs / 1000) " с и HP "
                . ST.hpPercent "% — отхожу (как делают про)")
            StopMove()
            TurnBy((Random(0, 1) ? 1 : -1) * RndF(360, 480), 0, 520)
            KeyDown(SC.w)
            if (Random(0, 99) < 60)
                SprintSet(true)
            SleepC(Random(900, 1400))
            ReleaseKeys()
            ST.segUntil := 0
            ST.damagedAt := 0
            return true
        }
    } else
        ST.engageAt := 0, ST.enemyHits := 0
    ; врага видно, HP в порядке, только что стреляли -> из боя не выходим
    if (ST.enemy && (now - ST.combatAt < 1200))
        return false

    ; ---- 2) нас бьют, а HP низкий -> укрытие и отход ----
    if ((now - ST.damagedAt < 3000) && (ST.hpPercent >= 0) && (ST.hpPercent < CFG.proRetreatHp)) {
        if (now - ST.retreatAt > 5000) {
            ST.retreatAt := now
            Log("[!] HP " ST.hpPercent "% под огнём — ухожу в укрытие")
            StopMove()
            if (CFG.zeroBuild) {
                ; Zero Build: строить нельзя, укрытием служит рельеф и стрейф.
                ; Раньше в этом режиме бот жал клавишу постройки и тратил
                ; полсекунды на стену, которой не будет.
                LogThrottledKey("[zerobuild]", "[i] Zero Build: стену не ставлю —"
                    . " ухожу за естественное укрытие (стрейф/прыжок)")
            } else if (CFG.featCover && CFG.buildWall != "" && !CFG.dryRun) {
                TapKey(CFG.buildWall, 70)
                Sleep(Random(140, 240))
                if !MouseDown("стена укрытия") {
                    LogThrottledKey("[bgcover]", "[i] фон-режим: стену мышью не поставить — убегаю")
                } else {
                    Sleep(90)
                    MouseUp()
                }
                ST.coverCount += 1
                Log("[+] Поставил стену укрытия (всего " ST.coverCount ")")
            } else if (CFG.featCover) {
                Log("[dry-run] поставил бы стену (" (CFG.buildWall = "" ? "клавиша не задана" : CFG.buildWall) ")")
            }
            TurnBy((Random(0, 1) ? 1 : -1) * RndF(300, 420), 0, 520)
            KeyDown(SC.s)
            SleepC(Random(700, 1100))
            KeyUp(SC.s)
            ST.segUntil := 0
            return true
        }
    }

    ; Лечение только через TryHeal: неизвестный слот может быть оружием.
    return false
}

; Отстрел по факту урона. Полоска HP противника распознаётся только цветом и
; подводит (в run-4.log «враг» находился даже в пустой комнате), поэтому есть
; второй, независимый путь: если наш HP упал — значит по нам стреляют. Тогда
; разворачиваемся на метку звука и даём очередь.
FightBack(shot, now) {
    global CFG, SC, ST
    if (!CFG.featFightBack || !CFG.featCombat || CFG.teamSafe)
        return false
    if (ST.hpPercent < 0)
        return false
    if (!ST.damagedAt || now - ST.damagedAt > CFG.fightBackMs)
        return false

    arc := FindIncomingHitArc(shot)
    if arc {
        ST.inHitAngle := arc.angleDeg, ST.inHitAt := now
        if (Abs(arc.angleDeg) > 12 && (now - ST.lastAimT >= CFG.aimIntervalMs)) {
            ST.lastAimT := now
            TurnBy(Clamp(arc.angleDeg * 2.2, -CFG.turnMaxPx, CFG.turnMaxPx), 0, CFG.turnMaxPx)
        }
        return true
    }
    mark := CachedSound(shot)
    if !mark
        return false
    dx := mark.x - shot.w / 2
    if (Abs(dx) > 12 && (now - ST.lastAimT >= CFG.aimIntervalMs)) {
        ST.lastAimT := now
        TurnBy(Clamp(dx * CFG.aimGain, -CFG.aimStepPx, CFG.aimStepPx), 0, CFG.aimStepPx)
    }
    ; Звук не является целью; очередь разрешает только Combat на свежем кадре.
    return true
}

; Эпизоды матча. В логе run-4.log бот «выпадал» из МАТЧ в ОЖИДАНИЕ на
; каждом кадре автобуса и глайдера (полосы HP там нет), потому что весь матч
; считался только по полосе здоровья. Здесь это исправлено: матч продолжается
; hpSeenWindowMs даже без HUD, а поведение зависит от эпизода матча.
MatchPhase(shot, now) {
    ; Эпизоды матча. В run-8.log бот на загрузке сразу решил «мы на земле» и
    ; побежал вперёд по острову ожидания — потому что HUD там уже виден.
    ; Теперь порядок жёсткий: ПРЕДМАТЧ (стоим) -> АВТОБУС/ПОЛЁТ -> ЗЕМЛЯ.
    global CFG, SC, ST
    inHud := InMatchHud(shot)
    if inHud
        ST.lastHpSeenT := now

    if (ST.phase = "") {
        ; Остров ожидания бывает только тогда, когда матч нашёл сам бот.
        ; Если скрипт запустили, когда игрок уже играет, стоять бессмысленно.
        if ST.matchFromQueue {
            ST.phase := "prep"
            ST.prepAt := now
            Log("[i] эпизод: предматч (загрузка / остров ожидания) — стою на месте")
        } else {
            ST.phase := "loot"
            Log("[i] эпизод: мы уже в матче — сразу собираю лут")
        }
        ST.phaseAt := now
    }

    ; ---- 1) ПРЕДМАТЧ: не двигаемся вообще ----
    if (ST.phase = "prep") {
        ReleaseKeys()
        ST.lastAction := "предматч: жду автобус"
        ; HUD пропал — началась загрузка матча или автобус
        if !inHud {
            ST.phase := "bus"
            ST.phaseAt := now
            ST.busAt := now
            ST.busJumped := false
            ST.glideDeploys := 0
            Log("[i] эпизод: автобус / загрузка — дальше прыжок из автобуса")
            return true
        }
        ; уже на земле? run-16.log: бот решал «мы на земле» по яркости панели
        ; слотов — а в пиратском лобби она ЯРЧЕ, чем в матче (0.94 против 0.04).
        ; Теперь панель слотов считается признаком ТОЛЬКО вместе с полосой HP:
        ; одна яркость панели больше ничего не значит.
        if (ST.hudSlots >= CFG.prepSlotsMin && inHud) {
            ST.phase := "loot"
            ST.phaseAt := now
            Log("[i] полоса HP + панель слотов — мы на земле, собираю лут")
            return false
        }
        if (inHud && (CachedChest(shot) || CachedLoot(shot))) {
            ST.phase := "loot"
            ST.phaseAt := now
            Log("[i] вижу лут рядом — значит мы на земле, собираю")
            return false
        }
        ; страховка: слишком долго «предматч»
        if (now - ST.prepAt > CFG.prepMaxMs) {
            ST.phase := "loot"
            ST.phaseAt := now
            Log("[!] " Round(CFG.prepMaxMs / 1000) " с в предматче — считаю, что мы на земле")
            return false
        }
        LogThrottledKey("[prep]", "[i] предматч: стою, клавиши не жму ("
            . Round((now - ST.prepAt) / 1000) " с) · слоты "
            . Round(ST.hudSlots * 1000) / 1000 . " · порог «уже на земле» "
            . CFG.prepSlotsMin)
        return true
    }

    ; ---- 2) АВТОБУС И ПОЛЁТ ----
    if (ST.phase = "bus") {
        ; прыжок отсчитывается от начала автобуса, а не от старта матча
        if (CFG.featBusJump && !ST.busJumped && (now - ST.busAt >= CFG.busJumpMs)) {
            ST.busJumped := true
            ST.lastJumpT := now
            Log("[~] автобус: прыгаю (Пробел)")
            if !CFG.dryRun
                TapKey(SC.space, 110)
        }
        ; Не повторяем слепое переключение. Даже одна попытка может закрыть
        ; уже открытый глайдер; отсутствие HUD не доказывает состояние полёта.
        glideFrom := ST.lastGlideAt ? ST.lastGlideAt : ST.lastJumpT
        glideWait := (ST.glidePresses = 0) ? CFG.glideDeployMs : CFG.glideRepressMs
        if (ST.busJumped && !CFG.dryRun && !inHud && glideFrom
            && (now - glideFrom >= glideWait)
            && (ST.glidePresses < CFG.glideMaxPresses)) {
            ST.glidePresses += 1
            ST.lastGlideAt := now
            ST.glideDeploys += 1
            ST.lastJumpT := now
            TapKey(SC.space, 100)
            ; пишем не каждое нажатие, а первое и далее каждое третье
            if (ST.glidePresses = 1 || Mod(ST.glidePresses, 3) = 0)
                Log("[~] глайдер: попытка Пробел (" ST.glidePresses
                    . ") — состояние и раскрытие не подтверждены")
        }
        if (CFG.glideHoldW && !ST.held.Has(SC.w) && !CFG.dryRun)
            KeyDown(SC.w)            ; в полёте летим вперёд
        ST.lastAction := ST.busJumped ? "полёт: держу W" : "в автобусе"
        ; HUD появился — мы на земле
        if inHud {
            ST.phase := "loot"
            ST.phaseAt := now
            ST.glidePresses := 0
            ST.glideDeploys := 0
            ST.lastGlideAt := 0
            Log("[i] приземлились — собираю лут")
            return false
        }
        if (now - ST.phaseAt > CFG.airMaxMs) {
            ST.phase := "loot"
            ST.phaseAt := now
            Log("[!] за " Round(CFG.airMaxMs / 1000) " с HUD не появился — считаю, что мы на земле")
        }
        ST.inMatchT := now            ; автобус/глайдер — матч точно идёт
        ST.segUntil := now + 400
        return true
    }

    ; ---- 3) НА ЗЕМЛЕ ----
    ; ВАЖНО: в фазе лута ничего не блокируем — обычный обход как раз и
    ; собирает сундуки и оружие. Фаза нужна только для журнала и для того,
    ; и не включает слепые удары киркой.
    if (ST.phase = "loot" && (now - ST.phaseAt >= CFG.lootPhaseMs)) {
        ST.phase := "roam"
        ST.phaseAt := now
        Log("[i] эпизод: обычный обход")
    }
    return false
}

; Инвентарь 1..5; Q — отдельная кирка. Автовыбор пробует 1..4 по
; просьбе пользователя, хотя в 4 может оказаться лечение; 5 не пробует. Клавиша слота не
; подтверждает, что в нём оружие или что игра приняла нажатие.
EnsureWeapon(now) {
    global CFG, ST
    if (!CFG.featWeaponPick || CFG.dryRun)
        return
    inCombat := ST.enemy && (now - ST.lastFire > 1200)
    if (ST.loots != ST.weaponLootMark) {
        ST.weaponLootMark := ST.loots
        ST.weaponTries := 0
        ST.firstSlotDone := false
    }
    if (now - ST.lastWeaponT < CFG.weaponSlotGapMs)
        return
    ; Слот 1 не пропускаем из-за яркости HUD: яркая панель не доказывает,
    ; что в руках именно оружие. На первой попытке не подтверждаем наличие.
    if (CFG.featFirstSlot && !ST.firstSlotDone) {
        ST.firstSlotDone := true
        ST.weaponTries := 1
        ST.lastWeaponT := now
        TapKey(SlotKey(1), 80)
        Log("[i] попытка выбрать слот 1; наличие оружия не подтверждено")
        return
    }
    if (ST.hudSlots >= CFG.weaponHaveMin && !inCombat)
        return
    if (ST.weaponTries >= CFG.weaponCycleMax) {
        if (now - ST.lastWeaponT < CFG.weaponRetryMs)
            return
        ST.weaponTries := 0
        LogThrottledKey("[weapretry]", "[i] повторно пробую слоты 1–4;"
            . " содержимое слотов не подтверждено")
    }
    ST.weaponTries += 1
    ST.lastWeaponT := now
    slot := ST.weaponTries
    if (slot > CFG.weaponCycleMax)
        return
    TapKey(SlotKey(slot), 80)
    Log("[~] попытка выбрать слот " slot "/" CFG.weaponCycleMax
        . " — наличие оружия не подтверждено")
}

Roam(shot, now) {
    global CFG, SC, ST

    ; ---- эпизод матча (автобус/глайдер/посадка) ----
    if MatchPhase(shot, now) {
        if (ST.stuckRecoverKey != "")
            KeyUp(ST.stuckRecoverKey)
        ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
        ResetMoveWatch()
        return
    }

    ; ---- оружие в руки (на острове ожидания и в автобусе — не надо) ----
    if (ST.phase != "prep" && ST.phase != "bus")
        EnsureWeapon(now)

    ; ---- бой: только наведение и огонь, движение не отбирает ----
    if (CFG.featCombat)
        Combat(shot, now)
    else
        ST.enemy := 0
    ; Наведение изменило перспективу: ни лут, ни звук, ни обход не должны
    ; принимать решения по координатам кадра до поворота. Следующий тик
    ; снимет новый кадр; это также не даёт поиску лута перебивать наводку.
    if (ST.cameraSeq != shot.cameraSeqAtCapture) {
        ST.lastAction := "камера повернулась: жду новый кадр"
        return
    }
    if (ST.enemy && ST.stuckRecoverKey != "") {
        KeyUp(ST.stuckRecoverKey)
        ST.stuckRecoverKey := "", ST.stuckRecoverUntil := 0
        ResetMoveWatch()
    }

    ; ---- про-решения: выйти из затяжного боя, укрытие, хил после боя ----
    if ProDecision(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "решение по обстановке"
        return
    }
    if (!ST.enemy) {
        TacticalReloadTick(now, false)
        CheckStormAndZone(shot, now)
        if PostChestLootTick(shot, now) {
            ST.lastChangeT := now
            return
        }
        if SeekChestBySound(shot, now) {
            ST.lastChangeT := now
            return
        }
        SteerOpenSpace(shot, now)
        LevelHorizonStep(now)
    }

    ; ---- v7.5: ВРАГ ГЛАВНЕЕ СУНДУКА ----
    ; Раньше цепочка ниже (сундук -> лут -> кирка) разворачивала камеру к
    ; сундуку КАЖДЫЙ тик и перебивала наведение: бот «видел» врага, но смотрел
    ; в ящик и не стрелял. Теперь, пока враг подтверждён и мы в бою, сбор,
    ; лут и кирка пропускаются — остаётся движение (обход/прыжки) и бой.
    if (CFG.combatOverLoot && ST.enemy && (A_TickCount - ST.combatAt < 1500)) {
        if (CFG.featMove && (!ST.combatBrakeUntil || A_TickCount >= ST.combatBrakeUntil)
            && !ST.held.Has(SC.w))
            KeyDown(SC.w)
        SmartMove(shot, A_TickCount)
        return
    }

    ; Оценка движения до выбора следующего действия, только в матче.
    if MoveWatch(shot, now)
        return

    ; ---- взаимодействие: сундук/предмет ----
    tChain := A_TickCount
    if TryInteract(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "сундук/предмет (E)"
        return
    } else if BreakObstacle(shot, now) {
        ST.lastChangeT := now
        ; Не начинать новый сегмент движения до свежего кадра проверки.
        return
    } else if TryHeal(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "лечусь"
    } else if FightBack(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "отстреливаюсь (по урону)"
    } else if SoundReact(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "реагирую на звук"
    } else if SeekLoot(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "иду к предмету"
    } else if TryHarvest(shot, now) {
        ST.lastChangeT := now
        ST.lastAction := "кирка"
    }
    TraceSlow("сбор/бой", tChain)

    ; ---- «водитель»: бег, прыжки через препятствия, подкат, присед ----
    tMove := A_TickCount
    SmartMove(shot, now)
    TraceSlow("вождение", tMove)

    ; Только что стреляли — на 200 мс замираем, чтобы отдача не уводила.
    if (now - ST.lastFire < 200)
        return

    ; ---- движение: НЕПРЕРЫВНЫЙ бег (v7.5) ----
    ; Раньше здесь на каждом отрезке вызывался StopMove(): бот отпускал W,
    ; «отдыхал» 60-350 мс и шёл снова. В игре это читается ровно как «ходит
    ; очень странно и часто останавливается спустя пару шагов» (run-20.log:
    ; StopMove/StartSegment по нескольку раз за 3 секунды, плюс прерывания).
    ; Теперь W держится постоянно; пауза — редкое событие (CFG.pauseChance),
    ; а смена отрезка только меняет темп и направление взгляда.
    if !CFG.featMove {
        if (HeldCount() > 0)
            StopMove()
        ST.lastAction := "движение выключено (галочка «Ходить»)"
        return
    }
    if (ST.pauseUntil && now < ST.pauseUntil) {
        ST.lastAction := "короткая пауза"
        ST.moveMode := "стою"
        return
    }
    if (ST.pauseUntil && now >= ST.pauseUntil) {
        ST.pauseUntil := 0
        ST.segUntil := 0
    }
    if (now >= ST.segUntil) {
        ; короткая пауза — только изредка (как человек, который осматривается)
        if (Random(0, 99) < CFG.pauseChance && HeldCount() > 0) {
            StopMove()
            ST.pauseUntil := now + Random(CFG.pauseMinMs, CFG.pauseMaxMs)
            ST.segUntil := 0
            ST.lastAction := "короткая пауза"
            ST.moveMode := "стою"
            return
        }
        if (HeldCount() > 0)
            RestartSegment()        ; W остаётся зажатой — идём дальше
        else
            StartSegment()
        ST.lastAction := "иду"
        ST.moveMode := ST.sprintOn ? "бегу" : "иду шагом"
        return
    }
    ; пока отрезок не истёк — держим W и медленно осматриваемся
    if (now - ST.lastScanT > 220) {
        ST.lastScanT := now
        MouseSmooth(Round(RndF(-9, 9)), 0)    ; плавный осмотр
    }
}


; ============================================================================
;                              ГЛАВНЫЙ ЦИКЛ
; ============================================================================
; Троттл по ПОСТОЯННОМУ ключу. Нужен там, где в текст сообщения подставляются
; меняющиеся числа (HP, затемнение): иначе каждая строка уникальна и защита
; не срабатывает — именно поэтому в run-4.log «сцена не распознана» сыпалась
; по десять раз в секунду.
LogThrottledKey(key, msg, ms := 4000) {
    global LogThrMap
    t := LogThrMap.Has(key) ? LogThrMap[key] : -999999
    if (A_TickCount - t < ms)
        return
    LogThrMap[key] := A_TickCount
    Log(msg)
}

LogThrottled(msg) {
    ; Раньше сравнивали только с ПОСЛЕДНЕЙ строкой журнала: любое другое
    ; сообщение между ними сбрасывало защиту, и одна и та же фраза сыпалась
    ; по несколько раз в секунду. Теперь у каждой строки свой таймер.
    global LogThrMap
    t := LogThrMap.Has(msg) ? LogThrMap[msg] : -999999
    if (A_TickCount - t < 5000)
        return
    LogThrMap[msg] := A_TickCount
    Log(msg)
}


; Сторож: если цикл перестал выполняться, это больше НЕ будет молчанием.
; В run-5.log после «СТАРТ» журнал замолкал на 33 секунды — ни строки, ни
; «пульса», и понять причину было нельзя. Теперь видно и в журнале, и глазами.
Watchdog() {
    global CFG, ST
    ; Во время подготовки F6 watchdog не должен перевооружать таймер тика.
    ; Но если внешний вызов застрял, не оставляем пользователя без сообщения.
    if ST.mouseCalActive {
        if (A_TickCount - ST.mouseCalStart > 4000)
            LogThrottledKey("[mousecalwait]", "[!] Тест мыши ещё не завершён: жду тик или захват. F8 — стоп.", 12000)
        return
    }

    ; ---- случай А0: бот ОСТАНОВЛЕН, а тик всё ещё держит флаг ----
    ; run-11.log: F8 «стоп» ставил просьбу прерваться, тик её не слышал (висел
    ; в блокирующем нажатии), и следующий Старт молча ничего не делал, потому
    ; что второй поток того же таймера AHK не запускает. Здесь защищать уже
    ; нечего — бот не работает, поэтому флаг забираем без долгого ожидания.
    if (!ST.running && ST.tickBusy && ST.tickAbort && ST.tickStart > 0
        && (A_TickCount - ST.tickStart > 2500)) {
        ST.tickOrphans += 1
        ST.tickOrphanAt := A_TickCount
        Log("[!] остановленный тик не отдал флаг за "
            . Round((A_TickCount - ST.tickStart) / 1000) " с (шаг: "
            . (ST.tickStep != "" ? ST.tickStep : "—") ") — забираю, Старт снова работает")
        try
            ReleaseKeysSafe()
        ST.tickBusy := false
        ST.tickStart := 0
        return
    }

    if !ST.running
        return

    ; ---- случай А: тик ВИСИТ (начался и не закончился) ----
    if ST.tickBusy {
        hung := A_TickCount - ST.tickStart

        ; ---- САМОВОССТАНОВЛЕНИЕ (run-16.log) ----
        ; Тик висел 6, 10, 14 ... 106 секунд, не реагируя ни на бюджет, ни на
        ; просьбу сторожа: в AHK поток, застрявший в блокирующем вызове, извне
        ; не убить. Зато можно перезапустить скрипт: Reload снимает ВСЕ его
        ; потоки. Флаг «бот играл» сохраняем — после перезагрузки он сам
        ; продолжит играть, и AFK не превращается в «стоим до утра».
        if (hung > CFG.tickReloadMs) {
            ST.selfHeal += 1
            Log("[!!] тик не выходит " Round(hung / 1000) " с (шаг: "
                . (ST.tickStep != "" ? ST.tickStep : "—") ") — перезапускаю скрипт"
                . " целиком (самовосстановление " ST.selfHeal ")")
            Toast("Самовосстановление", "перезапускаю скрипт — бот продолжит сам", 5000)
            try
                ReleaseKeysSafe()
            try
                ResumeFlagSet()
            Sleep(400)
            Reload()
            return
        }
        if (hung > 6000) {
            LogThrottledKey("[hang]", "[!] ТИК ВИСНЕТ " Round(hung / 1000) " с · действие: "
                . (ST.lastAction != "" ? ST.lastAction : "—")
                . " · шаг: " (ST.tickStep != "" ? ST.tickStep : "—")
                . " · сцена " StateRu(ST.state) " · отпускаю клавиши")
            Toast("Тик завис", ST.lastAction != "" ? ST.lastAction : "смотрите журнал", 3000)
            try
                ReleaseKeys()
        }
        ; run-7/run-8: раньше сторож только писал в журнал либо сбрасывал флаг
        ; снаружи — и бот оставался стоять, потому что старый поток тика жив,
        ; а второй поток того же таймера AHK не запускает. Теперь просим тик
        ; прерваться ИЗНУТРИ: TickCheck выбросит ошибку на ближайшей паузе.
        if (hung > CFG.tickHangAbortMs && !ST.tickAbort) {
            ST.tickAbort := true
            ST.tickHealPending := true
            ST.lastTickAt := A_TickCount
            Log("[!] тик висит " Round(hung / 1000) " с — прошу его прерваться"
                . " · спасений: " ST.tickHeals)
            Toast("Цикл завис — останавливаю тик", "если повторяется, нажмите F7", 3000)
            try
                ReleaseKeys()
        }
        return
    }

    ; ---- случай Б: таймер не вызывает тик ----
    busy := A_TickCount - ST.lastTickAt
    if (busy > 2500) {
        ; Переводим цикл на ЗАПАСНОЙ поток. Старый мог заблокироваться внутри
        ; DllCall — тогда его таймер уже не сработает никогда, а другой слот
        ; AHK запустит. Это и есть лечение «ЦИКЛ НЕ ВЫПОЛНЯЛСЯ» без перезапуска.
        n := ArmTickSlot(Mod(ST.tickSlot, 3) + 1)
        ST.stallRecover += 1
        LogThrottledKey("[wd]", "[!] ЦИКЛ НЕ ВЫПОЛНЯЛСЯ " Round(busy / 1000)
            . " с — перевёл на запасной поток " n " · сцена " StateRu(ST.state)
            . " · последний тик " Round(ST.tickMs) " мс · пропусков входа " ST.tickReentry
            . " · восстановлений " ST.stallRecover)
        Toast("Цикл стоял — перезапустил", "если повторяется, нажмите F7", 3000)
        ST.lastTickAt := A_TickCount
    }
}


; ----------------------------------------------------------------------------
; САМОВОССТАНОВЛЕНИЕ (run-16.log)
; Файл-флаг рядом с журналом: «до перезапуска бот играл». Скрипт, поднявшись,
; сам нажимает Старт, но только если окно игры уже найдено.
; ----------------------------------------------------------------------------
ResumeFlagFile() {
    global CFG
    return CFG.logFile ".resume"
}

ResumeFlagSet() {
    f := ResumeFlagFile()
    try
        FileAppend("1", f, "UTF-8")
}

ResumeFlagTake() {
    f := ResumeFlagFile()
    if !FileExist(f)
        return false
    try
        FileDelete(f)
    return true
}

AutoResume(expectedGen) {
    global ST
    if (ST.running || ST.startWorkers > 0 || ST.mouseCalActive || expectedGen != ST.startGeneration)
        return
    if A_IsSuspended
        return
    hwnd := GetGameWindow()
    if (expectedGen != ST.startGeneration)
        return
    if !hwnd {
        Log("[i] самовосстановление: окно игры пока не найдено — автозапуск отменён,"
            . " нажмите Старт сами")
        return
    }
    Log("[i] самовосстановление: продолжаю работу после перезапуска скрипта")
    if (expectedGen != ST.startGeneration)
        return
    Toast("FORMA", "продолжаю после самовосстановления", 3000)
    ; Даже если Stop прервал этот поток в журнале или GetGameWindow,
    ; ожидаемое поколение будет проверено атомарно внутри OnStart.
    OnStart(expectedGen)
}

Tick() {
    ; Обёртка нужна по четырём причинам:
    ;  1) ошибка внутри тика пишется в журнал, а не в скрытый диалог;
    ;  2) у тика есть бюджет времени, а сторож может попросить его прерваться
    ;     (ST.tickAbort) — проверяется в TickCheck;
    ;  3) «последнее действие» и длительность видны в F7 и у сторожа;
    ;  4) НОВОЕ (run-11.log): если тик застрял в блокирующем вызове и не вышел
    ;     по просьбе сторожа, флаг «тик работает» ЗАБИРАЕТСЯ принудительно.
    ;     У тика есть номер поколения: осиротевший старый поток не может ни
    ;     испортить уборку нового, ни запретить следующий цикл — он либо уже
    ;     мёртв, либо выйдет на ближайшей контрольной точке.
    global CFG, ST
    ; Отдельно от tickBusy: сторож может забрать флаг у зависшего потока,
    ; но это не означает, что поток действительно вернулся. Каждый вызов
    ; регистрируется до основного кода и снимается только в finally.
    prevCritical := Critical("On")
    ; Закрытие допуска и регистрация тика атомарны относительно F6.
    if ST.mouseCalActive {
        Critical(prevCritical)
        return
    }
    ST.tickLiveCount += 1
    Critical(prevCritical)
    try {
    if ST.tickBusy {
        hung := (ST.tickStart > 0) ? (A_TickCount - ST.tickStart) : 0
        hardLimit := CFG.tickHangAbortMs + CFG.tickHardResetMs
        if (ST.tickAbort && hung > hardLimit) {
            ST.tickOrphans += 1
            ST.tickOrphanAt := A_TickCount
            Log("[!!] тик не отдал управление " Round(hung / 1000) " с (шаг: "
                . (ST.tickStep != "" ? ST.tickStep : "—")
                . ") — забираю флаг, цикл продолжается"
                . " · поколение " ST.tickGen " -> " (ST.tickGen + 1)
                . " · таких случаев: " ST.tickOrphans)
            Toast("Зависший тик закрыт принудительно", "шаг: "
                . (ST.tickStep != "" ? ST.tickStep : "—"), 4000)
            try
                ReleaseKeysSafe()
            ST.tickBusy := false
            ST.tickStart := 0
        } else {
            ST.tickReentry += 1
            return                     ; предыдущий тик ещё не закончил — не наслаиваем
        }
    }
    gen := ST.tickGen + 1
    ST.tickGen := gen                  ; чей это тик: уборку делает только он
    ST.tickBusy := true
    ST.tickAbort := false
    ST.tickAborted := false
    ST.actCritical := 0, ST.actWhy := ""      ; v7.5: участок всегда начинается «с чистого листа»
    ST.tickStart := A_TickCount
    ST.lastTickAt := ST.tickStart
    ST.tickDeadline := ST.tickStart + CFG.tickBudgetMs
    ST.tickStep := "начало"
    ST.tickStepAt := ST.tickStart
    try
        TickBody()
    catch as e {
        if ST.tickAborted {
            ; v7.5: раньше здесь было ReleaseKeysSafe() — то есть при каждом
            ; прерывании бот ОТПУСКАЛ ВСЁ, включая W. Получалось «два шага,
            ; стоп, два шага, стоп». Теперь снимаем только стрельбу/прицел и
            ; одиночное нажатие, а ходьбу продолжаем со следующего тика.
            try
                AbortCleanup()
            LogThrottledKey("[tickabort]", "[i] тик перерос бюджет — снял стрельбу,"
                . " ходьбу НЕ отпускаю · действие: "
                . (ST.lastAction != "" ? ST.lastAction : "—"))
        }
        else
            LogFatal(e, "Return")
    }
    ; --- уборка текущего поколения; отдельно finally учтёт выход вызова ---
    ; Только если мы всё ещё текущее поколение: иначе тик уже «осиротели», и
    ; чужие флаги трогать нельзя (иначе новый тик потеряет свой tickBusy).
    if (ST.tickGen = gen) {
        ST.tickBusy := false
        ST.tickAbort := false
        ST.tickAborted := false
        ST.lastTickMs := A_TickCount - ST.tickStart
        ST.tickMs := ST.lastTickMs
        if (ST.lastTickMs > 2000)
            ST.tickLong += 1
        ; ---- АДАПТАЦИЯ ПОД МАШИНУ (реальное время) ----
        ; Если тики регулярно длинные, сканы слишком дорогие для этого ПК:
        ; огрубляем шаг (замечаем меньше мелкого, зато успеваем). Если тики
        ; снова быстрые — возвращаем точность. В журнале видно, что и почему.
        if (ST.lastTickMs > 350) {
            ST.slowTicks += 1, ST.fastTicks := 0
        } else if (ST.lastTickMs < CFG.tickTargetMs) {
            ST.fastTicks += 1, ST.slowTicks := 0
        }
        if (ST.slowTicks >= 3 && ST.stepBoost < CFG.stepBoostMax) {
            ST.stepBoost += 2, ST.slowTicks := 0
            Log("[i] тики долгие (" Round(ST.lastTickMs) " мс) — огрубляю сканы:"
                . " шаг +" ST.stepBoost ". Бот успевает реагировать, но видит мельче")
        }
        if (ST.fastTicks >= 30 && ST.stepBoost > 0) {
            ST.stepBoost -= 1, ST.fastTicks := 0
            Log("[i] тики быстрые — возвращаю точность сканов: шаг +" ST.stepBoost)
        }
        if ST.tickHealPending {
            ST.tickHealPending := false
            try
                ReleaseKeysSafe()
            ST.tickHeals += 1
            Log("[!] зависший тик спасён и закрыт (" ST.tickHeals ") — играю дальше")
        }
        ST.tickStep := ""
    }
    } finally {
        prevCritical := Critical("On")
        ST.tickLiveCount -= 1
        Critical(prevCritical)
    }
}

; ----------------------------------------------------------------------------
; ЗАПАСНЫЕ ПОТОКИ ЦИКЛА (run-13.log)
; AHK не запускает второй экземпляр той же функции таймера. Поэтому, если тик
; встал насмерть (заблокировался внутри DllCall/SendEvent), перезапуск таймера
; НЕ помогал: в журнале «ЦИКЛ НЕ ВЫПОЛНЯЛСЯ 6 с» повторялось до перезапуска
; скрипта. Но ДРУГУЮ функцию AHK запустить может. Отсюда три одинаковых слота:
; сторож переводит цикл на следующий, и работа продолжается.
; ----------------------------------------------------------------------------
TickSlot1() {
    Tick()
}

TickSlot2() {
    Tick()
}

TickSlot3() {
    Tick()
}

; ВАЖНО (run-15.log): здесь стояло `SetTimer(Func("TickSlot" n), CFG.loopMs)` —
; и на этой строке AHK падал с «Invalid base · Object.Call» при КАЖДОМ старте:
; кнопка «Старт» писала «=== СТАРТ ===» и не делала больше ничего, потому что
; цикл так и не заводился. Теперь ссылки на функции передаются напрямую —
; это единственный способ, который не зависит от поиска функции по имени.
ArmTickSlot(n) {
    global CFG, ST
    StopTickSlots()
    if (n < 1 || n > 3)
        n := 1
    ST.tickSlot := n
    try {
        if (n = 1)
            SetTimer(TickSlot1, CFG.loopMs)
        else if (n = 2)
            SetTimer(TickSlot2, CFG.loopMs)
        else
            SetTimer(TickSlot3, CFG.loopMs)
    } catch as e {
        Log("[!] не смог завести цикл через поток " n ": " e.Message
            . " — завожу напрямую, бот будет работать")
        return ArmTickFallback()
    }
    Log("[i] цикл заведён: поток " n " · шаг " CFG.loopMs " мс")
    return n
}

; Крайний случай: слоты почему-то не сработали. Лучше цикл напрямую, чем
; «кнопка Старт не работает».
ArmTickFallback() {
    global CFG, ST
    ST.tickSlot := 0
    SetTimer(Tick, CFG.loopMs)
    Log("[i] цикл заведён напрямую (без запасных потоков) — шаг " CFG.loopMs " мс")
    return 0
}

StopTickSlots() {
    SetTimer(TickSlot1, 0)
    SetTimer(TickSlot2, 0)
    SetTimer(TickSlot3, 0)
    SetTimer(Tick, 0)
}

; Где тик сейчас. Одна строка записи в ST — этого достаточно, чтобы в F7 и в
; сообщении сторожа было видно не «сундук/предмет (E)», а конкретный шаг.
; Имя намеренно TraceStep, а не Step: в AHK v2 регистр не важен, и локальная
; переменная «step» в пиксельных сканах перебила бы функцию.
; ДИАГНОСТИКА ВРЕМЕНИ (run-16.log). Тик вставал на шаге «обход матча», и по
; журналу нельзя было понять, какая ветка съела время: у шага было одно имя на
; весь обход. Теперь каждая тяжёлая ветка измеряется и, если она дольше
; slowBranchMs, попадает в журнал с именем.
TraceSlow(what, t0) {
    global CFG, ST
    d := A_TickCount - t0
    if (d < CFG.slowBranchMs)
        return
    LogThrottledKey("[slow:" what, "[i] медленная ветка «" what "» — " d
        . " мс · сцена " StateRu(ST.state) . " · действие "
        . (ST.lastAction != "" ? ST.lastAction : "—"))
}

TraceStep(where) {
    global ST
    ST.tickStep := where
    ST.tickStepAt := A_TickCount
}

; ----------------------------------------------------------------------------
; Окно игры ЖИВО? (run-11.log)
; После приземления игра на секунды замирает на загрузке. SendEvent в такое
; окно не возвращает управление: тик «исчезал» внутри нажатия, сторож писал
; «ТИК ВИСНЕТ», F8 не мог ничего сделать. Поэтому перед каждым нажатием окно
; спрашивается ПУСТЫМ сообщением с таймаутом: не ответило — клавиши не шлём.
; ----------------------------------------------------------------------------
GameResponsive() {
    global CFG, ST
    now := A_TickCount
    if (now - ST.respAt < 250)
        return ST.respOk
    ST.respAt := now
    hwnd := ST.hwnd
    if !hwnd
        hwnd := GetGameWindow()
    if !hwnd {
        ST.respOk := false
        return false
    }
    if ST.respNoProbe                     ; проверить нельзя — не мешаем работе
        return ST.respOk := true
    res := 0, err := 0
    try {
        out := 0
        ; 0x0002 = SMTO_ABORTIFHUNG: висящее окно не ждём вовсе
        res := DllCall("SendMessageTimeout", "Ptr", hwnd, "UInt", 0, "Ptr", 0, "Ptr", 0
            , "UInt", 0x0002, "UInt", Max(60, CFG.gameHangMs), "Ptr*", &out, "Ptr")
        err := A_LastError
    } catch {
        ST.respNoProbe := true
        ST.respOk := true
        return true
    }
    if (!res && err = 5) {
        ; ERROR_ACCESS_DENIED: игра с правами выше, чем у скрипта, и окно не
        ; пускает даже пустое сообщение. Тогда проверку отключаем совсем,
        ; иначе бот «замер бы навсегда» на ровном месте.
        ST.respNoProbe := true
        LogThrottledKey("[smto]", "[i] окно игры не пускает проверку отклика (разные"
            . " права). Работаю без неё: если бот изредка пропускает нажатие на"
            . " загрузке — это она. Надёжнее запускать скрипт от администратора.")
        ST.respOk := true
        return true
    }
    if res {
        if ST.gameHungAt {
            ; run-16.log: «игра снова отвечает (молчала 0 с)» — мусор. Пишем,
            ; только если игра молчала заметно.
            if (now - ST.gameHungAt >= 500)
                Log("[i] игра снова отвечает (молчала "
                    . Round((now - ST.gameHungAt) / 1000, 1) " с)")
            ST.gameHungAt := 0
        }
        ST.respOk := true
    } else {
        if !ST.gameHungAt
            ST.gameHungAt := now
        ST.respOk := false
    }
    return ST.respOk
}

; Контрольная точка. Вызывается там, где тик всё равно делает паузу
; (SleepC, TapKey, MouseSmooth, ожидание E) — то есть гарантированно
; в достижимом месте, и не тормозит тяжёлые пиксельные сканы.
TickCheck(where := "") {
    global ST, CFG, VIS
    if !ST.tickBusy
        return
    ; run-16.log: пока тик работал, ЛЮБОЙ хоткей (F7/F5/F4) падал в TickCheck —
    ; «ошибка в обработчике «захват (F7)»: тик прерван сторожем». Обработчик
    ; хоткея живёт своей короткой жизнью и прерывать его нечем и незачем.
    if ST.tickCheckMuted
        return

    ; v7.5: ОТДАТЬ ПРОЦЕССОР. AHK однопоточный: пока тик считает пиксели, таймер
    ; окна зрения не может выполниться — окно «зрения» и жило на 2-4 к/с при
    ; любом интервале таймера. Sleep(1) — точка, где AHK пускает другие потоки.
    if (VIS.on && (A_TickCount - ST.lastYieldAt >= CFG.scanYieldMs)) {
        ST.lastYieldAt := A_TickCount
        try Sleep(1)
    }

    if ST.tickAbort {
        ST.tickAborted := true
        ST.lastAction := "прерываюсь по просьбе сторожа (" (where != "" ? where : "точка") ")"
        throw Error("тик прерван сторожем · " (where != "" ? where : "точка"))
    }
    if (ST.tickDeadline && A_TickCount > ST.tickDeadline) {
        ; ---- v7.5: НЕ РВЁМ ДВИЖЕНИЕ НА СЕРЕДИНЕ ----
        ; run-20.log: «тик прерван по времени · действие было: плавный поворот»
        ; сыпалось каждые 2 секунды. Каждое прерывание отпускало W — персонаж
        ; останавливался через пару шагов, и это выглядело как «ходит очень
        ; странно». Теперь участки-действия (поворот, шаг, очередь) помечены
        ; BeginAction, и бюджет им даёт отсрочку CFG.tickGraceMs.
        if (ST.actCritical > 0 && (A_TickCount <= ST.tickDeadline + CFG.tickGraceMs)) {
            ST.budgetOver += 1
            return
        }
        ; даже в критическом участке выходить надо — но уже без «отпускания» ног
        ST.tickAborted := true
        ST.lastAction := "превысил бюджет времени (" (where != "" ? where : "точка") ")"
            . (ST.actCritical > 0 ? " · внутри действия «" ST.actWhy "»" : "")
        throw Error("тик работал " Round(A_TickCount - ST.tickStart) " мс — прерываю")
    }
}

; ---------------------------------------------------------------------------
; КРИТИЧЕСКИЕ УЧАСТКИ (v7.5)
; Действие, начатое человеком, доводится до конца: поворот камеры, шаг, очередь.
; Пока идёт такой участок, бюджет времени даёт отсрочку, а прерывание снимает
; только мышь и одиночные нажатия — НОГИ (W/A/S/D/Shift) остаются как были.
; Так персонаж больше не «дёргается» и не останавливается на ровном месте.
; ---------------------------------------------------------------------------
BeginAction(why) {
    global ST
    ST.actCritical += 1
    ST.actWhy := why
}

EndAction() {
    global ST
    if (ST.actCritical > 0)
        ST.actCritical -= 1
    if (ST.actCritical = 0)
        ST.actWhy := ""
}

; Уборка после прерывания: снимаем ТОЛЬКО стрельбу/прицел и одиночное нажатие.
; Клавиши движения НЕ отпускаем — иначе и получается «два шага и стоп».
AbortCleanup() {
    global ST
    ; ВАЖНО: если тик прервался ПОСРЕДИ действия, EndAction не успел вызваться.
    ; Сбросить счётчик здесь обязательно — иначе actCritical останется > 0 и
    ; бюджет больше никогда не сможет прервать тик (критический участок «навсегда»).
    ST.actCritical := 0
    ST.actWhy := ""
    if (ST.tapKey != "") {
        try KeyUp(ST.tapKey)
        ST.tapKey := ""
    }
    ; ЛКМ/ПКМ: прерванная очередь не должна остаться зажатой
    if !BgInputActive() {
        try DllCall("mouse_event", "UInt", 0x0004, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
        try DllCall("mouse_event", "UInt", 0x0010, "Int", 0, "Int", 0, "UInt", 0, "UPtr", 0)
    }
    ST.adsOn := false
}

; ----------------------------------------------------------------------------
; УСТОЙЧИВОСТЬ СЦЕНЫ (run-17.log — главная причина «в матче зависал»)
; В журнале сцена менялась 20+ раз за 15 секунд:
;   МАТЧ -> ПОИСК МАТЧА -> МАТЧ -> ПОИСК МАТЧА ...
; И на КАЖДОМ переходе бот отпускал клавиши и сбрасывал кэши — то есть в
; матче он ровно ничего не делал. Причина: детектор решает по одному кадру,
; а полоса HP дрожит (0…92 px вместо 200).
; Теперь решение принимается с «памятью»:
;   * МАТЧ нельзя покинуть, пока HUD пропадал меньше CFG.hudLostMs;
;   * в слабую сцену (ЛОББИ/ПОИСК/ОЖИДАНИЕ) переходим, только если она
;     держится CFG.sceneHoldMs подряд;
;   * сильные сцены (ИТОГИ, УСТРАНЁН, НАГРАДА) принимаются сразу — они
;     однозначные и ждать их незачем.
; ----------------------------------------------------------------------------
SettleScene(raw, now) {
    global CFG, ST
    strong := (raw = "END_SCREEN" || raw = "DEATH" || raw = "REWARD")
    if (raw != ST.sceneRaw) {
        ST.sceneRaw := raw
        ST.sceneRawAt := now
    }
    seenFor := (ST.sceneRawAt ? now - ST.sceneRawAt : 0)

    if (raw = ST.state)
        return raw

    if strong
        return raw

    ; --- не выпускаем из матча, пока HUD свежий ---
    if (ST.state = "GAME") {
        if (ST.hudLastT && (now - ST.hudLastT < CFG.hudLostMs)) {
            LogThrottledKey("[stickgame]", "[i] кадр похож на «" StateRu(raw) "», но HUD"
                . " матча был " . Round((now - ST.hudLastT) / 1000) . " с назад —"
                . " остаюсь в матче (сцена не прыгает)")
            return "GAME"
        }
    }

    ; --- в слабую сцену переходим только по устойчивому кадру ---
    if (seenFor < CFG.sceneHoldMs) {
        LogThrottledKey("[settle:" raw, "[i] сцена «" StateRu(raw) "» держится "
            . Round(seenFor) " мс из " CFG.sceneHoldMs " — пока не переключаюсь")
        return ST.state
    }
    return raw
}

TickBody() {
    global CFG, ST
    if !ST.running
        return
    if ST.paused {
        LeaveCancel(false)
        AntiAfkReset()
        XpModeReset()
        MacroPlayReset()
        ReleaseKeys()
        UpdateStatus()
        return
    }
    ; Поддерживаем запрет сна Windows и периодическое сохранение статистики
    if (CFG.keepAwake && (!ST.lastAwakeAt || A_TickCount - ST.lastAwakeAt >= 45000))
        UpdateKeepAwake(true)
    PersistStats(false)

    ; Таймер сессии (если не держим экран с жетоном; в матче учитывает finishMatch)
    if (CFG.stopAfterMin > 0 && !ST.tokenShown) {
        inLive := (ST.state = "GAME" || ST.state = "DEATH")
        if CheckSessionLimits(A_TickCount, inLive)
            return
    }

    ; Защита Alt+Tab: пока зажат Alt (+450 мс после), мгновенно отпускаем ввод.
    if AltTabGuardActive() {
        AntiAfkReset()
        XpModeReset()
        MacroPlayReset()
        ReleaseKeys()
        ST.lastAction := "пауза Alt+Tab"
        UpdateStatus()
        return
    }

    ; Защёлка отмены не снимается из-за ложной смены сцены или истечения времени.
    if ST.cancelHold {
        ReleaseKeysSafe()
        LogThrottled("[=] возможная отмена подбора · жду игрока · «Продолжить» или F8")
        UpdateStatus()
        return
    }

    hwnd := GetGameWindow()
    if !hwnd {
        if ST.leaveActive
            LeaveCancel(false)
        LogThrottled("[!] Окно игры не найдено: " CFG.winTitle " / " CFG.winTitleAlt)
        UpdateStatus()
        return
    }

    bgWatch := BgInputActive() || CFG.smartRestore || CFG.dryRun
    if (!WinActive("ahk_id " hwnd) && !ST.bgWarned && (BgInputActive() || CFG.smartRestore)) {
        ST.bgWarned := true
        if CFG.smartRestore {
            Log("[i] УМНЫЙ ФОН: слежу за Fortnite в фоне. Для кликов меню бот поднимет"
                . " игру на долю секунды и сразу вернёт ваше окно и курсор.")
            Toast("Умный фон активен", "можно работать за ПК — окно и курсор вернутся", 3500)
        } else {
            Log("[i] ФОН-РЕЖИМ: игра не в фокусе — клавиши шлю в окно игры, мышь не трогаю.")
            Toast("Фон-режим", "игра не в фокусе — работаю через окно", 3500)
        }
    }

    if !WinActive("ahk_id " hwnd) {
        XpReleaseLmb()
        if BgInputActive() {
            ST.focusLostAt := 0
        } else if (CFG.smartRestore || CFG.dryRun || CFG.botMode = "xp") {
            ; В Умном фоне и AFK XP клавиши не шлём в чужое окно, но таймеры/сцену ведём.
            if (HeldCount() > 0 || ST.afkAct != "" || ST.xpStepPhase != 0 || ST.macroPlayIdx != 0) {
                AntiAfkReset()
                XpModeReset()
                MacroPlayReset()
                ReleaseKeys()
            }
            ST.focusLostAt := 0
        } else {
            if !ST.focusLostAt
                ST.focusLostAt := A_TickCount
            lost := A_TickCount - ST.focusLostAt
            if (lost < CFG.focusGraceMs) {
                AbortCleanup()
                if (A_TickCount - ST.focusNoteAt > 4000) {
                    ST.focusNoteAt := A_TickCount
                    LogThrottledKey("[focusgrace]", "[i] фокус ушёл из игры на "
                        . Round(lost) " мс — держу сцену, продолжу при возврате")
                }
                UpdateStatus()
                return
            }
            AntiAfkReset()
            ReleaseKeys()
            took := Round((A_TickCount - ST.focusLostAt) / 1000)
            LogThrottledKey("[focus]", "[!] Окно игры НЕ в фокусе " took
                . " с — клавиши не отправляю. Вернитесь в игру либо включите"
                . " «Умный фон» / «Фон-режим» в меню.")
            Toast("Окно игры не в фокусе", "вернитесь в игру или включите «Умный фон»", 2500)
            if !bgWatch {
                UpdateStatus()
                return
            }
        }
    } else if ST.focusLostAt {
        wasAway := A_TickCount - ST.focusLostAt
        ST.focusLostAt := 0
        if (wasAway >= CFG.focusGraceMs) {
            ST.focusBackAt := A_TickCount
            Log("[i] фокус вернулся к игре (не было "
                . Round(wasAway / 1000, 1) " с) — продолжаю без сброса")
        }
    }
    ST.hwnd := hwnd

    if !GameResponsive() {
        waited := ST.gameHungAt ? Round((A_TickCount - ST.gameHungAt) / 1000, 1) : 0
        LogThrottledKey("[gamelag]", "[!] игра не отвечает " waited
            . " с — клавиши не шлю, жду (обычно это загрузка, а не сбой бота)")
        TraceStep("жду ответа игры (" waited " с)")
        UpdateStatus()
        return
    }
    TraceStep("захват кадра")

    shot := CaptureClient(hwnd)
    if !shot {
        iconic := false
        try
            iconic := (WinGetMinMax("ahk_id " hwnd) = -1)
        LogThrottledKey("[nocap]", iconic
            ? "[!] Кадр не взят: окно игры СВЁРНУТО. Разверните Fortnite (в «Умном фоне»"
              . " можно просто перекрыть его другим окном, не сворачивая)."
            : "[!] Кадр не взят: окно игры не отдало изображение. Нажмите F7 для диагностики.")
        return
    }
    if IsSelfWindow(hwnd) {
        LogThrottledKey("[selfwin]", "[!] Пропущен кадр собственного окна бота — жду окно Fortnite.")
        return
    }
    ST.winTxt := ""
    try
        ST.winTxt := WinGetTitle("ahk_id " hwnd)
    ST.lastShot := shot, ST.lastShotAt := A_TickCount
    ST.frames += 1
    ST.capW := shot.w, ST.capH := shot.h

    ST.scanWork := 0

    ; Если уже выполняется пошаговый выход из матча в лобби — ведём его без сбоя сцены
    if ST.leaveActive {
        CheckToken(shot, A_TickCount)
        if (!ST.tokenShown) {
            TraceStep("выход в лобби")
            LeaveStep(shot, A_TickCount)
            ST.prevShot := shot
            UpdateStatus()
            return
        }
        LeaveCancel(true)
    }
    TraceStep("распознаю сцену")
    density := CachedDensity(shot)
    scene := DetectState(shot, density, A_TickCount)
    ; Даже если антидребезг ещё удерживает старое состояние GAME, не
    ; выполнять игровые действия на кадре с похожей на лобби плашкой.
    frameMenu := CachedMenu(shot)
    frameLobby := frameMenu.lobby ? frameMenu.lobby : (frameMenu.lobbyY.Length ? frameMenu.lobbyY[frameMenu.lobbyY.Length] : 0)
    frameKind := frameLobby ? PlateKind(shot, frameLobby) : "?"
    blockGameForLobby := (frameKind = "play" || frameKind = "cancel")
    TraceStep("сцена: " StateRu(scene))

    ; Автобус, глайдер, пауза меню по Esc — HUD на это время пропадает, и
    ; раньше сцена прыгала в ОЖИДАНИЕ по несколько раз в секунду. Если полосу
    ; HP видели недавно, матч продолжается.
    fromQueue := ST.leftQueueT && (A_TickCount - ST.leftQueueT < CFG.hpSeenWindowMs * 3)
    if (scene = "UNKNOWN" && !ST.queuePending
        && ST.matchStarted && (A_TickCount - ST.lastHpSeenT < CFG.hpSeenWindowMs))
        scene := "GAME" ; краткое исчезновение HUD после уже принятого матча

    ; --- «липкая» сцена: не даём одному дрогнувшему кадру сбить работу
    scene := SettleScene(scene, A_TickCount)
    ; Даже если поиск ушёл через UNKNOWN/загрузку, сохраняем его до нового HUD.
    ; Статус — эвристика, а не доказательство начала матча.
    if (scene = "MATCHMAKING")
        ST.queuePending := true
    if (ST.queuePending && scene = "GAME") {
        if (HudEvidence(shot) >= 2) {
            ST.queuePending := false
            Log("[i] После поиска видны признаки HUD матча; начинаю обработку игры")
        } else
            scene := "UNKNOWN"
    }

    ; антидребезг: состояние меняем, только если оно повторилось несколько кадров
    if (scene != ST.state) {
        if (scene = ST.pendingState)
            ST.pendingCount += 1
        else
            ST.pendingState := scene, ST.pendingCount := 1
        if !ST.pendingSince
            ST.pendingSince := A_TickCount
        need := (scene = "REWARD") ? CFG.rewardConfirmFrames : CFG.stateConfirmFrames
        ; БЕСКОНЕЧНОЕ ОЖИДАНИЕ: если сцена скачет (МАТЧ/ОЖИДАНИЕ кадр в кадр),
        ; счётчик никогда не дойдёт до порога, и бот молча простаивал каждый
        ; кадр — именно так выглядело «ничего не делает и не пишет в журнал».
        if (ST.pendingCount < need) {
            ; Наспех принимаем только рабочие сцены. Награда, итоги и смерть
            ; требуют настоящего подтверждения: в run-8.log «НАГРАДА» наспех
            ; принялась прямо в лобби и бот жал кнопку внизу.
            safeFast := (scene = "GAME" || scene = "MENU" || scene = "MATCHMAKING"
                || scene = "UNKNOWN")
            if (safeFast && (A_TickCount - ST.pendingSince > 1500)) {
                LogThrottledKey("[flip]", "[i] сцена скачет «" StateRu(ST.state) "» / «"
                    . StateRu(scene) "» — принимаю «" StateRu(scene)
                    . "» без подтверждения, иначе бот стоит на месте")
                ST.pendingCount := need
            } else {
                ST.prevShot := shot
                UpdateStatus()
                return
            }
        }
    } else {
        ST.pendingSince := 0
        ST.pendingState := scene
        ST.pendingCount := 0
    }

    if (scene != ST.state) {
        ; --- МИГАНИЕ ДЕТЕКТОРА В ПОИСКЕ (run-16.log) --------------------------
        ; В журнале: «ПОИСК МАТЧА -> ЛОББИ», «очередь оборвалась через 0 с»,
        ; снова «Играть» — и так по кругу, хотя поиск шёл своим ходом. Если
        ; мы в поиске меньше mmFlickerMs, это мигнул детектор, а не выход в
        ; лобби: остаёмся в поиске, ничего не нажимаем.
        if (ST.state = "MATCHMAKING" && scene = "MENU" && ST.mmSince > 0
            && (A_TickCount - ST.mmSince) < CFG.mmFlickerMs) {
            ST.mmFlicker += 1
            ST.pendingState := "MATCHMAKING", ST.pendingCount := 0
            LogThrottledKey("[mmflicker]", "[i] детектор мигнул «лобби» во время поиска"
                . " — остаюсь в поиске (миганий: " ST.mmFlicker ")")
            ST.prevShot := shot
            UpdateStatus()
            return
        }
        ; Пока исход очереди не подтверждён HUD, даже через промежуточный
        ; UNKNOWN/тёмный экран возврат в MENU может быть ручной отменой.
        if (scene = "MENU" && ST.queuePending) {
            ST.cancelHold := true
            ST.cancelHoldAt := A_TickCount
            Log("[?] Поиск завершился, причина неизвестна: возможна ручная отмена. «Играть» не жму; жду F8 или «Продолжить».")
            Flash("Возможна отмена подбора — бот ждёт.`n"
                . "Возобновить поиск: F8 или «Продолжить».", 7000)
            UpdateStatus()
        }
        ST.pendingSince := 0
        prevState := ST.state          ; нужно ниже: откуда мы пришли
        if (scene = "GAME")
            ST.matchFromQueue := ST.queueSeen || fromQueue
        ; считаем перевороты: если их много, значит детектор мечется, и в
        ; журнале это должно быть видно одной строкой (run-13.log)
        if (prevState != "" && (A_TickCount - ST.lastFlipAt < 1500))
            ST.flips += 1
        ST.lastFlipAt := A_TickCount
        Log("[state] " StateRu(ST.state) " -> " StateRu(scene))
        ST.state := scene
        ST.sceneSince := A_TickCount
        ST.endFirstSeen := 0
        ST.endRetry := 0
        ST.lastClickT := 0
        ST.prompt := 0
        ST.chest := 0
        ST.enemy := 0
        ResetCaches()
        ReleaseKeys()
        if (scene != "GAME")
            ST.segUntil := 0
        if (scene = "MATCHMAKING") {
            ST.mmSince := A_TickCount
            ST.mmEnterAt := A_TickCount
            ST.roundActive := false, ST.lobbyRequeue := false, ST.roundCounted := false
        }
        if (scene = "GAME" || scene = "DEATH" || scene = "END_SCREEN" || scene = "REWARD")
            ST.roundActive := true
        if (scene != "MATCHMAKING" && scene != "MENU")
            ST.mmEnterAt := 0
        ; вышли из поиска: дальше загрузка, автобус, глайдер — HUD появится не сразу
        if (prevState = "MATCHMAKING" && scene != "MATCHMAKING" && scene != "MENU")
            ST.leftQueueT := A_TickCount
        if (scene = "UNKNOWN")
            ST.unknownSince := A_TickCount
        if (scene = "REWARD")
            ST.rewardClicks := 0
        if (scene = "MENU") {
            ST.lobbySince := A_TickCount
            ST.squadEmptyCount := 0, ST.squadEverSeen := false, ST.groundAt := 0
            ST.squadStatus := CFG.squadAutoLeave ? "в лобби" : "выкл"
            ; Только один ускоренный запуск после предполагаемого матча.
            ; Защёлка отмены имеет приоритет, а плашку ещё нужно подтвердить.
            if (ST.roundActive && prevState != "MATCHMAKING" && !ST.cancelHold) {
                RecordRoundCompleted("возврат в лобби")
                ST.lobbyRequeue := true
                ST.roundActive := false
                ST.queueTries := 0
                if (CFG.lobbyDelaySec > 0 && !ST.lobbyCooldownUntil)
                    ST.lobbyCooldownUntil := A_TickCount + CFG.lobbyDelaySec * 1000
                Log("[i] Возврат в лобби после матча — проверяю кнопку «Играть»"
                    . (CFG.lobbyDelaySec > 0 ? " (пауза " CFG.lobbyDelaySec " с)" : ""))
            }
        }
        if (scene = "GAME")
            ST.queueSeen := false
        if (scene = "GAME") {
            ST.inMatchT := A_TickCount
        }
        if (scene = "GAME" && !ST.matchStarted) {
            ST.matchStarted := true
            ST.roundCounted := false
            ST.tokenPresses := 0
            ST.tokenFoundMatch := false
            ST.bypassRequested := false
            ST.matchStartT := A_TickCount
            ST.lastHpSeenT := A_TickCount
            ST.groundAt := 0
            ST.squadCheckAt := 0, ST.squadEmptyCount := 0, ST.squadEverSeen := false
            ST.squadStatus := CFG.squadAutoLeave ? "ожидание высадки" : "выкл"
            ST.afkPitch := 0
            AntiAfkReset()
            ST.phase := "", ST.phaseAt := 0, ST.busJumped := false, ST.glideDeploys := 0
            ST.weaponTries := 0, ST.lastWeaponT := 0
            ST.hpPrev := -1, ST.damagedAt := 0, ST.tgt := 0
        }
        if (scene != "GAME") {
            AntiAfkReset()
            ST.matchStarted := false
            ST.matchFromQueue := false
            ST.firstSlotDone := false
            ST.bypassRequested := false
        }
    }
    if (scene != "MATCHMAKING")
        ST.mmSince := 0

    ; Защёлка могла включиться выше в этом же тике.
    if ST.cancelHold {
        ReleaseKeysSafe()
        UpdateStatus()
        return
    }
    ; В поиске ждём; неизвестный исход не превращаем в итог/награду по цвету.
    if (ST.queuePending && scene != "MATCHMAKING") {
        ReleaseKeysSafe()
        LogThrottledKey("[queueunknown]", "[?] После поиска исход неясен — жду признаки HUD или лобби; кнопки не нажимаю.", 10000)
        UpdateStatus()
        return
    }
    if (scene = "GAME" && blockGameForLobby) {
        ReleaseKeysSafe()
        LogThrottledKey("[lobbygamesafety]", "[?] Видна плашка лобби: игровые действия приостановлены до уточнения сцены.", 5000)
        UpdateStatus()
        return
    }
    ; жетон/баннер находки может выскочить где угодно, в том числе в матче
    CheckToken(shot, A_TickCount)

    if (scene = "SLEEP")
        HandleSleep(shot, A_TickCount)
    else if (scene = "END_SCREEN")
        HandleEndScreen(shot, A_TickCount)
    else if (scene = "MATCHMAKING")
        HandleMatchmaking(shot, A_TickCount)
    else if (scene = "GAME") {
        hbNow := CachedHealth(shot)
        ST.hpPercent := hbNow.hp.pct
        ST.shPercent := hbNow.sh.pct
        if (hbNow.hp.pct < 0) {
            ST.hpPrev := -1
        } else {
            if (ST.hpPrev >= 0 && ST.hpPrev - hbNow.hp.pct >= CFG.damageDrop) {
                ST.damagedAt := A_TickCount
                LogThrottledKey("[hpdrop]", "[?] HP снизился " ST.hpPrev " -> " hbNow.hp.pct
                    . "; причина не установлена (противник, буря или ошибка оценки)")
            }
            ST.hpPrev := hbNow.hp.pct
        }
        if (CFG.botMode = "xp") {
            TraceStep("AFK XP")
            if ST.bypassRequested
                LeaveStart("ручной пропуск " CFG.hkBypass, true)
            else
                XpModeTick(shot, A_TickCount)
        } else if (CFG.botMode = "antiafk") {
            TraceStep("Анти-АФК")
            if ST.bypassRequested
                LeaveStart("ручной пропуск " CFG.hkBypass, true)
            else
                AntiAfkTick(shot, A_TickCount)
        } else if (CFG.botMode = "queue") {
            TraceStep("AFK-очередь")
            HandleQueueGame(shot, A_TickCount)
        } else {
            ; Полный режим «Авто-игра»: также поддерживает F4, таймер матча, отряд и Умный фон
            if CheckMatchLeave(shot, A_TickCount) {
                ; выполняется выход или ожидание сигнала
            } else if (!WinActive("ahk_id " hwnd) && !BgInputActive()) {
                ST.lastAction := "умный фон: жду таймер / итоги"
            } else {
                if (!ST.groundAt && InMatchHud(shot) && ST.phase != "prep" && ST.phase != "bus")
                    ST.groundAt := A_TickCount
                TraceStep("обход матча")
                Roam(shot, A_TickCount)
            }
        }
    }
    else if (scene = "REWARD") {
        if (scene != ST.state)
            ST.rewardClicks := 0
        HandleReward(shot, A_TickCount)
    }
    else if (scene = "DEATH")
        HandleDeath(shot, A_TickCount)
    else if (scene = "UNKNOWN") {
        if (CFG.botMode = "antiafk")
            ST.lastAction := "Анти-АФК: жду HUD матча"
        else if (CFG.botMode = "xp")
            XpModeTick(shot, A_TickCount)
        else
            HandleUnknown(shot, A_TickCount)
    }
    else if (scene = "MENU") {
        ReleaseKeys()
        HandleMenu(shot, A_TickCount)
    }

    ; «пульс» раз в 10 секунд: видно, что бот жив и что он видит
    if (A_TickCount - ST.lastBeat > 10000) {
        ST.lastBeat := A_TickCount
        mInfo := ""
        if (scene = "GAME" && CFG.matchMaxMin > 0 && ST.matchStartT > 0) {
            rem := Max(0, Round(CFG.matchMaxMin * 60000) - (A_TickCount - ST.matchStartT))
            mInfo := " · до выхода " FmtCountdown(rem)
        }
        sqInfo := CFG.squadAutoLeave ? (" · отряд " ST.squadStatus) : ""
        Log("[·] " StateRu(ST.state) " [" CFG.botMode "]"
            . " · " (ST.lastAction != "" ? ST.lastAction : "—")
            . mInfo . sqInfo
            . " · раундов " ST.rounds " (всего " CFG.totalRounds ")"
            . " · HP " ST.hudHp " px"
            . (CFG.botMode = "auto" ? (" · враг " (ST.enemy ? "да" : "нет")) : "")
            . " · сундук " (ST.chest ? "да" : "нет")
            . " · жетонов " ST.tokensFound
            . " · тик " Round(ST.lastTickMs) " мс")
    }

    ST.prevShot := shot
    UpdateStatus()
}

; ============================================================================
;                    ЗРЕНИЕ В РЕАЛЬНОМ ВРЕМЕНИ (доп. окно)
; ============================================================================
; Просьба была: «чтобы было доп. окно игры с обработкой», как в разборе
; распознавания на скриншоте. Здесь ровно это: небольшое окно поверх игры, в
; нём ЖИВОЙ кадр и поверх него то, что бот нашёл — сундук, лут, враг, полоса
; HP, кнопка, — плюс строка «что вижу и что собираюсь делать».
; Окно ничего не нажимает и не мешает циклу: у него свой таймер (v7.2 — до 30 кадров/с).
; ----------------------------------------------------------------------------
BuildVisionGui() {
    global VIS
    if VIS.gui
        return
    ; v7.5: +E0x08000000 = WS_EX_NOACTIVATE. Раньше открытие окна зрения
    ; забирало фокус у игры, и бот на секунды переставал слать клавиши
    ; («в моменте сам переключил на окно программы и обратно в игру»).
    g := Gui("-DPIScale +Resize +E0x08000000"
        , "FORMA — зрение (что видит бот) — фокус не забирает")
    g.BackColor := "0A0E13"
    g.SetFont("s10 bold c38BDF8", "Segoe UI Semibold")
    VIS.head := g.AddText("x12 y8 w620 h22", "ЗРЕНИЕ · только окно игры")
    g.SetFont("s8 c6F7C8C", "Consolas")
    VIS.mode := g.AddText("x12 y30 w620 h16", "")
    ; сам кадр
    VIS.pic := g.AddPicture("x12 y50 w720 h405 +0xE +Background0C1219", "")
    ; легенда цветов
    g.SetFont("s8 c" "C9D4E0", "Consolas")
    VIS.legend := g.AddText("x12 y460 w720 h16",
        "жёлтый — сундук   синий — лут   красный — враг   зелёный — полоса HP   белый — кнопка")
    ; что вижу / что делаю
    g.SetFont("s8 c" "A9B4C4", "Consolas")
    VIS.txt := g.AddEdit("x12 y480 w720 h96 ReadOnly -Wrap +Background151E2A cC9D4E0", "")
    g.SetFont("s7 c5A6772", "Consolas")
    g.AddText("x12 y580 w440 h14", "F3 — скрыть · чистый GDI-анализ AutoHotkey v2 (без моделей)")
    g.SetFont("s8 cC9D4E0", "Segoe UI")
    VIS.btnCal := g.AddButton("x472 y574 w260 h24", "Диагностика HUD (F5)")
    VIS.btnCal.OnEvent("Click", (*) => OnCalibrate())
    g.OnEvent("Close", (*) => VisionHide())
    g.OnEvent("Escape", (*) => VisionHide())
    ApplyWindowChrome(g.Hwnd, false)
    VIS.gui := g
}

ToggleVision(*) {
    global VIS
    if VIS.on
        VisionHide()
    else
        VisionShow()
}

VisionShow() {
    global VIS, CFG
    BuildVisionGui()
    ; NA = показать, НЕ активируя: фокус остаётся у игры
    VIS.gui.Show("NA w744 h640")
    ; v7.4: рисуем кадр ПРЯМО в DC картинки. Раньше кадр отдавался окну через
    ; STM_SETIMAGE, и картинка могла остаться чёрной: битмап был выбран в наш
    ; собственный DC, а статик не всегда может его нарисовать.
    try
        VIS.hdcPic := DllCall("user32\GetDC", "Ptr", VIS.pic.Hwnd, "Ptr")
    VIS.on := true
    VIS.lastId := 0, VIS.lastMode := "", VIS.lastOverlayKey := "", VIS.lastDrawAt := 0, VIS.frames := 0, VIS.fpsAt := 0, VIS.fps := 0
    ; v7.2: до 30 кадров/с. Если кадр рисуется дольше интервала, AHK не
    ; запускает таймер повторно — окно просто идёт медленнее, но не «залипает».
    SetTimer(VisionFrame, CFG.visMs)
    Log("[i] окно «зрение» открыто: в нём живой кадр и то, что бот распознал")
    VisionFrame()
}

VisionHide() {
    global VIS
    if !VIS.gui
        return
    SetTimer(VisionFrame, 0)
    VIS.on := false
    try {
        if VIS.hdcPic
            DllCall("user32\ReleaseDC", "Ptr", VIS.pic.Hwnd, "Ptr", VIS.hdcPic)
    }
    VIS.hdcPic := 0
    VisionGdiFree()
    try
        VIS.gui.Hide()
}

; --- кадр + разметка ---------------------------------------------------------
VisionFrame() {
    global VIS, ST, CFG
    if !VIS.on || !VIS.gui
        return
    ; тик может быть занят — его флаги (бюджет/просьба прерваться) к нам не
    ; относятся, поэтому TickCheck на время кадра молчит
    if VIS.busy                     ; предыдущий кадр ещё рисуется — пропускаем
        return
    muted := ST.tickCheckMuted
    ST.tickCheckMuted := true
    VIS.busy := true
    t0 := A_TickCount
    try
        DrawVisionFrame()
    catch as e {
        LogThrottledKey("[viserr]", "[!] окно зрения: " e.Message)
    }
    VIS.workMs := A_TickCount - t0
    VIS.busy := false
    if (VIS.workMs > CFG.visMs * 1.8)
        VIS.slowFrames += 1
    ST.tickCheckMuted := muted
}

; GDI-ресурсы окна зрения: создаём только при смене размера кадра.
; Возврат к старому поведению (создать/удалить на каждый кадр) — это и была
; причина «4 кадра в секунду», которую просили поднять до 30.
EnsureVisionGdi(shot, pw, ph) {
    global VIS
    if (VIS.hdcDst && VIS.srcW = shot.w && VIS.srcH = shot.h && VIS.dstW = pw && VIS.dstH = ph)
        return true
    VisionGdiFree()
    hdcScreen := DllCall("GetDC", "Ptr", 0, "Ptr")
    VIS.hdcScreen := hdcScreen
    ; 1) исходный кадр
    bi := Buffer(40, 0)
    NumPut("UInt", 40, bi, 0), NumPut("Int", shot.w, bi, 4), NumPut("Int", -shot.h, bi, 8)
    NumPut("UShort", 1, bi, 12), NumPut("UShort", 32, bi, 14)
    pbits := 0
    hbmSrc := DllCall("gdi32\CreateDIBSection", "Ptr", hdcScreen, "Ptr", bi
        , "UInt", 0, "Ptr*", &pbits, "Ptr", 0, "UInt", 0, "Ptr")
    if !hbmSrc {
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
        VIS.hdcScreen := 0
        return false
    }
    hdcSrc := DllCall("gdi32\CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
    DllCall("gdi32\SelectObject", "Ptr", hdcSrc, "Ptr", hbmSrc)
    ; 2) уменьшенная копия, в неё рисуем рамки
    bi2 := Buffer(40, 0)
    NumPut("UInt", 40, bi2, 0), NumPut("Int", pw, bi2, 4), NumPut("Int", -ph, bi2, 8)
    NumPut("UShort", 1, bi2, 12), NumPut("UShort", 32, bi2, 14)
    pv := 0
    hbmDst := DllCall("gdi32\CreateDIBSection", "Ptr", hdcScreen, "Ptr", bi2
        , "UInt", 0, "Ptr*", &pv, "Ptr", 0, "UInt", 0, "Ptr")
    if !hbmDst {
        DllCall("gdi32\DeleteDC", "Ptr", hdcSrc)
        DllCall("gdi32\DeleteObject", "Ptr", hbmSrc)
        DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdcScreen)
        VIS.hdcScreen := 0
        return false
    }
    hdcDst := DllCall("gdi32\CreateCompatibleDC", "Ptr", hdcScreen, "Ptr")
    DllCall("gdi32\SelectObject", "Ptr", hdcDst, "Ptr", hbmDst)
    ; COLORONCOLOR (3) вместо HALFTONE (4): для окна предпросмотра разницы
    ; глазом не видно, а рисуется в 2-3 раза быстрее — это и держит 30 к/с.
    DllCall("gdi32\SetStretchBltMode", "Ptr", hdcDst, "Int", 3)
    VIS.hdcSrc := hdcSrc, VIS.hbmSrc := hbmSrc, VIS.pbits := pbits
    VIS.srcW := shot.w, VIS.srcH := shot.h
    VIS.hdcDst := hdcDst, VIS.hbmDst := hbmDst, VIS.dstW := pw, VIS.dstH := ph
    return true
}

VisionGdiFree() {
    global VIS
    if VIS.hdcDst
        try DllCall("gdi32\DeleteDC", "Ptr", VIS.hdcDst)
    if VIS.hbmDst
        try DllCall("gdi32\DeleteObject", "Ptr", VIS.hbmDst)
    if VIS.hdcSrc
        try DllCall("gdi32\DeleteDC", "Ptr", VIS.hdcSrc)
    if VIS.hbmSrc
        try DllCall("gdi32\DeleteObject", "Ptr", VIS.hbmSrc)
    if VIS.hdcScreen
        try DllCall("ReleaseDC", "Ptr", 0, "Ptr", VIS.hdcScreen)
    VIS.hdcDst := 0, VIS.hbmDst := 0, VIS.hdcSrc := 0, VIS.hbmSrc := 0
    VIS.pbits := 0, VIS.hdcScreen := 0
    VIS.srcW := 0, VIS.srcH := 0, VIS.dstW := 0, VIS.dstH := 0
    VIS.lastHbm := 0
}

; Скорость именно отрисованных кадров, по реальному интервалу между ними.
; Вызов только после успешной отрисовки нового кадра (реальный FPS окна зрения).
VisionFpsSample(now) {
    global VIS
    if !VIS.fpsAt {
        VIS.fpsAt := now, VIS.frames := 0
        return
    }
    elapsed := now - VIS.fpsAt
    if (elapsed <= 0)
        return
    VIS.frames += 1
    if (elapsed >= 1000) {
        VIS.fps := Round(VIS.frames * 1000 / elapsed, 1)
        VIS.frames := 0, VIS.fpsAt := now
    }
}

; Распознавание может завершиться после первого показа кадра: обновляем
; рамки этого же кадра, но не засчитываем повтор как новый кадр FPS.
VisionOverlayKey(shot) {
    global ST
    prev := Critical("On")
    try {
        return (ST.chestCacheSeq = shot.captureId && IsObject(ST.chestCache) ? "1" : "0")
            . (ST.lootCacheSeq = shot.captureId && IsObject(ST.lootCache) ? "1" : "0")
            . (ST.enemySeenSeq = shot.captureId && IsObject(ST.enemyCache) ? "1" : "0")
            . (ST.enemyTrackSeq = shot.captureId && IsObject(ST.enemyTrack) ? "1" : "0")
            . (ST.hudFoundSeq = shot.captureId && IsObject(ST.hudFound) ? "1" : "0")
            . (ST.uiBoxSeq = shot.captureId && IsObject(ST.uiBoxCache) ? "1" : "0")
            . (ST.promptSeq = shot.captureId && IsObject(ST.promptCache) ? "1" : "0")
    } finally {
        Critical(prev)
    }
}

DrawVisionFrame() {
    global VIS, ST, CFG
    hwnd := GetGameWindow()
    if !hwnd {
        VIS.txt.Value := "Окно игры не найдено.`nЗапустите Fortnite (оконный без рамки) и нажмите F7."
        return
    }
    shot := 0, overlayKey := ""
    if (ST.running && !ST.paused) {
        if IsObject(ST.lastShot) {
            shot := ST.lastShot, overlayKey := VisionOverlayKey(shot)
        }
        if (!shot || !ST.lastShotAt || A_TickCount - ST.lastShotAt > 1000
            || (shot.captureId = VIS.lastId && overlayKey = VIS.lastOverlayKey)) {
            if (!VIS.lastDrawAt || A_TickCount - VIS.lastDrawAt >= 1000) {
                VIS.mode.Value := "Жду свежий кадр цикла · новых кадров за последнюю секунду: 0"
                VIS.fps := 0
            }
            return
        }
    } else if !ST.mouseCalActive {
        shot := CaptureClient(hwnd)
        if shot
            overlayKey := VisionOverlayKey(shot)
    }
    newFrame := shot && (shot.captureId != VIS.lastId || !VIS.lastDrawAt)
    if shot {
        VIS.lastId := shot.captureId, VIS.lastOverlayKey := overlayKey
        if newFrame
            VIS.lastDrawAt := A_TickCount
    }
    if !shot {
        iconic := false
        try
            iconic := (WinGetMinMax("ahk_id " hwnd) = -1)
        VIS.mode.Value := "источник: — · окно игры " (iconic ? "СВЁРНУТО" : "не отдало кадр")
        VIS.txt.Value := iconic
            ? "Игра свёрнута в панель задач.`n"
              . "Разверните окно Fortnite — тогда здесь будет живой кадр.`n"
              . "Активным его делать не нужно: кадр берётся у самого окна."
            : "Окно игры не отдало изображение.`n"
              . "Кадр берётся у окна игры в режиме «Оконный без рамки».`n"
              . "Нажмите F7 — там подробная причина."
        return
    }
    brightPct := ShotBrightPct(shot)
    VIS.mode.Value := "источник: " (ST.visSrc != "" ? ST.visSrc : "окно игры")
        . " · GDI AHK v2 · " shot.w "x" shot.h " · возраст " Max(0, A_TickCount - shot.capturedAt)
        . " мс · показ " VIS.fps " кадр/с"
        . " · фокус: " (WinActive("ahk_id " hwnd) ? "игра" : (CFG.smartRestore ? "умный фон" : "другое окно"))
    VIS.legend.Value := "жёлтый — сундук · синий — лут · красный — враг · зелёный — HP · голубой — [E] · белый — кнопка"

    ; масштаб «кадр -> окно» с сохранением пропорций
    pw := VIS.pw, ph := VIS.ph
    sx := pw / shot.w, sy := ph / shot.h
    if (sx > sy)
        sx := sy, pw := Round(shot.w * sx), ph := Round(shot.h * sx)
    else
        sy := sx, ph := Round(shot.h * sy), pw := Round(shot.w * sy)

    ; --- GDI-ресурсы ПЕРЕИСПОЛЬЗУЕМ (v7.2) -----------------------------------
    ; Раньше на каждый кадр создавались и уничтожались два DIB-раздела и три
    ; контекста. На 1280x720 это ~30-40 мс на кадр — окно зрения так и жило на
    ; 4 кадрах/с, сколько ни ставь таймер. Теперь создаём один раз и только
    ; перерисовываем содержимое.
    if !EnsureVisionGdi(shot, pw, ph) || !VIS.hdcDst {
        VIS.mode.Value := "не смог создать GDI-ресурсы для кадра"
        VIS.txt.Value := "Не удалось подготовить вывод кадра.`nНажмите F3 (закрыть) и снова F3."
        return
    }
    DllCall("kernel32\RtlMoveMemory", "Ptr", VIS.pbits, "Ptr", shot.buf, "UPtr", shot.stride * shot.h)
    DllCall("gdi32\StretchBlt", "Ptr", VIS.hdcDst, "Int", 0, "Int", 0, "Int", pw, "Int", ph
        , "Ptr", VIS.hdcSrc, "Int", 0, "Int", 0, "Int", shot.w, "Int", shot.h, "UInt", 0x00CC0020)

    ; --- 3) рамки распознанного (атомарное чтение пар «объект + id кадра»)
    hdcDst := VIS.hdcDst
    k := pw / shot.w
    prev := Critical("On")
    chestBox := ST.chestCacheSeq = shot.captureId ? ST.chestCache : 0
    lootBox := ST.lootCacheSeq = shot.captureId ? ST.lootCache : 0
    enemyBox := ST.enemySeenSeq = shot.captureId ? ST.enemyCache : 0
    trackBox := ST.enemyTrackSeq = shot.captureId ? ST.enemyTrack : 0
    hudBox := ST.hudFoundSeq = shot.captureId ? ST.hudFound : 0
    uiBox := ST.uiBoxSeq = shot.captureId ? ST.uiBoxCache : 0
    promptBox := ST.promptSeq = shot.captureId ? ST.promptCache : 0
    Critical(prev)
    if IsObject(chestBox) {
        cDraw := (chestBox.HasOwnProp("drawX") && chestBox.HasOwnProp("drawY"))
            ? {x: chestBox.drawX, y: chestBox.drawY, w: chestBox.w, h: chestBox.h} : chestBox
        cCol := (chestBox.HasOwnProp("kind") && chestBox.kind = "chestRare") ? 0x00FFFF00 : 0x0000FFFF
        BoxRect(hdcDst, cDraw, k, cCol)
    }
    if IsObject(lootBox) && lootBox.HasOwnProp("drawX") && lootBox.HasOwnProp("drawY") {
        drawLoot := {x: lootBox.drawX, y: lootBox.drawY, w: lootBox.w, h: lootBox.h}
        BoxRect(hdcDst, drawLoot, k, 0x00FF8000)
    }
    BoxRect(hdcDst, enemyBox, k, 0x000000FF)
    if IsObject(trackBox)
        BoxRect(hdcDst, trackBox, k, 0x0000A5FF)
    if IsObject(promptBox)
        BoxRect(hdcDst, promptBox, k, 0x00FFFF00)
    if IsObject(uiBox)
        BoxRect(hdcDst, uiBox, k, 0x00FFFFFF)
    if IsObject(hudBox) {
        hpBox := {x: hudBox.x, y: hudBox.y, w: hudBox.run, h: Max(3, hudBox.thick)}
        BoxRect(hdcDst, hpBox, k, 0x0000FF00)
    }
    ; прицел + красный захват + луч звука
    cx := Round(shot.w / 2 * k), cy := Round(shot.h / 2 * k)
    PenLine(hdcDst, cx - 6, cy, cx + 6, cy, ST.redCrosshair ? 0x000000FF : 0x00FF00FF)
    PenLine(hdcDst, cx, cy - 6, cx, cy + 6, ST.redCrosshair ? 0x000000FF : 0x00FF00FF)
    if ST.redCrosshair
        BoxRect(hdcDst, {x: Round(shot.w / 2 - 12), y: Round(shot.h / 2 - 12), w: 24, h: 24}, k, 0x000000FF)
    if (IsObject(ST.soundRing) && IsObject(ST.soundRing.best)) {
        sb := ST.soundRing.best
        sCol := (sb.kind = "red") ? 0x000000FF : ((sb.kind = "gold") ? 0x0000FFFF : 0x00FFFFFF)
        PenLine(hdcDst, cx, cy, Round(sb.x * k), Round(sb.y * k), sCol)
    }

    ; --- 4) показать в окне: копируем готовый кадр в DC картинки
    if !VIS.hdcPic {
        try
            VIS.hdcPic := DllCall("user32\GetDC", "Ptr", VIS.pic.Hwnd, "Ptr")
    }
    if VIS.hdcPic {
        ox := Max(0, (VIS.pw - pw) // 2), oy := Max(0, (VIS.ph - ph) // 2)
        DllCall("gdi32\BitBlt", "Ptr", VIS.hdcPic, "Int", ox, "Int", oy, "Int", pw, "Int", ph
            , "Ptr", VIS.hdcDst, "Int", 0, "Int", 0, "UInt", 0x00CC0020, "Int")
    }

    ; --- 5) текст: что вижу и что делаю
    if newFrame
        VisionFpsSample(A_TickCount)
    hpb := IsObject(ST.hudFound) ? ("полоса " ST.hudFound.run " px · " ST.hudFound.kind) : "полосы нет"
    VIS.txt.Value := "режим: " ModeRu(CFG.botMode) " · сцена: " StateRu(ST.state)
        . " (детектор: " (ST.sceneRaw != "" ? StateRu(ST.sceneRaw) : "—") ")`n"
        . "делаю: " (ST.lastAction != "" ? ST.lastAction : "—") " · шаг: "
        . (ST.tickStep != "" ? ST.tickStep : "—") "`n"
        . "объекты: " (ST.chest ? "сундук" : "сундук нет")
        . " · " (ST.prompt ? "плашка [E]" : "[E] нет")
        . " · " (CFG.botMode = "auto" ? (ST.enemy ? "враг" : "враг нет") : ("отряд: " ST.squadStatus))
        . " · " hpb "`n"
        . "раундов: " ST.rounds " (всего " CFG.totalRounds ") · жетонов: " ST.tokensFound
        . " · кадр " shot.w "x" shot.h " · " VIS.fps " кадр/с · "
        . (MouseAllowed() ? "мышь: активна" : (CFG.smartRestore ? "мышь: умный фон" : "мышь: закрыта"))
        . (brightPct < 8
            ? "`nКАДР ТЁМНЫЙ: переключите Fortnite в «Оконный без рамки» —"
              . " в полноэкранном режиме окно не отдаёт содержимое." : "")
}

; рамка по прямоугольнику (координаты кадра -> окно)
BoxRect(hdc, box, k, color) {
    if !IsObject(box)
        return
    if !(box.HasOwnProp("w") && box.HasOwnProp("h"))
        return
    if (box.w <= 0 || box.h <= 0)
        return
    x1 := Round(box.x * k), y1 := Round(box.y * k)
    x2 := Round((box.x + box.w) * k), y2 := Round((box.y + box.h) * k)
    PenLine(hdc, x1, y1, x2, y1, color)
    PenLine(hdc, x2, y1, x2, y2, color)
    PenLine(hdc, x2, y2, x1, y2, color)
    PenLine(hdc, x1, y2, x1, y1, color)
}

PenLine(hdc, x1, y1, x2, y2, color) {
    pen := DllCall("gdi32\CreatePen", "Int", 0, "Int", 1, "UInt", color, "Ptr")
    old := DllCall("gdi32\SelectObject", "Ptr", hdc, "Ptr", pen)
    DllCall("gdi32\MoveToEx", "Ptr", hdc, "Int", x1, "Int", y1, "Ptr", 0)
    DllCall("gdi32\LineTo", "Ptr", hdc, "Int", x2, "Int", y2)
    DllCall("gdi32\SelectObject", "Ptr", hdc, "Ptr", old)
    DllCall("gdi32\DeleteObject", "Ptr", pen)
}


