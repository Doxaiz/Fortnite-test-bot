    autoLabel:     true,      ; писать рядом авто-разметку в формате YOLO
                              ; (0 — голова, 1 — тело, 2 — сундук, 3 — полоса HP)
    scanYieldMs:   30,        ; v7.5: как часто тик «отдаёт процессор», чтобы окно
                              ; зрения успевало перерисоваться (AHK однопоточный)
    ; ---- v7.3: мышь в фон-режиме и подбор порогов ----
    clickGapMs:    90,        ; не чаще одного настоящего клика за это время
    learnAuto:     true,      ; при запуске сам подбирает пороги по своим кадрам
    learnLimit:    500,       ; сколько картинок читать за один подбор
    learnSig:      "",        ; отпечаток датасета (чтобы не учиться дважды)
    learnFolder:   "",        ; папка со скриншотами для подбора порогов

    ; ---- безопасность ----
    humanize:         true,
    maxActionsPerMin: 90
}

