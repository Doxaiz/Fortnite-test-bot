#Requires AutoHotkey v2.0
#SingleInstance Force
; ---- ДИРЕКТИВЫ СБОРКИ В EXE (читает Ahk2Exe, на запуск .ahk не влияют) -------
;@Ahk2Exe-SetName             FORMA
;@Ahk2Exe-SetOrigFilename     FORMA.exe
;@Ahk2Exe-SetDescription      FORMA — Fortnite Auto-Play, AFK, Queue & XP Bot (AutoHotkey v2)
;@Ahk2Exe-SetVersion          11.0.0.0
;@Ahk2Exe-SetCompanyName      FORMA
;@Ahk2Exe-SetCopyright        MIT License (c) 2026 Doxaiz
; ============================================================================
;  FORMA v11.0 — автономный Auto-Play / AFK / Queue / XP бот для Fortnite (AHK v2)
;
;  ТОЛЬКО ОБЫЧНЫЙ AUTOHOTKEY v2 — БЕЗ МОДЕЛЕЙ, БЕЗ PYTHON, БЕЗ ONNX/YOLO.
;  Один файл .ahk (или собранный FORMA.exe через Compiler_EXE.bat):
;    • GDI-захват клиентской области игры (PrintWindow + резерв DC окна),
;      поддержка нативного Fortnite и облачного гейминга (GeForce NOW,
;      GeForce Infinity, Xbox Cloud Gaming, Amazon Luna);
;    • 4-канальное зрение врагов (красный прицел Fortnite + силуэт/контраст с
;      фоном для любых скинов + детектор движения + цифры урона и дуги выстрелов)
;      с защитой от стрельбы по себе, союзникам и деревьям;
;    • Продвинутый автобой: плавное PD-наведение с упреждением, адаптивный огонь
;      по дистанции (в упор от бедра со стрейфом / средняя с удержанием ПКМ /
;      дальняя сидя с ПКМ), гашение отдачи, смена слота и тактическая перезарядка;
;    • Автономный поиск и открытие сундуков: обычные золотые и редкие синие
;      сундуки по свечению + наведение по золотой дуге «Визуализации звука» +
;      наклон взгляда к сундуку + удержание [E] (работает и с «удержанием», и с
;      «нажатием») + сбор выпавшего оружия и щитов + пролом стены киркой;
;    • Умная 3-коридорная навигация: выбор открытого прохода (лево/центр/право),
;      карабканье (Mantle) через заборы/окна, бег с подкатом, стабилизация
;      горизонта, выход из Бури по белой линии миникарты и 5-ступенчатый выход
;      из застреваний без остановки бота;
;    • четыре режима работы:
;        1) Авто-игра (Zero Build: очередь + автобус + поиск сундуков + умный
;           обход + обнаружение врагов и стрельба)
;        2) AFK-очередь (цикл матчей, авто-выход без отряда, ожидание отряда и
;           возрождения, стратегия итогов «Играть снова / В лобби», свой маршрут)
;        3) Только Анти-АФК (разнообразное живое движение без кликов по меню)
;        4) AFK XP — LEGO / Creative (плавный криволинейный сдвиг камеры с
;           нулевой суммой против 7-мин таймаута XP + клик/удержание ЛКМ/шаг/[E]
;           + таймер-напоминание о сборе монет)
;    • Умный фон (Smart Multitasking) + защита Alt+Tab: работайте за ПК во время
;      матчей — бот мгновенно замирает при Alt+Tab, берёт фокус на ~0.5 с только
;      для клика по кнопке меню и возвращает ваше окно и позицию курсора;
;    • Сквозной мини-HUD поверх игры (F2): прозрачная для кликов панель со
;      статусом, раундами, темпом/ч и шансом жетона (скрыта от захвата кадра);
;    • Встроенные Discord / HTTPS Webhook-уведомления (чистый WinHTTP COM):
;      мгновенный сигнал на телефон при находке жетона, сводка сессии и тест;
;    • Интерактивный захват координат курсором за 3 секунды («Курсор 3с»),
;      запись и повтор своего маршрута (macro.txt), профили нагрузки ЦП,
;      авто-закрытие опросов и ошибок очереди, ротация журнала run.log;
;    • Охота за жетоном пиратского магазина (+ ЖЕТОН_НАЙДЕН.txt, авто-стоп,
;      расчёт кумулятивного шанса 1:137 500 и 1.5× в Час сокровищ);
;    • Таймер остановки сессии (с опцией «Доиграть текущий матч»), лимит
;      раундов, запрет сна Windows, статистика за всё время, меню в трее и
;      окно живого зрения (F3) с рамками распознанных объектов.
;
;  Не читает память процесса, не внедряет DLL и не изменяет файлы игры.
;
;  ГОРЯЧИЕ КЛАВИШИ ПО УМОЛЧАНИЮ (переназначаются в меню)
;    F8 — Старт / Стоп          F9 — Тест без нажатий (DryRun)
;    F4 — Пропустить матч       F2 — Сквозной мини-HUD
;    F3 — Окно «Зрение»         F5 — Диагностика HUD
;    F6 — Проверка кадра (мышь) F7 — Диагностика окна
;    F1 — Показать / скрыть     Esc — Аварийный стоп · Ctrl+Alt+Q — Выход
;
;  ВАЖНО: запускайте Fortnite в режиме «Оконный без рамки» (не сворачивайте).
;  Первый запуск по умолчанию в режиме DryRun (без нажатий) для проверки.
;  Автоматизация может нарушать условия использования Epic Games — на ваш риск.
; ============================================================================

; ============================================================================
;                              НАСТРОЙКИ
; ============================================================================
global CFG := {
    ; ---- окно игры ----
    winTitle:     "ahk_class UnrealWindow",
    winTitleAlt:  "Fortnite",                    ; справочно (не для поиска окна!)
    winExe:       "ahk_exe FortniteClient-Win64-Shipping.exe",   ; запасной путь

    ; ---- что включено ----
    featPlayAgain: true,    ; «Играть снова» на экране итогов
    featAutoQueue: true,    ; «Играть» в лобби + восстановление после ошибок поиска
    featMove:      true,    ; ходить
    featChest:     true,    ; открывать сундуки (E по золотому пятну)
    featLoot:      true,    ; подбирать оружие/лут по цвету редкости
    featHeal:      true,    ; лечиться при низком HP
    featCombat:    true,    ; находить врагов, наводиться и стрелять по ним
    teamSafe:      false,   ; true = отключить автострельбу (вести бой только вручную)
    featSound:     true,    ; реагировать на визуализацию звука (выстрелы/шаги/сундуки)
    featFightBack: true,    ; мгновенно разворачиваться и отстреливаться при получении урона
    featParkour:   true,    ; паркур: карабканье (Mantle), прыжки, подкаты, стрейф
    featCrouchFight: true,  ; приседать в перестрелке и на дальней дистанции
    featAds:       true,    ; удерживать прицел (ПКМ) на средней и дальней дистанции
    featProStyle:  true,    ; стиль про-игрока: укрытие, выход из Бури, смена оружия
    featCover:     false,   ; ставить укрытие (стену) — включите, когда зададите клавишу
    buildWall:     "",      ; клавиша «стена» в Fortnite (напр. F1 или Mouse4) — ПРОВЕРЬТЕ
    proFightMaxMs: 12000,   ; при низком HP и затяжном бое — манёвр отхода
    proRetreatHp:  42,      ; HP ниже этого под плотным огнём — уход за укрытие
    proHealPct:    75,      ; после боя уведомление о низком HP
    damageDrop:    6,       ; падение HP (%), при котором срабатывает разворот на атаку
    fightBackMs:   5500,    ; окно активного ответа на полученный урон
    featReward:    true,    ; забирать награду и закрывать экран пиратского магазина
    featToken:     true,    ; при жетоне один раз жать «\» (магазин)
    featHarvest:   true,    ; настройка сохранена, но слепые удары отключены
    featFirstSlot: true,    ; в начале матча и после сундука брать оружие в слот 1
    featReload:    true,    ; тактическая перезарядка (R) и смена слота после серии очередей
    dryRun:        true,    ; true = ничего не нажимать, только логи
    bgMode:        false,   ; ФОН-РЕЖИМ: игра не в фокусе (вы ушли в браузер) — бот
                            ; продолжает работать: кадр берём у самого окна игры
                            ; (PrintWindow), клавиши шлём прямо в окно (PostMessage).
                            ; Мышь в фоне не работает: обзор камеры игра читает
                            ; только из активного окна — так устроен ввод в игре.
    focusGraceMs:  2500,    ; v7.5: короткая потеря фокуса (переключились в меню и
                            ; обратно) НЕ считается остановкой: движение, сцена и
                            ; кэши сохраняются, бот продолжает работу сразу
    focusStealMs:  30000,   ; не чаще раза в 30 с пытаемся забрать фокус у другого
                            ; окна. run-18.log: бот каждые 1.5 с поднимал игру
                            ; поверх браузера — работать было невозможно.
    hideOnStart:   false,   ; НЕ прятать меню: если оно скрыто, не видно, что бот делает

    ; ---- цикл ----
    loopMs:        50,
    tickBudgetMs:  1300,    ; v7.5: 800 -> 1300. Раньше тик прерывался почти
                            ; каждые 2 с, и КАЖДОЕ прерывание отпускало клавиши —
                            ; персонаж останавливался через пару шагов.
    tickGraceMs:   700,     ; v7.5: столько тик может ПЕРЕРАБОТАТЬ, если он внутри
                            ; действия (поворот/шаг). Такие участки не рвём:
                            ; лучше опоздать на 0.3 с, чем дёрнуть персонажа
    tickHangAbortMs: 9000,  ; столько висим — сторож просит тик прерваться
    tickHardResetMs: 20000, ; не вышел по просьбе за это время — забираем флаг
    tickReloadMs: 14000,    ; не вышел И ПОСЛЕ ЭТОГО — перезапускаем скрипт целиком
                            ; (run-16.log: тик висел 100+ с, а убить поток извне
                            ;  в AHK нельзя; Reload убивает все потоки сразу)
    gameHangMs:     250,    ; окно игры не ответило за это время — клавиши не шлём

    ; ---- реальное время: сколько работы влезает в ОДИН тик ----
    scanPerTickMax: 8,      ; бюджет быстрых однопроходных сканов за тик (бой+сундук+навигация)
    slowBranchMs:  250,     ; ветка тика дольше — пишем в журнал (диагностика)
    tickTargetMs:   120,    ; к этому времени тика стремимся
    stepBoostMax:   6,      ; насколько можно огрубить шаг сканов на слабом ПК
    ; ---- антидребезг сцены и защита матча (run-13.log) ----
    stateStickyMs:  900,    ; ЛОББИ <-> ПОИСК не меняем чаще этого
    matchGuardMs:   2500,   ; «лобби» в живом матче подтверждается столько
    matchGuardWindowMs: 20000,  ; столько тик считается «матч ещё идёт»
    playMinGapMs:  20000,   ; между нажатиями «Играть» минимум столько (run-16.log:
                            ; счётчики сбрасывались миганием сцены, и бот жал 9 раз)
    lobbyStableMs: 2500,    ; лобби должно продержаться столько, а не один кадр
    mmFlickerMs:   3000,    ; «ПОИСК -> ЛОББИ» раньше этого срока — мигание детектора
    lobbyClickGuardMs: 25000,   ; после матча столько не жмём «Играть
    logFile:       A_ScriptDir "\run.log",

    ; ---- области, доли экрана [x1, y1, x2, y2] ----
    regEnd:       [0.00, 0.00, 1.00, 1.00],   ; общий поиск кнопок итогов
    regResults:   [0.55, 0.18, 1.00, 0.86],   ; правая колонка итогов (включая «Остаться с командой»)
    regReturnBtn: [0.62, 0.72, 0.98, 0.96],   ; резервная «В лобби» внизу справа на итогах
    regLobbyBtn:  [0.02, 0.72, 0.30, 0.95],   ; «Играть» / «Готово» / «Отменить»
    regLobbyPanel:[0.00, 0.30, 0.40, 1.00],   ; вся левая панель лобби
    regSleepBtn:  [0.28, 0.38, 0.72, 0.72],   ; кнопка «Продолжить игру» в спящем режиме
    regLeaveMenu: [0.68, 0.08, 0.98, 0.45],   ; правая панель меню Esc («Выйти в лобби»)
    regConfirmBtn:[0.30, 0.48, 0.70, 0.80],   ; подтверждение выхода по центру
    regLoot:      [0.12, 0.25, 0.90, 0.93],   ; свечение лута/сундуков
    regEnemy:     [0.05, 0.15, 0.95, 0.88],   ; область поиска врага в мире
    regHp:        [0.02, 0.885, 0.24, 0.990], ; полоса здоровья (низ-лево)
    regSound:     [0.10, 0.14, 0.90, 0.80],   ; метки звука в мире
    regSlots:     [0.70, 0.865, 1.00, 0.995], ; панель слотов/материалов (только в матче)
    regDeath:     [0.30, 0.84, 0.64, 0.99],   ; панель «ВАС УСТРАНЯЕТ» внизу по центру
    regRewardBtn: [0.25, 0.86, 0.78, 0.99],   ; «ЗАБРАТЬ ВСЁ» / «ПОЛУЧИТЬ ВСЁ» / «ИСПОЛЬЗОВАТЬ»
    regToken:     [0.28, 0.10, 0.72, 0.88],   ; жетон «пиратского магазина» (золото + белая F)
    regBanner:    [0.25, 0.08, 0.75, 0.45],   ; баннер «ВАША НАХОДКА» в матче

    ; ---- признаки кнопок (по цвету: и оливково-жёлтая 203,203,0, и яркая 247,254,25) ----
    yRMin: 155, yGMin: 155, yBMax: 100, yRGDelta: 48,   ; «ИГРАТЬ» / «ГОТОВО» / «ИГРАТЬ СНОВА»
    creamMin: 200, creamBMin: 150, creamBMax: 215,      ; «ОТМЕНИТЬ» кремовая
    btnMinW: 0.06, btnMaxW: 0.45, btnMinAspect: 1.6,    ; фильтры плашки

    ; ---- сцена ----
    ; ВАЖНО (проверено на реальных скриншотах): лобби — тоже детальный 3D-кадр
    ; (края 0.41 против 0.16 в матче), поэтому «плотность краёв» сцены НЕ различает.
    ; Надёжный признак матча — HUD: панель слотов внизу справа и полоса HP слева.
    ; структурные признаки полосы здоровья (проверено на реальных кадрах):
    ;   матч   — длина серии 164..241 px, толщина 22..32 строки;
    ;   лобби/итоги/награда — серии нет вообще (0 px).
    barMinRun:      60,         ; минимальная длина ровной серии, px
    ; ПОИСК ПОЛОСЫ HP ПО ШИРОКОЙ ПОЛОСЕ (run-17.log). В матче бар читался как
    ; «9 px» или «0 px» — фиксированная область промахивалась, и бот не считал
    ; себя в матче ВООБЩЕ: стоял, отпускал клавиши, иногда жал «Играть».
    hudBand:        [0.00, 0.780, 0.36, 1.000], ; где вообще ищем полосы HP/щита
    hudDetectRun:   70,         ; такую ровную полосу уже считаем HUD матча
    hudDetectThick: 4,
    hudHoldMs:      2500,       ; видели HUD — столько «мы в матче» без вопросов
    hudLostMs:      3000,       ; HUD пропал дольше — только тогда выходим из матча
    sceneHoldMs:    1200,       ; слабую сцену меняем не чаще
    hpBarMinThick:  6,          ; и толщиной хотя бы столько строк
    slotsBrightMin: 0.015,      ; справочно: яркость панели слотов (для журнала)
    endDarkRatio:   0.45,       ; затемнение экрана итогов (резервный признак)
    deathBrightMin: 0.10,       ; яркая панель «ВАС УСТРАНЯЕТ» => мы устранены
    deathEscMs:     45000,      ; столько ждём на экране смерти, потом Esc
    ; экран награды / пиратского магазина (сезон 5 «Охотники за сокровищами»)
    rewardClickMax:  6,         ; столько раз жать «Забрать всё», потом просто ждать
    rewardGapMs:     3000,      ; пауза между нажатиями
    ; жетон (золотой круг с белой «F») — один раз жмём «\»
    tokenRearmMs:    5000,      ; жетон должен пропасть на столько, чтобы жать снова
    tokenPressMax:   3,         ; страховка от зацикливания
    bannerGoldMin:   0.13,      ; золота в баннере находки (на кадре 0.167, у сундука 0.09)
    bannerLightMax:  0.140,     ; БУКВЫ занимают мало места. Больше — это не баннер,
                                ; а светлая картинка/видео на экране (run-17: ложный
                                ; баннер на скриншоте рабочего стола)
    bannerBandRows:  40,        ; сколько строк должны быть золотыми БОЛЬШЕ ЧЕМ
                                ; НАПОЛОВИНУ по ширине. У настоящего баннера — 106,
                                ; у фотографии/видео — 0. Это и есть решающий признак
    bannerLightMin:  0.020,     ; светлых букв «ВАША НАХОДКА» (на кадре 0.027, у сундука 0.000)
    ; ВАЖНО: активация жетона запускает 14-дневный отсчёт бесплатного магазина.
    ; Поэтому на экране, где виден жетон, бот НЕ жмёт кнопки — только «\».
    tokenNoClick:    true,

    ; ---- поиск матча / ошибки ----
    mmStuckMs:     50000,   ; после этого предупреждаем, но не отменяем поиск вслепую

    ; ---- сундуки и лут (v11.0: золотые + редкие синие + звуковая дуга + удержание E) ----
    chestGoldArea:   420,       ; минимальная площадь сундука (px при 1280) — видим издалека
    chestHoldMs:     580,       ; удержание E при открытии сундука (работает и для hold, и для tap)
    chestAudioSeek:  true,      ; идти на золотую метку сундука на кольце визуализации звука
    chestCloseOpen:  true,      ; открывать подтверждённый яркий сундук в упор по прицелу
    interactVerifyMs: 1100,     ; проверка открытия сундука / исчезновения плашки после E
    interactCenterX: 0.14,      ; объект ближе этого к центру => можно жать E
    interactCenterY: 0.20,
    lootMinArea:     360,       ; минимальная площадь цветного пятна лута

    ; ---- здоровье / лечение ----
    hpLowPercent:  55,
    hpBarFrac:     0.159,   ; полная длина полосы HP в долях ширины экрана
    shBarFrac:     0.159,
    ; ---- v7.5–v11.0: сундук за стеной / в ящике (пролом киркой) ----
    featBreakBox:  true,       ; ломать ящик/стену киркой на пути к сундуку или из тупика
    breakSwingCount: 4,        ; ударов за подход
    breakGapMs:    1400,       ; пауза между подходами с киркой
    breakGiveUpMs: 14000,      ; столько упорствуем с одним объектом
    ; ---- фильтр размеров сундука (отсекает золотые крыши, песок и витрины) ----
    chestGoldMax:  32000,      ; золота больше — это свечение/здание, а не сундук
    chestMaxW:     290,        ; сундук не бывает шире (при 1280)
    chestMaxH:     240,
    badSpotMs:     42000,      ; столько не трогаем уже открытый или недоступный сундук
    badSpotPx:     135,        ; радиус «того же места», px
    breakMaxPerMin: 4,         ; подходов с киркой не больше N в минуту
    breakVerifySwings: 2,      ; столько ударов без изменений картинки — бросаем
    breakChangeMin: 6,         ; насколько должна измениться яркость у цели

