ParseNumSafe(str, def, lo, hi, asInt := true) {
    s := StrReplace(Trim(str), ",", ".")
    if (s = "")
        return def
    try v := Number(s)
    catch
        return def
    v := Clamp(v, lo, hi)
    return asInt ? Round(v) : Round(v, 2)
}

OnSaveAfkSettings(*) {
    global CFG, ST, UI, HUD
    CancelCoordPick(false)
    CFG.matchMaxMin := ParseNumSafe(UI.edMatchMin.Value, 0, 0, 180, false)
    CFG.lobbyDelaySec := ParseNumSafe(UI.edLobbySec.Value, 0, 0, 600, true)
    CFG.stopAfterMin := ParseNumSafe(UI.edStopMin.Value, 0, 0, 1440, false)
    CFG.maxRounds := ParseNumSafe(UI.edMaxRounds.Value, 0, 0, 500, true)
    CFG.squadGraceSec := ParseNumSafe(UI.edSquadGrace.Value, 45, 10, 300, true)
    mmRaw := ParseNumSafe(UI.edMmRec.Value, 0, 0, 900, true)
    CFG.mmRecoverSec := (mmRaw > 0 && mmRaw < 90) ? 90 : mmRaw
    CFG.endAction := (UI.ddEndAct.Value = 2) ? "lobby_only" : "play_again"
    sa := UI.ddStopAct.Value
    CFG.stopAction := (sa = 2) ? "close_game" : ((sa = 3) ? "sleep_pc" : "none")
    sl := UI.ddSleepAct.Value
    CFG.sleepAction := (sl = 2) ? "stop" : ((sl = 3) ? "wait" : "wake")
    pf := UI.ddPerf.Value
    ApplyPerfProfile((pf = 2) ? "balanced" : ((pf = 3) ? "low_cpu" : "fast"))
    CFG.queueAntiAfk := UI.cbQueueAfk.Value ? true : false
    CFG.finishMatch := UI.cbFinishMatch.Value ? true : false
    if !CFG.finishMatch
        ST.finishMatchArmed := false, ST.finishMatchReason := ""
    CFG.waitSquadOnDeath := UI.cbWaitSquad.Value ? true : false
    CFG.audioAlert := UI.cbAlert.Value ? true : false
    CFG.stopOnToken := UI.cbStopTok.Value ? true : false
    if !CFG.stopOnToken
        ST.tokenStopArmed := false
    CFG.treasureHour := UI.cbTreasure.Value ? true : false
    CFG.cloudGaming := UI.cbCloud.Value ? true : false
    CFG.miniHudStart := UI.cbMiniStart.Value ? true : false
    CFG.keepAwake := UI.cbAwake.Value ? true : false
    CFG.hideFromCapture := UI.cbHideCap.Value ? true : false
    if ST.running
        UpdateKeepAwake(CFG.keepAwake)
    ; Применяем флаг скрытия окна от захвата сразу ко всем окнам FORMA
    try {
        aff := CFG.hideFromCapture ? 0x00000011 : 0
        for w in [UI.gui, UI.afkGui, UI.extGui, UI.keyGui, UI.detailGui, HUD.gui] {
            if w
                DllCall("user32\SetWindowDisplayAffinity", "Ptr", w.Hwnd, "UInt", aff, "Int")
        }
    }
    ref := GetSelectedRefSize()
    CFG.coordRefW := ref.w, CFG.coordRefH := ref.h
    px := ParseNumSafe(UI.edPlayX.Value, Round(CFG.playNormX * ref.w), 1, ref.w - 1, true)
    py := ParseNumSafe(UI.edPlayY.Value, Round(CFG.playNormY * ref.h), 1, ref.h - 1, true)
    ox := ParseNumSafe(UI.edOptX.Value, Round(CFG.optNormX * ref.w), 1, ref.w - 1, true)
    oy := ParseNumSafe(UI.edOptY.Value, Round(CFG.optNormY * ref.h), 1, ref.h - 1, true)
    lx := ParseNumSafe(UI.edLeaveX.Value, Round(CFG.leaveNormX * ref.w), 1, ref.w - 1, true)
    ly := ParseNumSafe(UI.edLeaveY.Value, Round(CFG.leaveNormY * ref.h), 1, ref.h - 1, true)
    CFG.playNormX := Round(px / ref.w, 5), CFG.playNormY := Round(py / ref.h, 5)
    CFG.optNormX := Round(ox / ref.w, 5), CFG.optNormY := Round(oy / ref.h, 5)
    CFG.leaveNormX := Round(lx / ref.w, 5), CFG.leaveNormY := Round(ly / ref.h, 5)
    ok := SaveSettings()
    UpdateTrayChecks()
    UpdateStatus()
    msg := ok ? "Настройки AFK сохранены (ЦП: " PerfRu(CFG.perfProfile)
        . ", матч: " (CFG.matchMaxMin > 0 ? CFG.matchMaxMin " мин" : "до конца") ")."
        : "Не удалось записать forma.ini — см. журнал."
    try UI.afkResult.Value := msg
    Log("[i] " msg)
    Flash(msg, 3000)
}

