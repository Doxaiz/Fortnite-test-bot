HideKeySettings(*) {
    global UI
    if UI.keyGui
        UI.keyGui.Hide()
}

SyncHotkeyFields() {
    global CFG, UI
    try {
        UI.edStart.Value := CFG.hkStart
        UI.edDry.Value   := CFG.hkDry
        UI.edCal.Value   := CFG.hkCal
        UI.edMouseCal.Value := CFG.hkMouseCal
        UI.edCheck.Value := CFG.hkCheck
        UI.edMenu.Value  := CFG.hkMenu
        UI.edVision.Value := CFG.hkVision
    } catch {
    }
}

OnResetSettings() {
    global CFG, UI
    CFG.hkStart := "F8", CFG.hkDry := "F9", CFG.hkCal := "F5", CFG.hkMouseCal := "F6"
    CFG.hkCheck := "F7", CFG.hkMenu := "F1"
    CFG.dryRun := true
    CFG.teamSafe := true
    CFG.hkVision := "F3", CFG.bgMode := false
    SetAutomaticFeatures()
    SyncHotkeyFields()
    SyncTogglesFromCfg()
    ApplyHotkeys()
    saved := SaveSettings()
    resetMsg := saved && UI.hkKeys.Length = 7 ? "Сброшено и сохранено: стандартные клавиши."
        : "Сброс не полностью сохранён или клавиша не назначена. См. журнал."
    try UI.keyResult.Value := resetMsg
    Log("[i] " resetMsg)
    Flash(resetMsg, 3000)
}

OnShowHelp() {
    msg := "FORMA — краткая справка"
        . "`n`n1. Запустите Fortnite, выберите оконный режим без рамки и проверьте захват."
        . "`n2. Выберите командный режим или соло самостоятельно. В команде автонаведение и автоогонь отключены."
        . "`n3. Тест без нажатий позволяет проверить интерфейс без управления игрой."
        . "`n4. Старт / стоп, пауза и поиск матча доступны на главной панели."
        . "`n`nКЛАВИШИ: кнопка «Клавиши и сервис» позволяет переназначить действия;"
        . " после ввода нажмите «Применить и сохранить». Esc — стоп."
        . "`n`nДИАГНОСТИКА: HUD проверяет видимые элементы, «Захват окна» — окно игры,"
        . " «Зрение» показывает захваченный кадр и отметки, «Проверить кадры» анализирует snapshots."
        . " Для проверки кадров требуется Python с OpenCV; работа бота — только AutoHotkey v2."
        . "`n`nМЫШЬ: кнопка и клавиша запускают пока только пассивную проверку кадра."
        . " Автокалибровка чувствительности и профили ПКМ ещё не реализованы."
        . "`n`nВАЖНО: автоматическое лечение и перезарядка отключены до надёжного"
        . " распознавания предметов и патронов. В слоте 4 может быть лечение."
        . " Сундук не считается гарантированно открытым по одной подсказке."
        . "`n`nВсе обычные функции включены без отдельных галочек, но их работоспособность"
        . " в Fortnite не проверена. В Zero Build постройки отключены."
        . " Мышь не управляет игрой без фокуса. При отменённом поиске бот ждёт пользователя."
    MsgBox(msg, "FORMA — справка", "Iconi")
}

