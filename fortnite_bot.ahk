; Интерактивный захват точки курсором за 3 с (с учётом смещения окна и 2-го монитора).
CoordKindRu(kind) {
    return (kind = "opt") ? "Меню Esc: Параметры"
        : ((kind = "leave") ? "Меню Esc: В лобби" : "Кнопка «Играть»")
}

StartCoordPick(kind) {
    global ST, UI
    ST.pickActive := true
    ST.pickKind := kind
    ST.pickLeft := 3
    SetTimer(CoordPickTick, 1000)
    CoordPickTick()
}

CancelCoordPick(notify := true) {
    global ST
    if !ST.pickActive
        return
    SetTimer(CoordPickTick, 0)
    ST.pickActive := false
    ST.pickKind := ""
    ST.pickLeft := 0
    if notify
        Flash("Захват координат отменён", 1800)
}

CalcNormFromCursor(mx, my, area) {
    if (!area || area.w < 50 || area.h < 50)
        return 0
    if (mx < area.x || mx >= area.x + area.w || my < area.y || my >= area.y + area.h)
        return 0
    nx := Clamp(Round((mx - area.x) / area.w, 5), 0.005, 0.995)
    ny := Clamp(Round((my - area.y) / area.h, 5), 0.005, 0.995)
    return {nx: nx, ny: ny, rx: Round(mx - area.x), ry: Round(my - area.y)}
}

CoordPickTick() {
    global CFG, ST, UI
    if !ST.pickActive {
        SetTimer(CoordPickTick, 0)
        return
    }
    label := CoordKindRu(ST.pickKind)
    if (ST.pickLeft > 0) {
        msg := "Наведите мышь на «" label "» (" ST.pickLeft " с)..."
        Flash(msg, 1100)
        try {
            if UI.afkGui
                UI.afkResult.Value := msg
        }
        ST.pickLeft -= 1
        return
    }
    kind := ST.pickKind
    SetTimer(CoordPickTick, 0)
    ST.pickActive := false, ST.pickKind := "", ST.pickLeft := 0
    CoordMode("Mouse", "Screen")
    mx := 0, my := 0
    MouseGetPos(&mx, &my)
    hwnd := GetGameWindow()
    area := hwnd ? GetClientArea(hwnd) : 0
    srcNote := "окно игры"
    if !area {
        ; Если игра закрыта — пересчитываем относительно монитора, где стоит курсор
        area := {x: 0, y: 0, w: Max(640, A_ScreenWidth), h: Max(480, A_ScreenHeight)}
        try {
            mc := MonitorGetCount()
            loop mc {
                ml := 0, mt := 0, mr := 0, mb := 0
                MonitorGet(A_Index, &ml, &mt, &mr, &mb)
                if (mx >= ml && mx < mr && my >= mt && my < mb) {
                    area := {x: ml, y: mt, w: mr - ml, h: mb - mt}
                    break
                }
            }
        }
        srcNote := "экран " area.w "×" area.h
    }
    res := CalcNormFromCursor(mx, my, area)
    if !res {
        warn := "Курсор вне окна игры (" mx "," my ") — наведите внутрь Fortnite."
        try {
            if UI.afkGui
                UI.afkResult.Value := warn
        }
        Flash(warn, 3400)
        return
    }
    if (kind = "opt")
        CFG.optNormX := res.nx, CFG.optNormY := res.ny
    else if (kind = "leave")
        CFG.leaveNormX := res.nx, CFG.leaveNormY := res.ny
    else
        CFG.playNormX := res.nx, CFG.playNormY := res.ny
    ref := GetSelectedRefSize()
    SyncCoordFields(ref.w, ref.h)
    PlayAlertBeep(1046, 90)
    done := "Захвачено «" label "»: (" res.rx "," res.ry ") [" srcNote "] — нажмите «Сохранить»."
    Log("[+] " done)
    try {
        if UI.afkGui
            UI.afkResult.Value := done
    }
    Flash(done, 3200)
}

