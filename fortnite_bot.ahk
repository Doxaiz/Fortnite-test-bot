OnTestWebhook(*) {
    global CFG, UI
    try CFG.webhookUrl := Trim(UI.edWebhook.Value)
    if (CFG.webhookUrl = "") {
        msg := "Вставьте HTTPS URL вебхука Discord и нажмите «Тест»."
        try UI.extResult.Value := msg
        Flash(msg, 2800)
        return
    }
    if !ValidateWebhookUrl(CFG.webhookUrl) {
        msg := "Некорректный адрес: нужен публичный https://... URL без пробелов."
        try UI.extResult.Value := msg
        Flash(msg, 3200)
        return
    }
    try UI.extResult.Value := "Отправляю тестовое сообщение..."
    testMsg := "🔔 **FORMA v10.0 — тест уведомлений** · связь работает!"
        . " · Всего раундов: " CFG.totalRounds
        . " · [E]: " CFG.totalChests " (шанс " FmtOdds(CFG.totalChests, CFG.treasureHour) ")"
    SendWebhookAsync(testMsg, "тест", true)
}

OnSaveExtraSettings(*) {
    global CFG, ST, UI
    xa := UI.ddXpAct.Value
    CFG.xpAction := (xa = 2) ? "click" : ((xa = 3) ? "hold_lmb"
        : ((xa = 4) ? "interact" : ((xa = 5) ? "nudge_only" : "move")))
    CFG.xpActionSec := ParseNumSafe(UI.edXpActSec.Value, 18, 2, 300, true)
    CFG.xpNudgeSec := ParseNumSafe(UI.edXpNudgeSec.Value, 285, 30, 380, true)
    CFG.xpNudgePx := ParseNumSafe(UI.edXpNudgePx.Value, 95, 20, 260, true)
    CFG.coinRemindMin := ParseNumSafe(UI.edCoinMin.Value, 0, 0, 180, false)
    if (CFG.xpAction != "hold_lmb")
        XpReleaseLmb()
    ST.coinNextAt := 0
    if (ST.running && CFG.botMode = "xp")
        ST.xpNextNudgeAt := A_TickCount + XpNextNudgeDelayMs()
    CFG.macroInQueue := UI.cbMacroQueue.Value ? true : false
    if !CFG.macroInQueue
        MacroPlayReset()
    CFG.webhookUrl := Trim(UI.edWebhook.Value)
    CFG.webhookToken := UI.cbWhTok.Value ? true : false
    CFG.webhookStop := UI.cbWhStop.Value ? true : false
    CFG.webhookRound := UI.cbWhRound.Value ? true : false
    CFG.webhookSave := UI.cbWhSave.Value ? true : false
    if (CFG.webhookUrl != "" && !ValidateWebhookUrl(CFG.webhookUrl)) {
        warn := "Проверьте URL вебхука: допускается только публичный https://..."
        try UI.extResult.Value := warn
        Flash(warn, 3400)
        return
    }
    ok := SaveSettings()
    UpdateStatus()
    msg := ok ? ("Сохранено: XP «" XpActRu(CFG.xpAction) "» · камера ~" CFG.xpNudgeSec " с"
        . (CFG.webhookUrl != "" ? (CFG.webhookSave ? " · Webhook в INI" : " · Webhook в ОЗУ") : ""))
        : "Не удалось записать forma.ini — см. журнал."
    try UI.extResult.Value := msg
    Log("[i] " msg)
    Flash(msg, 3000)
}

GetSelectedRefSize() {
    global CFG, UI
    idx := 1
    try idx := UI.ddResPreset.Value
    if (idx = 2)
        return {w: 2560, h: 1440}
    if (idx = 3)
        return {w: 3840, h: 2160}
    if (idx = 4) {
        hwnd := GetGameWindow()
        area := hwnd ? GetClientArea(hwnd) : 0
        if area
            return {w: area.w, h: area.h}
    }
    return {w: 1920, h: 1080}
}

